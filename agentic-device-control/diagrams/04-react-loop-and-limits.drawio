<mxfile host="app.diagrams.net"><diagram id="p_04_react_loop_and_limits" name="04-react-loop-and-limits"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="880" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Three nested limits bound one task: 20 [I1] ReAct iterations per specialist turn, inside 10 [I2] graph hops, inside a 5 min [I3] watchdog" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="34" as="geometry" /></mxCell><mxCell id="wd" value="WATCHDOG: whole task, 5 min [I3] wall clock  -&gt;  catches a slow model or network" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=center;fontSize=12;fontStyle=1;dashed=1;fillColor=none;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="64" width="820" height="580" as="geometry" /></mxCell><mxCell id="gs" value="GRAPH STEP LIMIT: 10 [I2] orchestrator -&gt; specialist hops  -&gt;  catches ping-pong between nodes" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=center;fontSize=12;fontStyle=1;dashed=1;fillColor=none;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="100" width="780" height="528" as="geometry" /></mxCell><mxCell id="orc" value="ORCHESTRATOR&#10;routes to a specialist (diagram 02)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="140" width="220" height="56" as="geometry" /></mxCell><mxCell id="turn" value="ONE SPECIALIST TURN: ReAct iteration limit 20 [I1]  -&gt;  catches a stuck inner loop" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=center;fontSize=12;fontStyle=1;dashed=1;fillColor=none;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="226" width="740" height="386" as="geometry" /></mxCell><mxCell id="th" value="THOUGHT&#10;the model reasons about the&#10;latest screenshot + history" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="110" y="300" width="210" height="96" as="geometry" /></mxCell><mxCell id="ac" value="ACTION&#10;a tool call, e.g. left_click;&#10;device code executes it" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="410" y="300" width="210" height="96" as="geometry" /></mxCell><mxCell id="ob" value="OBSERVATION&#10;wait the settle delay 1 s [I4],&#10;capture, return the screenshot&#10;as the tool result" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="410" y="444" width="210" height="96" as="geometry" /></mxCell><mxCell id="err" value="Action failed on the device? Return an ERROR RESULT as the observation; the model reads it and re-plans. An exception would end the loop instead." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#fff7f7;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="100" y="544" width="300" height="56" as="geometry" /></mxCell><mxCell id="exA" value="EXIT 1&#10;reply with NO tool call:&#10;sub-goal believed done&#10;(orchestrator still checks)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="650" y="262" width="150" height="92" as="geometry" /></mxCell><mxCell id="exB" value="EXIT 2  loop detection&#10;same action repeated,&#10;screen unchanged:&#10;stop, report &quot;stuck&quot;" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="650" y="444" width="150" height="96" as="geometry" /></mxCell><mxCell id="lim" value="WHAT EACH LIMIT CATCHES&#10;- iteration limit 20 [I1]: a stuck inner loop&#10;- graph step limit 10 [I2]: ping-pong between nodes&#10;- watchdog 5 min [I3]: a slow model or network (a slow step can use up time without using up steps)&#10;Size each from the step-count distribution of SUCCESSFUL runs, plus headroom. Too low fails healthy long tasks; too high lets a stuck loop burn tokens." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="870" y="64" width="380" height="150" as="geometry" /></mxCell><mxCell id="rec" value="WHY THE LOOP MATTERS: RECOVERY&#10;Without recovery, per-step reliability compounds: p = 0.9 [I5] per step, n = 5 [I6] steps, so the task succeeds with p^n = 0.9^5 ≈ 0.59 [calc].&#10;The observe-and-retry loop breaks this product: a wrong click shows in the next observation and is undone (go_back, close a dialog, scroll)." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="870" y="228" width="380" height="124" as="geometry" /></mxCell><mxCell id="pub" value="PUBLIC EVIDENCE FOR THE PATTERN&#10;ReAct (Yao et al. 2022): +34 pp [P7] absolute success on ALFWorld and +10 pp [P8] on WebShop over imitation / RL baselines, with only 1-2 [P9] in-context examples.&#10;Their benchmarks, not yours: measure on your own devices and apps." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="870" y="366" width="380" height="108" as="geometry" /></mxCell><mxCell id="legend" value="Legend:  dashed frames = limits, each wraps everything inside it (red watchdog, amber step limit, green iteration limit)  |  green = model call  |  blue = device code  |  amber = check in code  |  red = error result  |  solid arrows = one ReAct iteration; exits leave the turn and return to the orchestrator" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="658" width="1220" height="36" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Numbers are loaded from ../constants.json by key (shown). P = public (cited doc/paper, value as published); I = illustrative (round value chosen to explain the idea, never a measurement); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/06-the-react-loop.md (loop, two loop exits, three nested limits, error results, loop detection, limit sizing); notes/09-evaluation.md (compounding per-step reliability). Vendor reference loop and error handling: computer-use tool documentation, 'Understand the agent loop', 'Handle errors'. ReAct: Yao et al. 2022, https://arxiv.org/abs/2210.03629, abstract.&#10;[I1] react_iteration_limit_illustrative = 20 iterations per specialist turn. illustrative inner-loop limit&#10;[I2] graph_step_limit_illustrative = 10 orchestrator hops. illustrative outer-loop limit&#10;[I3] watchdog_timeout_illustrative = 5 min. illustrative hard limit on task wall time&#10;[I4] settle_delay_illustrative = 1 s. illustrative wait after an action before the next screenshot&#10;[I5] per_step_success_illustrative = 0.9 probability. illustrative; with 5 steps and no recovery gives 0.59 by my arithmetic&#10;[I6] steps_without_recovery_illustrative = 5 steps. illustrative&#10;[P7] react_alfworld_gain_pp = 34 percentage points absolute success rate. public: Yao et al. 2022, ReAct, arXiv:2210.03629, abstract (ALFWorld, over imitation/RL baselines)&#10;[P8] react_webshop_gain_pp = 10 percentage points absolute success rate. public: Yao et al. 2022, ReAct, arXiv:2210.03629, abstract (WebShop)&#10;[P9] react_in_context_examples = [1, 2] examples. public: Yao et al. 2022, ReAct, arXiv:2210.03629, abstract" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="708" width="1220" height="156" as="geometry" /></mxCell><mxCell id="edge0" value="route" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.162;entryY=0;entryDx=0;entryDy=0;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1" source="orc" target="turn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="tool call" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="th" target="ac"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="executed" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="ac" target="ob"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="next iteration" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="ob" target="th"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="215" y="492" /></Array></mxGeometry></mxCell><mxCell id="edge4" value="no tool call" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.13;entryDx=0;entryDy=0;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1" source="th" target="exA"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="215" y="274" /><mxPoint x="650" y="274" /></Array></mxGeometry></mxCell><mxCell id="edge5" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#d79b00;fontColor=#d79b00;" edge="1" parent="1" source="ob" target="exB"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="summary to state; control returns" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=0.93;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1" source="exA" target="orc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="790" y="168" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>