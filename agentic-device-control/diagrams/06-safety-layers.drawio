<mxfile host="app.diagrams.net"><diagram id="p_06_safety_layers" name="06-safety-layers"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="756" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="The model proposes, device code disposes: each layer after the prompt assumes the one before it has failed, and the log records every step" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="34" as="geometry" /></mxCell><mxCell id="task" value="TASK  (trusted)&#10;from the authenticated cloud&#10;message: the ONLY instruction" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="84" width="230" height="92" as="geometry" /></mxCell><mxCell id="screen" value="SCREEN CONTENT  (untrusted DATA)&#10;notifications, web pages,&#10;in-app messages, text inside images&#10;-&gt; indirect prompt injection&#10;(OWASP LLM01)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="206" width="230" height="140" as="geometry" /></mxCell><mxCell id="model" value="THE MODEL PROPOSES&#10;(orchestrator / specialists)&#10;&#10;LAYER 1  INSTRUCTION HIERARCHY&#10;in the system prompt: only the task is an instruction; screen text is content to read.&#10;Lowers the injection rate. Does NOT remove it." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="120" width="230" height="176" as="geometry" /></mxCell><mxCell id="dev" value="DEVICE CODE DISPOSES  (the model cannot change anything in this frame)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=center;fontSize=12;fontStyle=1;dashed=1;fillColor=none;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="570" y="70" width="680" height="330" as="geometry" /></mxCell><mxCell id="l2" value="LAYER 2  ALLOW-LIST&#10;named, typed tools only; no &quot;run this command&quot; tool.&#10;Arguments checked: launch_app accepts listed packages, open_settings listed pages." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="590" y="112" width="200" height="160" as="geometry" /></mxCell><mxCell id="l3" value="LAYER 3  SCOPE LIMITS&#10;screen taps cannot be listed one by one, so limit the context: only apps on the per-task list; refuse to type into password, payment or account-deletion screens." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="810" y="112" width="200" height="160" as="geometry" /></mxCell><mxCell id="l4" value="LAYER 4  CONFIRMATION GATE&#10;irreversible or costly (purchase, delete, send a message, factory reset): approval from a human or a cloud policy, before EACH action in a batch." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1030" y="112" width="200" height="160" as="geometry" /></mxCell><mxCell id="refuse" value="REFUSED  -&gt;  error result to the model, and logged" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=12;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="590" y="318" width="380" height="62" as="geometry" /></mxCell><mxCell id="exec" value="EXECUTE on the device" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=12;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1030" y="318" width="200" height="62" as="geometry" /></mxCell><mxCell id="log" value="LAYER 5  AUDIT LOG  (append-only, stored off the device with the result report, diagram 01):  the task  |  every routing decision  |  every tool call with its arguments  |  every result  |  a reference to each screenshot" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="430" width="1220" height="54" as="geometry" /></mxCell><mxCell id="trade" value="TRADE-OFFS&#10;- Least privilege vs capability: every tool removed shrinks the blast radius and removes something a task might need. Start narrow; add a tool when an evaluated task needs it.&#10;- Privileged installation is a target: authenticate cloud messages, use short-lived credentials, keep one task source.&#10;- Screenshots hold personal data (OWASP LLM02): minimise retention, redact, access-control the logs.&#10;- Gates cost latency and autonomy: gate the irreversible few, not every tap." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="504" width="610" height="112" as="geometry" /></mxCell><mxCell id="owasp" value="OWASP TOP 10 FOR LLM APPLICATIONS 2025 -&gt; WHICH LAYER ANSWERS IT&#10;- LLM01 Prompt Injection (the screen is the channel): layer 1 lowers it; layers 2-4 bound the damage when it succeeds.&#10;- LLM06 Excessive Agency (more tools, permissions or autonomy than the job needs): layers 2, 3, 4.&#10;- LLM02 Sensitive Information Disclosure: retention, redaction and access control on screenshots and logs (layer 5).&#10;A gate the model can approve for itself is not a gate." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#fff7f7;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="655" y="504" width="595" height="112" as="geometry" /></mxCell><mxCell id="legend" value="Legend:  purple = trusted input  |  red = untrusted input, refusal  |  green = model / execution  |  amber = a check in device code  |  dashed blue frame = code the model cannot alter  |  dashed grey arrows = written to the audit log" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="630" width="1220" height="36" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Numbers are loaded from ../constants.json by key (shown). P = public (cited doc/paper, value as published); I = illustrative (round value chosen to explain the idea, never a measurement); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/08-safety.md (two dominant risks, five controls, trade-offs). Public: OWASP Top 10 for LLM Applications 2025, https://genai.owasp.org/llm-top-10/ (LLM01, LLM02, LLM06); computer-use tool documentation, 'Limitations' (prompt injection via web pages or images) and 'Batch actions' (confirm before each action in a batch).&#10;This page carries no numbers from ../constants.json: note 08 states none. OWASP identifiers are public labels, not quantities." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="680" width="1220" height="60" as="geometry" /></mxCell><mxCell id="edge0" value="instruction" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" parent="1" source="task" target="model"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="130" /><mxPoint x="280" y="155" /></Array></mxGeometry></mxCell><mxCell id="edge1" value="read as data" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="screen" target="model"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="276" /><mxPoint x="280" y="261" /></Array></mxGeometry></mxCell><mxCell id="edge2" value="tool&#10;call" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1" source="model" target="l2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="ok" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#d79b00;fontColor=#d79b00;" edge="1" parent="1" source="l2" target="l3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="ok" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#d79b00;fontColor=#d79b00;" edge="1" parent="1" source="l3" target="l4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge5" value="fails" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.263;entryY=0;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="l2" target="refuse"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="fails" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.842;entryY=0;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="l3" target="refuse"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge7" value="denied" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="l4" target="refuse"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="296" /><mxPoint x="1000" y="296" /><mxPoint x="1000" y="349" /></Array></mxGeometry></mxCell><mxCell id="edge8" value="approved" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1" source="l4" target="exec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge9" value="error result: re-plan" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="refuse" target="model"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="415" y="349" /></Array></mxGeometry></mxCell><mxCell id="edge10" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.278;entryY=0;entryDx=0;entryDy=0;strokeColor=#999999;fontColor=#999999;" edge="1" parent="1" source="model" target="log"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge11" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.615;entryY=0;entryDx=0;entryDy=0;strokeColor=#999999;fontColor=#999999;" edge="1" parent="1" source="refuse" target="log"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge12" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.902;entryY=0;entryDx=0;entryDy=0;strokeColor=#999999;fontColor=#999999;" edge="1" parent="1" source="exec" target="log"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>