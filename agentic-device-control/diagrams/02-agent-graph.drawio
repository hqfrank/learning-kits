<mxfile host="app.diagrams.net"><diagram id="p_02_agent_graph" name="02-agent-graph"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="938" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="One planner, two doers and a plain-code router: every specialist turn returns to the orchestrator until it says FINISH" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="34" as="geometry" /></mxCell><mxCell id="start" value="START" style="rounded=1;whiteSpace=wrap;html=0;arcSize=44;verticalAlign=middle;align=center;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="263" width="90" height="44" as="geometry" /></mxCell><mxCell id="orc" value="ORCHESTRATOR  (planner)&#10;stronger, slower model tier&#10;temperature 0.2 [I1]&#10;max output 4 000 tokens [I3]&#10;&#10;plans ONE step, picks the next node,&#10;FINISHes only on visible evidence" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="150" y="200" width="290" height="170" as="geometry" /></mxCell><mxCell id="router" value="ROUTER&#10;plain code, not a model:&#10;switch on one field" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=12;dashed=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="530" y="245" width="170" height="80" as="geometry" /></mxCell><mxCell id="vis" value="VISION SPECIALIST&#10;fast tier | temperature 0 [I2] | max output 4 000 [I3]&#10;tools: the computer-use tool (screenshot, left_click,&#10;type, key, scroll, zoom ...)&#10;acts through the screen (diagram 03),&#10;in its own ReAct loop (diagram 04)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="780" y="80" width="340" height="140" as="geometry" /></mxCell><mxCell id="fin" value="FINISH" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=12;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="780" y="262" width="120" height="46" as="geometry" /></mxCell><mxCell id="end" value="END" style="rounded=1;whiteSpace=wrap;html=0;arcSize=44;verticalAlign=middle;align=center;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="950" y="262" width="80" height="46" as="geometry" /></mxCell><mxCell id="endnote" value="then the one result report&#10;(diagram 01)" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1040" y="256" width="220" height="60" as="geometry" /></mxCell><mxCell id="act" value="ACTUATOR&#10;fast tier | temperature 0 [I2] | max output 2 000 [I3]&#10;tools: launch_app, open_settings, go_home, go_back,&#10;set_volume, get_device_state  (each allow-listed)&#10;OS route to open an app: 1 call, about 2 s,&#10;vs 2 calls, about 10 s through the screen [I4]" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="780" y="350" width="340" height="140" as="geometry" /></mxCell><mxCell id="state" value="STATE  (one shared object rides every edge):  task text  |  routing decisions + each specialist's summary  |  latest screenshot  |  step counter.  Step limit: 10 orchestrator hops [I5] stops a graph that never says FINISH. It counts steps; the watchdog (diagram 01) counts seconds; keep both." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="556" width="1220" height="50" as="geometry" /></mxCell><mxCell id="fw" value="WHY A HAND-WRITTEN GRAPH, NOT A PYTHON FRAMEWORK&#10;The device runtime is Java/Kotlin; popular agent-graph frameworks are Python-first.&#10;Hand-written: native, no extra interpreter | a while loop + a switch | one-language stack traces | no dependencies | nothing for free.&#10;Framework: embedded Python or bindings | layers per step | framework internals in the trace | a large, fast-moving dependency tree | checkpoints, streaming, interrupts provided.&#10;Deciding fact: this graph is small and stable. Borrow the concepts (named nodes, explicit state, conditional edges, step limit) so a later port is mechanical." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="622" width="610" height="128" as="geometry" /></mxCell><mxCell id="three" value="WHY THREE AGENTS, NOT ONE&#10;- Separation: the planner decides what to do; the specialists only do.&#10;- Different model needs: planning wants the stronger tier; seeing and tapping want the fast one.&#10;- Per-node settings: each node has its own temperature, output cap and tool list.&#10;- Smaller prompts: each specialist sees only its own tools, so fewer tokens and fewer wrong-tool errors.&#10;Cost: every specialist turn costs one more orchestrator call. Hub-and-spoke: specialists never talk to each other." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="655" y="622" width="595" height="128" as="geometry" /></mxCell><mxCell id="legend" value="Legend:  green = node that calls the model  |  dashed white = plain code, no model  |  red = terminal decision  |  blue = shared state  |  solid arrow = router choice  |  dashed arrow = control returns to the orchestrator after EVERY specialist turn" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="764" width="1220" height="36" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Numbers are loaded from ../constants.json by key (shown). P = public (cited doc/paper, value as published); I = illustrative (round value chosen to explain the idea, never a measurement); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/02-the-agent-graph.md (nodes, router, state, step limit, framework comparison, three agents); notes/03-the-orchestrator.md (tier, temperature, output cap, stop on evidence); notes/05-the-actuator.md (actuator tools, OS route). Vocabulary (StateGraph, conditional edges, START/END, recursion limit): LangGraph Graph API docs, https://docs.langchain.com/oss/python/langgraph/graph-api (public).&#10;[I1] orchestrator_temperature_illustrative = 0.2. illustrative low non-zero temperature for the planner&#10;[I2] specialist_temperature_illustrative = 0. illustrative: deterministic-as-possible specialists&#10;[I3] max_output_tokens_illustrative = {orchestrator: 4000, vision: 4000, actuator: 2000} tokens per reply. illustrative per-node reply caps&#10;[I4] actuator_vs_screen_illustrative = {screen_calls: 2, screen_s: 10, os_calls: 1, os_s: 2} model calls / s. illustrative comparison of opening an app via the screen vs via one OS call&#10;[I5] graph_step_limit_illustrative = 10 orchestrator hops. illustrative outer-loop limit" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="814" width="1220" height="108" as="geometry" /></mxCell><mxCell id="edge0" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="start" target="orc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="routing&#10;decision" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1" source="orc" target="router"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="vision" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="router" target="vis"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="615" y="150" /></Array></mxGeometry></mxCell><mxCell id="edge3" value="FINISH" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="router" target="fin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="actuator" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="router" target="act"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="615" y="420" /></Array></mxGeometry></mxCell><mxCell id="edge5" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="fin" target="end"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="summary written to state; control returns" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1" source="vis" target="orc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="62" /><mxPoint x="295" y="62" /></Array></mxGeometry></mxCell><mxCell id="edge7" value="summary written to state; control returns" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1" source="act" target="orc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="525" /><mxPoint x="295" y="525" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>