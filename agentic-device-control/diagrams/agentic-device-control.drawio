<mxfile host="app.diagrams.net"><diagram id="p_01_message_path" name="01-message-path"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="786" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Four cheap guards run before any model token is spent, and every accepted task ends as exactly one result" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="34" as="geometry" /></mxCell><mxCell id="cloud" value="CLOUD SERVER&#10;sends one task message:&#10;message ID, session ID,&#10;type, payload = task text" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="180" height="110" as="geometry" /></mxCell><mxCell id="val" value="1  VALIDATE&#10;well-formed?&#10;known message type?" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="270" y="110" width="150" height="110" as="geometry" /></mxCell><mxCell id="dup" value="2  DE-DUPLICATE&#10;seen this message ID&#10;recently?&#10;IDs kept 10 min [I1]" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="110" width="165" height="110" as="geometry" /></mxCell><mxCell id="lock" value="3  LOCK&#10;is another task&#10;running?&#10;one screen = one task" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="645" y="110" width="155" height="110" as="geometry" /></mxCell><mxCell id="wd" value="4  WATCHDOG: hard stop after 5 min [I2]" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=center;fontSize=12;fontStyle=1;dashed=1;fillColor=none;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="825" y="66" width="430" height="174" as="geometry" /></mxCell><mxCell id="exe" value="WORK EXECUTOR&#10;background job,&#10;outside the UI&#10;(e.g. WorkManager)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="840" y="116" width="160" height="104" as="geometry" /></mxCell><mxCell id="graph" value="AGENT GRAPH&#10;orchestrator + two&#10;specialists call the model&#10;(diagram 02)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1025" y="116" width="215" height="104" as="geometry" /></mxCell><mxCell id="err" value="ERROR at once&#10;malformed or&#10;unknown type" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="270" y="300" width="150" height="70" as="geometry" /></mxCell><mxCell id="drop" value="DROPPED&#10;not a new task:&#10;no second run,&#10;no second result" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="300" width="165" height="70" as="geometry" /></mxCell><mxCell id="busy" value="BUSY at once&#10;no queue: the cloud&#10;decides on retry" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="645" y="300" width="155" height="70" as="geometry" /></mxCell><mxCell id="tout" value="TIMEOUT&#10;stop, clean up,&#10;release the lock" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="840" y="300" width="160" height="70" as="geometry" /></mxCell><mxCell id="succ" value="SUCCESS or ERROR&#10;FINISH reached, or a model&#10;error / exception is caught" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1025" y="300" width="215" height="70" as="geometry" /></mxCell><mxCell id="result" value="ONE RESULT MESSAGE up the channel, exactly once per accepted task:  status (SUCCESS | ERROR | BUSY | TIMEOUT)  +  execution time  +  task description" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=12;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="270" y="430" width="970" height="56" as="geometry" /></mxCell><mxCell id="why" value="WHY THESE GUARDS (design choices)&#10;- BUSY instead of a queue: a queued task would run minutes later on a changed screen. BUSY hands the retry decision to the cloud, which knows whether the task is still wanted. Cost: the cloud must retry with back-off.&#10;- The timeout is a safety bound, not a performance number. Size it well above the slow tail of successful tasks, e.g. several x the 20 s [I3] simple task.&#10;- One result per accepted task: a missing result looks like a lost message, so the cloud cannot decide whether to retry." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="520" width="600" height="98" as="geometry" /></mxCell><mxCell id="idem" value="THE IDEMPOTENCY TRAP&#10;De-duplication makes an exact repeat of one message safe. It does NOT make the task idempotent: &quot;add an item to the list&quot; run twice adds two items.&#10;A retry with a NEW message ID runs the task again. So after a lost result the cloud must ask the device first, or send only tasks that are safe to repeat." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#fff7f7;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="650" y="520" width="590" height="98" as="geometry" /></mxCell><mxCell id="legend" value="Legend:  purple = cloud side  |  amber = guard in device code  |  blue = device component  |  green = agent that calls the model  |  red = failure status or time limit (dashed frame = the limit wraps everything inside it)  |  dashed grey = dropped, no result sent.  Cloud message channel: down = task, up = result." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="632" width="1210" height="40" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Numbers are loaded from ../constants.json by key (shown). P = public (cited doc/paper, value as published); I = illustrative (round value chosen to explain the idea, never a measurement); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/01-the-message-path.md (five stages, four guards, the four result statuses, idempotency, design choices). Work executor example: Android WorkManager guide, https://developer.android.com/topic/libraries/architecture/workmanager (public). No measured numbers.&#10;[I1] dedup_window_illustrative = 10 min. illustrative retention of message IDs in the de-duplication cache&#10;[I2] watchdog_timeout_illustrative = 5 min. illustrative hard limit on task wall time&#10;[I3] task_wall_time_illustrative = 20 s. illustrative end-to-end time for a simple 'open an app' task; sum of the 07 budget table" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="686" width="1210" height="84" as="geometry" /></mxCell><mxCell id="edge0" value="down" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" parent="1" source="cloud" target="val"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="ok" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#d79b00;fontColor=#d79b00;" edge="1" parent="1" source="val" target="dup"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="new" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#d79b00;fontColor=#d79b00;" edge="1" parent="1" source="dup" target="lock"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="free" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#d79b00;fontColor=#d79b00;" edge="1" parent="1" source="lock" target="exe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="exe" target="graph"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge5" value="no" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="val" target="err"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="repeat" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#999999;fontColor=#999999;" edge="1" parent="1" source="dup" target="drop"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge7" value="held" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#d79b00;fontColor=#d79b00;" edge="1" parent="1" source="lock" target="busy"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge8" value="limit passed" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.221;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="wd" target="tout"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge9" value="graph ends" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1" source="graph" target="succ"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge10" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.077;entryY=0;entryDx=0;entryDy=0;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="err" target="result"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge11" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.468;entryY=0;entryDx=0;entryDy=0;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="busy" target="result"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge12" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.67;entryY=0;entryDx=0;entryDy=0;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="tout" target="result"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge13" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.889;entryY=0;entryDx=0;entryDy=0;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="succ" target="result"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge14" value="up" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" parent="1" source="result" target="cloud"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="120" y="458" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p_02_agent_graph" name="02-agent-graph"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="938" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="One planner, two doers and a plain-code router: every specialist turn returns to the orchestrator until it says FINISH" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="34" as="geometry" /></mxCell><mxCell id="start" value="START" style="rounded=1;whiteSpace=wrap;html=0;arcSize=44;verticalAlign=middle;align=center;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="263" width="90" height="44" as="geometry" /></mxCell><mxCell id="orc" value="ORCHESTRATOR  (planner)&#10;stronger, slower model tier&#10;temperature 0.2 [I1]&#10;max output 4 000 tokens [I3]&#10;&#10;plans ONE step, picks the next node,&#10;FINISHes only on visible evidence" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="150" y="200" width="290" height="170" as="geometry" /></mxCell><mxCell id="router" value="ROUTER&#10;plain code, not a model:&#10;switch on one field" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=12;dashed=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="530" y="245" width="170" height="80" as="geometry" /></mxCell><mxCell id="vis" value="VISION SPECIALIST&#10;fast tier | temperature 0 [I2] | max output 4 000 [I3]&#10;tools: the computer-use tool (screenshot, left_click,&#10;type, key, scroll, zoom ...)&#10;acts through the screen (diagram 03),&#10;in its own ReAct loop (diagram 04)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="780" y="80" width="340" height="140" as="geometry" /></mxCell><mxCell id="fin" value="FINISH" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=12;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="780" y="262" width="120" height="46" as="geometry" /></mxCell><mxCell id="end" value="END" style="rounded=1;whiteSpace=wrap;html=0;arcSize=44;verticalAlign=middle;align=center;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="950" y="262" width="80" height="46" as="geometry" /></mxCell><mxCell id="endnote" value="then the one result report&#10;(diagram 01)" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1040" y="256" width="220" height="60" as="geometry" /></mxCell><mxCell id="act" value="ACTUATOR&#10;fast tier | temperature 0 [I2] | max output 2 000 [I3]&#10;tools: launch_app, open_settings, go_home, go_back,&#10;set_volume, get_device_state  (each allow-listed)&#10;OS route to open an app: 1 call, about 2 s,&#10;vs 2 calls, about 10 s through the screen [I4]" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="780" y="350" width="340" height="140" as="geometry" /></mxCell><mxCell id="state" value="STATE  (one shared object rides every edge):  task text  |  routing decisions + each specialist's summary  |  latest screenshot  |  step counter.  Step limit: 10 orchestrator hops [I5] stops a graph that never says FINISH. It counts steps; the watchdog (diagram 01) counts seconds; keep both." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="556" width="1220" height="50" as="geometry" /></mxCell><mxCell id="fw" value="WHY A HAND-WRITTEN GRAPH, NOT A PYTHON FRAMEWORK&#10;The device runtime is Java/Kotlin; popular agent-graph frameworks are Python-first.&#10;Hand-written: native, no extra interpreter | a while loop + a switch | one-language stack traces | no dependencies | nothing for free.&#10;Framework: embedded Python or bindings | layers per step | framework internals in the trace | a large, fast-moving dependency tree | checkpoints, streaming, interrupts provided.&#10;Deciding fact: this graph is small and stable. Borrow the concepts (named nodes, explicit state, conditional edges, step limit) so a later port is mechanical." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="622" width="610" height="128" as="geometry" /></mxCell><mxCell id="three" value="WHY THREE AGENTS, NOT ONE&#10;- Separation: the planner decides what to do; the specialists only do.&#10;- Different model needs: planning wants the stronger tier; seeing and tapping want the fast one.&#10;- Per-node settings: each node has its own temperature, output cap and tool list.&#10;- Smaller prompts: each specialist sees only its own tools, so fewer tokens and fewer wrong-tool errors.&#10;Cost: every specialist turn costs one more orchestrator call. Hub-and-spoke: specialists never talk to each other." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="655" y="622" width="595" height="128" as="geometry" /></mxCell><mxCell id="legend" value="Legend:  green = node that calls the model  |  dashed white = plain code, no model  |  red = terminal decision  |  blue = shared state  |  solid arrow = router choice  |  dashed arrow = control returns to the orchestrator after EVERY specialist turn" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="764" width="1220" height="36" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Numbers are loaded from ../constants.json by key (shown). P = public (cited doc/paper, value as published); I = illustrative (round value chosen to explain the idea, never a measurement); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/02-the-agent-graph.md (nodes, router, state, step limit, framework comparison, three agents); notes/03-the-orchestrator.md (tier, temperature, output cap, stop on evidence); notes/05-the-actuator.md (actuator tools, OS route). Vocabulary (StateGraph, conditional edges, START/END, recursion limit): LangGraph Graph API docs, https://docs.langchain.com/oss/python/langgraph/graph-api (public).&#10;[I1] orchestrator_temperature_illustrative = 0.2. illustrative low non-zero temperature for the planner&#10;[I2] specialist_temperature_illustrative = 0. illustrative: deterministic-as-possible specialists&#10;[I3] max_output_tokens_illustrative = {orchestrator: 4000, vision: 4000, actuator: 2000} tokens per reply. illustrative per-node reply caps&#10;[I4] actuator_vs_screen_illustrative = {screen_calls: 2, screen_s: 10, os_calls: 1, os_s: 2} model calls / s. illustrative comparison of opening an app via the screen vs via one OS call&#10;[I5] graph_step_limit_illustrative = 10 orchestrator hops. illustrative outer-loop limit" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="814" width="1220" height="108" as="geometry" /></mxCell><mxCell id="edge0" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="start" target="orc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="routing&#10;decision" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1" source="orc" target="router"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="vision" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="router" target="vis"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="615" y="150" /></Array></mxGeometry></mxCell><mxCell id="edge3" value="FINISH" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="router" target="fin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="actuator" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="router" target="act"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="615" y="420" /></Array></mxGeometry></mxCell><mxCell id="edge5" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="fin" target="end"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="summary written to state; control returns" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1" source="vis" target="orc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="62" /><mxPoint x="295" y="62" /></Array></mxGeometry></mxCell><mxCell id="edge7" value="summary written to state; control returns" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1" source="act" target="orc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="950" y="525" /><mxPoint x="295" y="525" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p_03_vision_cycle_and_scaling" name="03-vision-cycle-and-scaling"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="884" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="The model taps in its 1280×800 [P1] reference frame, the device taps in its own pixels: a consistent offset means the scaler is wrong, not the model" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="34" as="geometry" /></mxCell><mxCell id="cap" value="1  CAPTURE&#10;the OS screen-capture API&#10;(MediaProjection); the user&#10;consents before capture" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="66" width="190" height="96" as="geometry" /></mxCell><mxCell id="down" value="2  SCALE DOWN&#10;to the reference frame&#10;1280×800 [P1]&#10;(advice: not above 1920×1080 [P2])" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="233" y="66" width="190" height="96" as="geometry" /></mxCell><mxCell id="dec" value="3  DECIDE  (model call)&#10;returns left_click at&#10;(200, 560) [I4]&#10;in reference px" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="436" y="66" width="190" height="96" as="geometry" /></mxCell><mxCell id="up" value="4  SCALE UP&#10;the coordinate scaler maps it&#10;to (375, 1120) [calc]&#10;in device px" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="639" y="66" width="190" height="96" as="geometry" /></mxCell><mxCell id="act" value="5  ACT&#10;the accessibility service&#10;injects the tap&#10;(dispatchGesture)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="842" y="66" width="190" height="96" as="geometry" /></mxCell><mxCell id="set" value="6  SETTLE&#10;wait 1 s [I5] so the UI&#10;stops moving, then&#10;capture again" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1045" y="66" width="190" height="96" as="geometry" /></mxCell><mxCell id="frames_t" value="Both frames drawn to the SAME scale. Different aspect ratios (3:2 vs 8:5 (= 16:10)) mean the x and y scale factors differ." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="214" width="820" height="40" as="geometry" /></mxCell><mxCell id="ref" value="REFERENCE FRAME&#10;(what the model sees)&#10;1280×800 [P1]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#eef8ec;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="268" width="230" height="144" as="geometry" /></mxCell><mxCell id="dev" value="DEVICE NATIVE SCREEN&#10;(where the tap happens)&#10;2400×1600 [I3]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#eef4fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="400" y="268" width="432" height="288" as="geometry" /></mxCell><mxCell id="rdot" value="" style="rounded=1;whiteSpace=wrap;html=0;arcSize=14;verticalAlign=middle;align=center;fontSize=11;fillColor=#82b366;strokeColor=#3d6b2a;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="89" y="362" width="14" height="14" as="geometry" /></mxCell><mxCell id="rdot_l" value="(200, 560) [I4]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#3d6b2a;" vertex="1" parent="1"><mxGeometry x="106" y="359" width="120" height="20" as="geometry" /></mxCell><mxCell id="ddot" value="" style="rounded=1;whiteSpace=wrap;html=0;arcSize=14;verticalAlign=middle;align=center;fontSize=11;fillColor=#6c8ebf;strokeColor=#2c4a7a;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="460" y="463" width="14" height="14" as="geometry" /></mxCell><mxCell id="ddot_l" value="(375, 1120) [calc]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#2c4a7a;" vertex="1" parent="1"><mxGeometry x="478" y="460" width="160" height="20" as="geometry" /></mxCell><mxCell id="math" value="THE SCALER ARITHMETIC  [calc]&#10;x scale = reference ÷ native = 1280 ÷ 2400 = 0.533&#10;y scale = 800 ÷ 1600 = 0.5&#10;device tap = (200 ÷ 0.533, 560 ÷ 0.5) = (375, 1120)&#10;&#10;The two scales differ because 3:2 ≠ 8:5 (= 16:10). A plain resize therefore STRETCHES the image. Vendor advice: preserve the aspect ratio when resizing.&#10;&#10;Uniform alternative: one scale = min(0.533, 0.5) = 0.5, giving a 1200×800 image padded to 1280×800.&#10;&#10;Either way: keep the factors, and apply their inverse to EVERY coordinate the model returns." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="880" y="214" width="370" height="270" as="geometry" /></mxCell><mxCell id="diag" value="DIAGNOSE A WRONG TAP&#10;- Consistent offset in one direction: almost always a scaling bug (coordinates applied to a display of a different size). Check the scaler before the prompt.&#10;- Near-miss on a small target: detail lost in down-scaling. Use the zoom action, or crop; not more prompt text.&#10;- Similar-looking wrong element: a more specific instruction, placed BEFORE the image in the message." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#fff7f7;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="572" width="610" height="100" as="geometry" /></mxCell><mxCell id="knobs" value="KNOBS AND THEIR TRADE&#10;- Reference frame size: smaller = fewer image tokens and a faster reply; larger = small text stays readable. zoom inspects one region at full resolution.&#10;- Settle delay 1 s [I5]: too short = a half-drawn screen and a repeated action; too long = every step pays the wait.&#10;- Screenshot history: 1 000-1 800 input tokens per screenshot [P6]; keep the last 3 [P7] (diagram 05)." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="655" y="572" width="595" height="100" as="geometry" /></mxCell><mxCell id="legend" value="Legend:  blue = device code  |  amber = the scaler, where most tap bugs live  |  green = the model call  |  green dot = point the model asked for (reference px)  |  blue dot = where the device taps (native px)  |  arrows: one action cycle; the dashed return is the next observation (diagram 04)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="687" width="1220" height="36" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Numbers are loaded from ../constants.json by key (shown). P = public (cited doc/paper, value as published); I = illustrative (round value chosen to explain the idea, never a measurement); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/04-the-vision-specialist.md (five-step cycle, worked scaling example, grounding errors, knobs). Public docs: computer-use tool documentation, sections 'Available actions', 'Size screenshots to fit image limits', 'Diagnose click issues', 'Manage screenshot history', 'Optimize model performance with prompting'; Android MediaProjection guide and AccessibilityService.dispatchGesture reference (see ../SOURCES.md).&#10;[P1] cu_reference_frame_recommended = [1280, 800] px (width, height). public: Anthropic computer-use tool documentation, 'Size screenshots to fit image limits' (recommended for web applications)&#10;[P2] cu_max_resolution_advised = [1920, 1080] px. public: Anthropic computer-use tool documentation, 'Size screenshots to fit image limits' (avoid higher)&#10;[I3] device_native_resolution_illustrative = [2400, 1600] px. illustrative tablet screen, chosen with a different aspect ratio from the reference frame&#10;[I4] model_click_illustrative = [200, 560] px in reference frame. illustrative tap request; maps to (375, 1120) device px by my arithmetic&#10;[I5] settle_delay_illustrative = 1 s. illustrative wait after an action before the next screenshot&#10;[P6] cu_tokens_per_screenshot = [1000, 1800] input tokens. public: Anthropic computer-use tool documentation, 'Manage screenshot history'&#10;[P7] cu_screenshots_kept = 3 screenshots. public: Anthropic computer-use tool documentation, 'Manage screenshot history' (suggested default)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="736" width="1220" height="132" as="geometry" /></mxCell><mxCell id="edge0" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="cap" target="down"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="down" target="dec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="dec" target="up"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="up" target="act"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="act" target="set"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge5" value="next observation" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="set" target="cap"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1140" y="188" /><mxPoint x="125" y="188" /></Array></mxGeometry></mxCell><mxCell id="edge6" value="scaler&#10;x ÷ 0.533&#10;y ÷ 0.5" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;strokeColor=#d79b00;fontColor=#d79b00;" edge="1" parent="1" source="ref" target="dev"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p_04_react_loop_and_limits" name="04-react-loop-and-limits"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="880" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Three nested limits bound one task: 20 [I1] ReAct iterations per specialist turn, inside 10 [I2] graph hops, inside a 5 min [I3] watchdog" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="34" as="geometry" /></mxCell><mxCell id="wd" value="WATCHDOG: whole task, 5 min [I3] wall clock  -&gt;  catches a slow model or network" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=center;fontSize=12;fontStyle=1;dashed=1;fillColor=none;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="64" width="820" height="580" as="geometry" /></mxCell><mxCell id="gs" value="GRAPH STEP LIMIT: 10 [I2] orchestrator -&gt; specialist hops  -&gt;  catches ping-pong between nodes" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=center;fontSize=12;fontStyle=1;dashed=1;fillColor=none;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="100" width="780" height="528" as="geometry" /></mxCell><mxCell id="orc" value="ORCHESTRATOR&#10;routes to a specialist (diagram 02)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="140" width="220" height="56" as="geometry" /></mxCell><mxCell id="turn" value="ONE SPECIALIST TURN: ReAct iteration limit 20 [I1]  -&gt;  catches a stuck inner loop" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=center;fontSize=12;fontStyle=1;dashed=1;fillColor=none;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="226" width="740" height="386" as="geometry" /></mxCell><mxCell id="th" value="THOUGHT&#10;the model reasons about the&#10;latest screenshot + history" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="110" y="300" width="210" height="96" as="geometry" /></mxCell><mxCell id="ac" value="ACTION&#10;a tool call, e.g. left_click;&#10;device code executes it" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="410" y="300" width="210" height="96" as="geometry" /></mxCell><mxCell id="ob" value="OBSERVATION&#10;wait the settle delay 1 s [I4],&#10;capture, return the screenshot&#10;as the tool result" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="410" y="444" width="210" height="96" as="geometry" /></mxCell><mxCell id="err" value="Action failed on the device? Return an ERROR RESULT as the observation; the model reads it and re-plans. An exception would end the loop instead." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#fff7f7;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="100" y="544" width="300" height="56" as="geometry" /></mxCell><mxCell id="exA" value="EXIT 1&#10;reply with NO tool call:&#10;sub-goal believed done&#10;(orchestrator still checks)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="650" y="262" width="150" height="92" as="geometry" /></mxCell><mxCell id="exB" value="EXIT 2  loop detection&#10;same action repeated,&#10;screen unchanged:&#10;stop, report &quot;stuck&quot;" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="650" y="444" width="150" height="96" as="geometry" /></mxCell><mxCell id="lim" value="WHAT EACH LIMIT CATCHES&#10;- iteration limit 20 [I1]: a stuck inner loop&#10;- graph step limit 10 [I2]: ping-pong between nodes&#10;- watchdog 5 min [I3]: a slow model or network (a slow step can use up time without using up steps)&#10;Size each from the step-count distribution of SUCCESSFUL runs, plus headroom. Too low fails healthy long tasks; too high lets a stuck loop burn tokens." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="870" y="64" width="380" height="150" as="geometry" /></mxCell><mxCell id="rec" value="WHY THE LOOP MATTERS: RECOVERY&#10;Without recovery, per-step reliability compounds: p = 0.9 [I5] per step, n = 5 [I6] steps, so the task succeeds with p^n = 0.9^5 ≈ 0.59 [calc].&#10;The observe-and-retry loop breaks this product: a wrong click shows in the next observation and is undone (go_back, close a dialog, scroll)." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="870" y="228" width="380" height="124" as="geometry" /></mxCell><mxCell id="pub" value="PUBLIC EVIDENCE FOR THE PATTERN&#10;ReAct (Yao et al. 2022): +34 pp [P7] absolute success on ALFWorld and +10 pp [P8] on WebShop over imitation / RL baselines, with only 1-2 [P9] in-context examples.&#10;Their benchmarks, not yours: measure on your own devices and apps." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="870" y="366" width="380" height="108" as="geometry" /></mxCell><mxCell id="legend" value="Legend:  dashed frames = limits, each wraps everything inside it (red watchdog, amber step limit, green iteration limit)  |  green = model call  |  blue = device code  |  amber = check in code  |  red = error result  |  solid arrows = one ReAct iteration; exits leave the turn and return to the orchestrator" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="658" width="1220" height="36" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Numbers are loaded from ../constants.json by key (shown). P = public (cited doc/paper, value as published); I = illustrative (round value chosen to explain the idea, never a measurement); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/06-the-react-loop.md (loop, two loop exits, three nested limits, error results, loop detection, limit sizing); notes/09-evaluation.md (compounding per-step reliability). Vendor reference loop and error handling: computer-use tool documentation, 'Understand the agent loop', 'Handle errors'. ReAct: Yao et al. 2022, https://arxiv.org/abs/2210.03629, abstract.&#10;[I1] react_iteration_limit_illustrative = 20 iterations per specialist turn. illustrative inner-loop limit&#10;[I2] graph_step_limit_illustrative = 10 orchestrator hops. illustrative outer-loop limit&#10;[I3] watchdog_timeout_illustrative = 5 min. illustrative hard limit on task wall time&#10;[I4] settle_delay_illustrative = 1 s. illustrative wait after an action before the next screenshot&#10;[I5] per_step_success_illustrative = 0.9 probability. illustrative; with 5 steps and no recovery gives 0.59 by my arithmetic&#10;[I6] steps_without_recovery_illustrative = 5 steps. illustrative&#10;[P7] react_alfworld_gain_pp = 34 percentage points absolute success rate. public: Yao et al. 2022, ReAct, arXiv:2210.03629, abstract (ALFWorld, over imitation/RL baselines)&#10;[P8] react_webshop_gain_pp = 10 percentage points absolute success rate. public: Yao et al. 2022, ReAct, arXiv:2210.03629, abstract (WebShop)&#10;[P9] react_in_context_examples = [1, 2] examples. public: Yao et al. 2022, ReAct, arXiv:2210.03629, abstract" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="708" width="1220" height="156" as="geometry" /></mxCell><mxCell id="edge0" value="route" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.162;entryY=0;entryDx=0;entryDy=0;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1" source="orc" target="turn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="tool call" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="th" target="ac"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="executed" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="ac" target="ob"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="next iteration" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="ob" target="th"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="215" y="492" /></Array></mxGeometry></mxCell><mxCell id="edge4" value="no tool call" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.13;entryDx=0;entryDy=0;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1" source="th" target="exA"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="215" y="274" /><mxPoint x="650" y="274" /></Array></mxGeometry></mxCell><mxCell id="edge5" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#d79b00;fontColor=#d79b00;" edge="1" parent="1" source="ob" target="exB"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="summary to state; control returns" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=0.93;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1" source="exA" target="orc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="790" y="168" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p_05_cost_and_caching" name="05-cost-and-caching"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1016" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Model calls take about 15 s [calc] of an illustrative 20 s [I8] task and carry all its tokens; caching cuts a repeat vision call to about 35 % [calc]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="34" as="geometry" /></mxCell><mxCell id="a_h" value="A   WHERE ONE ILLUSTRATIVE TASK'S TIME GOES  (bar lengths to scale, 55 px per second)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="1220" height="22" as="geometry" /></mxCell><mxCell id="seg0" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="6" height="64" as="geometry" /></mxCell><mxCell id="segl0" value="receive, validate, lock 0.1 s [I1]" style="text;html=0;whiteSpace=wrap;verticalAlign=bottom;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="56" y="100" width="200" height="18" as="geometry" /></mxCell><mxCell id="seg1" value="orchestrator: route to vision&#10;2 s [I2]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="66" y="120" width="110" height="64" as="geometry" /></mxCell><mxCell id="tok1" value="1 call x 4 000 tok [I6]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="66" y="186" width="110" height="30" as="geometry" /></mxCell><mxCell id="seg2" value="capture + resize&#10;2 s [I3]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="176" y="120" width="110" height="64" as="geometry" /></mxCell><mxCell id="seg3" value="vision: find icon, tap&#10;5 s [I4]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="286" y="120" width="275" height="64" as="geometry" /></mxCell><mxCell id="tok3" value="1 call x 7 000 tok [I7]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="286" y="186" width="275" height="30" as="geometry" /></mxCell><mxCell id="seg4" value="1 s&#10;[I5]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="561" y="120" width="55" height="64" as="geometry" /></mxCell><mxCell id="segl4" value="settle" style="text;html=0;whiteSpace=wrap;verticalAlign=bottom;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="541" y="100" width="95" height="18" as="geometry" /></mxCell><mxCell id="seg5" value="capture&#10;2 s [I3]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="616" y="120" width="110" height="64" as="geometry" /></mxCell><mxCell id="seg6" value="vision: confirm, tap again if needed&#10;6 s [I4]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="726" y="120" width="330" height="64" as="geometry" /></mxCell><mxCell id="tok6" value="2 calls x 7 000 tok [I7]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="726" y="186" width="330" height="30" as="geometry" /></mxCell><mxCell id="seg7" value="orchestrator: FINISH&#10;2 s [I2]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1056" y="120" width="110" height="64" as="geometry" /></mxCell><mxCell id="tok7" value="1 call x 4 000 tok [I6]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1056" y="186" width="110" height="30" as="geometry" /></mxCell><mxCell id="tick0" value="0 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="214" width="40" height="16" as="geometry" /></mxCell><mxCell id="tickm0" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="1" height="5" as="geometry" /></mxCell><mxCell id="tick5" value="5 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="315" y="214" width="40" height="16" as="geometry" /></mxCell><mxCell id="tickm5" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="335" y="210" width="1" height="5" as="geometry" /></mxCell><mxCell id="tick10" value="10 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="590" y="214" width="40" height="16" as="geometry" /></mxCell><mxCell id="tickm10" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="610" y="210" width="1" height="5" as="geometry" /></mxCell><mxCell id="tick15" value="15 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="865" y="214" width="40" height="16" as="geometry" /></mxCell><mxCell id="tickm15" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="885" y="210" width="1" height="5" as="geometry" /></mxCell><mxCell id="tick20" value="20 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1140" y="214" width="40" height="16" as="geometry" /></mxCell><mxCell id="tickm20" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1160" y="210" width="1" height="5" as="geometry" /></mxCell><mxCell id="a_sum" value="Model calls: 5 [I9] calls, 2 + 5 + 6 + 2 s = 15 s [calc]   |   device side: 0.1 + 2 + 1 + 2 s = 5.1 s [calc]   |   total 20.1 s [calc], about 20 s [I8]&#10;Input tokens: 4 000 + 7 000 + 2 x 7 000 + 4 000 = 29 000 [calc], about 30 000 [I10]   -&gt;  latency work starts with FEWER CALLS (e.g. the actuator's one OS call, diagram 02), not faster ones." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="232" width="1190" height="44" as="geometry" /></mxCell><mxCell id="b_h" value="B   ONE VISION CALL IN BASE-INPUT-TOKEN UNITS  (bar lengths to scale)   split [I7]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=13;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="292" width="1220" height="22" as="geometry" /></mxCell><mxCell id="r1l" value="NO CACHING&#10;7 000 units" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="334" width="175" height="46" as="geometry" /></mxCell><mxCell id="u0" value="stable prefix: tools + system&#10;3 000 tok" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#e6e6e6;strokeColor=#888888;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="210" y="334" width="390" height="46" as="geometry" /></mxCell><mxCell id="u1" value="earlier history&#10;2 500 tok" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#e6e6e6;strokeColor=#888888;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="600" y="334" width="325" height="46" as="geometry" /></mxCell><mxCell id="u2" value="new screenshot&#10;1 500 tok" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#e6e6e6;strokeColor=#888888;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="925" y="334" width="195" height="46" as="geometry" /></mxCell><mxCell id="bp0" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#b85450;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="598" y="326" width="4" height="62" as="geometry" /></mxCell><mxCell id="bpl0" value="breakpoint 1" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="550" y="308" width="100" height="16" as="geometry" /></mxCell><mxCell id="bp1" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#b85450;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="923" y="326" width="4" height="62" as="geometry" /></mxCell><mxCell id="bpl1" value="breakpoint 2" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="875" y="308" width="100" height="16" as="geometry" /></mxCell><mxCell id="spt" value="(one screenshot costs 1000-1800 input tokens [P21])" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="790" y="382" width="330" height="18" as="geometry" /></mxCell><mxCell id="r2l" value="CACHED&#10;2 425 units [calc]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="420" width="175" height="46" as="geometry" /></mxCell><mxCell id="c0" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="210" y="420" width="39" height="46" as="geometry" /></mxCell><mxCell id="c1" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="249" y="420" width="32" height="46" as="geometry" /></mxCell><mxCell id="c2" value="new screenshot WRITTEN&#10;1 500 x 1.25 = 1 875" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="281" y="420" width="244" height="46" as="geometry" /></mxCell><mxCell id="c_read_l" value="first 5 500 tok READ from the cache:&#10;5 500 x 0.1 [P13] = 550 units" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#3d6b2a;" vertex="1" parent="1"><mxGeometry x="210" y="468" width="300" height="34" as="geometry" /></mxCell><mxCell id="c_w_l" value="write multiplier 1.25 [P11] (5 min lifetime)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#9a6b00;" vertex="1" parent="1"><mxGeometry x="460" y="468" width="300" height="34" as="geometry" /></mxCell><mxCell id="c_res" value="2 425 ÷ 7 000 = 35 % of the uncached call [calc]. The first call of a task pays the 1.25x write on the whole prefix; caching pays back from the second call on." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="555" y="416" width="695" height="54" as="geometry" /></mxCell><mxCell id="c1" value="C1  THE CACHING RULES (public docs)&#10;- The prefix order is fixed: tools -&gt; system -&gt; messages.&#10;- Up to 4 breakpoints [P14] per request: one after tools + system, the rest on the latest tool results, advanced each turn.&#10;- Lifetime 5 min [P15] by default, refreshed by each use; 1 h [P16] optional, written at 2x [P12].&#10;- Any change at or before a breakpoint misses everything after it." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="512" width="400" height="124" as="geometry" /></mxCell><mxCell id="c2" value="C2  WHY PRUNING BREAKS CACHING, AND THE FIX&#10;Dropping the oldest screenshot edits an EARLY block, so every later block misses.&#10;Fix: prune in batches. Keep the last 3 [P17] screenshots and prune every 25 [P18] turns, so the prefix stays byte-identical between prunes.&#10;A 20 s [I8] task fits easily in the 5 min [P15] lifetime; long gaps between tasks let it expire." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="440" y="512" width="400" height="124" as="geometry" /></mxCell><mxCell id="c3" value="C3  MODEL TIERS PER ROLE&#10;One same-generation pair: fast tier $1, stronger tier $3 per million input tokens [P19]. Output price = 5x input [P20].&#10;Strong tier on the orchestrator only (a wrong route wastes a whole turn); fast tier on the many specialist calls.&#10;Outputs here are short tool calls, so input tokens dominate: caching matters more than reply length." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="850" y="512" width="400" height="124" as="geometry" /></mxCell><mxCell id="legend" value="Legend:  green bar = model-call time  |  blue bar = device-side time  |  grey = uncached input tokens  |  light green = cache read  |  amber = cache write  |  red tick = cache breakpoint.  Units in B = tokens x price multiplier, i.e. cost relative to base input price." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="650" width="1220" height="36" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Numbers are loaded from ../constants.json by key (shown). P = public (cited doc/paper, value as published); I = illustrative (round value chosen to explain the idea, never a measurement); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/07-cost-and-latency.md (illustrative budget table, caching arithmetic, tiers). Public rules and multipliers: prompt-caching documentation (prefix order, breakpoints, lifetimes, price table read 2026-11 - prices change, multipliers are the durable part); computer-use tool documentation, 'Manage screenshot history'.&#10;[I1] receive_lock_latency_illustrative = 0.1 s. illustrative, 07 budget table&#10;[I2] orchestrator_call_latency_illustrative = 2 s. illustrative, 07 budget table&#10;[I3] capture_resize_latency_illustrative = 2 s. illustrative, 07 budget table&#10;[I4] vision_call_latency_illustrative = [5, 6] s per step. illustrative, 07 budget table&#10;[I5] settle_delay_illustrative = 1 s. illustrative wait after an action before the next screenshot&#10;[I6] orchestrator_call_tokens_illustrative = 4 000 input tokens. illustrative, 07 budget table&#10;[I7] vision_call_tokens_illustrative = {total: 7000, stable_prefix: 3000, history: 2500, new_screenshot: 1500} input tokens. illustrative split used in the 07 caching arithmetic; new_screenshot chosen inside cu_tokens_per_screenshot&#10;[I8] task_wall_time_illustrative = 20 s. illustrative end-to-end time for a simple 'open an app' task; sum of the 07 budget table&#10;[I9] task_model_calls_illustrative = 5 calls. illustrative: 2 orchestrator + 3 vision calls in the 07 budget table&#10;[I10] task_input_tokens_illustrative = 30 000 tokens. illustrative: 29 000 in the 07 budget table, rounded&#10;[P11] cache_write_5m_multiplier = 1.25 x base input price. public: Anthropic prompt-caching documentation, price table (5m writes column ÷ input column)&#10;[P12] cache_write_1h_multiplier = 2 x base input price. public: Anthropic prompt-caching documentation, TTL support&#10;[P13] cache_read_multiplier = 0.1 x base input price. public: Anthropic prompt-caching documentation, price table notes (standard multiplier)&#10;[P14] cache_max_breakpoints = 4 breakpoints per request. public: Anthropic prompt-caching documentation&#10;[P15] cache_ttl_default = 5 min. public: Anthropic prompt-caching documentation&#10;[P16] cache_ttl_long = 1 h. public: Anthropic prompt-caching documentation&#10;[P17] cu_screenshots_kept = 3 screenshots. public: Anthropic computer-use tool documentation, 'Manage screenshot history' (suggested default)&#10;[P18] cu_prune_interval = 25 turns. public: Anthropic computer-use tool documentation, 'Manage screenshot history' (suggested default)&#10;[P19] price_tier_pair_input = {fast: 1, strong: 3} USD per million input tokens. public: Anthropic prompt-caching documentation, price table (one same-generation fast/strong pair)&#10;[P20] price_output_to_input_ratio = 5 ratio. public: Anthropic prompt-caching documentation, price table (output ÷ input, every listed model)&#10;[P21] cu_tokens_per_screenshot = [1000, 1800] input tokens. public: Anthropic computer-use tool documentation, 'Manage screenshot history'" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="700" width="1220" height="300" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="p_06_safety_layers" name="06-safety-layers"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="756" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="The model proposes, device code disposes: each layer after the prompt assumes the one before it has failed, and the log records every step" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="34" as="geometry" /></mxCell><mxCell id="task" value="TASK  (trusted)&#10;from the authenticated cloud&#10;message: the ONLY instruction" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="84" width="230" height="92" as="geometry" /></mxCell><mxCell id="screen" value="SCREEN CONTENT  (untrusted DATA)&#10;notifications, web pages,&#10;in-app messages, text inside images&#10;-&gt; indirect prompt injection&#10;(OWASP LLM01)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="206" width="230" height="140" as="geometry" /></mxCell><mxCell id="model" value="THE MODEL PROPOSES&#10;(orchestrator / specialists)&#10;&#10;LAYER 1  INSTRUCTION HIERARCHY&#10;in the system prompt: only the task is an instruction; screen text is content to read.&#10;Lowers the injection rate. Does NOT remove it." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="120" width="230" height="176" as="geometry" /></mxCell><mxCell id="dev" value="DEVICE CODE DISPOSES  (the model cannot change anything in this frame)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=center;fontSize=12;fontStyle=1;dashed=1;fillColor=none;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="570" y="70" width="680" height="330" as="geometry" /></mxCell><mxCell id="l2" value="LAYER 2  ALLOW-LIST&#10;named, typed tools only; no &quot;run this command&quot; tool.&#10;Arguments checked: launch_app accepts listed packages, open_settings listed pages." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="590" y="112" width="200" height="160" as="geometry" /></mxCell><mxCell id="l3" value="LAYER 3  SCOPE LIMITS&#10;screen taps cannot be listed one by one, so limit the context: only apps on the per-task list; refuse to type into password, payment or account-deletion screens." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="810" y="112" width="200" height="160" as="geometry" /></mxCell><mxCell id="l4" value="LAYER 4  CONFIRMATION GATE&#10;irreversible or costly (purchase, delete, send a message, factory reset): approval from a human or a cloud policy, before EACH action in a batch." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1030" y="112" width="200" height="160" as="geometry" /></mxCell><mxCell id="refuse" value="REFUSED  -&gt;  error result to the model, and logged" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=12;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="590" y="318" width="380" height="62" as="geometry" /></mxCell><mxCell id="exec" value="EXECUTE on the device" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=12;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1030" y="318" width="200" height="62" as="geometry" /></mxCell><mxCell id="log" value="LAYER 5  AUDIT LOG  (append-only, stored off the device with the result report, diagram 01):  the task  |  every routing decision  |  every tool call with its arguments  |  every result  |  a reference to each screenshot" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=12;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="430" width="1220" height="54" as="geometry" /></mxCell><mxCell id="trade" value="TRADE-OFFS&#10;- Least privilege vs capability: every tool removed shrinks the blast radius and removes something a task might need. Start narrow; add a tool when an evaluated task needs it.&#10;- Privileged installation is a target: authenticate cloud messages, use short-lived credentials, keep one task source.&#10;- Screenshots hold personal data (OWASP LLM02): minimise retention, redact, access-control the logs.&#10;- Gates cost latency and autonomy: gate the irreversible few, not every tap." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="504" width="610" height="112" as="geometry" /></mxCell><mxCell id="owasp" value="OWASP TOP 10 FOR LLM APPLICATIONS 2025 -&gt; WHICH LAYER ANSWERS IT&#10;- LLM01 Prompt Injection (the screen is the channel): layer 1 lowers it; layers 2-4 bound the damage when it succeeds.&#10;- LLM06 Excessive Agency (more tools, permissions or autonomy than the job needs): layers 2, 3, 4.&#10;- LLM02 Sensitive Information Disclosure: retention, redaction and access control on screenshots and logs (layer 5).&#10;A gate the model can approve for itself is not a gate." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#fff7f7;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="655" y="504" width="595" height="112" as="geometry" /></mxCell><mxCell id="legend" value="Legend:  purple = trusted input  |  red = untrusted input, refusal  |  green = model / execution  |  amber = a check in device code  |  dashed blue frame = code the model cannot alter  |  dashed grey arrows = written to the audit log" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="630" width="1220" height="36" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Numbers are loaded from ../constants.json by key (shown). P = public (cited doc/paper, value as published); I = illustrative (round value chosen to explain the idea, never a measurement); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/08-safety.md (two dominant risks, five controls, trade-offs). Public: OWASP Top 10 for LLM Applications 2025, https://genai.owasp.org/llm-top-10/ (LLM01, LLM02, LLM06); computer-use tool documentation, 'Limitations' (prompt injection via web pages or images) and 'Batch actions' (confirm before each action in a batch).&#10;This page carries no numbers from ../constants.json: note 08 states none. OWASP identifiers are public labels, not quantities." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="680" width="1220" height="60" as="geometry" /></mxCell><mxCell id="edge0" value="instruction" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" parent="1" source="task" target="model"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="130" /><mxPoint x="280" y="155" /></Array></mxGeometry></mxCell><mxCell id="edge1" value="read as data" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="screen" target="model"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="280" y="276" /><mxPoint x="280" y="261" /></Array></mxGeometry></mxCell><mxCell id="edge2" value="tool&#10;call" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1" source="model" target="l2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="ok" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#d79b00;fontColor=#d79b00;" edge="1" parent="1" source="l2" target="l3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="ok" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#d79b00;fontColor=#d79b00;" edge="1" parent="1" source="l3" target="l4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge5" value="fails" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.263;entryY=0;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="l2" target="refuse"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="fails" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.842;entryY=0;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="l3" target="refuse"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge7" value="denied" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="l4" target="refuse"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060"