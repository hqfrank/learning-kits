<mxfile host="app.diagrams.net"><diagram id="p_03_vision_cycle_and_scaling" name="03-vision-cycle-and-scaling"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="884" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="The model taps in its 1280×800 [P1] reference frame, the device taps in its own pixels: a consistent offset means the scaler is wrong, not the model" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="34" as="geometry" /></mxCell><mxCell id="cap" value="1  CAPTURE&#10;the OS screen-capture API&#10;(MediaProjection); the user&#10;consents before capture" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="66" width="190" height="96" as="geometry" /></mxCell><mxCell id="down" value="2  SCALE DOWN&#10;to the reference frame&#10;1280×800 [P1]&#10;(advice: not above 1920×1080 [P2])" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="233" y="66" width="190" height="96" as="geometry" /></mxCell><mxCell id="dec" value="3  DECIDE  (model call)&#10;returns left_click at&#10;(200, 560) [I4]&#10;in reference px" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="436" y="66" width="190" height="96" as="geometry" /></mxCell><mxCell id="up" value="4  SCALE UP&#10;the coordinate scaler maps it&#10;to (375, 1120) [calc]&#10;in device px" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="639" y="66" width="190" height="96" as="geometry" /></mxCell><mxCell id="act" value="5  ACT&#10;the accessibility service&#10;injects the tap&#10;(dispatchGesture)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="842" y="66" width="190" height="96" as="geometry" /></mxCell><mxCell id="set" value="6  SETTLE&#10;wait 1 s [I5] so the UI&#10;stops moving, then&#10;capture again" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1045" y="66" width="190" height="96" as="geometry" /></mxCell><mxCell id="frames_t" value="Both frames drawn to the SAME scale. Different aspect ratios (3:2 vs 8:5 (= 16:10)) mean the x and y scale factors differ." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="214" width="820" height="40" as="geometry" /></mxCell><mxCell id="ref" value="REFERENCE FRAME&#10;(what the model sees)&#10;1280×800 [P1]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#eef8ec;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="268" width="230" height="144" as="geometry" /></mxCell><mxCell id="dev" value="DEVICE NATIVE SCREEN&#10;(where the tap happens)&#10;2400×1600 [I3]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#eef4fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="400" y="268" width="432" height="288" as="geometry" /></mxCell><mxCell id="rdot" value="" style="rounded=1;whiteSpace=wrap;html=0;arcSize=14;verticalAlign=middle;align=center;fontSize=11;fillColor=#82b366;strokeColor=#3d6b2a;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="89" y="362" width="14" height="14" as="geometry" /></mxCell><mxCell id="rdot_l" value="(200, 560) [I4]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#3d6b2a;" vertex="1" parent="1"><mxGeometry x="106" y="359" width="120" height="20" as="geometry" /></mxCell><mxCell id="ddot" value="" style="rounded=1;whiteSpace=wrap;html=0;arcSize=14;verticalAlign=middle;align=center;fontSize=11;fillColor=#6c8ebf;strokeColor=#2c4a7a;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="460" y="463" width="14" height="14" as="geometry" /></mxCell><mxCell id="ddot_l" value="(375, 1120) [calc]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#2c4a7a;" vertex="1" parent="1"><mxGeometry x="478" y="460" width="160" height="20" as="geometry" /></mxCell><mxCell id="math" value="THE SCALER ARITHMETIC  [calc]&#10;x scale = reference ÷ native = 1280 ÷ 2400 = 0.533&#10;y scale = 800 ÷ 1600 = 0.5&#10;device tap = (200 ÷ 0.533, 560 ÷ 0.5) = (375, 1120)&#10;&#10;The two scales differ because 3:2 ≠ 8:5 (= 16:10). A plain resize therefore STRETCHES the image. Vendor advice: preserve the aspect ratio when resizing.&#10;&#10;Uniform alternative: one scale = min(0.533, 0.5) = 0.5, giving a 1200×800 image padded to 1280×800.&#10;&#10;Either way: keep the factors, and apply their inverse to EVERY coordinate the model returns." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="880" y="214" width="370" height="270" as="geometry" /></mxCell><mxCell id="diag" value="DIAGNOSE A WRONG TAP&#10;- Consistent offset in one direction: almost always a scaling bug (coordinates applied to a display of a different size). Check the scaler before the prompt.&#10;- Near-miss on a small target: detail lost in down-scaling. Use the zoom action, or crop; not more prompt text.&#10;- Similar-looking wrong element: a more specific instruction, placed BEFORE the image in the message." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#fff7f7;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="572" width="610" height="100" as="geometry" /></mxCell><mxCell id="knobs" value="KNOBS AND THEIR TRADE&#10;- Reference frame size: smaller = fewer image tokens and a faster reply; larger = small text stays readable. zoom inspects one region at full resolution.&#10;- Settle delay 1 s [I5]: too short = a half-drawn screen and a repeated action; too long = every step pays the wait.&#10;- Screenshot history: 1 000-1 800 input tokens per screenshot [P6]; keep the last 3 [P7] (diagram 05)." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="655" y="572" width="595" height="100" as="geometry" /></mxCell><mxCell id="legend" value="Legend:  blue = device code  |  amber = the scaler, where most tap bugs live  |  green = the model call  |  green dot = point the model asked for (reference px)  |  blue dot = where the device taps (native px)  |  arrows: one action cycle; the dashed return is the next observation (diagram 04)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="687" width="1220" height="36" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Numbers are loaded from ../constants.json by key (shown). P = public (cited doc/paper, value as published); I = illustrative (round value chosen to explain the idea, never a measurement); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/04-the-vision-specialist.md (five-step cycle, worked scaling example, grounding errors, knobs). Public docs: computer-use tool documentation, sections 'Available actions', 'Size screenshots to fit image limits', 'Diagnose click issues', 'Manage screenshot history', 'Optimize model performance with prompting'; Android MediaProjection guide and AccessibilityService.dispatchGesture reference (see ../SOURCES.md).&#10;[P1] cu_reference_frame_recommended = [1280, 800] px (width, height). public: Anthropic computer-use tool documentation, 'Size screenshots to fit image limits' (recommended for web applications)&#10;[P2] cu_max_resolution_advised = [1920, 1080] px. public: Anthropic computer-use tool documentation, 'Size screenshots to fit image limits' (avoid higher)&#10;[I3] device_native_resolution_illustrative = [2400, 1600] px. illustrative tablet screen, chosen with a different aspect ratio from the reference frame&#10;[I4] model_click_illustrative = [200, 560] px in reference frame. illustrative tap request; maps to (375, 1120) device px by my arithmetic&#10;[I5] settle_delay_illustrative = 1 s. illustrative wait after an action before the next screenshot&#10;[P6] cu_tokens_per_screenshot = [1000, 1800] input tokens. public: Anthropic computer-use tool documentation, 'Manage screenshot history'&#10;[P7] cu_screenshots_kept = 3 screenshots. public: Anthropic computer-use tool documentation, 'Manage screenshot history' (suggested default)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="736" width="1220" height="132" as="geometry" /></mxCell><mxCell id="edge0" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="cap" target="down"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="down" target="dec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="dec" target="up"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="up" target="act"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="act" target="set"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge5" value="next observation" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="set" target="cap"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1140" y="188" /><mxPoint x="125" y="188" /></Array></mxGeometry></mxCell><mxCell id="edge6" value="scaler&#10;x ÷ 0.533&#10;y ÷ 0.5" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;strokeColor=#d79b00;fontColor=#d79b00;" edge="1" parent="1" source="ref" target="dev"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>