<mxfile host="app.diagrams.net"><diagram id="p_01_message_path" name="01-message-path"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="786" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Four cheap guards run before any model token is spent, and every accepted task ends as exactly one result" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="34" as="geometry" /></mxCell><mxCell id="cloud" value="CLOUD SERVER&#10;sends one task message:&#10;message ID, session ID,&#10;type, payload = task text" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="180" height="110" as="geometry" /></mxCell><mxCell id="val" value="1  VALIDATE&#10;well-formed?&#10;known message type?" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="270" y="110" width="150" height="110" as="geometry" /></mxCell><mxCell id="dup" value="2  DE-DUPLICATE&#10;seen this message ID&#10;recently?&#10;IDs kept 10 min [I1]" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="110" width="165" height="110" as="geometry" /></mxCell><mxCell id="lock" value="3  LOCK&#10;is another task&#10;running?&#10;one screen = one task" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="645" y="110" width="155" height="110" as="geometry" /></mxCell><mxCell id="wd" value="4  WATCHDOG: hard stop after 5 min [I2]" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=center;fontSize=12;fontStyle=1;dashed=1;fillColor=none;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="825" y="66" width="430" height="174" as="geometry" /></mxCell><mxCell id="exe" value="WORK EXECUTOR&#10;background job,&#10;outside the UI&#10;(e.g. WorkManager)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="840" y="116" width="160" height="104" as="geometry" /></mxCell><mxCell id="graph" value="AGENT GRAPH&#10;orchestrator + two&#10;specialists call the model&#10;(diagram 02)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1025" y="116" width="215" height="104" as="geometry" /></mxCell><mxCell id="err" value="ERROR at once&#10;malformed or&#10;unknown type" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="270" y="300" width="150" height="70" as="geometry" /></mxCell><mxCell id="drop" value="DROPPED&#10;not a new task:&#10;no second run,&#10;no second result" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="300" width="165" height="70" as="geometry" /></mxCell><mxCell id="busy" value="BUSY at once&#10;no queue: the cloud&#10;decides on retry" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="645" y="300" width="155" height="70" as="geometry" /></mxCell><mxCell id="tout" value="TIMEOUT&#10;stop, clean up,&#10;release the lock" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="840" y="300" width="160" height="70" as="geometry" /></mxCell><mxCell id="succ" value="SUCCESS or ERROR&#10;FINISH reached, or a model&#10;error / exception is caught" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1025" y="300" width="215" height="70" as="geometry" /></mxCell><mxCell id="result" value="ONE RESULT MESSAGE up the channel, exactly once per accepted task:  status (SUCCESS | ERROR | BUSY | TIMEOUT)  +  execution time  +  task description" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=12;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="270" y="430" width="970" height="56" as="geometry" /></mxCell><mxCell id="why" value="WHY THESE GUARDS (design choices)&#10;- BUSY instead of a queue: a queued task would run minutes later on a changed screen. BUSY hands the retry decision to the cloud, which knows whether the task is still wanted. Cost: the cloud must retry with back-off.&#10;- The timeout is a safety bound, not a performance number. Size it well above the slow tail of successful tasks, e.g. several x the 20 s [I3] simple task.&#10;- One result per accepted task: a missing result looks like a lost message, so the cloud cannot decide whether to retry." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="520" width="600" height="98" as="geometry" /></mxCell><mxCell id="idem" value="THE IDEMPOTENCY TRAP&#10;De-duplication makes an exact repeat of one message safe. It does NOT make the task idempotent: &quot;add an item to the list&quot; run twice adds two items.&#10;A retry with a NEW message ID runs the task again. So after a lost result the cloud must ask the device first, or send only tasks that are safe to repeat." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#fff7f7;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="650" y="520" width="590" height="98" as="geometry" /></mxCell><mxCell id="legend" value="Legend:  purple = cloud side  |  amber = guard in device code  |  blue = device component  |  green = agent that calls the model  |  red = failure status or time limit (dashed frame = the limit wraps everything inside it)  |  dashed grey = dropped, no result sent.  Cloud message channel: down = task, up = result." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="632" width="1210" height="40" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Numbers are loaded from ../constants.json by key (shown). P = public (cited doc/paper, value as published); I = illustrative (round value chosen to explain the idea, never a measurement); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/01-the-message-path.md (five stages, four guards, the four result statuses, idempotency, design choices). Work executor example: Android WorkManager guide, https://developer.android.com/topic/libraries/architecture/workmanager (public). No measured numbers.&#10;[I1] dedup_window_illustrative = 10 min. illustrative retention of message IDs in the de-duplication cache&#10;[I2] watchdog_timeout_illustrative = 5 min. illustrative hard limit on task wall time&#10;[I3] task_wall_time_illustrative = 20 s. illustrative end-to-end time for a simple 'open an app' task; sum of the 07 budget table" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="686" width="1210" height="84" as="geometry" /></mxCell><mxCell id="edge0" value="down" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" parent="1" source="cloud" target="val"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="ok" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#d79b00;fontColor=#d79b00;" edge="1" parent="1" source="val" target="dup"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="new" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#d79b00;fontColor=#d79b00;" edge="1" parent="1" source="dup" target="lock"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="free" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#d79b00;fontColor=#d79b00;" edge="1" parent="1" source="lock" target="exe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="exe" target="graph"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge5" value="no" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="val" target="err"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="repeat" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#999999;fontColor=#999999;" edge="1" parent="1" source="dup" target="drop"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge7" value="held" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#d79b00;fontColor=#d79b00;" edge="1" parent="1" source="lock" target="busy"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge8" value="limit passed" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.221;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="wd" target="tout"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge9" value="graph ends" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1" source="graph" target="succ"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge10" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.077;entryY=0;entryDx=0;entryDy=0;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="err" target="result"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge11" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.468;entryY=0;entryDx=0;entryDy=0;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="busy" target="result"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge12" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.67;entryY=0;entryDx=0;entryDy=0;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="tout" target="result"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge13" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.889;entryY=0;entryDx=0;entryDy=0;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="succ" target="result"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge14" value="up" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" parent="1" source="result" target="cloud"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="120" y="458" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>