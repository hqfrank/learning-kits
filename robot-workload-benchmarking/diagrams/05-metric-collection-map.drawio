<mxfile host="app.diagrams.net"><diagram id="p_05_metric_collection_map" name="05-metric-collection-map"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="680" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Every metric has a source it is read from and a pitfall that misreads it - four groups, read all four or the result lies" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=15;fontStyle=1;fillColor=#f5f5f5;strokeColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1320" height="30" as="geometry" /></mxCell><mxCell id="g1" value="CPU  (B0)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=12;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="30" y="64" width="320" height="26" as="geometry" /></mxCell><mxCell id="m_cgroup" value="CPU usage in CORES&#10;source: cgroup cpu.stat (time / window)&#10;pitfall: convert to cores, not %, to compare across machines" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="30" y="96" width="320" height="70" as="geometry" /></mxCell><mxCell id="m_throttle" value="quota throttling&#10;source: cgroup cpu.max, cpu.stat (nr_throttled, throttled_usec)&#10;pitfall: throttled_usec is SUMMED over run-queues, NOT unmet demand - report fraction of throttled periods" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="30" y="172" width="320" height="78" as="geometry" /></mxCell><mxCell id="m_percore" value="per-core busy&#10;source: /proc/stat&#10;pitfall: pool near 100% busy = CPU is the limit" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="30" y="256" width="320" height="64" as="geometry" /></mxCell><mxCell id="m_rq" value="run-queue wait&#10;source: /proc/schedstat&#10;pitfall: rising wait (not GPU-busy) is the CPU-bound signature" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="30" y="326" width="320" height="64" as="geometry" /></mxCell><mxCell id="m_load" value="load average&#10;source: kernel loadavg&#10;pitfall: counts runnable+waiting incl. spikes; pair with per-core busy" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="30" y="396" width="320" height="60" as="geometry" /></mxCell><mxCell id="m_census" value="foreign-CPU census&#10;source: per-window process list&#10;pitfall: &gt; ~0.3 cores foreign =&gt; window suspect [foreign_cpu_gate_illustrative]" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="30" y="462" width="320" height="64" as="geometry" /></mxCell><mxCell id="g2" value="GPU + MEMORY  (B1)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=12;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="370" y="64" width="320" height="26" as="geometry" /></mxCell><mxCell id="m_gr3d" value="GPU-busy (GR3D %)&#10;source: tegrastats GR3D&#10;pitfall: TIME a kernel ran, NOT occupancy; calibrate vs kernel-time trace" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="370" y="96" width="320" height="70" as="geometry" /></mxCell><mxCell id="m_smi" value="utilization.gpu&#10;source: nvidia-smi&#10;pitfall: also a time fraction; can read below true busy - calibrate" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="370" y="172" width="320" height="64" as="geometry" /></mxCell><mxCell id="m_emc" value="memory-controller index (EMC %)&#10;source: tegrastats EMC&#10;pitfall: integer RELATIVE to current mem clock, not GB/s; lock the clock" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="370" y="242" width="320" height="70" as="geometry" /></mxCell><mxCell id="m_rails" value="power rails&#10;source: tegrastats rails&#10;pitfall: coarse steps; GPU+SoC may share a rail - no sub-step claims" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="370" y="318" width="320" height="60" as="geometry" /></mxCell><mxCell id="m_mem" value="memory: MemAvailable / cgroup / nvmap&#10;source: /proc/meminfo, memory.current, nvmap&#10;pitfall: do NOT sum cgroup + GPU mem (overlap/uncharged); use MemAvailable as the honest total" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="370" y="384" width="320" height="78" as="geometry" /></mxCell><mxCell id="m_clk" value="clock lock&#10;source: GPU + mem clock regime&#10;pitfall: verify lock at BOTH window ends or the counters are incomparable" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="370" y="468" width="320" height="58" as="geometry" /></mxCell><mxCell id="g3" value="RATES + LATENCY + STATS  (B2, B3)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=12;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="710" y="64" width="320" height="26" as="geometry" /></mxCell><mxCell id="m_rate" value="topic rate + period p50/p95/p99&#10;source: topic probes (msg timestamps)&#10;pitfall: a SOFTWARE-capped rate is a ceiling, not a compute limit" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="710" y="96" width="320" height="64" as="geometry" /></mxCell><mxCell id="m_stamp" value="receive-time vs header-stamp latency&#10;source: subscriber clock vs sender stamp&#10;pitfall: mixing bases silently adds the clock offset to every number" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="710" y="166" width="320" height="70" as="geometry" /></mxCell><mxCell id="m_offset" value="cross-machine clock offset&#10;source: SNTP probe (several/sec)&#10;pitfall: bound must be &lt; smallest latency measured [clock_offset_target_illustrative]" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="710" y="242" width="320" height="70" as="geometry" /></mxCell><mxCell id="m_clockfree" value="clock-free latency&#10;source: two arrivals on the SAME machine&#10;pitfall: the primary latency when the offset bound is too large" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="710" y="318" width="320" height="60" as="geometry" /></mxCell><mxCell id="m_miss" value="deadline misses/min + p99 tail&#10;source: per-cycle times (control loop)&#10;pitfall: Garwood Poisson interval; tails not means; block bootstrap for autocorrelation" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="710" y="384" width="320" height="72" as="geometry" /></mxCell><mxCell id="m_samples" value="sample-count rule&#10;source: window length from B3&#10;pitfall: too few samples =&gt; p99 noisy =&gt; flag the window, do not trust" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="710" y="462" width="320" height="64" as="geometry" /></mxCell><mxCell id="g4" value="PROFILERS  (B4)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=12;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1050" y="64" width="280" height="26" as="geometry" /></mxCell><mxCell id="m_tegra" value="tegrastats&#10;source: periodic one-line summary&#10;pitfall: cheap/coarse; duty + power only" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1050" y="96" width="280" height="60" as="geometry" /></mxCell><mxCell id="m_nsys" value="Nsight Systems (timeline)&#10;source: kernel + API timeline&#10;pitfall: MED intrusion: adds ~ms latency [nsys_perturbation_illustrative]; KPIs from UNTRACED windows only" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1050" y="162" width="280" height="86" as="geometry" /></mxCell><mxCell id="m_ncu" value="Nsight Compute (counters)&#10;source: per-kernel hardware counters&#10;pitfall: HIGH intrusion: serialises + replays kernels; take STRUCTURE not wall-times; never beside control loop" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1050" y="254" width="280" height="86" as="geometry" /></mxCell><mxCell id="m_union" value="union of kernel intervals&#10;source: nsys timeline&#10;pitfall: the true GPU-busy to CALIBRATE the coarse GR3D counter" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1050" y="346" width="280" height="64" as="geometry" /></mxCell><mxCell id="m_safety" value="profiler safety&#10;source: privileged container&#10;pitfall: min privilege, logged, time-bounded; NEVER next to the control loop" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1050" y="416" width="280" height="72" as="geometry" /></mxCell><mxCell id="legend" value="Legend&#10;Four colour groups = four metric families: blue CPU, green GPU+memory, amber rates+latency+stats, purple profilers.&#10;Every card carries: the metric name, the SOURCE it is read from, and the PITFALL that misreads it.&#10;Rule: the headline KPIs (rates, latencies, misses) come from UNTRACED windows; profilers run in separate,&#10;labelled trace-only windows for MECHANISM, never for a KPI (B4)." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="30" y="556" width="640" height="96" as="geometry" /></mxCell><mxCell id="src" value="Source: B0 (cgroup cpu.stat/cpu.max, /proc/stat, /proc/schedstat, loadavg, foreign-CPU census); B1 (tegrastats GR3D/EMC/rails, nvidia-smi, MemAvailable /proc/meminfo, cgroup memory.current, nvmap, clock lock); B2 (topic rate + period percentiles, receive vs header stamp, SNTP offset RFC 4330, clock-free latency); B3 (misses/min Garwood Poisson interval, p99 tails, sample-count rule, moving-block bootstrap); B4 (tegrastats / Nsight Systems / Nsight Compute, union of kernel intervals, profiler safety). Illustrative thresholds from constants.json as tagged. No measured robot numbers." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=9;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="690" y="556" width="640" height="96" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>