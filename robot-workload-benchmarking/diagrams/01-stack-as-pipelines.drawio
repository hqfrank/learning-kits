<mxfile host="app.diagrams.net"><diagram id="p_01_stack_as_pipelines" name="01-stack-as-pipelines"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="880" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="A home robot is not one program with one bottleneck: it is a crowd of pipelines with different deadlines sharing one CPU, one GPU, one memory pool" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=15;fontStyle=1;fillColor=#f5f5f5;strokeColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="30" as="geometry" /></mxCell><mxCell id="h_sense" value="SENSE  (read hardware)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=12;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="290" height="28" as="geometry" /></mxCell><mxCell id="h_perc" value="PERCEIVE  (raw data -&gt; meaning)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=12;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="350" y="70" width="290" height="28" as="geometry" /></mxCell><mxCell id="h_dec" value="DECIDE  (choose what to do)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=12;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="660" y="70" width="290" height="28" as="geometry" /></mxCell><mxCell id="h_act" value="ACT  (command motors + speaker)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=12;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="970" y="70" width="290" height="28" as="geometry" /></mxCell><mxCell id="cam" value="Depth camera + IMU [A1]&#10;stereo pair, IMU at 100s Hz&#10;both CPU+GPU | on-board" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="290" height="70" as="geometry" /></mxCell><mxCell id="depth" value="Depth map / point cloud / VIO [A1]&#10;neural depth = largest GPU cost&#10;both CPU+GPU | soft ~30 Hz | on-board" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="350" y="120" width="290" height="70" as="geometry" /></mxCell><mxCell id="pp" value="People perception [A2]&#10;detect/face/re-ID/pose/speaker + track&#10;networks GPU, CPU glue dominates&#10;both | soft ~10 Hz | on-board" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="350" y="204" width="290" height="78" as="geometry" /></mxCell><mxCell id="map" value="Mapping + localization [A3]&#10;keyframes, DISK/LightGlue/MixVPR,&#10;loop closure, iSAM2, TSDF  (BURSTY)&#10;both | soft | on-board" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="350" y="296" width="290" height="78" as="geometry" /></mxCell><mxCell id="nav" value="Navigation / path planning [A3]&#10;search occupancy grid, replan&#10;mostly CPU | soft | on-board" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="660" y="296" width="290" height="78" as="geometry" /></mxCell><mxCell id="mic" value="Microphone array [A5]&#10;packets: 48 frames/pkt @ 16 kHz&#10;CPU | on-board" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="388" width="290" height="70" as="geometry" /></mxCell><mxCell id="voice" value="Voice: VAD + wake-word [A5]&#10;always on-board, gate heavier models&#10;mostly CPU (per-msg overhead) | soft" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="350" y="388" width="290" height="70" as="geometry" /></mxCell><mxCell id="asr" value="ASR / TTS / speech-to-speech [A5]&#10;Whisper-class; often CLOUD (stubbed)&#10;CPU/GPU or cloud | best-effort" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="660" y="388" width="290" height="70" as="geometry" /></mxCell><mxCell id="cog" value="Cognition / on-demand LLM [A6]&#10;reasoning, called occasionally&#10;often CLOUD (stubbed) | best-effort" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="660" y="472" width="290" height="66" as="geometry" /></mxCell><mxCell id="vla" value="VLA (vision-language-action) [A6]&#10;backbone + action head -&gt; action chunk&#10;latency caps re-plan rate (e.g. 53 ms -&gt; ~19 Hz)&#10;GPU (bandwidth-bound) | best-effort | on-board" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="660" y="552" width="290" height="78" as="geometry" /></mxCell><mxCell id="wbc" value="Whole-body control [A4]&#10;MLP policy, fixed loop 50 Hz / 20 ms deadline&#10;motor bus 100-1000 Hz&#10;CPU (isolated cores) | HARD real-time | on-board" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="970" y="552" width="290" height="78" as="geometry" /></mxCell><mxCell id="act_lbl" value="action chunk -&gt;" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=9;fontStyle=1;fillColor=#f5f5f5;strokeColor=#f5f5f5;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="905" y="530" width="120" height="18" as="geometry" /></mxCell><mxCell id="plat" value="Platform layer [A7]: ROS 2 pub/sub + QoS, router (zenoh), containers, CPU quotas (cgroup cpu.max), core pinning (cpusets/isolcpus). Near-zero CPU, decides correctness: who gets which core, which messages arrive, whether the control loop is protected." style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=11;fillColor=#f0f0f0;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="644" width="900" height="52" as="geometry" /></mxCell><mxCell id="floor_lbl" value="THE FLOOR: one small on-board computer, cores partitioned -&gt;" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=11;fontStyle=1;fillColor=#f5f5f5;strokeColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="20" y="688" width="360" height="20" as="geometry" /></mxCell><mxCell id="pool_shared" value="Shared pool cores&#10;perception, mapping, nav, voice,&#10;VLA, cognition compete here" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="712" width="400" height="58" as="geometry" /></mxCell><mxCell id="pool_svc" value="Service cores&#10;middleware router, telemetry,&#10;camera service threads" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="460" y="712" width="360" height="58" as="geometry" /></mxCell><mxCell id="pool_iso" value="Isolated control cores&#10;reserved (isolcpus): ONLY the&#10;hard control loop, IRQs moved off" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="840" y="712" width="380" height="58" as="geometry" /></mxCell><mxCell id="legend" value="Legend&#10;Fill = timing class:   red = hard real-time (miss = fault)   amber = soft real-time (miss degrades quality)   blue = best-effort (no deadline)&#10;   purple = sense / raw I/O     green = core-partition floor&#10;Each box tags: resource (CPU / GPU / both), rate class, and on-board vs cloud.&#10;Arrows = message flow on pub/sub topics; services never call each other directly.&#10;Layers below are PROVIDERS; layers above CONSUME them (interference flows up, not down)." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="476" width="560" height="160" as="geometry" /></mxCell><mxCell id="src" value="Sources: stack structure + timing classes A0; depth/VIO/NVENC A1; perception chain A2; mapping/nav A3; control loop + isolation A4; voice + framing A5; VLA + re-plan A6; platform/QoS/quotas/pinning A7.  All rates ILLUSTRATIVE from constants.json: camera 30 Hz [camera_frame_rate_illustrative]; perception 10 Hz [perception_output_rate_illustrative]; control 50 Hz / 20 ms [wbc_control_rate_illustrative, wbc_deadline_illustrative]; motor bus 100-1000 Hz [motor_bus_rate_illustrative]; audio 48 frames/pkt @ 16 kHz [audio_packet_framing_illustrative, audio_sample_rate_illustrative].  VLA 53 ms -&gt; ~19 Hz is the SIBLING worked example [vla_latency_example_sibling]. No measured robot numbers." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=9;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="792" width="1180" height="70" as="geometry" /></mxCell><mxCell id="edge0" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#9673a6;" edge="1" parent="1" source="cam" target="depth"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge1" value="" style="endArrow=classic;html=0;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#d79b00;" edge="1" parent="1" source="depth" target="pp"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge2" value="" style="endArrow=classic;html=0;fontSize=10;exitX=0.2;exitY=1;entryX=0.2;entryY=0;strokeColor=#d79b00;" edge="1" parent="1" source="depth" target="map"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge3" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#d79b00;" edge="1" parent="1" source="map" target="nav"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge4" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#9673a6;" edge="1" parent="1" source="mic" target="voice"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge5" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#d79b00;" edge="1" parent="1" source="voice" target="asr"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge6" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.2;strokeColor=#6c8ebf;" edge="1" parent="1" source="pp" target="vla"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge7" value="" style="endArrow=classic;html=0;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#6c8ebf;" edge="1" parent="1" source="nav" target="vla"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge8" value="" style="endArrow=classic;html=0;fontSize=10;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#b85450;" edge="1" parent="1" source="vla" target="wbc"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>