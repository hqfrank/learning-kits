<mxfile host="app.diagrams.net"><diagram id="p_01_stack_as_pipelines" name="01-stack-as-pipelines"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="880" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="A home robot is not one program with one bottleneck: it is a crowd of pipelines with different deadlines sharing one CPU, one GPU, one memory pool" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=15;fontStyle=1;fillColor=#f5f5f5;strokeColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="30" as="geometry" /></mxCell><mxCell id="h_sense" value="SENSE  (read hardware)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=12;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="290" height="28" as="geometry" /></mxCell><mxCell id="h_perc" value="PERCEIVE  (raw data -&gt; meaning)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=12;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="350" y="70" width="290" height="28" as="geometry" /></mxCell><mxCell id="h_dec" value="DECIDE  (choose what to do)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=12;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="660" y="70" width="290" height="28" as="geometry" /></mxCell><mxCell id="h_act" value="ACT  (command motors + speaker)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=12;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="970" y="70" width="290" height="28" as="geometry" /></mxCell><mxCell id="cam" value="Depth camera + IMU [A1]&#10;stereo pair, IMU at 100s Hz&#10;both CPU+GPU | on-board" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="290" height="70" as="geometry" /></mxCell><mxCell id="depth" value="Depth map / point cloud / VIO [A1]&#10;neural depth = largest GPU cost&#10;both CPU+GPU | soft ~30 Hz | on-board" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="350" y="120" width="290" height="70" as="geometry" /></mxCell><mxCell id="pp" value="People perception [A2]&#10;detect/face/re-ID/pose/speaker + track&#10;networks GPU, CPU glue dominates&#10;both | soft ~10 Hz | on-board" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="350" y="204" width="290" height="78" as="geometry" /></mxCell><mxCell id="map" value="Mapping + localization [A3]&#10;keyframes, DISK/LightGlue/MixVPR,&#10;loop closure, iSAM2, TSDF  (BURSTY)&#10;both | soft | on-board" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="350" y="296" width="290" height="78" as="geometry" /></mxCell><mxCell id="nav" value="Navigation / path planning [A3]&#10;search occupancy grid, replan&#10;mostly CPU | soft | on-board" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="660" y="296" width="290" height="78" as="geometry" /></mxCell><mxCell id="mic" value="Microphone array [A5]&#10;packets: 48 frames/pkt @ 16 kHz&#10;CPU | on-board" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="388" width="290" height="70" as="geometry" /></mxCell><mxCell id="voice" value="Voice: VAD + wake-word [A5]&#10;always on-board, gate heavier models&#10;mostly CPU (per-msg overhead) | soft" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="350" y="388" width="290" height="70" as="geometry" /></mxCell><mxCell id="asr" value="ASR / TTS / speech-to-speech [A5]&#10;Whisper-class; often CLOUD (stubbed)&#10;CPU/GPU or cloud | best-effort" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="660" y="388" width="290" height="70" as="geometry" /></mxCell><mxCell id="cog" value="Cognition / on-demand LLM [A6]&#10;reasoning, called occasionally&#10;often CLOUD (stubbed) | best-effort" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="660" y="472" width="290" height="66" as="geometry" /></mxCell><mxCell id="vla" value="VLA (vision-language-action) [A6]&#10;backbone + action head -&gt; action chunk&#10;latency caps re-plan rate (e.g. 53 ms -&gt; ~19 Hz)&#10;GPU (bandwidth-bound) | best-effort | on-board" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="660" y="552" width="290" height="78" as="geometry" /></mxCell><mxCell id="wbc" value="Whole-body control [A4]&#10;MLP policy, fixed loop 50 Hz / 20 ms deadline&#10;motor bus 100-1000 Hz&#10;CPU (isolated cores) | HARD real-time | on-board" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="970" y="552" width="290" height="78" as="geometry" /></mxCell><mxCell id="act_lbl" value="action chunk -&gt;" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=9;fontStyle=1;fillColor=#f5f5f5;strokeColor=#f5f5f5;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="905" y="530" width="120" height="18" as="geometry" /></mxCell><mxCell id="plat" value="Platform layer [A7]: ROS 2 pub/sub + QoS, router (zenoh), containers, CPU quotas (cgroup cpu.max), core pinning (cpusets/isolcpus). Near-zero CPU, decides correctness: who gets which core, which messages arrive, whether the control loop is protected." style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=11;fillColor=#f0f0f0;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="644" width="900" height="52" as="geometry" /></mxCell><mxCell id="floor_lbl" value="THE FLOOR: one small on-board computer, cores partitioned -&gt;" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=11;fontStyle=1;fillColor=#f5f5f5;strokeColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="20" y="688" width="360" height="20" as="geometry" /></mxCell><mxCell id="pool_shared" value="Shared pool cores&#10;perception, mapping, nav, voice,&#10;VLA, cognition compete here" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="712" width="400" height="58" as="geometry" /></mxCell><mxCell id="pool_svc" value="Service cores&#10;middleware router, telemetry,&#10;camera service threads" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="460" y="712" width="360" height="58" as="geometry" /></mxCell><mxCell id="pool_iso" value="Isolated control cores&#10;reserved (isolcpus): ONLY the&#10;hard control loop, IRQs moved off" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="840" y="712" width="380" height="58" as="geometry" /></mxCell><mxCell id="legend" value="Legend&#10;Fill = timing class:   red = hard real-time (miss = fault)   amber = soft real-time (miss degrades quality)   blue = best-effort (no deadline)&#10;   purple = sense / raw I/O     green = core-partition floor&#10;Each box tags: resource (CPU / GPU / both), rate class, and on-board vs cloud.&#10;Arrows = message flow on pub/sub topics; services never call each other directly.&#10;Layers below are PROVIDERS; layers above CONSUME them (interference flows up, not down)." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="476" width="560" height="160" as="geometry" /></mxCell><mxCell id="src" value="Sources: stack structure + timing classes A0; depth/VIO/NVENC A1; perception chain A2; mapping/nav A3; control loop + isolation A4; voice + framing A5; VLA + re-plan A6; platform/QoS/quotas/pinning A7.  All rates ILLUSTRATIVE from constants.json: camera 30 Hz [camera_frame_rate_illustrative]; perception 10 Hz [perception_output_rate_illustrative]; control 50 Hz / 20 ms [wbc_control_rate_illustrative, wbc_deadline_illustrative]; motor bus 100-1000 Hz [motor_bus_rate_illustrative]; audio 48 frames/pkt @ 16 kHz [audio_packet_framing_illustrative, audio_sample_rate_illustrative].  VLA 53 ms -&gt; ~19 Hz is the SIBLING worked example [vla_latency_example_sibling]. No measured robot numbers." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=9;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="792" width="1180" height="70" as="geometry" /></mxCell><mxCell id="edge0" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#9673a6;" edge="1" parent="1" source="cam" target="depth"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge1" value="" style="endArrow=classic;html=0;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#d79b00;" edge="1" parent="1" source="depth" target="pp"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge2" value="" style="endArrow=classic;html=0;fontSize=10;exitX=0.2;exitY=1;entryX=0.2;entryY=0;strokeColor=#d79b00;" edge="1" parent="1" source="depth" target="map"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge3" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#d79b00;" edge="1" parent="1" source="map" target="nav"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge4" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#9673a6;" edge="1" parent="1" source="mic" target="voice"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge5" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#d79b00;" edge="1" parent="1" source="voice" target="asr"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge6" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.2;strokeColor=#6c8ebf;" edge="1" parent="1" source="pp" target="vla"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge7" value="" style="endArrow=classic;html=0;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#6c8ebf;" edge="1" parent="1" source="nav" target="vla"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge8" value="" style="endArrow=classic;html=0;fontSize=10;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#b85450;" edge="1" parent="1" source="vla" target="wbc"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="p_02_people_perception_pipeline" name="02-people-perception-pipeline"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="770" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="People perception: a short GPU network chain wrapped in CPU bookkeeping that grows with the number of people N" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=15;fontStyle=1;fillColor=#f5f5f5;strokeColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1280" height="30" as="geometry" /></mxCell><mxCell id="band_frame" value="PER-FRAME work  (fixed cost, once per camera frame)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=12;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="560" height="26" as="geometry" /></mxCell><mxCell id="band_person" value="PER-PERSON work  (runs once per detected person -&gt; scales ~linearly with N)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=12;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="640" y="66" width="640" height="26" as="geometry" /></mxCell><mxCell id="decode" value="Decode frame&#10;(CPU)" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="175" height="62" as="geometry" /></mxCell><mxCell id="letterbox" value="Rectify / letterbox&#10;resize to net input (CPU)" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="235" y="110" width="175" height="62" as="geometry" /></mxCell><mxCell id="detector" value="Person detection&#10;YOLOX (GPU)" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="425" y="110" width="175" height="62" as="geometry" /></mxCell><mxCell id="nms" value="NMS&#10;de-dup boxes (CPU)" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="425" y="192" width="175" height="58" as="geometry" /></mxCell><mxCell id="crop" value="Crop / warp per person&#10;(CPU) - xN" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="640" y="110" width="200" height="58" as="geometry" /></mxCell><mxCell id="facedet" value="Face detect + landmarks&#10;SCRFD (GPU) - xN" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="860" y="110" width="200" height="58" as="geometry" /></mxCell><mxCell id="facerec" value="Face recognition&#10;ArcFace embedding (GPU) - xN" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1080" y="110" width="200" height="58" as="geometry" /></mxCell><mxCell id="reid" value="Body re-ID&#10;OSNet embedding (GPU) - xN" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="640" y="180" width="200" height="58" as="geometry" /></mxCell><mxCell id="pose" value="2D pose&#10;BlazePose (GPU) - xN" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="860" y="180" width="200" height="58" as="geometry" /></mxCell><mxCell id="asd" value="Active-speaker&#10;Light-ASD (GPU) - xN" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1080" y="180" width="200" height="58" as="geometry" /></mxCell><mxCell id="track" value="Tracking-by-detection&#10;Kalman predict + Hungarian match&#10;(CPU) - per track per frame" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="640" y="300" width="200" height="72" as="geometry" /></mxCell><mxCell id="smooth" value="Smoothing&#10;One Euro filter&#10;(CPU) - per tracked quantity" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="860" y="300" width="200" height="72" as="geometry" /></mxCell><mxCell id="proj" value="3D projection&#10;sample depth map at pixels&#10;(CPU) - per person" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1080" y="300" width="200" height="72" as="geometry" /></mxCell><mxCell id="out" value="Publish tracks&#10;(illustrative ~10 Hz,&#10;often rate-capped)" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1080" y="392" width="200" height="58" as="geometry" /></mxCell><mxCell id="headline" value="HEADLINE LESSON (A2):&#10;The neural networks run on the GPU and are individually small.&#10;But NMS + Kalman + Hungarian + One Euro + depth-sampling + coordinate&#10;transforms all run on the CPU, usually in a scripting language, once per&#10;person per frame. On a small robot computer this CPU post-processing&#10;FREQUENTLY EXCEEDS the GPU inference time. A GPU-busy-only benchmark&#10;concludes 'plenty of headroom' while the CPU cores are already full." style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="560" height="120" as="geometry" /></mxCell><mxCell id="ncost" value="WHERE COST GROWS WITH N (people in view):  per-frame stages (decode, letterbox, YOLOX, NMS) stay FLAT.  Per-person stages (crop/warp, SCRFD, ArcFace, OSNet, BlazePose, Light-ASD, Kalman+Hungarian, One Euro, 3D projection) grow ~LINEARLY with N.  Measure at N = 1, 2, 5, 10: report the fixed per-frame cost AND the per-person slope separately, not one average.  Note: occlusion means fewer than N may actually be detected, so N = people in view, not people detected." style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="472" width="1240" height="76" as="geometry" /></mxCell><mxCell id="legend" value="Legend&#10;green = runs on the GPU (a neural network)&#10;blue = runs on the CPU (post-processing 'glue')&#10;'xN' = stage runs once per detected person (scales with N)&#10;purple band = the N-scaling rule itself" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="566" width="600" height="92" as="geometry" /></mxCell><mxCell id="src" value="Source: note A2. Models: YOLOX (arXiv:2107.08430), SCRFD (arXiv:2105.04714), ArcFace (arXiv:1801.07698), OSNet (arXiv:1905.00953), BlazePose (arXiv:2006.10204), Light-ASD (CVPR 2023). CPU post-processing: NMS; Kalman filter + Hungarian algorithm (tracking-by-detection); One Euro filter (Casiez et al., CHI 2012); 3D projection by sampling the depth map from A1.  Output rate ~10 Hz is ILLUSTRATIVE [perception_output_rate_illustrative]; camera 30 Hz [camera_frame_rate_illustrative]. A software rate cap is a ceiling, not a compute signal (B2). No measured robot numbers." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=9;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="674" width="1240" height="70" as="geometry" /></mxCell><mxCell id="edge0" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="decode" target="letterbox"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge1" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="letterbox" target="detector"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge2" value="" style="endArrow=classic;html=0;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#82b366;" edge="1" parent="1" source="detector" target="nms"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge3" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="nms" target="crop"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge4" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="crop" target="facedet"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge5" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#82b366;" edge="1" parent="1" source="facedet" target="facerec"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge6" value="" style="endArrow=classic;html=0;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#6c8ebf;" edge="1" parent="1" source="crop" target="reid"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge7" value="" style="endArrow=classic;html=0;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#82b366;" edge="1" parent="1" source="reid" target="track"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge8" value="" style="endArrow=classic;html=0;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#82b366;" edge="1" parent="1" source="pose" target="smooth"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge9" value="" style="endArrow=classic;html=0;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#82b366;" edge="1" parent="1" source="asd" target="proj"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge10" value="" style="endArrow=classic;html=0;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#6c8ebf;" edge="1" parent="1" source="proj" target="out"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="p_03_solo_levels" name="03-solo-levels"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="820" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Three solo levels of realism: the unit is the DEPLOYED SERVICE, not the model - and the gaps between levels are the finding" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=15;fontStyle=1;fillColor=#f5f5f5;strokeColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="30" as="geometry" /></mxCell><mxCell id="l3" value="L3  -  service WITH its real upstream&#10;answers: how fast is the service on REAL INPUT?&#10;(e.g. the camera service feeding mapping)" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=13;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="60" y="70" width="740" height="470" as="geometry" /></mxCell><mxCell id="l2" value="L2  -  the service AS DEPLOYED&#10;answers: how fast is the SERVICE?&#10;real container + runtime + pre/post-processing, driven through its own interface" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=13;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="120" y="190" width="620" height="320" as="geometry" /></mxCell><mxCell id="l1" value="L1  -  the engine alone&#10;answers: how fast is the NETWORK?&#10;compiled inference engine timed in isolation&#10;(trtexec-style: no service wrapper, no middleware)&#10;= the floor" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=13;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="190" y="320" width="480" height="160" as="geometry" /></mxCell><mxCell id="gap21" value="GAP  L2 - L1 = the service's OWN overhead&#10;= the CPU 'glue' (pre/post-processing, container,&#10;runtime) around the bare network. On a small robot&#10;this glue usually dominates (see A2)." style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="820" y="230" width="420" height="90" as="geometry" /></mxCell><mxCell id="gap32" value="GAP  L3 - L2 = the cost of REAL UPSTREAM data&#10;= real input shape and timing from the upstream&#10;service it consumes. Captures real-input cost, but&#10;adds the upstream's variability." style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="420" height="90" as="geometry" /></mxCell><mxCell id="side_hdr" value="SIDE PANEL: idle floor vs working cost" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=12;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="820" y="340" width="420" height="26" as="geometry" /></mxCell><mxCell id="idle" value="IDLE FLOOR&#10;an event-driven service&#10;with NO input does almost&#10;nothing (~0 cost).&#10;This is NOT its working&#10;cost. Must be labelled&#10;'idle floor', never&#10;reported as the cost." style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="820" y="372" width="200" height="120" as="geometry" /></mxCell><mxCell id="work" value="WORKING COST&#10;DRIVE the service through&#10;its own API:&#10;- speech plan -&gt; voice&#10;- inject detections -&gt; perception&#10;- replay motion -&gt; mapping&#10;- command a mode -&gt; control&#10;so it does REAL work." style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1040" y="372" width="200" height="120" as="geometry" /></mxCell><mxCell id="guide" value="HOW TO USE (C2):  Measure SOLO before combined - the clean per-service baseline is the DENOMINATOR for the interference factor the combined run reveals (C6); it is a result, not a rehearsal.  Pick the level that answers your question: L1 for the network floor, L2 for the deployable cost, L3 for real-input cost.  Measure the deployed service (L2), not the bare model (L1) - the network is only a fraction of the service's cost.  A 'replaced pair' (sized stand-in) is measured at its level and labelled with its basis, so the combined run adds a known, labelled quantity." style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=11;fillColor=#f0f0f0;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="1180" height="96" as="geometry" /></mxCell><mxCell id="legend" value="Legend&#10;Nesting = increasing realism: L1 (engine) within L2 (deployed service) within L3 (+ real upstream)&#10;green = L1 engine   blue = L2 service   purple = L3 upstream&#10;amber = the gap between two levels (what each gap measures)   red = the idle-floor caveat" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="60" y="676" width="560" height="76" as="geometry" /></mxCell><mxCell id="src" value="Source: note C2 (solo runs and levels). L1 = a trtexec-style engine timing (NVIDIA TensorRT, docs.nvidia.com/deeplearning/tensorrt/). 'Idle floor', 'working cost', 'driver', and 'replaced pair' are C2 terms. The interference factor the baseline feeds is defined in C6. No measured robot numbers." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=9;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="640" y="676" width="600" height="76" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="p_04_bench_topology" name="04-bench-topology"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="860" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Two machines: only the real stack runs on the robot; everything that stands in for the world runs on a separate harness machine" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=15;fontStyle=1;fillColor=#f5f5f5;strokeColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1300" height="30" as="geometry" /></mxCell><mxCell id="robot" value="ROBOT COMPUTER  -  runs ONLY the real deployed stack (the system under test)" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=13;fontStyle=1;fillColor=#eef4fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="50" y="70" width="560" height="560" as="geometry" /></mxCell><mxCell id="r_stack" value="Real services (A0-A7):&#10;- camera / depth / VIO&#10;- people perception&#10;- mapping + navigation&#10;- voice (VAD, wake-word)&#10;- VLA + cognition&#10;- middleware router, telemetry" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="80" y="120" width="300" height="150" as="geometry" /></mxCell><mxCell id="r_ctrl" value="Whole-body control loop (A4)&#10;MLP policy on ISOLATED cores&#10;50 Hz / 20 ms deadline&#10;(the island the bench tests)" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=11;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="80" y="286" width="300" height="90" as="geometry" /></mxCell><mxCell id="r_obs" value="Observers / probes (B0, B2, B4)&#10;on their OWN dedicated core,&#10;off the application cores,&#10;ready + settled BEFORE t0" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="80" y="400" width="300" height="90" as="geometry" /></mxCell><mxCell id="r_clk" value="Clock-sync probe (B2)&#10;SNTP, several times/sec&#10;reports a bounded offset&#10;(illustrative &lt; 0.5 ms)" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="80" y="512" width="300" height="72" as="geometry" /></mxCell><mxCell id="r_isl_a" value="ISLAND A&#10;(control + sensor&#10;wire protocols)&#10;&#10;fast bus endpoints,&#10;mic stream,&#10;camera topics" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=10;fontStyle=1;fillColor=#eafaf1;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="410" y="130" width="170" height="200" as="geometry" /></mxCell><mxCell id="r_isl_b" value="ISLAND B&#10;(bulk feeds +&#10;cloud calls)&#10;&#10;synthetic camera,&#10;bag replay,&#10;cloud-API calls" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=10;fontStyle=1;fillColor=#fdf2f2;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="410" y="400" width="170" height="185" as="geometry" /></mxCell><mxCell id="harness" value="HARNESS MACHINE  -  stands in for the physical world; its CPU is measured HERE, never counted as stack load" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=13;fontStyle=1;fillColor=#fff6ec;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="730" y="70" width="560" height="560" as="geometry" /></mxCell><mxCell id="h_motor" value="Fake motor boards (C3, A4)&#10;real wire protocol + framing,&#10;real rate (100-1000 Hz)" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760" y="120" width="250" height="72" as="geometry" /></mxCell><mxCell id="h_mic" value="Fake microphone board (C3, A5)&#10;match frames/pkt + packets/msg&#10;(wrong framing biases every consumer)" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760" y="204" width="250" height="72" as="geometry" /></mxCell><mxCell id="h_cam" value="Synthetic camera (C3, A2)&#10;generate frames with N people,&#10;or inject ground-truth detections" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760" y="288" width="250" height="72" as="geometry" /></mxCell><mxCell id="h_bag" value="Bag replay (C3, A3)&#10;recorded motion drives bursty&#10;mapping; person-data stays local" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760" y="372" width="250" height="64" as="geometry" /></mxCell><mxCell id="h_stub" value="Cloud-API stubs (C3, A5/A6)&#10;faithful schema + status codes,&#10;LABELLED latency assumption" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="760" y="448" width="250" height="72" as="geometry" /></mxCell><mxCell id="h_obs" value="Harness CPU measured here&#10;(not counted as stack load)" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="760" y="532" width="250" height="64" as="geometry" /></mxCell><mxCell id="h_clk" value="Clock-sync peer (B2)&#10;SNTP responder for&#10;the offset bound" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1040" y="532" width="220" height="64" as="geometry" /></mxCell><mxCell id="link1" value="DEDICATED&#10;low-latency&#10;CONTROL link" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=10;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="620" y="210" width="100" height="56" as="geometry" /></mxCell><mxCell id="link2" value="BULK link&#10;(feeds,&#10;replay)" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=10;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="620" y="460" width="100" height="56" as="geometry" /></mxCell><mxCell id="legend" value="Legend&#10;blue = robot (system under test)   amber = harness machine&#10;green = a faithful fake / stub / synthetic input   purple = observers &amp; harness-CPU accounting&#10;red = the hard control loop + its dedicated link (the thing most at risk)&#10;Two links: a DEDICATED low-latency link for control (so its timing is not stolen) and a BULK link for&#10;feeds; TWO network ISLANDS so a live and a synthetic source sharing a topic name do not collide." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="50" y="660" width="620" height="100" as="geometry" /></mxCell><mxCell id="src" value="Source: note C3 (harness, second machine, fake boards + framing fidelity, schema-faithful stubs, synthetic input / detection injection, bag replay, network islands + cut edges). Control loop + isolation: A4. Fake-mic framing + per-message cost: A5. Synthetic N people: A2. Bursty mapping bag replay: A3. Cross-machine clock offset by SNTP, bound &lt; smallest latency: B2 (RFC 4330). Observer core: B0, B4. Rates ILLUSTRATIVE: motor bus 100-1000 Hz [motor_bus_rate_illustrative]; offset &lt; 0.5 ms [clock_offset_target_illustrative]. No measured robot numbers." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=9;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="690" y="660" width="600" height="100" as="geometry" /></mxCell><mxCell id="edge0" value="" style="endArrow=classic;html=0;fontSize=10;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#b85450;" edge="1" parent="1" source="r_isl_a" target="link1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge1" value="" style="endArrow=classic;html=0;fontSize=10;fontStyle=1;exitX=1;exitY=0.3;entryX=0;entryY=0.5;strokeColor=#b85450;" edge="1" parent="1" source="link1" target="h_motor"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge2" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="r_isl_b" target="link2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge3" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.3;entryX=0;entryY=0.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="link2" target="h_cam"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge4" value="" style="endArrow=classic;html=0;fontSize=10;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#999999;" edge="1" parent="1" source="r_clk" target="h_clk"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="p_05_metric_collection_map" name="05-metric-collection-map"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="680" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Every metric has a source it is read from and a pitfall that misreads it - four groups, read all four or the result lies" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=15;fontStyle=1;fillColor=#f5f5f5;strokeColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1320" height="30" as="geometry" /></mxCell><mxCell id="g1" value="CPU  (B0)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=12;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="30" y="64" width="320" height="26" as="geometry" /></mxCell><mxCell id="m_cgroup" value="CPU usage in CORES&#10;source: cgroup cpu.stat (time / window)&#10;pitfall: convert to cores, not %, to compare across machines" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="30" y="96" width="320" height="70" as="geometry" /></mxCell><mxCell id="m_throttle" value="quota throttling&#10;source: cgroup cpu.max, cpu.stat (nr_throttled, throttled_usec)&#10;pitfall: throttled_usec is SUMMED over run-queues, NOT unmet demand - report fraction of throttled periods" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="30" y="172" width="320" height="78" as="geometry" /></mxCell><mxCell id="m_percore" value="per-core busy&#10;source: /proc/stat&#10;pitfall: pool near 100% busy = CPU is the limit" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="30" y="256" width="320" height="64" as="geometry" /></mxCell><mxCell id="m_rq" value="run-queue wait&#10;source: /proc/schedstat&#10;pitfall: rising wait (not GPU-busy) is the CPU-bound signature" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="30" y="326" width="320" height="64" as="geometry" /></mxCell><mxCell id="m_load" value="load average&#10;source: kernel loadavg&#10;pitfall: counts runnable+waiting incl. spikes; pair with per-core busy" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="30" y="396" width="320" height="60" as="geometry" /></mxCell><mxCell id="m_census" value="foreign-CPU census&#10;source: per-window process list&#10;pitfall: &gt; ~0.3 cores foreign =&gt; window suspect [foreign_cpu_gate_illustrative]" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="30" y="462" width="320" height="64" as="geometry" /></mxCell><mxCell id="g2" value="GPU + MEMORY  (B1)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=12;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="370" y="64" width="320" height="26" as="geometry" /></mxCell><mxCell id="m_gr3d" value="GPU-busy (GR3D %)&#10;source: tegrastats GR3D&#10;pitfall: TIME a kernel ran, NOT occupancy; calibrate vs kernel-time trace" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="370" y="96" width="320" height="70" as="geometry" /></mxCell><mxCell id="m_smi" value="utilization.gpu&#10;source: nvidia-smi&#10;pitfall: also a time fraction; can read below true busy - calibrate" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="370" y="172" width="320" height="64" as="geometry" /></mxCell><mxCell id="m_emc" value="memory-controller index (EMC %)&#10;source: tegrastats EMC&#10;pitfall: integer RELATIVE to current mem clock, not GB/s; lock the clock" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="370" y="242" width="320" height="70" as="geometry" /></mxCell><mxCell id="m_rails" value="power rails&#10;source: tegrastats rails&#10;pitfall: coarse steps; GPU+SoC may share a rail - no sub-step claims" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="370" y="318" width="320" height="60" as="geometry" /></mxCell><mxCell id="m_mem" value="memory: MemAvailable / cgroup / nvmap&#10;source: /proc/meminfo, memory.current, nvmap&#10;pitfall: do NOT sum cgroup + GPU mem (overlap/uncharged); use MemAvailable as the honest total" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="370" y="384" width="320" height="78" as="geometry" /></mxCell><mxCell id="m_clk" value="clock lock&#10;source: GPU + mem clock regime&#10;pitfall: verify lock at BOTH window ends or the counters are incomparable" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="370" y="468" width="320" height="58" as="geometry" /></mxCell><mxCell id="g3" value="RATES + LATENCY + STATS  (B2, B3)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=12;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="710" y="64" width="320" height="26" as="geometry" /></mxCell><mxCell id="m_rate" value="topic rate + period p50/p95/p99&#10;source: topic probes (msg timestamps)&#10;pitfall: a SOFTWARE-capped rate is a ceiling, not a compute limit" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="710" y="96" width="320" height="64" as="geometry" /></mxCell><mxCell id="m_stamp" value="receive-time vs header-stamp latency&#10;source: subscriber clock vs sender stamp&#10;pitfall: mixing bases silently adds the clock offset to every number" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="710" y="166" width="320" height="70" as="geometry" /></mxCell><mxCell id="m_offset" value="cross-machine clock offset&#10;source: SNTP probe (several/sec)&#10;pitfall: bound must be &lt; smallest latency measured [clock_offset_target_illustrative]" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="710" y="242" width="320" height="70" as="geometry" /></mxCell><mxCell id="m_clockfree" value="clock-free latency&#10;source: two arrivals on the SAME machine&#10;pitfall: the primary latency when the offset bound is too large" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="710" y="318" width="320" height="60" as="geometry" /></mxCell><mxCell id="m_miss" value="deadline misses/min + p99 tail&#10;source: per-cycle times (control loop)&#10;pitfall: Garwood Poisson interval; tails not means; block bootstrap for autocorrelation" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="710" y="384" width="320" height="72" as="geometry" /></mxCell><mxCell id="m_samples" value="sample-count rule&#10;source: window length from B3&#10;pitfall: too few samples =&gt; p99 noisy =&gt; flag the window, do not trust" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="710" y="462" width="320" height="64" as="geometry" /></mxCell><mxCell id="g4" value="PROFILERS  (B4)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=12;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1050" y="64" width="280" height="26" as="geometry" /></mxCell><mxCell id="m_tegra" value="tegrastats&#10;source: periodic one-line summary&#10;pitfall: cheap/coarse; duty + power only" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1050" y="96" width="280" height="60" as="geometry" /></mxCell><mxCell id="m_nsys" value="Nsight Systems (timeline)&#10;source: kernel + API timeline&#10;pitfall: MED intrusion: adds ~ms latency [nsys_perturbation_illustrative]; KPIs from UNTRACED windows only" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1050" y="162" width="280" height="86" as="geometry" /></mxCell><mxCell id="m_ncu" value="Nsight Compute (counters)&#10;source: per-kernel hardware counters&#10;pitfall: HIGH intrusion: serialises + replays kernels; take STRUCTURE not wall-times; never beside control loop" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1050" y="254" width="280" height="86" as="geometry" /></mxCell><mxCell id="m_union" value="union of kernel intervals&#10;source: nsys timeline&#10;pitfall: the true GPU-busy to CALIBRATE the coarse GR3D counter" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1050" y="346" width="280" height="64" as="geometry" /></mxCell><mxCell id="m_safety" value="profiler safety&#10;source: privileged container&#10;pitfall: min privilege, logged, time-bounded; NEVER next to the control loop" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1050" y="416" width="280" height="72" as="geometry" /></mxCell><mxCell id="legend" value="Legend&#10;Four colour groups = four metric families: blue CPU, green GPU+memory, amber rates+latency+stats, purple profilers.&#10;Every card carries: the metric name, the SOURCE it is read from, and the PITFALL that misreads it.&#10;Rule: the headline KPIs (rates, latencies, misses) come from UNTRACED windows; profilers run in separate,&#10;labelled trace-only windows for MECHANISM, never for a KPI (B4)." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="30" y="556" width="640" height="96" as="geometry" /></mxCell><mxCell id="src" value="Source: B0 (cgroup cpu.stat/cpu.max, /proc/stat, /proc/schedstat, loadavg, foreign-CPU census); B1 (tegrastats GR3D/EMC/rails, nvidia-smi, MemAvailable /proc/meminfo, cgroup memory.current, nvmap, clock lock); B2 (topic rate + period percentiles, receive vs header stamp, SNTP offset RFC 4330, clock-free latency); B3 (misses/min Garwood Poisson interval, p99 tails, sample-count rule, moving-block bootstrap); B4 (tegrastats / Nsight Systems / Nsight Compute, union of kernel intervals, profiler safety). Illustrative thresholds from constants.json as tagged. No measured robot numbers." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=9;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="690" y="556" width="640" height="96" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="p_06_campaign_flow" name="06-campaign-flow"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="790" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="The campaign flow: predict before you measure, freeze the plan, build up in tiers, gate every window, then attribute the first limit" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=15;fontStyle=1;fillColor=#f5f5f5;strokeColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1300" height="30" as="geometry" /></mxCell><mxCell id="predict" value="1. PREDICT - compute-budget ledger (C1)&#10;t = FLOP/R + bytes/B + t_CPU per stage.&#10;R, B MEASURED on target, not datasheet.&#10;Name bound class + falsifiable predictions.&#10;Small batch-1 models = launch-bound." style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="280" height="92" as="geometry" /></mxCell><mxCell id="prereg" value="2. PRE-REGISTER (C5)&#10;Freeze hypotheses, PASS/FAIL thresholds,&#10;and the seeded run order BEFORE data.&#10;No tuning after data. Disclose anything&#10;seen early." style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="360" y="66" width="280" height="92" as="geometry" /></mxCell><mxCell id="solo" value="3. SOLO runs (C2)&#10;Each service alone: L1 engine / L2 deployed /&#10;L3 + upstream. DRIVE event-driven services&#10;(no idle floors). Clean baseline = the&#10;DENOMINATOR for interference." style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="680" y="66" width="280" height="92" as="geometry" /></mxCell><mxCell id="review1" value="4. REVIEW&#10;Independent second person checks the&#10;solo baselines, gate logic, and statistics&#10;before the combined runs begin." style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1000" y="66" width="300" height="92" as="geometry" /></mxCell><mxCell id="combined" value="5. COMBINED runs in TIERS (C6), seeded INTERLEAVED order (C5)&#10;Build up the stack: default load -&gt; next-generation -&gt; + manipulation -&gt; + on-demand large models.&#10;Interleave A/B (ABBA / mirror) so slow drift cancels; replicate blocks; paired within-block comparisons.&#10;Interference factor = combined value / solo sum, read per KPI (the TAIL, not the mean)." style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="600" height="120" as="geometry" /></mxCell><mxCell id="gate" value="6. VALIDITY GATES per window (C4) - warm-up then a fixed window from a sample-count rule&#10;alive (rate DROP is an outcome, silence is a void) | expected input rates | crash scan | foreign-CPU census | clocks locked at BOTH ends&#10;=&gt; each window is VALID (counts) / FLAGGED (kept with caveat) / VOID (thrown out, with a recorded void class)" style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="680" y="200" width="620" height="120" as="geometry" /></mxCell><mxCell id="valid" value="VALID&#10;numbers count" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="680" y="336" width="195" height="48" as="geometry" /></mxCell><mxCell id="flagged" value="FLAGGED&#10;kept with a caveat" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="890" y="336" width="195" height="48" as="geometry" /></mxCell><mxCell id="void" value="VOID&#10;record the void class" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1100" y="336" width="200" height="48" as="geometry" /></mxCell><mxCell id="carries" value="7. 'CARRIES' VERDICT per KPI band (C6), over valid windows&#10;Each timing KPI (control-loop misses, camera rate, perception rate, VLA rate) has pre-set bands:&#10;PASS band | UNRESOLVED zone | FAIL band.&#10;A cell CARRIES only if EVERY applicable KPI is PASS. Any FAIL =&gt; does not carry. Any UNRESOLVED (no FAIL) =&gt; unresolved." style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="410" width="600" height="120" as="geometry" /></mxCell><mxCell id="attrib" value="8. FIRST-LIMIT ATTRIBUTION (C6), pre-registered classifier&#10;CPU-pool (pool ~full + loser's drop tracks rising run-queue wait) | GPU (GPU-busy ~saturated, GPU loser, CPU flat) |&#10;memory (mem index high, CPU-only loser, no CPU saturation) | none-observed; a loss with no matching signal = UNATTRIBUTED.&#10;SATURATED-BASELINE caveat: if the lightest tier is already at the wall, the classifier reads unattributed BY CONSTRUCTION - report the saturation, do not pretend it found nothing." style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="680" y="410" width="620" height="120" as="geometry" /></mxCell><mxCell id="loop" value="LOOP BACK ONLY for a HARNESS / INSTRUMENT bug (C5):  record a numbered ADDENDUM (defect, evidence, fix, impact on windows already run); if a recorded window was affected, SUPERSEDE it - re-run whole under the SAME seeds, keep the original, log it.  NEVER loop back to change stack behaviour: a surprise about the STACK is a FINDING, not a bug to tune away. No tuning after data (C5)." style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="566" width="1260" height="78" as="geometry" /></mxCell><mxCell id="legend" value="Legend&#10;blue = a campaign step (predict -&gt; pre-register -&gt; solo -&gt; review -&gt; combined)&#10;amber = validity gates + the FLAGGED outcome   green = a verdict step (valid / carries / attribution)&#10;red = VOID / the saturated-baseline caveat (the honest failure modes)   purple = the addenda/supersede loop&#10;Arrows = campaign order; the only backward arrow is the harness-bug loop, never a stack-behaviour loop." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="664" width="620" height="92" as="geometry" /></mxCell><mxCell id="src" value="Source: C1 (predict-then-measure, compute-budget ledger, bound class, falsifiable predictions, launch-bound batch-1 models); C5 (pre-registration, no tuning after data, seeded interleaved ABBA/mirror order, replicate blocks, paired comparisons, addenda + supersedes, independent review); C2 (solo L1/L2/L3, idle floors, drivers); C4 (warm-up + fixed window, sample-count rule, validity gates alive/rates/crash/census/clocks, valid vs flagged vs void + void class); C6 (workload tiers, interference factor, PASS/UNRESOLVED/FAIL bands, first-limit attribution CPU/GPU/memory/none, saturated-baseline failure). No measured robot numbers." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=9;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="680" y="664" width="620" height="92" as="geometry" /></mxCell><mxCell id="edge0" value="" style="endArrow=classic;html=0;fontSize=10;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="predict" target="prereg"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge1" value="" style="endArrow=classic;html=0;fontSize=10;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="prereg" target="solo"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge2" value="" style="endArrow=classic;html=0;fontSize=10;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="solo" target="review1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge3" value="" style="endArrow=classic;html=0;fontSize=10;fontStyle=1;exitX=0.5;exitY=1;entryX=0.9;entryY=0;strokeColor=#6c8ebf;" edge="1" parent="1" source="review1" target="combined"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge4" value="" style="endArrow=classic;html=0;fontSize=10;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="combined" target="gate"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge5" value="" style="endArrow=classic;html=0;fontSize=10;fontStyle=1;exitX=0.1;exitY=1;entryX=0.5;entryY=0;strokeColor=#82b366;" edge="1" parent="1" source="gate" target="carries"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge6" value="" style="endArrow=classic;html=0;fontSize=10;fontStyle=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#82b366;" edge="1" parent="1" source="carries" target="attrib"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge7" value="" style="endArrow=classic;html=0;fontSize=10;dashed=1;exitX=0.5;exitY=1;entryX=0.9;entryY=0;strokeColor=#9673a6;" edge="1" parent="1" source="attrib" target="loop"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>