<mxfile host="app.diagrams.net"><diagram id="p_02_people_perception_pipeline" name="02-people-perception-pipeline"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="770" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="People perception: a short GPU network chain wrapped in CPU bookkeeping that grows with the number of people N" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=15;fontStyle=1;fillColor=#f5f5f5;strokeColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1280" height="30" as="geometry" /></mxCell><mxCell id="band_frame" value="PER-FRAME work  (fixed cost, once per camera frame)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=12;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="560" height="26" as="geometry" /></mxCell><mxCell id="band_person" value="PER-PERSON work  (runs once per detected person -&gt; scales ~linearly with N)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=12;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="640" y="66" width="640" height="26" as="geometry" /></mxCell><mxCell id="decode" value="Decode frame&#10;(CPU)" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="175" height="62" as="geometry" /></mxCell><mxCell id="letterbox" value="Rectify / letterbox&#10;resize to net input (CPU)" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="235" y="110" width="175" height="62" as="geometry" /></mxCell><mxCell id="detector" value="Person detection&#10;YOLOX (GPU)" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="425" y="110" width="175" height="62" as="geometry" /></mxCell><mxCell id="nms" value="NMS&#10;de-dup boxes (CPU)" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="425" y="192" width="175" height="58" as="geometry" /></mxCell><mxCell id="crop" value="Crop / warp per person&#10;(CPU) - xN" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="640" y="110" width="200" height="58" as="geometry" /></mxCell><mxCell id="facedet" value="Face detect + landmarks&#10;SCRFD (GPU) - xN" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="860" y="110" width="200" height="58" as="geometry" /></mxCell><mxCell id="facerec" value="Face recognition&#10;ArcFace embedding (GPU) - xN" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1080" y="110" width="200" height="58" as="geometry" /></mxCell><mxCell id="reid" value="Body re-ID&#10;OSNet embedding (GPU) - xN" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="640" y="180" width="200" height="58" as="geometry" /></mxCell><mxCell id="pose" value="2D pose&#10;BlazePose (GPU) - xN" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="860" y="180" width="200" height="58" as="geometry" /></mxCell><mxCell id="asd" value="Active-speaker&#10;Light-ASD (GPU) - xN" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1080" y="180" width="200" height="58" as="geometry" /></mxCell><mxCell id="track" value="Tracking-by-detection&#10;Kalman predict + Hungarian match&#10;(CPU) - per track per frame" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="640" y="300" width="200" height="72" as="geometry" /></mxCell><mxCell id="smooth" value="Smoothing&#10;One Euro filter&#10;(CPU) - per tracked quantity" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="860" y="300" width="200" height="72" as="geometry" /></mxCell><mxCell id="proj" value="3D projection&#10;sample depth map at pixels&#10;(CPU) - per person" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1080" y="300" width="200" height="72" as="geometry" /></mxCell><mxCell id="out" value="Publish tracks&#10;(illustrative ~10 Hz,&#10;often rate-capped)" style="rounded=1;whiteSpace=wrap;html=0;align=center;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1080" y="392" width="200" height="58" as="geometry" /></mxCell><mxCell id="headline" value="HEADLINE LESSON (A2):&#10;The neural networks run on the GPU and are individually small.&#10;But NMS + Kalman + Hungarian + One Euro + depth-sampling + coordinate&#10;transforms all run on the CPU, usually in a scripting language, once per&#10;person per frame. On a small robot computer this CPU post-processing&#10;FREQUENTLY EXCEEDS the GPU inference time. A GPU-busy-only benchmark&#10;concludes 'plenty of headroom' while the CPU cores are already full." style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="560" height="120" as="geometry" /></mxCell><mxCell id="ncost" value="WHERE COST GROWS WITH N (people in view):  per-frame stages (decode, letterbox, YOLOX, NMS) stay FLAT.  Per-person stages (crop/warp, SCRFD, ArcFace, OSNet, BlazePose, Light-ASD, Kalman+Hungarian, One Euro, 3D projection) grow ~LINEARLY with N.  Measure at N = 1, 2, 5, 10: report the fixed per-frame cost AND the per-person slope separately, not one average.  Note: occlusion means fewer than N may actually be detected, so N = people in view, not people detected." style="rounded=1;whiteSpace=wrap;html=0;align=left;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="472" width="1240" height="76" as="geometry" /></mxCell><mxCell id="legend" value="Legend&#10;green = runs on the GPU (a neural network)&#10;blue = runs on the CPU (post-processing 'glue')&#10;'xN' = stage runs once per detected person (scales with N)&#10;purple band = the N-scaling rule itself" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="566" width="600" height="92" as="geometry" /></mxCell><mxCell id="src" value="Source: note A2. Models: YOLOX (arXiv:2107.08430), SCRFD (arXiv:2105.04714), ArcFace (arXiv:1801.07698), OSNet (arXiv:1905.00953), BlazePose (arXiv:2006.10204), Light-ASD (CVPR 2023). CPU post-processing: NMS; Kalman filter + Hungarian algorithm (tracking-by-detection); One Euro filter (Casiez et al., CHI 2012); 3D projection by sampling the depth map from A1.  Output rate ~10 Hz is ILLUSTRATIVE [perception_output_rate_illustrative]; camera 30 Hz [camera_frame_rate_illustrative]. A software rate cap is a ceiling, not a compute signal (B2). No measured robot numbers." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=9;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="674" width="1240" height="70" as="geometry" /></mxCell><mxCell id="edge0" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="decode" target="letterbox"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge1" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="letterbox" target="detector"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge2" value="" style="endArrow=classic;html=0;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#82b366;" edge="1" parent="1" source="detector" target="nms"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge3" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="nms" target="crop"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge4" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#6c8ebf;" edge="1" parent="1" source="crop" target="facedet"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge5" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#82b366;" edge="1" parent="1" source="facedet" target="facerec"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge6" value="" style="endArrow=classic;html=0;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#6c8ebf;" edge="1" parent="1" source="crop" target="reid"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge7" value="" style="endArrow=classic;html=0;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#82b366;" edge="1" parent="1" source="reid" target="track"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge8" value="" style="endArrow=classic;html=0;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#82b366;" edge="1" parent="1" source="pose" target="smooth"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge9" value="" style="endArrow=classic;html=0;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#82b366;" edge="1" parent="1" source="asd" target="proj"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge10" value="" style="endArrow=classic;html=0;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#6c8ebf;" edge="1" parent="1" source="proj" target="out"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>