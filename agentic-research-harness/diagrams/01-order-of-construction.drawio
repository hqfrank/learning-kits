<mxfile host="app.diagrams.net"><diagram id="p_01_order_of_construction" name="01-order-of-construction"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="778" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Automate last: by hand the policy call fell 400 -&gt; 100 ms [I1][I2]; the automated loop then found a further 12 % [calc] cheaply (all illustrative)" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="40" as="geometry" /></mxCell><mxCell id="ph_CALIBRATE" value="CALIBRATE" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=13;fontStyle=1;dashed=1;fillColor=none;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="72" width="510" height="40" as="geometry" /></mxCell><mxCell id="ph_HAND-RUN" value="HAND-RUN" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=13;fontStyle=1;dashed=1;fillColor=none;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="555" y="72" width="510" height="40" as="geometry" /></mxCell><mxCell id="ph_AUTOMATE" value="AUTOMATE" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=13;fontStyle=1;dashed=1;fillColor=none;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1080" y="72" width="160" height="40" as="geometry" /></mxCell><mxCell id="s0" value="1  REFERENCE + BASELINE&#10;&#10;port, make it run, benchmark on frozen inputs on several devices (B1)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="128" width="160" height="100" as="geometry" /></mxCell><mxCell id="s1" value="2  PROPOSAL&#10;&#10;one page: what is optimized, what 'equivalent' means, who owns the evaluator (B8)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=center;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="205" y="128" width="160" height="100" as="geometry" /></mxCell><mxCell id="s2" value="3  FROZEN EVALUATOR + CONTROLS&#10;&#10;build the judge; baseline must pass, cheats must fail (B2, B3)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="128" width="160" height="100" as="geometry" /></mxCell><mxCell id="s3" value="4  RESEARCH BY HAND&#10;&#10;a coordinating agent gives one bounded question per researcher session; a human watches every round" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="555" y="128" width="160" height="100" as="geometry" /></mxCell><mxCell id="s4" value="5  EVALUATOR HARDENING&#10;&#10;each new check answers a failure seen the day before" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="730" y="128" width="160" height="100" as="geometry" /></mxCell><mxCell id="s5" value="6  FIRST REPORT&#10;&#10;rebuilt from the evidence records (B4, B8)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="905" y="128" width="160" height="100" as="geometry" /></mxCell><mxCell id="s6" value="7  AUTOMATED LOOP&#10;&#10;planner, parallel researchers, queue, promotion policy, memory, cost meter (B7)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1080" y="128" width="160" height="100" as="geometry" /></mxCell><mxCell id="ex0" value="EXIT: the baseline passes every input set with margin clearly below 1, and every negative control is rejected" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="240" width="510" height="50" as="geometry" /></mxCell><mxCell id="ex3" value="EXIT: the evaluator has survived several rounds of real candidates; the lessons file 'writes itself'" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="555" y="240" width="510" height="50" as="geometry" /></mxCell><mxCell id="ex6" value="START: small caps, few parallel researchers, cost metered from round one" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1080" y="240" width="160" height="50" as="geometry" /></mxCell><mxCell id="w1" value="WHY 1 BEFORE 3&#10;A correctness gate compares the candidate with a trusted output. No reference -&gt; nothing to compare -&gt; the first fast-but-wrong result is accepted." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="306" width="400" height="70" as="geometry" /></mxCell><mxCell id="w2" value="WHY BASELINE BEFORE CANDIDATES&#10;In the first campaign the first gate wrongly REJECTED the real baseline. It was found the day the evaluator was built, because the baseline ran before any candidate." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="440" y="306" width="400" height="70" as="geometry" /></mxCell><mxCell id="w3" value="WHY 4 BEFORE 7&#10;The hand-run rounds showed which prompts, rules and checks the agents need. The loop then encodes a process that already works; automating earlier automates the wrong prompts." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="850" y="306" width="400" height="70" as="geometry" /></mxCell><mxCell id="shape_h" value="THE SHAPE OF THE FIRST CAMPAIGN (illustrative values that keep the shape, not the campaign's values). Bar length is to scale: latency of one policy call." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="394" width="1220" height="24" as="geometry" /></mxCell><mxCell id="bar0" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="426" width="880" height="34" as="geometry" /></mxCell><mxCell id="bar0_l" value="start: 400 ms [I1]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="920" y="426" width="300" height="34" as="geometry" /></mxCell><mxCell id="bar1" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="472" width="220" height="34" as="geometry" /></mxCell><mxCell id="bar1_l" value="after hand-run rounds: 100 ms [I2]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="260" y="472" width="300" height="34" as="geometry" /></mxCell><mxCell id="bar1_n" value="-75 % [calc] in 3 days [I4], about 12 researcher sessions [I5]: people steering agents found the big gains" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="560" y="472" width="690" height="34" as="geometry" /></mxCell><mxCell id="bar2" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="518" width="193" height="34" as="geometry" /></mxCell><mxCell id="bar2_l" value="after automated loop: 88 ms [I3]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="233" y="518" width="300" height="34" as="geometry" /></mxCell><mxCell id="bar2_n" value="a further -12 % [calc] in 5 rounds [I6] for about 50 USD of model usage [I7]: the loop found smaller, harder gains cheaply" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="560" y="518" width="690" height="34" as="geometry" /></mxCell><mxCell id="legend" value="Legend:  dashed frames = phases (note A1 table)  |  purple = human-owned  |  amber = the judge  |  green = agent work  |  blue = records / data  |  grey = why the order matters  |  bars: red = start, green = after hand-run, amber = after automation. Steps run left to right; each needs the one before it." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="572" width="1220" height="40" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Every number is loaded from ../constants.json by the key shown. [Pn] = public (cited paper, or my arithmetic on public mathematics); [In] = illustrative (a design parameter of the harness, a round value that keeps the shape of the first campaign, or output of the demonstration scheduling simulator; never a measurement of a real platform); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/A1-the-order-of-construction.md (seven steps, three dependencies, phase table, illustrative campaign shape); notes/C5-the-checklist.md; B1-B4, B7, B8 for each step. [calc]: -75 % = (400 - 100) / 400; -12 % = (100 - 88) / 100.&#10;[I1] c1_baseline_ms_illustrative = 400 ms. illustrative; keeps the shape of the first campaign (internal methodology notes, 2026), not its values&#10;[I2] c1_after_handrun_ms_illustrative = 100 ms. illustrative; keeps the shape of the first campaign (internal methodology notes, 2026), not its values&#10;[I3] c1_after_auto_ms_illustrative = 88 ms. illustrative; keeps the shape of the first campaign (internal methodology notes, 2026), not its values&#10;[I4] c1_handrun_days_illustrative = 3 days. illustrative; keeps the shape of the first campaign (internal methodology notes, 2026), not its values&#10;[I5] c1_handrun_sessions_illustrative = 12 researcher sessions. illustrative; keeps the shape of the first campaign (internal methodology notes, 2026), not its values&#10;[I6] c1_auto_rounds_illustrative = 5 rounds. illustrative; keeps the shape of the first campaign (internal methodology notes, 2026), not its values&#10;[I7] c1_auto_spend_usd_illustrative = 50 USD. illustrative; keeps the shape of the first campaign (internal methodology notes, 2026), not its values" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="626" width="1220" height="136" as="geometry" /></mxCell><mxCell id="edge0" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge5" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>