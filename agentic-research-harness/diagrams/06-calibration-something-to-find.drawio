<mxfile host="app.diagrams.net"><diagram id="p_06_calibration_something_to_find" name="06-calibration-something-to-find"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1006" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Calibration: on the first workload EDF came within 1.1 ms [calc] of the work floor, so the owner densified it until placement (GPU 91 % [I11], DLA 0 % [I12]) became the lever" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="40" as="geometry" /></mxCell><mxCell id="h30" value="FIRST VISIBLE WORKLOAD (superseded)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=13;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="66" width="590" height="36" as="geometry" /></mxCell><mxCell id="lh30" value="perception-chain metric, ms, as reported in note C3; densified rows are medians over seeds (8 px per ms)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="108" width="590" height="18" as="geometry" /></mxCell><mxCell id="ll30_0" value="FIFO baseline [I1] (binding 0.66 [I2])" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="130" width="212" height="26" as="geometry" /></mxCell><mxCell id="lb30_0" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="250" y="134" width="233" height="18" as="geometry" /></mxCell><mxCell id="lv30_0" value="29.2 ms" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="487" y="130" width="120" height="26" as="geometry" /></mxCell><mxCell id="ll30_1" value="EDF, GPU first [I3]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="160" width="212" height="26" as="geometry" /></mxCell><mxCell id="lb30_1" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="250" y="164" width="132" height="18" as="geometry" /></mxCell><mxCell id="lv30_1" value="16.6 ms" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="386" y="160" width="120" height="26" as="geometry" /></mxCell><mxCell id="ll30_2" value="work floor [I4]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="190" width="212" height="26" as="geometry" /></mxCell><mxCell id="lb30_2" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="250" y="194" width="124" height="18" as="geometry" /></mxCell><mxCell id="lv30_2" value="15.5 ms" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="378" y="190" width="120" height="26" as="geometry" /></mxCell><mxCell id="uh30" value="utilization, % (bars to scale, 100 % = 300 px)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="226" width="590" height="18" as="geometry" /></mxCell><mxCell id="ul30_0" value="CPU [I5]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="248" width="212" height="24" as="geometry" /></mxCell><mxCell id="ub30_0" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="250" y="252" width="300" height="16" as="geometry" /></mxCell><mxCell id="uf30_0" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="250" y="252" width="72" height="16" as="geometry" /></mxCell><mxCell id="uv30_0" value="24 %" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="554" y="248" width="100" height="24" as="geometry" /></mxCell><mxCell id="ul30_1" value="GPU [I5]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="274" width="212" height="24" as="geometry" /></mxCell><mxCell id="ub30_1" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="250" y="278" width="300" height="16" as="geometry" /></mxCell><mxCell id="uf30_1" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="250" y="278" width="126" height="16" as="geometry" /></mxCell><mxCell id="uv30_1" value="42 %" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="554" y="274" width="100" height="24" as="geometry" /></mxCell><mxCell id="h660" value="DENSIFIED WORKLOAD (frozen v0.1)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=13;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="660" y="66" width="590" height="36" as="geometry" /></mxCell><mxCell id="lh660" value="perception-chain metric, ms, as reported in note C3; densified rows are medians over seeds (8 px per ms)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="660" y="108" width="590" height="18" as="geometry" /></mxCell><mxCell id="ll660_0" value="baseline: FIFO, shortest-exec [I6]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="660" y="130" width="212" height="26" as="geometry" /></mxCell><mxCell id="lb660_0" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="880" y="134" width="277" height="18" as="geometry" /></mxCell><mxCell id="lv660_0" value="34.7 ms" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1161" y="130" width="120" height="26" as="geometry" /></mxCell><mxCell id="ll660_1" value="EDF, same placement [I7]" style="text;html=0;whiteSpace=wrap;ver