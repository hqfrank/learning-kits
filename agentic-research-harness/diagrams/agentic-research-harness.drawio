 x="880" y="312" width="300" height="16" as="geometry" /></mxCell><mxCell id="uf660_0" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="880" y="312" width="273" height="16" as="geometry" /></mxCell><mxCell id="uv660_0" value="91 %" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1184" y="308" width="100" height="24" as="geometry" /></mxCell><mxCell id="ul660_1" value="GPU after R1 [I14]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="660" y="334" width="212" height="24" as="geometry" /></mxCell><mxCell id="ub660_1" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="880" y="338" width="300" height="16" as="geometry" /></mxCell><mxCell id="uf660_1" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="880" y="338" width="195" height="16" as="geometry" /></mxCell><mxCell id="uv660_1" value="65 %" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1184" y="334" width="100" height="24" as="geometry" /></mxCell><mxCell id="ul660_2" value="DLA before [I12]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="660" y="360" width="212" height="24" as="geometry" /></mxCell><mxCell id="ub660_2" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="880" y="364" width="300" height="16" as="geometry" /></mxCell><mxCell id="uv660_2" value="0 %" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1184" y="360" width="100" height="24" as="geometry" /></mxCell><mxCell id="ul660_3" value="DLA after R1 [I15]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="660" y="386" width="212" height="24" as="geometry" /></mxCell><mxCell id="ub660_3" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="880" y="390" width="300" height="16" as="geometry" /></mxCell><mxCell id="uf660_3" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="880" y="390" width="126" height="16" as="geometry" /></mxCell><mxCell id="uv660_3" value="42 %" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1184" y="386" width="100" height="24" as="geometry" /></mxCell><mxCell id="ul660_4" value="CPU before [I13]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="660" y="412" width="212" height="24" as="geometry" /></mxCell><mxCell id="ub660_4" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="880" y="416" width="300" height="16" as="geometry" /></mxCell><mxCell id="uf660_4" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="880" y="416" width="99" height="16" as="geometry" /></mxCell><mxCell id="uv660_4" value="33 %" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1184" y="412" width="100" height="24" as="geometry" /></mxCell><mxCell id="v1" value="NOTHING TO FIND. EDF sits 1.1 ms [calc] above the floor and both units have slack (CPU 24 %, GPU 42 % [I5]). The baseline passes, the gate is calibrated, yet a campaign's ceiling is tiny: a passing baseline does not make a topic ready." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#fff7f7;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="446" width="590" height="72" as="geometry" /></mxCell><mxCell id="v2" value="THE LEVER IS PLACEMENT. Dispatch order alone (EDF, least laxity) stays inside the baseline's range; earliest-finish placement moves work off the saturated GPU onto the idle DLA and the promoted candidate's median drops to 25.8 ms [I9]. Medians shown; promotion compares ranges (diagram 05)." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="660" y="446" width="590" height="72" as="geometry" /></mxCell><mxCell id="dens" value="HOW IT WAS DENSIFIED (on purpose, documented)&#10;- a parallel segmenter in the perception chain&#10;- a new depth-mapping chain&#10;- several jobs made heavier&#10;- control deadline set to 20 ms [I19]" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="530" width="400" height="100" as="geometry" /></mxCell><mxCell id="fair" value="A FAIR BASELINE, NOT A STRAWMAN&#10;The first baseline placed jobs alphabetically: every accelerator job went to the DLA, perception reached 626 ms [I16] (off this scale) and the densified workload failed outright. It was replaced by shortest-execution placement: the default an engineer ships first." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="445" y="530" width="400" height="100" as="geometry" /></mxCell><mxCell id="greedy" value="GPU-GREEDY LOSES WHEN A LONG JOB BLOCKS THE GPU (diagnostic)&#10;Held-out b, first calibration: GPU-greedy 37 ms vs CPU placement 29 ms [I17]. A 200 ms [I18] grasp-planner job holds the single non-preemptive GPU and perception queues behind it." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;dashed=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="860" y="530" width="390" height="100" as="geometry" /></mxCell><mxCell id="legend" value="Legend:  grey bar = baseline  |  green = best non-diagnostic policy  |  blue = other policy; dashed = diagnostic (did not pass through the frozen evaluator)  |  red = work floor (no scheduler beats it)  |  utilization: amber = before, green = after round 1, blue = CPU. Simulator output: illustrative, not a real platform." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="642" width="1220" height="40" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Every number is loaded from ../constants.json by the key shown. [Pn] = public (cited paper, or my arithmetic on public mathematics); [In] = illustrative (a design parameter of the harness, a round value that keeps the shape of the first campaign, or output of the demonstration scheduling simulator; never a measurement of a real platform); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/C3-calibration.md (two goals of calibration, work floor, densifying, baseline placement choice, GPU-greedy finding, round-1 result); notes/C2-the-scheduling-topic.md (platform, metric, held-out b). [calc]: 1.1 = 16.6 - 15.5. The first workload's DLA utilization is not in the notes and is not drawn.&#10;[I1] sched_cal1_fifo_ms = 29.2 ms. illustrative: demonstration run of the local scheduling simulator&#10;[I2] sched_cal1_fifo_binding = 0.66 binding ratio. illustrative: demonstration run of the local scheduling simulator&#10;[I3] sched_cal1_edf_ms = 16.6 ms. illustrative: demonstration run of the local scheduling simulator&#10;[I4] sched_cal1_floor_ms = 15.5 ms. illustrative: demonstration run of the local scheduling simulator&#10;[I5] sched_cal1_util = {cpu 24, gpu 42} %. illustrative: demonstration run of the local scheduling simulator&#10;[I6] sched_baseline = {median 34.7, min 32.3, max 45.4, binding_visible 0.49, binding_a 0.34, binding_b 0.44} ms / binding. illustrative: demonstration run of the local scheduling simulator&#10;[I7] sched_edf_gpu_first = {median 34.5, min 31.6, max 41.6, binding_visible 0.6, binding_a 0.26, binding_b 0.43} ms / binding. illustrative: demonstration run of the local scheduling simulator&#10;[I8] sched_probe_least_laxity_ms = 34.2 ms. illustrative: demonstration run of the local scheduling simulator&#10;[I9] sched_r1_eft_metric_first = {median 25.8, min 23.7, max 30.7, binding 0.474} ms / binding. illustrative: demonstration run of the local scheduling simulator&#10;[I10] sched_work_floor_ms = 22.5 ms. illustrative: demonstration run of the local scheduling simulator&#10;[I11] sched_baseline_gpu_util = 91 %. illustrative: demonstration run of the local scheduling simulator&#10;[I12] sched_baseline_dla_util = 0 %. illustrative: demonstration run of the local scheduling simulator&#10;[I13] sched_baseline_cpu_util = 33 %. illustrative: demonstration run of the local scheduling simulator&#10;[I14] sched_r1_gpu_util = 65 %. illustrative: demonstration run of the local scheduling simulator&#10;[I15] sched_r1_dla_util = 42 %. illustrative: demonstration run of the local scheduling simulator&#10;[I16] sched_alphabetical_perception_ms = 626 ms. illustrative: demonstration run of the local scheduling simulator&#10;[I17] sched_cal1_heldout_b = {gpu_greedy 37, cpu_placement 29} ms. illustrative: demonstration run of the local scheduling simulator&#10;[I18] sched_heldout_b_grasp_ms = 200 ms. illustrative: demonstration run of the local scheduling simulator&#10;[I19] sched_control_deadline_ms = 20 ms. illustrative: demonstration run of the local scheduling simulator" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="696" width="1220" height="294" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>