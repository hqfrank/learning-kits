<mxfile host="app.diagrams.net"><diagram id="p_01_order_of_construction" name="01-order-of-construction"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="778" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Automate last: by hand the policy call fell 400 -&gt; 100 ms [I1][I2]; the automated loop then found a further 12 % [calc] cheaply (all illustrative)" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="40" as="geometry" /></mxCell><mxCell id="ph_CALIBRATE" value="CALIBRATE" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=13;fontStyle=1;dashed=1;fillColor=none;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="72" width="510" height="40" as="geometry" /></mxCell><mxCell id="ph_HAND-RUN" value="HAND-RUN" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=13;fontStyle=1;dashed=1;fillColor=none;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="555" y="72" width="510" height="40" as="geometry" /></mxCell><mxCell id="ph_AUTOMATE" value="AUTOMATE" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=13;fontStyle=1;dashed=1;fillColor=none;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1080" y="72" width="160" height="40" as="geometry" /></mxCell><mxCell id="s0" value="1  REFERENCE + BASELINE&#10;&#10;port, make it run, benchmark on frozen inputs on several devices (B1)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="128" width="160" height="100" as="geometry" /></mxCell><mxCell id="s1" value="2  PROPOSAL&#10;&#10;one page: what is optimized, what 'equivalent' means, who owns the evaluator (B8)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=center;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="205" y="128" width="160" height="100" as="geometry" /></mxCell><mxCell id="s2" value="3  FROZEN EVALUATOR + CONTROLS&#10;&#10;build the judge; baseline must pass, cheats must fail (B2, B3)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="128" width="160" height="100" as="geometry" /></mxCell><mxCell id="s3" value="4  RESEARCH BY HAND&#10;&#10;a coordinating agent gives one bounded question per researcher session; a human watches every round" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="555" y="128" width="160" height="100" as="geometry" /></mxCell><mxCell id="s4" value="5  EVALUATOR HARDENING&#10;&#10;each new check answers a failure seen the day before" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="730" y="128" width="160" height="100" as="geometry" /></mxCell><mxCell id="s5" value="6  FIRST REPORT&#10;&#10;rebuilt from the evidence records (B4, B8)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="905" y="128" width="160" height="100" as="geometry" /></mxCell><mxCell id="s6" value="7  AUTOMATED LOOP&#10;&#10;planner, parallel researchers, queue, promotion policy, memory, cost meter (B7)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1080" y="128" width="160" height="100" as="geometry" /></mxCell><mxCell id="ex0" value="EXIT: the baseline passes every input set with margin clearly below 1, and every negative control is rejected" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="240" width="510" height="50" as="geometry" /></mxCell><mxCell id="ex3" value="EXIT: the evaluator has survived several rounds of real candidates; the lessons file 'writes itself'" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="555" y="240" width="510" height="50" as="geometry" /></mxCell><mxCell id="ex6" value="START: small caps, few parallel researchers, cost metered from round one" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1080" y="240" width="160" height="50" as="geometry" /></mxCell><mxCell id="w1" value="WHY 1 BEFORE 3&#10;A correctness gate compares the candidate with a trusted output. No reference -&gt; nothing to compare -&gt; the first fast-but-wrong result is accepted." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="306" width="400" height="70" as="geometry" /></mxCell><mxCell id="w2" value="WHY BASELINE BEFORE CANDIDATES&#10;In the first campaign the first gate wrongly REJECTED the real baseline. It was found the day the evaluator was built, because the baseline ran before any candidate." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="440" y="306" width="400" height="70" as="geometry" /></mxCell><mxCell id="w3" value="WHY 4 BEFORE 7&#10;The hand-run rounds showed which prompts, rules and checks the agents need. The loop then encodes a process that already works; automating earlier automates the wrong prompts." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="850" y="306" width="400" height="70" as="geometry" /></mxCell><mxCell id="shape_h" value="THE SHAPE OF THE FIRST CAMPAIGN (illustrative values that keep the shape, not the campaign's values). Bar length is to scale: latency of one policy call." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="394" width="1220" height="24" as="geometry" /></mxCell><mxCell id="bar0" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="426" width="880" height="34" as="geometry" /></mxCell><mxCell id="bar0_l" value="start: 400 ms [I1]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="920" y="426" width="300" height="34" as="geometry" /></mxCell><mxCell id="bar1" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="472" width="220" height="34" as="geometry" /></mxCell><mxCell id="bar1_l" value="after hand-run rounds: 100 ms [I2]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="260" y="472" width="300" height="34" as="geometry" /></mxCell><mxCell id="bar1_n" value="-75 % [calc] in 3 days [I4], about 12 researcher sessions [I5]: people steering agents found the big gains" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="560" y="472" width="690" height="34" as="geometry" /></mxCell><mxCell id="bar2" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="518" width="193" height="34" as="geometry" /></mxCell><mxCell id="bar2_l" value="after automated loop: 88 ms [I3]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="233" y="518" width="300" height="34" as="geometry" /></mxCell><mxCell id="bar2_n" value="a further -12 % [calc] in 5 rounds [I6] for about 50 USD of model usage [I7]: the loop found smaller, harder gains cheaply" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="560" y="518" width="690" height="34" as="geometry" /></mxCell><mxCell id="legend" value="Legend:  dashed frames = phases (note A1 table)  |  purple = human-owned  |  amber = the judge  |  green = agent work  |  blue = records / data  |  grey = why the order matters  |  bars: red = start, green = after hand-run, amber = after automation. Steps run left to right; each needs the one before it." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="572" width="1220" height="40" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Every number is loaded from ../constants.json by the key shown. [Pn] = public (cited paper, or my arithmetic on public mathematics); [In] = illustrative (a design parameter of the harness, a round value that keeps the shape of the first campaign, or output of the demonstration scheduling simulator; never a measurement of a real platform); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/A1-the-order-of-construction.md (seven steps, three dependencies, phase table, illustrative campaign shape); notes/C5-the-checklist.md; B1-B4, B7, B8 for each step. [calc]: -75 % = (400 - 100) / 400; -12 % = (100 - 88) / 100.&#10;[I1] c1_baseline_ms_illustrative = 400 ms. illustrative; keeps the shape of the first campaign (internal methodology notes, 2026), not its values&#10;[I2] c1_after_handrun_ms_illustrative = 100 ms. illustrative; keeps the shape of the first campaign (internal methodology notes, 2026), not its values&#10;[I3] c1_after_auto_ms_illustrative = 88 ms. illustrative; keeps the shape of the first campaign (internal methodology notes, 2026), not its values&#10;[I4] c1_handrun_days_illustrative = 3 days. illustrative; keeps the shape of the first campaign (internal methodology notes, 2026), not its values&#10;[I5] c1_handrun_sessions_illustrative = 12 researcher sessions. illustrative; keeps the shape of the first campaign (internal methodology notes, 2026), not its values&#10;[I6] c1_auto_rounds_illustrative = 5 rounds. illustrative; keeps the shape of the first campaign (internal methodology notes, 2026), not its values&#10;[I7] c1_auto_spend_usd_illustrative = 50 USD. illustrative; keeps the shape of the first campaign (internal methodology notes, 2026), not its values" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="626" width="1220" height="136" as="geometry" /></mxCell><mxCell id="edge0" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge5" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p_02_frozen_evaluator_binding_ratio" name="02-frozen-evaluator-binding-ratio"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="985" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="The evaluator reports how close a candidate came to failing: binding ratio = largest measured / limit; below 1 passes, promotion needs at most 0.9 [I1]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="40" as="geometry" /></mxCell><mxCell id="cand" value="CANDIDATE&#10;candidates/&lt;id&gt;/&#10;one idea, parent-linked, never modified (B5)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="31" y="121" width="150" height="100" as="geometry" /></mxCell><mxCell id="verify" value="VERIFY&#10;frozen tree hash = manifest?&#10;if not: refuse to evaluate&#10;(human-owned, versioned)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="210" y="120" width="160" height="100" as="geometry" /></mxCell><mxCell id="vis" value="VISIBLE set&#10;20 seeds [I3] x 5 s [I4]; agents may read it" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="405" y="70" width="210" height="60" as="geometry" /></mxCell><mxCell id="hoa" value="HELD-OUT a: 3 cores, perception 40 Hz [I6]; 8 seeds [I5]" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#fff7f7;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="405" y="140" width="210" height="60" as="geometry" /></mxCell><mxCell id="hob" value="HELD-OUT b: another robot, 200 ms GPU grasp planner [I7], no DLA; 8 seeds [I5]" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#fff7f7;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="405" y="210" width="210" height="60" as="geometry" /></mxCell><mxCell id="gate" value="GATE, per input set (limit -&gt; ratio)&#10;- every chain instance due completes&#10;- hard chains: 0 deadline misses; worst e2e / deadline&#10;- soft chains: misses &lt;= 5 % [I8]; p99 e2e / deadline, miss ratio / limit&#10;- mean decision time &lt; 2 ms [I9]; time / limit&#10;- order probe: reversed seeds give identical results&#10;- only ready jobs, allowed resources" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="650" y="70" width="260" height="200" as="geometry" /></mxCell><mxCell id="bind" value="BINDING RATIO&#10;= the LARGEST measured / limit over every check and every input set&#10;(also called the margin)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="940" y="100" width="140" height="140" as="geometry" /></mxCell><mxCell id="verd" value="VERDICT&#10;ACCEPTED: all checks pass (binding below 1)&#10;REJECTED: a check fails&#10;INVALID: cannot count by design (e.g. a quick development run)&#10;&#10;promotable only if binding &lt;= 0.9 [I1]" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1110" y="70" width="140" height="200" as="geometry" /></mxCell><mxCell id="integ" value="INTEGRITY CHECKS (each closes one way a fast result can be fake):  model ran exactly once per call (no skipping or caching)  |  fixed noise consumed exactly once  |  output came from the device (no silent host fall-back)  |  order probe (no carried state)  |  provenance hashes of every file read  |  candidate tree hash before = after the run" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#fff8ee;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="293" width="1220" height="64" as="geometry" /></mxCell><mxCell id="ch_h" value="BINDING RATIOS OF THE DEMONSTRATION RUN on one scale (illustrative output of the local scheduling simulator, not a real platform). Bars are to scale; zones are set by the margin cap and the pass limit." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="382" width="1220" height="34" as="geometry" /></mxCell><mxCell id="z_ok" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#f1f8ef;strokeColor=#82b366;strokeWidth=0;" vertex="1" parent="1"><mxGeometry x="440" y="422" width="486" height="180" as="geometry" /></mxCell><mxCell id="z_low" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#fff3e0;strokeColor=#d79b00;strokeWidth=0;" vertex="1" parent="1"><mxGeometry x="926" y="422" width="54" height="180" as="geometry" /></mxCell><mxCell id="z_bad" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#fdecec;strokeColor=#b85450;strokeWidth=0;" vertex="1" parent="1"><mxGeometry x="980" y="422" width="43" height="180" as="geometry" /></mxCell><mxCell id="r0_l" value="baseline (calibration) [I10]:  0.49  accepted [calc]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="425" width="400" height="24" as="geometry" /></mxCell><mxCell id="r0_b" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="440" y="428" width="264" height="18" as="geometry" /></mxCell><mxCell id="r1_l" value="EDF, same placement [I11]:  0.6  accepted [calc]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="455" width="400" height="24" as="geometry" /></mxCell><mxCell id="r1_b" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="440" y="458" width="324" height="18" as="geometry" /></mxCell><mxCell id="r2_l" value="R1 earliest-finish placement [I12]:  0.434  accepted" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="485" width="400" height="24" as="geometry" /></mxCell><mxCell id="r2_b" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="440" y="488" width="234" height="18" as="geometry" /></mxCell><mxCell id="r3_l" value="R1 + perception-first dispatch [I13]:  0.474  promoted" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="515" width="400" height="24" as="geometry" /></mxCell><mxCell id="r3_b" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="440" y="518" width="255" height="18" as="geometry" /></mxCell><mxCell id="r4_l" value="R1 earliest-finish + reservation [I14]:  0.78  accepted, not promotable" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="545" width="400" height="24" as="geometry" /></mxCell><mxCell id="r4_b" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="440" y="548" width="421" height="18" as="geometry" /></mxCell><mxCell id="r5_l" value="R1 baseline placement + reservation [I15]:  0.807  accepted, not promotable" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="575" width="400" height="24" as="geometry" /></mxCell><mxCell id="r5_b" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="440" y="578" width="435" height="18" as="geometry" /></mxCell><mxCell id="tk0" value="0" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="420" y="606" width="40" height="18" as="geometry" /></mxCell><mxCell id="tk0.5" value="0.5" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="690" y="606" width="40" height="18" as="geometry" /></mxCell><mxCell id="tk_cap1" value="0.85 [I2]&#10;first-campaign cap" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="775" y="606" width="120" height="32" as="geometry" /></mxCell><mxCell id="tk_cap" value="0.9 [I1]&#10;cap here" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="922" y="606" width="80" height="32" as="geometry" /></mxCell><mxCell id="tk_one" value="1.0 = a limit reached&#10;-&gt; REJECTED" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="984" y="606" width="150" height="32" as="geometry" /></mxCell><mxCell id="zl_ok" value="promotable zone (if the range rule also holds, diagram 04)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#4d7a3d;" vertex="1" parent="1"><mxGeometry x="444" y="642" width="486" height="18" as="geometry" /></mxCell><mxCell id="why" value="WHY A MARGIN AND NOT JUST A PASS&#10;A pass close to 1 means the next small change breaks it, or the candidate exploits the edge of a limit: such a run is 'accepted, low margin' and never promoted.&#10;Limits come from legitimate runs (B1), not a guess: a limit tighter than legitimate noise rejects correct work." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1070" y="418" width="180" height="182" as="geometry" /></mxCell><mxCell id="legend" value="Legend:  amber = the frozen judge  |  blue = inputs agents may read / candidate files  |  pale red = held-out inputs agents never read  |  chart: bar = binding ratio (green, thick = promoted); purple dashed = first-campaign cap; amber = cap in the scheduling topic; red = pass limit 1.0" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="668" width="1220" height="40" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Every number is loaded from ../constants.json by the key shown. [Pn] = public (cited paper, or my arithmetic on public mathematics); [In] = illustrative (a design parameter of the harness, a round value that keeps the shape of the first campaign, or output of the demonstration scheduling simulator; never a measurement of a real platform); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/B2-the-frozen-evaluator.md (frozen = human-owned, hash-pinned, versioned; four jobs; integrity table; verdicts); notes/C2-the-scheduling-topic.md (gate per input set, binding definition, held-out workloads); notes/C3-calibration.md (calibration and round-1 table). [calc]: baseline binding = max(visible 0.49, a 0.34, b 0.44); EDF binding = max(visible 0.6, a 0.26, b 0.43). The R1 rows use each record's single 'binding' value.&#10;[I1] harness_margin_cap_scheduling = 0.9 binding ratio. illustrative: design parameter of the harness&#10;[I2] harness_margin_cap_first_campaign = 0.85 binding ratio. illustrative: design parameter of the harness&#10;[I3] topic_visible_seeds = 20 seeds. illustrative: design parameter of the harness&#10;[I4] topic_horizon_s = 5 s. illustrative: design parameter of the harness&#10;[I5] topic_heldout_seeds = 8 seeds per held-out workload. illustrative: design parameter of the harness&#10;[I6] sched_heldout_a = {cpu_cores 3, perception_hz 40} -. illustrative: demonstration run of the local scheduling simulator&#10;[I7] sched_heldout_b_grasp_ms = 200 ms. illustrative: demonstration run of the local scheduling simulator&#10;[I8] topic_soft_miss_limit = 5 %. illustrative: design parameter of the harness&#10;[I9] topic_decision_time_limit_ms = 2 ms. illustrative: design parameter of the harness&#10;[I10] sched_baseline = {median 34.7, min 32.3, max 45.4, binding_visible 0.49, binding_a 0.34, binding_b 0.44} ms / binding. illustrative: demonstration run of the local scheduling simulator&#10;[I11] sched_edf_gpu_first = {median 34.5, min 31.6, max 41.6, binding_visible 0.6, binding_a 0.26, binding_b 0.43} ms / binding. illustrative: demonstration run of the local scheduling simulator&#10;[I12] sched_r1_eft_placement = {median 27.8, min 23.7, max 34.2, binding 0.434} ms / binding. illustrative: demonstration run of the local scheduling simulator&#10;[I13] sched_r1_eft_metric_first = {median 25.8, min 23.7, max 30.7, binding 0.474} ms / binding. illustrative: demonstration run of the local scheduling simulator&#10;[I14] sched_r1_eft_reserve = {median 23.9, min 23.7, max 24.1, binding 0.78} ms / binding. illustrative: demonstration run of the local scheduling simulator&#10;[I15] sched_r1_metric_reserve = {median 30, min 27.9, max 31.2, binding 0.807} ms / binding. illustrative: demonstration run of the local scheduling simulator" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="722" width="1220" height="245" as="geometry" /></mxCell><mxCell id="edge0" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="cand" target="verify"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="verify" target="vis"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="verify" target="hoa"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="verify" target="hob"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="vis" target="gate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge5" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.55;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="hoa" target="gate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="hob" target="gate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge7" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="gate" target="bind"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge8" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="bind" target="verd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="line0" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="422" as="sourcePoint" /><mxPoint x="440" y="606" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line1" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="602" as="sourcePoint" /><mxPoint x="1023.2" y="602" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line2" value="" style="endArrow=none;html=0;strokeColor=#9673a6;strokeWidth=1.5;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="899.0" y="422" as="sourcePoint" /><mxPoint x="899.0" y="602" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line3" value="" style="endArrow=none;html=0;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="926.0" y="422" as="sourcePoint" /><mxPoint x="926.0" y="602" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line4" value="" style="endArrow=none;html=0;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="980.0" y="422" as="sourcePoint" /><mxPoint x="980.0" y="602" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p_03_gate_tested_from_both_sides" name="03-gate-tested-from-both-sides"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="750" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="A gate is tested from both sides: the real baseline must PASS (the gate is not too tight) and every negative control must FAIL (the gate is not too loose)" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="40" as="geometry" /></mxCell><mxCell id="legit_h" value="MUST BE ACCEPTED" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=13;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="330" height="34" as="geometry" /></mxCell><mxCell id="bl" value="THE REAL BASELINE&#10;scheduling topic: accepted at binding 0.49 [I5] on the visible set, clearly below the cap 0.9 [I6]" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="112" width="330" height="74" as="geometry" /></mxCell><mxCell id="noise" value="LEGITIMATE-NOISE REFERENCES&#10;legitimate runs (e.g. reduced precision, another device) that set each limit, per input set (B1)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="196" width="330" height="74" as="geometry" /></mxCell><mxCell id="tight" value="IF ONE IS REJECTED: the gate is too tight.&#10;In the first campaign the first gate rejected the real baseline; found the day the evaluator was built, because the baseline ran before any candidate." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#fff7f7;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="282" width="330" height="92" as="geometry" /></mxCell><mxCell id="gate" value="THE FROZEN GATE (B2)&#10;is finished only when, on EVERY input set, held-out included:&#10;1. the baseline is ACCEPTED with margin clearly below 1&#10;2. every control is REJECTED&#10;&#10;re-run both on every evaluator version" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="150" width="380" height="150" as="geometry" /></mxCell><mxCell id="ctrl_h" value="MUST BE REJECTED (negative controls)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=13;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="920" y="70" width="330" height="34" as="geometry" /></mxCell><mxCell id="c1" value="FIRST CAMPAIGN (diffusion-model policy)&#10;- fewer denoising steps -&gt; correctness gate vs reference&#10;- output scaled by 3 % [I1] -&gt; calibrated per-dimension limits&#10;- cached output -&gt; inputs change per call; 'model ran once'&#10;- perturbation on a second compute core -&gt; correctness gate" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#fff7f7;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="920" y="112" width="330" height="128" as="geometry" /></mxCell><mxCell id="c2" value="SCHEDULING TOPIC&#10;- starve_soft: never runs soft chains -&gt; completion check (logging, telemetry never finish)&#10;- not_ready: returns a job already started -&gt; integrity check&#10;- wallclock: unseeded random tie-break -&gt; order probe (REJECTED at 53.5 ms [I2])" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#fff7f7;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="920" y="250" width="330" height="124" as="geometry" /></mxCell><mxCell id="wrong" value="A CONTROL CAN BE WRONG TOO&#10;The wallclock control first salted its tie-break with the parity of a nanosecond clock. On the development machine that clock had microsecond resolution, so the parity was always even: the control was accidentally deterministic and the order probe could not see it. Fix: an unseeded random generator. Rule: run each control and confirm it fails for the reason it was built for." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="400" width="600" height="92" as="geometry" /></mxCell><mxCell id="hosts" value="DEVELOPMENT HOST vs EVALUATION HOST&#10;- development host: visible set only; its records are INVALID by design (scheduling topic quick mode: 4 seeds [I4]), so a development number is never taken for an official one&#10;- evaluation host: visible + held-out sets, official runs only&#10;- a device lock on each host keeps other work off the device during a timed run" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="650" y="400" width="600" height="92" as="geometry" /></mxCell><mxCell id="popper" value="WHY: a claim is scientific only if some observation could refute it (Popper 1959 [P3]). A gate that has never rejected a plausible cheat makes no claim; the rejected controls are the observations that show it can refute. Most fake results are accidents (a bug that skips work looks like a cheat); controls catch both." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="504" width="1220" height="44" as="geometry" /></mxCell><mxCell id="legend" value="Legend:  green = legitimate runs that must pass  |  red = controls that must fail, and the too-tight failure  |  amber = the frozen gate  |  blue = hosts  |  purple = the principle  |  arrow label = required verdict" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="560" width="1220" height="26" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Every number is loaded from ../constants.json by the key shown. [Pn] = public (cited paper, or my arithmetic on public mathematics); [In] = illustrative (a design parameter of the harness, a round value that keeps the shape of the first campaign, or output of the demonstration scheduling simulator; never a measurement of a real platform); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/B3-negative-controls.md (both control tables, 'a control can be wrong too', development vs evaluation host, device lock, Popper); notes/B2-the-frozen-evaluator.md; notes/B1-reference-and-baseline.md (legitimate-noise references); notes/C3-calibration.md (baseline binding, wallclock control rejected); notes/C4-lessons-about-the-method.md (gates fail both ways). The second-core perturbation's purpose is the notes' reading; the source names the control only.&#10;[I1] c1_control_scale_illustrative = 3 %. illustrative; keeps the shape of the first campaign (internal methodology notes, 2026), not its values&#10;[I2] sched_control_wallclock_ms = 53.5 ms. illustrative: demonstration run of the local scheduling simulator&#10;[P3] pub_popper_year = 1959 year. public: Popper, The Logic of Scientific Discovery, English edition, Hutchinson, 1959&#10;[I4] topic_quick_seeds = 4 seeds. illustrative: design parameter of the harness&#10;[I5] sched_baseline = {median 34.7, min 32.3, max 45.4, binding_visible 0.49, binding_a 0.34, binding_b 0.44} ms / binding. illustrative: demonstration run of the local scheduling simulator&#10;[I6] harness_margin_cap_scheduling = 0.9 binding ratio. illustrative: design parameter of the harness" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="598" width="1220" height="136" as="geometry" /></mxCell><mxCell id="edge0" value="pass" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1" source="bl" target="gate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="pass" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1" source="noise" target="gate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="fail" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="c1" target="gate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="fail" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="c2" target="gate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p_04_one_round_of_the_loop" name="04-one-round-of-the-loop"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="867" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="One round: a read-only planner sets 2 [I1] bounded tasks, 2 [I2] researchers work in parallel, and only the harness's evaluation worker judges, promotes and writes memory" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="40" as="geometry" /></mxCell><mxCell id="plan" value="PLANNER (agent, read-only)&#10;reads champions + lessons + attempts digest; rewrites the lessons; assigns tasks.&#10;May not: modify files, run evaluations, read held-out inputs" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="220" height="140" as="geometry" /></mxCell><mxCell id="tasks" value="TASKS (x 2 [I1])&#10;id, title, parent candidate, hypothesis with numbers from memory, 3-6 steps [I4], success criterion; about 1 hour [I5] each; independent mechanisms" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="290" y="80" width="200" height="140" as="geometry" /></mxCell><mxCell id="resA" value="RESEARCHER A (agent)&#10;builds candidates, diagnostics, appends to the worklog; up to 4 submissions [I3]" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="530" y="70" width="210" height="76" as="geometry" /></mxCell><mxCell id="resB" value="RESEARCHER B (agent, in parallel)&#10;may not edit the evaluator, an existing candidate, the topic config; may not read held-out" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="530" y="156" width="210" height="76" as="geometry" /></mxCell><mxCell id="queue" value="EVALUATION QUEUE&#10;submit blocks until done; one official run at a time" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="780" y="100" width="140" height="90" as="geometry" /></mxCell><mxCell id="work" value="EVALUATION WORKER (harness code, not an agent)&#10;1. paired baseline in the same measurement context, younger than 1440 min [I6]; else run it first&#10;2. re-measure the track's champion if it has no record in this context&#10;3. run the frozen evaluator (diagram 02)&#10;4. apply the promotion policy (diagram 05)&#10;5. write the record and memory" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="960" y="64" width="290" height="176" as="geometry" /></mxCell><mxCell id="lessons" value="SLOW MEMORY: lessons.md&#10;short (about 70 lines [I7]), curated, every lesson cites a run id; rewritten by the planner each round; negative results KEPT ('X did not help (run id); do not repeat without a new idea')" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="300" height="86" as="geometry" /></mxCell><mxCell id="attempts" value="FAST MEMORY: attempts.jsonl&#10;one row per official evaluation, append-only: candidate, parent, agent, verdict, metric, paired baseline, binding, note. Agents see a digest" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="370" y="300" width="270" height="86" as="geometry" /></mxCell><mxCell id="champ" value="champion.json&#10;per track: id, run id, metric, margin, since when, reason, previous champion. Written only by the promotion policy" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="680" y="300" width="250" height="86" as="geometry" /></mxCell><mxCell id="evid" value="evidence/&lt;time&gt;-&lt;candidate&gt;/&#10;one directory per run: record, raw outputs, log. The directory name is the run id: 'cite or it did not happen' (B4)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="970" y="300" width="280" height="86" as="geometry" /></mxCell><mxCell id="caps" value="CAPS AND COST (each agent is told its cap, so it reports before it is killed)&#10;- planner: 30 min [I8], 100 credits [I9]; each researcher: 60 min [I10], 300 credits [I11]&#10;- every tool call and credit is recorded; cost per accepted improvement is a campaign metric; a campaign budget pauses the loop&#10;- check the meter in round one: in the demonstration round the agent tool emitted no usage events, so credits read 0 and only the wall-time cap bounded the agents" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="410" width="560" height="100" as="geometry" /></mxCell><mxCell id="coord" value="COORDINATOR (human-facing agent)&#10;commits, writes the weekly report from the records (B8), raises the decisions the policy cannot take. May not: promote by judgement" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="620" y="410" width="300" height="100" as="geometry" /></mxCell><mxCell id="human" value="HUMAN OWNER&#10;owns the evaluator and the promotion rule; decides e.g. whether a near-tie blocked by the rule should change the rule" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="960" y="410" width="290" height="100" as="geometry" /></mxCell><mxCell id="pair" value="WHY PAIRED: compare within one measurement context (host, boot, evaluator id), as in blocking in experimental design. In the first campaign absolute latency shifted by 10 % [I14] between two hosts of the same type; an unpaired comparison would have swamped real gains. Demonstration round 1: 4 submissions [I12], 13 min [I13] of wall time." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#fff8ee;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="522" width="1220" height="44" as="geometry" /></mxCell><mxCell id="legend" value="Legend:  green = agent sessions  |  amber = harness code that judges  |  blue = files (memory and records)  |  purple = human-facing  |  grey = caps  |  bold arrows = the work path; blue = writes; dashed green = what agents read" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="578" width="1220" height="26" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Every number is loaded from ../constants.json by the key shown. [Pn] = public (cited paper, or my arithmetic on public mathematics); [In] = illustrative (a design parameter of the harness, a round value that keeps the shape of the first campaign, or output of the demonstration scheduling simulator; never a measurement of a real platform); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/B7-agents-and-the-loop.md (roles table, task shape, queue, paired baseline, champion re-measurement, caps, credit-meter caveat, machine-readable endings); notes/B6-the-two-memories.md (attempts log, lessons file, champions); notes/B4-evidence-records.md (one directory per run, run id); notes/B8-reporting.md (coordinator, weekly report, decisions).&#10;[I1] topic_tasks_per_round = 2 tasks. illustrative: configuration of the demonstration topic (design parameter of the harness)&#10;[I2] topic_researchers_parallel = 2 researchers. illustrative: configuration of the demonstration topic (design parameter of the harness)&#10;[I3] topic_submissions_per_researcher = 4 submissions. illustrative: configuration of the demonstration topic (design parameter of the harness)&#10;[I4] harness_plan_steps = 3-6 steps per task. illustrative: design parameter of the harness&#10;[I5] harness_task_hours = 1 hour. illustrative: design parameter of the harness&#10;[I6] topic_baseline_max_age_min = 1440 min. illustrative: configuration of the demonstration topic (design parameter of the harness)&#10;[I7] harness_lessons_max_lines = 70 lines. illustrative: design parameter of the harness&#10;[I8] topic_planner_wall_min = 30 min. illustrative: configuration of the demonstration topic (design parameter of the harness)&#10;[I9] topic_planner_credits = 100 credits. illustrative: configuration of the demonstration topic (design parameter of the harness)&#10;[I10] topic_researcher_wall_min = 60 min. illustrative: configuration of the demonstration topic (design parameter of the harness)&#10;[I11] topic_researcher_credits = 300 credits. illustrative: configuration of the demonstration topic (design parameter of the harness)&#10;[I12] sched_r1_submissions = 4 submissions. illustrative: demonstration run of the local scheduling simulator&#10;[I13] sched_r1_wall_min = 13 min. illustrative: demonstration run of the local scheduling simulator&#10;[I14] c1_host_shift_illustrative = 10 %. illustrative; keeps the shape of the first campaign (internal methodology notes, 2026), not its values" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="618" width="1220" height="233" as="geometry" /></mxCell><mxCell id="edge0" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="plan" target="tasks"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="tasks" target="resA"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="tasks" target="resB"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="submit" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="resA" target="queue"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="resB" target="queue"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge5" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.47;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="queue" target="work"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="work" target="evid"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge7" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="work" target="champ"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1018" y="270" /><mxPoint x="855" y="270" /></Array></mxGeometry></mxCell><mxCell id="edge8" value="write" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="work" target="attempts"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="989" y="260" /><mxPoint x="559" y="260" /></Array></mxGeometry></mxCell><mxCell id="edge9" value="digest" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=0.15;exitY=0;exitDx=0;exitDy=0;entryX=0.85;entryY=1;entryDx=0;entryDy=0;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1" source="attempts" target="plan"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="410" y="240" /><mxPoint x="217" y="240" /></Array></mxGeometry></mxCell><mxCell id="edge10" value="rewrite + read" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1" source="plan" target="lessons"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge11" value="decisions, asks" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" parent="1" source="coord" target="human"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge12" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="champ" target="coord"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p_05_promotion_by_disjoint_ranges" name="05-promotion-by-disjoint-ranges"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="857" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="A new champion must beat the old one on EVERY seed, not on average: a median rule promotes a no-change candidate with probability 0.5 [P1], the range rule with about 7.3e-12 [P2]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="40" as="geometry" /></mxCell><mxCell id="ch_h" value="Range of the per-seed p95 end-to-end latency of the perception chain (min to max over 20 seeds [I3]; tick = median), lower is better. Demonstration run of the local scheduling simulator: illustrative, not a real platform." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="63" width="1000" height="44" as="geometry" /></mxCell><mxCell id="l0" value="baseline (paired): champion before round 1 [I7]&#10;median 34.7 (32.3-45.4) ms; champion before" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="116" width="395" height="34" as="geometry" /></mxCell><mxCell id="b0" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="680" y="125" width="266" height="16" as="geometry" /></mxCell><mxCell id="l1" value="calibration: EDF, same placement [I8]&#10;median 34.5 (31.6-41.6) ms; accepted; ranges overlap" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="162" width="395" height="34" as="geometry" /></mxCell><mxCell id="b1" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="666" y="171" width="203" height="16" as="geometry" /></mxCell><mxCell id="l2" value="R1: earliest-finish placement [I9]&#10;median 27.8 (23.7-34.2) ms; accepted; range overlaps the baseline's" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="208" width="395" height="34" as="geometry" /></mxCell><mxCell id="b2" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="505" y="217" width="213" height="16" as="geometry" /></mxCell><mxCell id="l3" value="R1: earliest-finish + perception-first [I10]&#10;median 25.8 (23.7-30.7) ms; PROMOTED" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="254" width="395" height="34" as="geometry" /></mxCell><mxCell id="b3" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="505" y="263" width="142" height="16" as="geometry" /></mxCell><mxCell id="l4" value="R1: baseline placement + GPU reservation [I11]&#10;median 30.0 (27.9-31.2) ms; accepted; not promotable" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="395" height="34" as="geometry" /></mxCell><mxCell id="b4" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="590" y="309" width="67" height="16" as="geometry" /></mxCell><mxCell id="l5" value="R1: earliest-finish + reservation [I12]&#10;median 23.9 (23.7-24.1) ms; accepted; not promotable" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="346" width="395" height="34" as="geometry" /></mxCell><mxCell id="b5" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="505" y="355" width="8" height="16" as="geometry" /></mxCell><mxCell id="t20" value="20" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="415" y="398" width="30" height="16" as="geometry" /></mxCell><mxCell id="t24" value="24" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="496" y="398" width="30" height="16" as="geometry" /></mxCell><mxCell id="t28" value="28" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="577" y="398" width="30" height="16" as="geometry" /></mxCell><mxCell id="t32" value="32" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="659" y="398" width="30" height="16" as="geometry" /></mxCell><mxCell id="t36" value="36" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="740" y="398" width="30" height="16" as="geometry" /></mxCell><mxCell id="t40" value="40" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="822" y="398" width="30" height="16" as="geometry" /></mxCell><mxCell id="t44" value="44" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="903" y="398" width="30" height="16" as="geometry" /></mxCell><mxCell id="t48" value="48" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="985" y="398" width="30" height="16" as="geometry" /></mxCell><mxCell id="ax" value="ms (scale is linear)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="430" y="414" width="570" height="16" as="geometry" /></mxCell><mxCell id="fl" value="work floor 22.5 ms [I5]:&#10;no scheduler beats it" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=right;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="330" y="432" width="148" height="46" as="geometry" /></mxCell><mxCell id="chb" value="new champion's BEST seed 23.7 ms: already near the floor plus jitter" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#4d7a3d;" vertex="1" parent="1"><mxGeometry x="509" y="432" width="170" height="46" as="geometry" /></mxCell><mxCell id="blb" value="baseline's BEST seed 32.3 ms: the promoted candidate's WORST seed 30.7 ms is below it" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="684" y="432" width="240" height="46" as="geometry" /></mxCell><mxCell id="rule" value="THE PROMOTION POLICY (mechanical)&#10;1. verdict ACCEPTED&#10;2. binding &lt;= 0.9 [I6], else 'accepted, low margin'&#10;3. lower-is-better: the candidate's WORST sample beats the champion's BEST sample, same measurement context&#10;samples: 20 seeds [I3] here; 20 timed calls [I4] in the first campaign" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1030" y="62" width="220" height="140" as="geometry" /></mxCell><mxCell id="null" value="WHY NOT MEDIANS&#10;If the candidate is no better, both give 20 i.i.d. samples of one distribution:&#10;- median lower with probability 0.5 [P1]&#10;- all 20 below all 20 with probability 1 / C(40, 20) = 7.25e-12 [P2]&#10;Price: power. A real gain smaller than the sample spread is never promoted." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1030" y="214" width="220" height="140" as="geometry" /></mxCell><mxCell id="floorcase" value="THE RULE MEETS THE FLOOR. Earliest-finish + reservation has a better median (23.9 vs 25.8 ms) and a far better worst seed (24.1 vs 30.7 ms) than the new champion, yet it cannot be promoted: its worst seed must beat 23.7 ms, which sits 1.2 ms [calc] above the 22.5 ms floor. The researcher raised it as a decision (promote by median and maximum together, or by a paired per-seed comparison); the coordinator recorded it and did NOT change the rule: changing it is a human decision." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#f7f0fa;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="490" width="1220" height="62" as="geometry" /></mxCell><mxCell id="legend" value="Legend:  bar = min-max range over seeds, black tick = median  |  green thick bar = promoted  |  grey = baseline champion  |  dashed purple = baseline's best seed  |  dashed green = new champion's best seed  |  red = work floor. Which champion each 'not promotable' row was compared with follows the round-1 table in note C3; the notes do not give the evaluation order." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="565" width="1220" height="40" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Every number is loaded from ../constants.json by the key shown. [Pn] = public (cited paper, or my arithmetic on public mathematics); [In] = illustrative (a design parameter of the harness, a round value that keeps the shape of the first campaign, or output of the demonstration scheduling simulator; never a measurement of a real platform); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/B7-agents-and-the-loop.md (promotion policy, disjoint-range rule, null probabilities, price in power); notes/C3-calibration.md (calibration result, round-1 table, 'the rule meets the floor'); notes/C2-the-scheduling-topic.md (metric). [calc]: 1.2 = 23.7 - 22.5.&#10;[P1] pub_median_null_probability = 0.5 probability. public: my arithmetic: under the same no-difference assumption, the candidate's median is below the champion's median with probability 1/2 (symmetry)&#10;[P2] pub_disjoint_null_probability_20v20 = 7.25e-12 probability. public: my arithmetic: if candidate and champion samples are 20 i.i.d. draws each from one continuous distribution, every ordering of the 40 values is equally likely, so P(all 20 candidate values below all 20 champion values) = 1 / C(40,20) = 1 / 137 846 528 820&#10;[I3] topic_visible_seeds = 20 seeds. illustrative: design parameter of the harness&#10;[I4] harness_timed_calls = 20 timed calls per run. illustrative: design parameter of the harness&#10;[I5] sched_work_floor_ms = 22.5 ms. illustrative: demonstration run of the local scheduling simulator&#10;[I6] harness_margin_cap_scheduling = 0.9 binding ratio. illustrative: design parameter of the harness&#10;[I7] sched_baseline = {median 34.7, min 32.3, max 45.4, binding_visible 0.49, binding_a 0.34, binding_b 0.44} ms / binding. illustrative: demonstration run of the local scheduling simulator&#10;[I8] sched_edf_gpu_first = {median 34.5, min 31.6, max 41.6, binding_visible 0.6, binding_a 0.26, binding_b 0.43} ms / binding. illustrative: demonstration run of the local scheduling simulator&#10;[I9] sched_r1_eft_placement = {median 27.8, min 23.7, max 34.2, binding 0.434} ms / binding. illustrative: demonstration run of the local scheduling simulator&#10;[I10] sched_r1_eft_metric_first = {median 25.8, min 23.7, max 30.7, binding 0.474} ms / binding. illustrative: demonstration run of the local scheduling simulator&#10;[I11] sched_r1_metric_reserve = {median 30, min 27.9, max 31.2, binding 0.807} ms / binding. illustrative: demonstration run of the local scheduling simulator&#10;[I12] sched_r1_eft_reserve = {median 23.9, min 23.7, max 24.1, binding 0.78} ms / binding. illustrative: demonstration run of the local scheduling simulator" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="618" width="1220" height="221" as="geometry" /></mxCell><mxCell id="line0" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=2.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="729.25" y="120" as="sourcePoint" /><mxPoint x="729.25" y="146" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line1" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=2.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="725.1785714285714" y="166" as="sourcePoint" /><mxPoint x="725.1785714285714" y="192" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line2" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=2.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="588.7857142857142" y="212" as="sourcePoint" /><mxPoint x="588.7857142857142" y="238" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line3" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=2.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="548.0714285714286" y="258" as="sourcePoint" /><mxPoint x="548.0714285714286" y="284" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line4" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=2.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="633.5714285714286" y="304" as="sourcePoint" /><mxPoint x="633.5714285714286" y="330" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line5" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=2.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="509.3928571428571" y="350" as="sourcePoint" /><mxPoint x="509.3928571428571" y="376" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line6" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="430" y="392" as="sourcePoint" /><mxPoint x="1000" y="392" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line7" value="" style="endArrow=none;html=0;strokeColor=#9673a6;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680.3928571428571" y="112" as="sourcePoint" /><mxPoint x="680.3928571428571" y="392" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line8" value="" style="endArrow=none;html=0;strokeColor=#82b366;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="505.32142857142856" y="112" as="sourcePoint" /><mxPoint x="505.32142857142856" y="392" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line9" value="" style="endArrow=none;html=0;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480.89285714285717" y="112" as="sourcePoint" /><mxPoint x="480.89285714285717" y="392" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line10" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="430.0" y="392" as="sourcePoint" /><mxPoint x="430.0" y="397" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line11" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="511.42857142857144" y="392" as="sourcePoint" /><mxPoint x="511.42857142857144" y="397" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line12" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="592.8571428571429" y="392" as="sourcePoint" /><mxPoint x="592.8571428571429" y="397" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line13" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="674.2857142857142" y="392" as="sourcePoint" /><mxPoint x="674.2857142857142" y="397" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line14" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="755.7142857142858" y="392" as="sourcePoint" /><mxPoint x="755.7142857142858" y="397" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line15" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="837.1428571428571" y="392" as="sourcePoint" /><mxPoint x="837.1428571428571" y="397" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line16" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="918.5714285714286" y="392" as="sourcePoint" /><mxPoint x="918.5714285714286" y="397" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line17" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1000.0" y="392" as="sourcePoint" /><mxPoint x="1000.0" y="397" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p_06_calibration_something_to_find" name="06-calibration-something-to-find"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1006" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Calibration: on the first workload EDF came within 1.1 ms [calc] of the work floor, so the owner densified it until placement (GPU 91 % [I11], DLA 0 % [I12]) became the lever" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="40" as="geometry" /></mxCell><mxCell id="h30" value="FIRST VISIBLE WORKLOAD (superseded)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=13;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="66" width="590" height="36" as="geometry" /></mxCell><mxCell id="lh30" value="perception-chain metric, ms, as reported in note C3; densified rows are medians over seeds (8 px per ms)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="108" width="590" height="18" as="geometry" /></mxCell><mxCell id="ll30_0" value="FIFO baseline [I1] (binding 0.66 [I2])" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="130" width="212" height="26" as="geometry" /></mxCell><mxCell id="lb30_0" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="250" y="134" width="233" height="18" as="geometry" /></mxCell><mxCell id="lv30_0" value="29.2 ms" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="487" y="130" width="120" height="26" as="geometry" /></mxCell><mxCell id="ll30_1" value="EDF, GPU first [I3]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="160" width="212" height="26" as="geometry" /></mxCell><mxCell id="lb30_1" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="250" y="164" width="132" height="18" as="geometry" /></mxCell><mxCell id="lv30_1" value="16.6 ms" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="386" y="160" width="120" height="26" as="geometry" /></mxCell><mxCell id="ll30_2" value="work floor [I4]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="190" width="212" height="26" as="geometry" /></mxCell><mxCell id="lb30_2" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="250" y="194" width="124" height="18" as="geometry" /></mxCell><mxCell id="lv30_2" value="15.5 ms" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="378" y="190" width="120" height="26" as="geometry" /></mxCell><mxCell id="uh30" value="utilization, % (bars to scale, 100 % = 300 px)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="226" width="590" height="18" as="geometry" /></mxCell><mxCell id="ul30_0" value="CPU [I5]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="248" width="212" height="24" as="geometry" /></mxCell><mxCell id="ub30_0" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="250" y="252" width="300" height="16" as="geometry" /></mxCell><mxCell id="uf30_0" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="250" y="252" width="72" height="16" as="geometry" /></mxCell><mxCell id="uv30_0" value="24 %" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="554" y="248" width="100" height="24" as="geometry" /></mxCell><mxCell id="ul30_1" value="GPU [I5]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="274" width="212" height="24" as="geometry" /></mxCell><mxCell id="ub30_1" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="250" y="278" width="300" height="16" as="geometry" /></mxCell><mxCell id="uf30_1" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=