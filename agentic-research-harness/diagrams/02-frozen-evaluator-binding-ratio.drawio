<mxfile host="app.diagrams.net"><diagram id="p_02_frozen_evaluator_binding_ratio" name="02-frozen-evaluator-binding-ratio"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="985" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="The evaluator reports how close a candidate came to failing: binding ratio = largest measured / limit; below 1 passes, promotion needs at most 0.9 [I1]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="40" as="geometry" /></mxCell><mxCell id="cand" value="CANDIDATE&#10;candidates/&lt;id&gt;/&#10;one idea, parent-linked, never modified (B5)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="31" y="121" width="150" height="100" as="geometry" /></mxCell><mxCell id="verify" value="VERIFY&#10;frozen tree hash = manifest?&#10;if not: refuse to evaluate&#10;(human-owned, versioned)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="210" y="120" width="160" height="100" as="geometry" /></mxCell><mxCell id="vis" value="VISIBLE set&#10;20 seeds [I3] x 5 s [I4]; agents may read it" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="405" y="70" width="210" height="60" as="geometry" /></mxCell><mxCell id="hoa" value="HELD-OUT a: 3 cores, perception 40 Hz [I6]; 8 seeds [I5]" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#fff7f7;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="405" y="140" width="210" height="60" as="geometry" /></mxCell><mxCell id="hob" value="HELD-OUT b: another robot, 200 ms GPU grasp planner [I7], no DLA; 8 seeds [I5]" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#fff7f7;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="405" y="210" width="210" height="60" as="geometry" /></mxCell><mxCell id="gate" value="GATE, per input set (limit -&gt; ratio)&#10;- every chain instance due completes&#10;- hard chains: 0 deadline misses; worst e2e / deadline&#10;- soft chains: misses &lt;= 5 % [I8]; p99 e2e / deadline, miss ratio / limit&#10;- mean decision time &lt; 2 ms [I9]; time / limit&#10;- order probe: reversed seeds give identical results&#10;- only ready jobs, allowed resources" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="650" y="70" width="260" height="200" as="geometry" /></mxCell><mxCell id="bind" value="BINDING RATIO&#10;= the LARGEST measured / limit over every check and every input set&#10;(also called the margin)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="940" y="100" width="140" height="140" as="geometry" /></mxCell><mxCell id="verd" value="VERDICT&#10;ACCEPTED: all checks pass (binding below 1)&#10;REJECTED: a check fails&#10;INVALID: cannot count by design (e.g. a quick development run)&#10;&#10;promotable only if binding &lt;= 0.9 [I1]" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1110" y="70" width="140" height="200" as="geometry" /></mxCell><mxCell id="integ" value="INTEGRITY CHECKS (each closes one way a fast result can be fake):  model ran exactly once per call (no skipping or caching)  |  fixed noise consumed exactly once  |  output came from the device (no silent host fall-back)  |  order probe (no carried state)  |  provenance hashes of every file read  |  candidate tree hash before = after the run" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#fff8ee;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="293" width="1220" height="64" as="geometry" /></mxCell><mxCell id="ch_h" value="BINDING RATIOS OF THE DEMONSTRATION RUN on one scale (illustrative output of the local scheduling simulator, not a real platform). Bars are to scale; zones are set by the margin cap and the pass limit." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="382" width="1220" height="34" as="geometry" /></mxCell><mxCell id="z_ok" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#f1f8ef;strokeColor=#82b366;strokeWidth=0;" vertex="1" parent="1"><mxGeometry x="440" y="422" width="486" height="180" as="geometry" /></mxCell><mxCell id="z_low" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#fff3e0;strokeColor=#d79b00;strokeWidth=0;" vertex="1" parent="1"><mxGeometry x="926" y="422" width="54" height="180" as="geometry" /></mxCell><mxCell id="z_bad" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#fdecec;strokeColor=#b85450;strokeWidth=0;" vertex="1" parent="1"><mxGeometry x="980" y="422" width="43" height="180" as="geometry" /></mxCell><mxCell id="r0_l" value="baseline (calibration) [I10]:  0.49  accepted [calc]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="425" width="400" height="24" as="geometry" /></mxCell><mxCell id="r0_b" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="440" y="428" width="264" height="18" as="geometry" /></mxCell><mxCell id="r1_l" value="EDF, same placement [I11]:  0.6  accepted [calc]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="455" width="400" height="24" as="geometry" /></mxCell><mxCell id="r1_b" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="440" y="458" width="324" height="18" as="geometry" /></mxCell><mxCell id="r2_l" value="R1 earliest-finish placement [I12]:  0.434  accepted" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="485" width="400" height="24" as="geometry" /></mxCell><mxCell id="r2_b" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="440" y="488" width="234" height="18" as="geometry" /></mxCell><mxCell id="r3_l" value="R1 + perception-first dispatch [I13]:  0.474  promoted" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="515" width="400" height="24" as="geometry" /></mxCell><mxCell id="r3_b" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="440" y="518" width="255" height="18" as="geometry" /></mxCell><mxCell id="r4_l" value="R1 earliest-finish + reservation [I14]:  0.78  accepted, not promotable" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="545" width="400" height="24" as="geometry" /></mxCell><mxCell id="r4_b" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="440" y="548" width="421" height="18" as="geometry" /></mxCell><mxCell id="r5_l" value="R1 baseline placement + reservation [I15]:  0.807  accepted, not promotable" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="575" width="400" height="24" as="geometry" /></mxCell><mxCell id="r5_b" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="440" y="578" width="435" height="18" as="geometry" /></mxCell><mxCell id="tk0" value="0" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="420" y="606" width="40" height="18" as="geometry" /></mxCell><mxCell id="tk0.5" value="0.5" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="690" y="606" width="40" height="18" as="geometry" /></mxCell><mxCell id="tk_cap1" value="0.85 [I2]&#10;first-campaign cap" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="775" y="606" width="120" height="32" as="geometry" /></mxCell><mxCell id="tk_cap" value="0.9 [I1]&#10;cap here" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="922" y="606" width="80" height="32" as="geometry" /></mxCell><mxCell id="tk_one" value="1.0 = a limit reached&#10;-&gt; REJECTED" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="984" y="606" width="150" height="32" as="geometry" /></mxCell><mxCell id="zl_ok" value="promotable zone (if the range rule also holds, diagram 04)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#4d7a3d;" vertex="1" parent="1"><mxGeometry x="444" y="642" width="486" height="18" as="geometry" /></mxCell><mxCell id="why" value="WHY A MARGIN AND NOT JUST A PASS&#10;A pass close to 1 means the next small change breaks it, or the candidate exploits the edge of a limit: such a run is 'accepted, low margin' and never promoted.&#10;Limits come from legitimate runs (B1), not a guess: a limit tighter than legitimate noise rejects correct work." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1070" y="418" width="180" height="182" as="geometry" /></mxCell><mxCell id="legend" value="Legend:  amber = the frozen judge  |  blue = inputs agents may read / candidate files  |  pale red = held-out inputs agents never read  |  chart: bar = binding ratio (green, thick = promoted); purple dashed = first-campaign cap; amber = cap in the scheduling topic; red = pass limit 1.0" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="668" width="1220" height="40" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Every number is loaded from ../constants.json by the key shown. [Pn] = public (cited paper, or my arithmetic on public mathematics); [In] = illustrative (a design parameter of the harness, a round value that keeps the shape of the first campaign, or output of the demonstration scheduling simulator; never a measurement of a real platform); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/B2-the-frozen-evaluator.md (frozen = human-owned, hash-pinned, versioned; four jobs; integrity table; verdicts); notes/C2-the-scheduling-topic.md (gate per input set, binding definition, held-out workloads); notes/C3-calibration.md (calibration and round-1 table). [calc]: baseline binding = max(visible 0.49, a 0.34, b 0.44); EDF binding = max(visible 0.6, a 0.26, b 0.43). The R1 rows use each record's single 'binding' value.&#10;[I1] harness_margin_cap_scheduling = 0.9 binding ratio. illustrative: design parameter of the harness&#10;[I2] harness_margin_cap_first_campaign = 0.85 binding ratio. illustrative: design parameter of the harness&#10;[I3] topic_visible_seeds = 20 seeds. illustrative: design parameter of the harness&#10;[I4] topic_horizon_s = 5 s. illustrative: design parameter of the harness&#10;[I5] topic_heldout_seeds = 8 seeds per held-out workload. illustrative: design parameter of the harness&#10;[I6] sched_heldout_a = {cpu_cores 3, perception_hz 40} -. illustrative: demonstration run of the local scheduling simulator&#10;[I7] sched_heldout_b_grasp_ms = 200 ms. illustrative: demonstration run of the local scheduling simulator&#10;[I8] topic_soft_miss_limit = 5 %. illustrative: design parameter of the harness&#10;[I9] topic_decision_time_limit_ms = 2 ms. illustrative: design parameter of the harness&#10;[I10] sched_baseline = {median 34.7, min 32.3, max 45.4, binding_visible 0.49, binding_a 0.34, binding_b 0.44} ms / binding. illustrative: demonstration run of the local scheduling simulator&#10;[I11] sched_edf_gpu_first = {median 34.5, min 31.6, max 41.6, binding_visible 0.6, binding_a 0.26, binding_b 0.43} ms / binding. illustrative: demonstration run of the local scheduling simulator&#10;[I12] sched_r1_eft_placement = {median 27.8, min 23.7, max 34.2, binding 0.434} ms / binding. illustrative: demonstration run of the local scheduling simulator&#10;[I13] sched_r1_eft_metric_first = {median 25.8, min 23.7, max 30.7, binding 0.474} ms / binding. illustrative: demonstration run of the local scheduling simulator&#10;[I14] sched_r1_eft_reserve = {median 23.9, min 23.7, max 24.1, binding 0.78} ms / binding. illustrative: demonstration run of the local scheduling simulator&#10;[I15] sched_r1_metric_reserve = {median 30, min 27.9, max 31.2, binding 0.807} ms / binding. illustrative: demonstration run of the local scheduling simulator" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="722" width="1220" height="245" as="geometry" /></mxCell><mxCell id="edge0" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="cand" target="verify"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="verify" target="vis"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="verify" target="hoa"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="verify" target="hob"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="vis" target="gate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge5" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.55;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="hoa" target="gate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="hob" target="gate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge7" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="gate" target="bind"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge8" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="bind" target="verd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="line0" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="422" as="sourcePoint" /><mxPoint x="440" y="606" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line1" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="440" y="602" as="sourcePoint" /><mxPoint x="1023.2" y="602" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line2" value="" style="endArrow=none;html=0;strokeColor=#9673a6;strokeWidth=1.5;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="899.0" y="422" as="sourcePoint" /><mxPoint x="899.0" y="602" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line3" value="" style="endArrow=none;html=0;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="926.0" y="422" as="sourcePoint" /><mxPoint x="926.0" y="602" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line4" value="" style="endArrow=none;html=0;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="980.0" y="422" as="sourcePoint" /><mxPoint x="980.0" y="602" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>