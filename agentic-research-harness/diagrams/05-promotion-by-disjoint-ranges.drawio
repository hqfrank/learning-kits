<mxfile host="app.diagrams.net"><diagram id="p_05_promotion_by_disjoint_ranges" name="05-promotion-by-disjoint-ranges"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="857" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="A new champion must beat the old one on EVERY seed, not on average: a median rule promotes a no-change candidate with probability 0.5 [P1], the range rule with about 7.3e-12 [P2]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="40" as="geometry" /></mxCell><mxCell id="ch_h" value="Range of the per-seed p95 end-to-end latency of the perception chain (min to max over 20 seeds [I3]; tick = median), lower is better. Demonstration run of the local scheduling simulator: illustrative, not a real platform." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="63" width="1000" height="44" as="geometry" /></mxCell><mxCell id="l0" value="baseline (paired): champion before round 1 [I7]&#10;median 34.7 (32.3-45.4) ms; champion before" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="116" width="395" height="34" as="geometry" /></mxCell><mxCell id="b0" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="680" y="125" width="266" height="16" as="geometry" /></mxCell><mxCell id="l1" value="calibration: EDF, same placement [I8]&#10;median 34.5 (31.6-41.6) ms; accepted; ranges overlap" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="162" width="395" height="34" as="geometry" /></mxCell><mxCell id="b1" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="666" y="171" width="203" height="16" as="geometry" /></mxCell><mxCell id="l2" value="R1: earliest-finish placement [I9]&#10;median 27.8 (23.7-34.2) ms; accepted; range overlaps the baseline's" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="208" width="395" height="34" as="geometry" /></mxCell><mxCell id="b2" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="505" y="217" width="213" height="16" as="geometry" /></mxCell><mxCell id="l3" value="R1: earliest-finish + perception-first [I10]&#10;median 25.8 (23.7-30.7) ms; PROMOTED" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="254" width="395" height="34" as="geometry" /></mxCell><mxCell id="b3" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2.5;" vertex="1" parent="1"><mxGeometry x="505" y="263" width="142" height="16" as="geometry" /></mxCell><mxCell id="l4" value="R1: baseline placement + GPU reservation [I11]&#10;median 30.0 (27.9-31.2) ms; accepted; not promotable" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="395" height="34" as="geometry" /></mxCell><mxCell id="b4" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="590" y="309" width="67" height="16" as="geometry" /></mxCell><mxCell id="l5" value="R1: earliest-finish + reservation [I12]&#10;median 23.9 (23.7-24.1) ms; accepted; not promotable" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="346" width="395" height="34" as="geometry" /></mxCell><mxCell id="b5" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="505" y="355" width="8" height="16" as="geometry" /></mxCell><mxCell id="t20" value="20" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="415" y="398" width="30" height="16" as="geometry" /></mxCell><mxCell id="t24" value="24" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="496" y="398" width="30" height="16" as="geometry" /></mxCell><mxCell id="t28" value="28" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="577" y="398" width="30" height="16" as="geometry" /></mxCell><mxCell id="t32" value="32" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="659" y="398" width="30" height="16" as="geometry" /></mxCell><mxCell id="t36" value="36" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="740" y="398" width="30" height="16" as="geometry" /></mxCell><mxCell id="t40" value="40" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="822" y="398" width="30" height="16" as="geometry" /></mxCell><mxCell id="t44" value="44" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="903" y="398" width="30" height="16" as="geometry" /></mxCell><mxCell id="t48" value="48" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="985" y="398" width="30" height="16" as="geometry" /></mxCell><mxCell id="ax" value="ms (scale is linear)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="430" y="414" width="570" height="16" as="geometry" /></mxCell><mxCell id="fl" value="work floor 22.5 ms [I5]:&#10;no scheduler beats it" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=right;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="330" y="432" width="148" height="46" as="geometry" /></mxCell><mxCell id="chb" value="new champion's BEST seed 23.7 ms: already near the floor plus jitter" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#4d7a3d;" vertex="1" parent="1"><mxGeometry x="509" y="432" width="170" height="46" as="geometry" /></mxCell><mxCell id="blb" value="baseline's BEST seed 32.3 ms: the promoted candidate's WORST seed 30.7 ms is below it" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="684" y="432" width="240" height="46" as="geometry" /></mxCell><mxCell id="rule" value="THE PROMOTION POLICY (mechanical)&#10;1. verdict ACCEPTED&#10;2. binding &lt;= 0.9 [I6], else 'accepted, low margin'&#10;3. lower-is-better: the candidate's WORST sample beats the champion's BEST sample, same measurement context&#10;samples: 20 seeds [I3] here; 20 timed calls [I4] in the first campaign" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1030" y="62" width="220" height="140" as="geometry" /></mxCell><mxCell id="null" value="WHY NOT MEDIANS&#10;If the candidate is no better, both give 20 i.i.d. samples of one distribution:&#10;- median lower with probability 0.5 [P1]&#10;- all 20 below all 20 with probability 1 / C(40, 20) = 7.25e-12 [P2]&#10;Price: power. A real gain smaller than the sample spread is never promoted." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1030" y="214" width="220" height="140" as="geometry" /></mxCell><mxCell id="floorcase" value="THE RULE MEETS THE FLOOR. Earliest-finish + reservation has a better median (23.9 vs 25.8 ms) and a far better worst seed (24.1 vs 30.7 ms) than the new champion, yet it cannot be promoted: its worst seed must beat 23.7 ms, which sits 1.2 ms [calc] above the 22.5 ms floor. The researcher raised it as a decision (promote by median and maximum together, or by a paired per-seed comparison); the coordinator recorded it and did NOT change the rule: changing it is a human decision." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#f7f0fa;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="490" width="1220" height="62" as="geometry" /></mxCell><mxCell id="legend" value="Legend:  bar = min-max range over seeds, black tick = median  |  green thick bar = promoted  |  grey = baseline champion  |  dashed purple = baseline's best seed  |  dashed green = new champion's best seed  |  red = work floor. Which champion each 'not promotable' row was compared with follows the round-1 table in note C3; the notes do not give the evaluation order." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="565" width="1220" height="40" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Every number is loaded from ../constants.json by the key shown. [Pn] = public (cited paper, or my arithmetic on public mathematics); [In] = illustrative (a design parameter of the harness, a round value that keeps the shape of the first campaign, or output of the demonstration scheduling simulator; never a measurement of a real platform); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/B7-agents-and-the-loop.md (promotion policy, disjoint-range rule, null probabilities, price in power); notes/C3-calibration.md (calibration result, round-1 table, 'the rule meets the floor'); notes/C2-the-scheduling-topic.md (metric). [calc]: 1.2 = 23.7 - 22.5.&#10;[P1] pub_median_null_probability = 0.5 probability. public: my arithmetic: under the same no-difference assumption, the candidate's median is below the champion's median with probability 1/2 (symmetry)&#10;[P2] pub_disjoint_null_probability_20v20 = 7.25e-12 probability. public: my arithmetic: if candidate and champion samples are 20 i.i.d. draws each from one continuous distribution, every ordering of the 40 values is equally likely, so P(all 20 candidate values below all 20 champion values) = 1 / C(40,20) = 1 / 137 846 528 820&#10;[I3] topic_visible_seeds = 20 seeds. illustrative: design parameter of the harness&#10;[I4] harness_timed_calls = 20 timed calls per run. illustrative: design parameter of the harness&#10;[I5] sched_work_floor_ms = 22.5 ms. illustrative: demonstration run of the local scheduling simulator&#10;[I6] harness_margin_cap_scheduling = 0.9 binding ratio. illustrative: design parameter of the harness&#10;[I7] sched_baseline = {median 34.7, min 32.3, max 45.4, binding_visible 0.49, binding_a 0.34, binding_b 0.44} ms / binding. illustrative: demonstration run of the local scheduling simulator&#10;[I8] sched_edf_gpu_first = {median 34.5, min 31.6, max 41.6, binding_visible 0.6, binding_a 0.26, binding_b 0.43} ms / binding. illustrative: demonstration run of the local scheduling simulator&#10;[I9] sched_r1_eft_placement = {median 27.8, min 23.7, max 34.2, binding 0.434} ms / binding. illustrative: demonstration run of the local scheduling simulator&#10;[I10] sched_r1_eft_metric_first = {median 25.8, min 23.7, max 30.7, binding 0.474} ms / binding. illustrative: demonstration run of the local scheduling simulator&#10;[I11] sched_r1_metric_reserve = {median 30, min 27.9, max 31.2, binding 0.807} ms / binding. illustrative: demonstration run of the local scheduling simulator&#10;[I12] sched_r1_eft_reserve = {median 23.9, min 23.7, max 24.1, binding 0.78} ms / binding. illustrative: demonstration run of the local scheduling simulator" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="618" width="1220" height="221" as="geometry" /></mxCell><mxCell id="line0" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=2.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="729.25" y="120" as="sourcePoint" /><mxPoint x="729.25" y="146" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line1" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=2.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="725.1785714285714" y="166" as="sourcePoint" /><mxPoint x="725.1785714285714" y="192" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line2" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=2.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="588.7857142857142" y="212" as="sourcePoint" /><mxPoint x="588.7857142857142" y="238" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line3" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=2.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="548.0714285714286" y="258" as="sourcePoint" /><mxPoint x="548.0714285714286" y="284" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line4" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=2.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="633.5714285714286" y="304" as="sourcePoint" /><mxPoint x="633.5714285714286" y="330" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line5" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=2.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="509.3928571428571" y="350" as="sourcePoint" /><mxPoint x="509.3928571428571" y="376" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line6" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="430" y="392" as="sourcePoint" /><mxPoint x="1000" y="392" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line7" value="" style="endArrow=none;html=0;strokeColor=#9673a6;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680.3928571428571" y="112" as="sourcePoint" /><mxPoint x="680.392857