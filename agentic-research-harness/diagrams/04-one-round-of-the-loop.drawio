<mxfile host="app.diagrams.net"><diagram id="p_04_one_round_of_the_loop" name="04-one-round-of-the-loop"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="867" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="One round: a read-only planner sets 2 [I1] bounded tasks, 2 [I2] researchers work in parallel, and only the harness's evaluation worker judges, promotes and writes memory" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="40" as="geometry" /></mxCell><mxCell id="plan" value="PLANNER (agent, read-only)&#10;reads champions + lessons + attempts digest; rewrites the lessons; assigns tasks.&#10;May not: modify files, run evaluations, read held-out inputs" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="220" height="140" as="geometry" /></mxCell><mxCell id="tasks" value="TASKS (x 2 [I1])&#10;id, title, parent candidate, hypothesis with numbers from memory, 3-6 steps [I4], success criterion; about 1 hour [I5] each; independent mechanisms" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="290" y="80" width="200" height="140" as="geometry" /></mxCell><mxCell id="resA" value="RESEARCHER A (agent)&#10;builds candidates, diagnostics, appends to the worklog; up to 4 submissions [I3]" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="530" y="70" width="210" height="76" as="geometry" /></mxCell><mxCell id="resB" value="RESEARCHER B (agent, in parallel)&#10;may not edit the evaluator, an existing candidate, the topic config; may not read held-out" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="530" y="156" width="210" height="76" as="geometry" /></mxCell><mxCell id="queue" value="EVALUATION QUEUE&#10;submit blocks until done; one official run at a time" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="780" y="100" width="140" height="90" as="geometry" /></mxCell><mxCell id="work" value="EVALUATION WORKER (harness code, not an agent)&#10;1. paired baseline in the same measurement context, younger than 1440 min [I6]; else run it first&#10;2. re-measure the track's champion if it has no record in this context&#10;3. run the frozen evaluator (diagram 02)&#10;4. apply the promotion policy (diagram 05)&#10;5. write the record and memory" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="960" y="64" width="290" height="176" as="geometry" /></mxCell><mxCell id="lessons" value="SLOW MEMORY: lessons.md&#10;short (about 70 lines [I7]), curated, every lesson cites a run id; rewritten by the planner each round; negative results KEPT ('X did not help (run id); do not repeat without a new idea')" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="300" height="86" as="geometry" /></mxCell><mxCell id="attempts" value="FAST MEMORY: attempts.jsonl&#10;one row per official evaluation, append-only: candidate, parent, agent, verdict, metric, paired baseline, binding, note. Agents see a digest" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="370" y="300" width="270" height="86" as="geometry" /></mxCell><mxCell id="champ" value="champion.json&#10;per track: id, run id, metric, margin, since when, reason, previous champion. Written only by the promotion policy" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="680" y="300" width="250" height="86" as="geometry" /></mxCell><mxCell id="evid" value="evidence/&lt;time&gt;-&lt;candidate&gt;/&#10;one directory per run: record, raw outputs, log. The directory name is the run id: 'cite or it did not happen' (B4)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="970" y="300" width="280" height="86" as="geometry" /></mxCell><mxCell id="caps" value="CAPS AND COST (each agent is told its cap, so it reports before it is killed)&#10;- planner: 30 min [I8], 100 credits [I9]; each researcher: 60 min [I10], 300 credits [I11]&#10;- every tool call and credit is recorded; cost per accepted improvement is a campaign metric; a campaign budget pauses the loop&#10;- check the meter in round one: in the demonstration round the agent tool emitted no usage events, so credits read 0 and only the wall-time cap bounded the agents" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="410" width="560" height="100" as="geometry" /></mxCell><mxCell id="coord" value="COORDINATOR (human-facing agent)&#10;commits, writes the weekly report from the records (B8), raises the decisions the policy cannot take. May not: promote by judgement" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="620" y="410" width="300" height="100" as="geometry" /></mxCell><mxCell id="human" value="HUMAN OWNER&#10;owns the evaluator and the promotion rule; decides e.g. whether a near-tie blocked by the rule should change the rule" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="960" y="410" width="290" height="100" as="geometry" /></mxCell><mxCell id="pair" value="WHY PAIRED: compare within one measurement context (host, boot, evaluator id), as in blocking in experimental design. In the first campaign absolute latency shifted by 10 % [I14] between two hosts of the same type; an unpaired comparison would have swamped real gains. Demonstration round 1: 4 submissions [I12], 13 min [I13] of wall time." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#fff8ee;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="522" width="1220" height="44" as="geometry" /></mxCell><mxCell id="legend" value="Legend:  green = agent sessions  |  amber = harness code that judges  |  blue = files (memory and records)  |  purple = human-facing  |  grey = caps  |  bold arrows = the work path; blue = writes; dashed green = what agents read" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="578" width="1220" height="26" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Every number is loaded from ../constants.json by the key shown. [Pn] = public (cited paper, or my arithmetic on public mathematics); [In] = illustrative (a design parameter of the harness, a round value that keeps the shape of the first campaign, or output of the demonstration scheduling simulator; never a measurement of a real platform); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/B7-agents-and-the-loop.md (roles table, task shape, queue, paired baseline, champion re-measurement, caps, credit-meter caveat, machine-readable endings); notes/B6-the-two-memories.md (attempts log, lessons file, champions); notes/B4-evidence-records.md (one directory per run, run id); notes/B8-reporting.md (coordinator, weekly report, decisions).&#10;[I1] topic_tasks_per_round = 2 tasks. illustrative: configuration of the demonstration topic (design parameter of the harness)&#10;[I2] topic_researchers_parallel = 2 researchers. illustrative: configuration of the demonstration topic (design parameter of the harness)&#10;[I3] topic_submissions_per_researcher = 4 submissions. illustrative: configuration of the demonstration topic (design parameter of the harness)&#10;[I4] harness_plan_steps = 3-6 steps per task. illustrative: design parameter of the harness&#10;[I5] harness_task_hours = 1 hour. illustrative: design parameter of the harness&#10;[I6] topic_baseline_max_age_min = 1440 min. illustrative: configuration of the demonstration topic (design parameter of the harness)&#10;[I7] harness_lessons_max_lines = 70 lines. illustrative: design parameter of the harness&#10;[I8] topic_planner_wall_min = 30 min. illustrative: configuration of the demonstration topic (design parameter of the harness)&#10;[I9] topic_planner_credits = 100 credits. illustrative: configuration of the demonstration topic (design parameter of the harness)&#10;[I10] topic_researcher_wall_min = 60 min. illustrative: configuration of the demonstration topic (design parameter of the harness)&#10;[I11] topic_researcher_credits = 300 credits. illustrative: configuration of the demonstration topic (design parameter of the harness)&#10;[I12] sched_r1_submissions = 4 submissions. illustrative: demonstration run of the local scheduling simulator&#10;[I13] sched_r1_wall_min = 13 min. illustrative: demonstration run of the local scheduling simulator&#10;[I14] c1_host_shift_illustrative = 10 %. illustrative; keeps the shape of the first campaign (internal methodology notes, 2026), not its values" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="618" width="1220" height="233" as="geometry" /></mxCell><mxCell id="edge0" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="plan" target="tasks"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="tasks" target="resA"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.6;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="tasks" target="resB"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="submit" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="resA" target="queue"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="resB" target="queue"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge5" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.47;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="queue" target="work"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="work" target="evid"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge7" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="work" target="champ"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1018" y="270" /><mxPoint x="855" y="270" /></Array></mxGeometry></mxCell><mxCell id="edge8" value="write" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="work" target="attempts"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="989" y="260" /><mxPoint x="559" y="260" /></Array></mxGeometry></mxCell><mxCell id="edge9" value="digest" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=0.15;exitY=0;exitDx=0;exitDy=0;entryX=0.85;entryY=1;entryDx=0;entryDy=0;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1" source="attempts" target="plan"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="410" y="240" /><mxPoint x="217" y="240" /></Array></mxGeometry></mxCell><mxCell id="edge10" value="rewrite + read" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1" source="plan" target="lessons"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge11" value="decisions, asks" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" parent="1" source="coord" target="human"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge12" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="champ" target="coord"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>