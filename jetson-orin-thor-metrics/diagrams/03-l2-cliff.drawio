<mxfile host="app.diagrams.net"><diagram id="bwkv5l0l-gfu8" name="03-l2-cliff"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="660" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />
    <mxCell id="t" value="The L2 capacity cliff: a working set that fits L2 streams 12.4× (Orin) / 14.6× (Thor) faster than one that spills to DRAM" style="text;html=0;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="6" width="860" height="22" as="geometry" /></mxCell>
    <mxCell id="s" value="Streaming read bandwidth vs footprint. The cliff falls exactly at each board's L2 size (4 MB Orin, 32 MB Thor). Latency shelves (right) show L2 ~150 ns on both — only capacity grew, not speed." style="text;html=0;fontSize=9;align=center;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="28" width="860" height="14" as="geometry" /></mxCell>

    <!-- Axes -->
    <mxCell id="ay" style="endArrow=none;html=0;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="440" as="sourcePoint" /><mxPoint x="110" y="70" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="ax" style="endArrow=none;html=0;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="440" as="sourcePoint" /><mxPoint x="770" y="440" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="aylab" value="Streaming read bandwidth (GB/s, log)" style="text;html=0;fontSize=10;align=center;horizontal=0;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="24" height="240" as="geometry" /></mxCell>
    <mxCell id="axlab" value="Working-set footprint (MB, log scale)" style="text;html=0;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="560" y="448" width="210" height="16" as="geometry" /></mxCell>

    <!-- X ticks: 1,4,32,256 MB. x=110+ (660/ log10(256)) *log10(MB). log10(256)=2.408; scale=274/decade -->
    <mxCell id="x1" value="1" style="text;html=0;fontSize=9;align=center;" vertex="1" parent="1"><mxGeometry x="100" y="442" width="20" height="12" as="geometry" /></mxCell>
    <mxCell id="x4" value="4 MB
(Orin L2)" style="text;html=0;fontSize=9;align=center;fontColor=#2a4d7a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="245" y="442" width="60" height="24" as="geometry" /></mxCell>
    <mxCell id="x32" value="32 MB
(Thor L2)" style="text;html=0;fontSize=9;align=center;fontColor=#2d6a2d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="493" y="442" width="60" height="24" as="geometry" /></mxCell>
    <mxCell id="x256" value="256" style="text;html=0;fontSize=9;align=center;" vertex="1" parent="1"><mxGeometry x="750" y="442" width="30" height="12" as="geometry" /></mxCell>

    <!-- Y ticks bandwidth: 100,1000,4000. y=440-110*log10(B/100)? Range 100..5000 -> log 2..3.7. Use y=440-110*(log10(B)-2) over 3.7 decades? simplify: 100->y=440,1000->y=330,2200->y=... let scale 110px/decade from 100. 
      177->y=440-110*log10(1.77)=440-27=413; 259->y=440-110*0.413=395; 2200->y=440-110*1.342=292; 3790->y=440-110*1.579=266 -->
    <mxCell id="yb100" value="100" style="text;html=0;fontSize=9;align=right;" vertex="1" parent="1"><mxGeometry x="78" y="434" width="26" height="12" as="geometry" /></mxCell>
    <mxCell id="yb1000" value="1000" style="text;html=0;fontSize=9;align=right;" vertex="1" parent="1"><mxGeometry x="74" y="324" width="30" height="12" as="geometry" /></mxCell>
    <mxCell id="yb4000" value="4000" style="text;html=0;fontSize=9;align=right;" vertex="1" parent="1"><mxGeometry x="74" y="258" width="30" height="12" as="geometry" /></mxCell>

    <!-- Vertical cliff markers -->
    <mxCell id="cliffO" style="endArrow=none;html=0;strokeColor=#2a4d7a;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="275" y="440" as="sourcePoint" /><mxPoint x="275" y="80" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="cliffT" style="endArrow=none;html=0;strokeColor=#2d6a2d;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="523" y="440" as="sourcePoint" /><mxPoint x="523" y="80" as="targetPoint" /></mxGeometry></mxCell>

    <!-- Thor curve: flat at 3790 until 32 MB (x=523,y=266), drop to 259 (y=395) at ~34MB (x=535), flat to 256 -->
    <mxCell id="thorFlat" style="endArrow=none;html=0;strokeColor=#2d6a2d;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="266" as="sourcePoint" /><mxPoint x="523" y="266" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="thorDrop" style="endArrow=none;html=0;strokeColor=#2d6a2d;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="523" y="266" as="sourcePoint" /><mxPoint x="545" y="395" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="thorDram" style="endArrow=none;html=0;strokeColor=#2d6a2d;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="545" y="395" as="sourcePoint" /><mxPoint x="770" y="395" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="thorL2lbl" value="Thor L2-resident 3790 GB/s [A.6]" style="text;html=0;fontSize=9;fontColor=#2d6a2d;labelBackgroundColor=#ffffff;align=left;" vertex="1" parent="1"><mxGeometry x="140" y="250" width="220" height="14" as="geometry" /></mxCell>
    <mxCell id="thorDramlbl" value="Thor DRAM 259 GB/s [A.6]" style="text;html=0;fontSize=9;fontColor=#2d6a2d;labelBackgroundColor=#ffffff;align=left;" vertex="1" parent="1"><mxGeometry x="590" y="378" width="180" height="14" as="geometry" /></mxCell>
    <mxCell id="thorRatio" value="14.6× [A.6]" style="text;html=0;fontSize=10;fontColor=#2d6a2d;fontStyle=1;labelBackgroundColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="528" y="312" width="70" height="16" as="geometry" /></mxCell>
    <mxCell id="thorArrow" style="endArrow=classic;startArrow=classic;html=0;strokeColor=#2d6a2d;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="534" y="270" as="sourcePoint" /><mxPoint x="534" y="391" as="targetPoint" /></mxGeometry></mxCell>

    <!-- Orin curve: flat at 2200 (y=292) until 4 MB (x=275), drop to 177 (y=413) at ~4.5MB (x=288), flat -->
    <mxCell id="orinFlat" style="endArrow=none;html=0;strokeColor=#2a4d7a;strokeWidth=3;dashed=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="292" as="sourcePoint" /><mxPoint x="275" y="292" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="orinDrop" style="endArrow=none;html=0;strokeColor=#2a4d7a;strokeWidth=3;dashed=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="275" y="292" as="sourcePoint" /><mxPoint x="295" y="413" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="orinDram" style="endArrow=none;html=0;strokeColor=#2a4d7a;strokeWidth=3;dashed=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="295" y="413" as="sourcePoint" /><mxPoint x="770" y="413" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="orinL2lbl" value="Orin L2-resident 2200 GB/s [A.6]" style="text;html=0;fontSize=9;fontColor=#2a4d7a;labelBackgroundColor=#ffffff;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="276" width="150" height="26" as="geometry" /></mxCell>
    <mxCell id="orinDramlbl" value="Orin DRAM 177 GB/s [A.6]" style="text;html=0;fontSize=9;fontColor=#2a4d7a;labelBackgroundColor=#ffffff;align=left;" vertex="1" parent="1"><mxGeometry x="340" y="416" width="170" height="14" as="geometry" /></mxCell>
    <mxCell id="orinRatio" value="12.4× [A.6]" style="text;html=0;fontSize=10;fontColor=#2a4d7a;fontStyle=1;labelBackgroundColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="200" y="340" width="70" height="16" as="geometry" /></mxCell>
    <mxCell id="orinArrow" style="endArrow=classic;startArrow=classic;html=0;strokeColor=#2a4d7a;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="258" y="296" as="sourcePoint" /><mxPoint x="258" y="409" as="targetPoint" /></mxGeometry></mxCell>

    <!-- ===== Latency shelves inset (right block) ===== -->
    <mxCell id="latbox" value="Latency shelves — dependent-load latency by level [A.7]" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fbf7ef;strokeColor=#d6b656;verticalAlign=top;fontSize=10;fontStyle=1;align=center;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="560" y="468" width="330" height="184" as="geometry" /></mxCell>
    <mxCell id="lat_hdr" value="Level       Orin       Thor" style="text;html=0;fontSize=8;fontStyle=1;align=left;fontFamily=monospace;" vertex="1" parent="1"><mxGeometry x="572" y="492" width="310" height="13" as="geometry" /></mxCell>
    <mxCell id="lat_l1" value="L1 shelf    29.9 ns    25.3 ns" style="text;html=0;fontSize=8;align=left;fontFamily=monospace;" vertex="1" parent="1"><mxGeometry x="572" y="507" width="310" height="13" as="geometry" /></mxCell>
    <mxCell id="lat_l2" value="L2 shelf    ~146 ns    ~156 ns  (unchanged!)" style="text;html=0;fontSize=8;align=left;fontFamily=monospace;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="572" y="522" width="310" height="13" as="geometry" /></mxCell>
    <mxCell id="lat_cliff" value="L2 cliff    4.0 MB     32 MB" style="text;html=0;fontSize=8;align=left;fontFamily=monospace;" vertex="1" parent="1"><mxGeometry x="572" y="537" width="310" height="13" as="geometry" /></mxCell>
    <mxCell id="lat_dram" value="DRAM shelf  ~675 ns    ~510 ns" style="text;html=0;fontSize=8;align=left;fontFamily=monospace;" vertex="1" parent="1"><mxGeometry x="572" y="552" width="310" height="13" as="geometry" /></mxCell>
    <mxCell id="lat_save" value="L2 save     ~530ns 4.6x  ~355ns 3.3x" style="text;html=0;fontSize=8;align=left;fontFamily=monospace;" vertex="1" parent="1"><mxGeometry x="572" y="567" width="310" height="13" as="geometry" /></mxCell>
    <mxCell id="lat_note" value="L2 latency holds fixed in TIME, not cycles (190 vs 246 cyc): the memory win is capacity, not reach [A.7]." style="text;html=0;fontSize=8;align=left;fontStyle=2;fontColor=#555555;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="572" y="584" width="306" height="60" as="geometry" /></mxCell>

    <!-- Legend -->
    <mxCell id="lg" value="Legend" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;fontSize=9;fontStyle=1;align=left;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="110" y="470" width="430" height="100" as="geometry" /></mxCell>
    <mxCell id="lg1" value="— solid green = Thor measured bandwidth · dashed blue = Orin measured bandwidth" style="text;html=0;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="492" width="420" height="12" as="geometry" /></mxCell>
    <mxCell id="lg2" value="— vertical dashed line = each board's L2 capacity (the cliff location)" style="text;html=0;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="508" width="420" height="12" as="geometry" /></mxCell>
    <mxCell id="lg3" value="— double arrow + N× = measured L2:DRAM bandwidth ratio" style="text;html=0;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="524" width="420" height="12" as="geometry" /></mxCell>
    <mxCell id="lg4" value="Bandwidth axis is log; curve shapes are schematic, plateaus/cliffs at exact source values." style="text;html=0;fontSize=8;fontStyle=2;fontColor=#555555;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="540" width="420" height="24" as="geometry" /></mxCell>

