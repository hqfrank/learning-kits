<mxfile host="app.diagrams.net"><diagram id="8g3aczok-3fme" name="02-roofline"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="680" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />
    <mxCell id="r_title" value="Hierarchical roofline, Orin vs Thor: π0.5's phases sit far below every tensor ceiling — the model is bandwidth-bound, not TOPS-bound" style="text;html=0;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="6" width="860" height="22" as="geometry" /></mxCell>
    <mxCell id="r_sub" value="Log–log. Horizontal lines = compute ceilings (measured, A.2–A.4). Sloped lines = memory roofs (slope = measured bandwidth, A.5–A.6). Datasheet peaks dashed grey. Dots = real workload phases at their arithmetic intensity." style="text;html=0;fontSize=9;align=center;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="28" width="860" height="14" as="geometry" /></mxCell>

    <!-- Plot frame -->
    <mxCell id="axis_y" style="endArrow=none;html=0;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="470" as="sourcePoint" /><mxPoint x="110" y="70" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="axis_x" style="endArrow=none;html=0;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="470" as="sourcePoint" /><mxPoint x="800" y="470" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="ylab" value="Throughput (TFLOP/s or TOP/s) — log scale" style="text;html=0;fontSize=10;align=center;horizontal=0;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="24" height="240" as="geometry" /></mxCell>
    <mxCell id="xlab" value="Arithmetic intensity  (FLOP per byte)  —  log scale" style="text;html=0;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="476" width="320" height="16" as="geometry" /></mxCell>

    <!-- X ticks: AI = 1,10,100,731,2000. x=110+209*log10(AI) -->
    <mxCell id="xt1" value="1" style="text;html=0;fontSize=9;align=center;" vertex="1" parent="1"><mxGeometry x="100" y="472" width="20" height="12" as="geometry" /></mxCell>
    <mxCell id="xt10" value="10" style="text;html=0;fontSize=9;align=center;" vertex="1" parent="1"><mxGeometry x="309" y="472" width="20" height="12" as="geometry" /></mxCell>
    <mxCell id="xt100" value="100" style="text;html=0;fontSize=9;align=center;" vertex="1" parent="1"><mxGeometry x="518" y="472" width="20" height="12" as="geometry" /></mxCell>
    <mxCell id="xt1000" value="1000" style="text;html=0;fontSize=9;align=center;" vertex="1" parent="1"><mxGeometry x="727" y="472" width="20" height="12" as="geometry" /></mxCell>

    <!-- Y ticks: throughput mapping. Range 1..1000 TFLOP/s over y=470(bottom)..70(top). 3 decades over 400px = 133/decade. y=470-133*log10(T) -->
    <mxCell id="yt1" value="1" style="text;html=0;fontSize=9;align=right;" vertex="1" parent="1"><mxGeometry x="82" y="463" width="22" height="12" as="geometry" /></mxCell>
    <mxCell id="yt10" value="10" style="text;html=0;fontSize=9;align=right;" vertex="1" parent="1"><mxGeometry x="82" y="330" width="22" height="12" as="geometry" /></mxCell>
    <mxCell id="yt100" value="100" style="text;html=0;fontSize=9;align=right;" vertex="1" parent="1"><mxGeometry x="82" y="197" width="22" height="12" as="geometry" /></mxCell>
    <mxCell id="yt1000" value="1000" style="text;html=0;fontSize=9;align=right;" vertex="1" parent="1"><mxGeometry x="78" y="64" width="26" height="12" as="geometry" /></mxCell>

    <!-- ===== Compute ceilings (horizontal). y = 470 - 133*log10(T_TFLOPs) ===== -->
    <!-- Thor NVFP4 dense 627.8 -> log10=2.798 -> y=98 -->
    <mxCell id="c_nvfp4" style="endArrow=none;html=0;strokeColor=#9673a6;strokeWidth=2.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="98" as="sourcePoint" /><mxPoint x="800" y="98" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="lc_nvfp4" value="NVFP4 dense 627.8 [A.4]" style="text;html=0;fontSize=8;fontColor=#9673a6;labelBackgroundColor=#ffffff;align=left;" vertex="1" parent="1"><mxGeometry x="474" y="84" width="150" height="12" as="geometry" /></mxCell>

    <!-- Thor tcgen05 FP8 345.4 -> log10=2.538 -> y=132 -->
    <mxCell id="c_fp8" style="endArrow=none;html=0;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="132" as="sourcePoint" /><mxPoint x="800" y="132" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="lc_fp8" value="tcgen05 INT8 324.5 / FP8 345.4 [A.3]" style="text;html=0;fontSize=8;fontColor=#9673a6;labelBackgroundColor=#ffffff;align=left;" vertex="1" parent="1"><mxGeometry x="474" y="134" width="220" height="12" as="geometry" /></mxCell>

    <!-- Thor tcgen05 FP16 192.5 -> log10=2.284 -> y=166 -->
    <mxCell id="c_fp16t5" style="endArrow=none;html=0;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="166" as="sourcePoint" /><mxPoint x="800" y="166" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="lc_fp16t5" value="tcgen05 FP16 192.5 [A.3]" style="text;html=0;fontSize=8;fontColor=#9673a6;labelBackgroundColor=#ffffff;align=left;" vertex="1" parent="1"><mxGeometry x="474" y="154" width="160" height="12" as="geometry" /></mxCell>

    <!-- Thor classic INT8 128.8 -> log10=2.110 -> y=189 -->
    <mxCell id="c_int8t" style="endArrow=none;html=0;strokeColor=#82b366;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="189" as="sourcePoint" /><mxPoint x="800" y="189" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="lc_int8t" value="Thor classic INT8 128.8 / FP8 132.1 [A.3]" style="text;html=0;fontSize=8;fontColor=#2d6a2d;labelBackgroundColor=#ffffff;align=right;" vertex="1" parent="1"><mxGeometry x="540" y="177" width="258" height="12" as="geometry" /></mxCell>

    <!-- Thor classic FP16 64.4 -> log10=1.809 -> y=229 -->
    <mxCell id="c_fp16tc" style="endArrow=none;html=0;strokeColor=#82b366;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="229" as="sourcePoint" /><mxPoint x="800" y="229" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="lc_fp16tc" value="Thor classic FP16 64.4 [A.3]" style="text;html=0;fontSize=8;fontColor=#2d6a2d;labelBackgroundColor=#ffffff;align=right;" vertex="1" parent="1"><mxGeometry x="620" y="231" width="178" height="12" as="geometry" /></mxCell>

    <!-- Orin classic INT8 83.4 -> log10=1.921 -> y=214 -->
    <mxCell id="c_int8o" style="endArrow=none;html=0;strokeColor=#6c8ebf;strokeWidth=1.5;dashed=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="214" as="sourcePoint" /><mxPoint x="800" y="214" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="lc_int8o" value="Orin classic INT8 83.4 [A.3]" style="text;html=0;fontSize=8;fontColor=#2a4d7a;labelBackgroundColor=#ffffff;align=left;" vertex="1" parent="1"><mxGeometry x="424" y="202" width="160" height="12" as="geometry" /></mxCell>

    <!-- Orin classic FP16 42.5 -> log10=1.628 -> y=253 -->
    <mxCell id="c_fp16o" style="endArrow=none;html=0;strokeColor=#6c8ebf;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="253" as="sourcePoint" /><mxPoint x="800" y="253" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="lc_fp16o" value="Orin classic FP16 42.5 [A.3]" style="text;html=0;fontSize=8;fontColor=#2a4d7a;labelBackgroundColor=#ffffff;align=left;" vertex="1" parent="1"><mxGeometry x="474" y="255" width="160" height="12" as="geometry" /></mxCell>

    <!-- CUDA FP32: Thor 7.82 -> log10=0.893 -> y=351 ; Orin 5.15 -> log10=0.712 -> y=375 -->
    <mxCell id="c_fp32t" style="endArrow=none;html=0;strokeColor=#82b366;strokeWidth=1.5;dashed=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="351" as="sourcePoint" /><mxPoint x="800" y="351" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="lc_fp32t" value="CUDA FP32 Thor 7.82 / Orin 5.15 [A.2]" style="text;html=0;fontSize=8;fontColor=#2d6a2d;labelBackgroundColor=#ffffff;align=right;" vertex="1" parent="1"><mxGeometry x="560" y="339" width="238" height="12" as="geometry" /></mxCell>
    <mxCell id="c_fp32o" style="endArrow=none;html=0;strokeColor=#6c8ebf;strokeWidth=1.5;dashed=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="300" y="375" as="sourcePoint" /><mxPoint x="800" y="375" as="targetPoint" /></mxGeometry></mxCell>

    <!-- Datasheet dashed grey: NVFP4 2:4-sparse 2070 -> log10=3.316 -> y=29 (above frame; clamp 70) ; FP8/INT8 datasheet 517 -> log10=2.714 -> y=109 -->
    <mxCell id="c_ds_fp8" style="endArrow=none;html=0;strokeColor=#999999;strokeWidth=1.5;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="109" as="sourcePoint" /><mxPoint x="800" y="109" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="lc_ds_fp8" value="INT8/FP8 datasheet 517 [A.3]" style="text;html=0;fontSize=8;fontColor=#777777;labelBackgroundColor=#ffffff;align=right;" vertex="1" parent="1"><mxGeometry x="620" y="110" width="178" height="12" as="geometry" /></mxCell>
    <mxCell id="c_ds_nvfp4" style="endArrow=none;html=0;strokeColor=#999999;strokeWidth=1.5;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="72" as="sourcePoint" /><mxPoint x="800" y="72" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="lc_ds_nvfp4" value="NVFP4 datasheet 1035 [A.4]" style="text;html=0;fontSize=8;fontColor=#777777;labelBackgroundColor=#ffffff;align=right;" vertex="1" parent="1"><mxGeometry x="620" y="60" width="178" height="12" as="geometry" /></mxCell>

    <!-- ===== Memory roofs (sloped). throughput[TFLOP/s] = B[GB/s]/1000 * AI. In log space slope = +1 decade per decade. 
         Line passes point: at AI=1, T = B/1000. 
         Thor DRAM 259 GB/s: at AI=1 -> T=0.259 -> log10=-0.587 -> y=548 (below frame). Draw within frame: at AI=10 T=2.59 (y=470-? ... use T mapping y=470-133*log10(T)). 
         We draw diagonal from (AI=3.6, hits bottom) up. Simplify: draw from (x at AI=10, y for T=2.59) to (x at AI=2000, y for T=518 clipped). 
         Thor DRAM: AI=10->T=2.59->y=470-133*0.413=415, x=309 ; AI=1000->T=259->y=470-133*2.413=149, x=727 -->
    <mxCell id="m_dram_t" style="endArrow=none;html=0;strokeColor=#cc0000;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="266" y="470" as="sourcePoint" /><mxPoint x="760" y="162" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="lm_dram_t" value="Thor DRAM 259 GB/s [A.6]" style="text;html=0;fontSize=8;fontColor=#cc0000;labelBackgroundColor=#ffffff;align=left;rotation=-32;" vertex="1" parent="1"><mxGeometry x="300" y="420" width="150" height="12" as="geometry" /></mxCell>

    <!-- Orin DRAM 177 GB/s: slightly below Thor. at AI=10 T=1.77 y=437 x=309; parallel line shifted right -->
    <mxCell id="m_dram_o" style="endArrow=none;html=0;strokeColor=#6c8ebf;strokeWidth=1.5;dashed=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="288" y="470" as="sourcePoint" /><mxPoint x="782" y="162" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="lm_dram_o" value="Orin DRAM 177 GB/s [A.6]" style="text;html=0;fontSize=8;fontColor=#2a4d7a;labelBackgroundColor=#ffffff;align=left;rotation=-32;" vertex="1" parent="1"><mxGeometry x="360" y="430" width="150" height="12" as="geometry" /></mxCell>

    <!-- Thor L2-resident 3790 GB/s: at AI=1 T=3.79 y=392 x=110 ; at AI=100 T=379 y=470-133*2.579=127 x=518 -->
    <mxCell id="m_l2_t" style="endArrow=none;html=0;strokeColor=#d6b656;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="393" as="sourcePoint" /><mxPoint x="560" y="112" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="lm_l2_t" value="Thor L2-resident 3790 GB/s [A.6]" style="text;html=0;fontSize=8;fontColor=#8a6d1f;labelBackgroundColor=#ffffff;align=left;rotation=-32;" vertex="1" parent="1"><mxGeometry x="170" y="340" width="180" height="12" as="geometry" /></mxCell>

    <!-- Orin L2-resident 2200 GB/s -->
    <mxCell id="m_l2_o" style="endArrow=none;html=0;strokeColor=#d6b656;strokeWidth=1.5;dashed=4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="424" as="sourcePoint" /><mxPoint x="540" y="156" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="lm_l2_o" value="Orin L2 2200 GB/s [A.6]" style="text;html=0;fontSize=8;fontColor=#8a6d1f;labelBackgroundColor=#ffffff;align=left;rotation=-32;" vertex="1" parent="1"><mxGeometry x="130" y="392" width="150" height="12" as="geometry" /></mxCell>

    <!-- L1 per-SM aggregate Thor 3038 / Orin 2067 GB/s - draw as faint ref near top-left -->
    <mxCell id="m_l1" style="endArrow=none;html=0;strokeColor=#b3b3b3;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="403" as="sourcePoint" /><mxPoint x="470" y="178" as="targetPoint" /></mxGeometry></mxCell>
    <mxCell id="lm_l1" value="L1 aggregate 3038/2067 GB/s [A.5]" style="text;html=0;fontSize=7;fontColor=#888888;labelBackgroundColor=#ffffff;align=left;rotation=-32;" vertex="1" parent="1"><mxGeometry x="150" y="365" width="170" height="10" as="geometry" /></mxCell>

    <!-- ===== Workload dots ===== 
      WBC MLP: AI 0.4 -> log10=-0.398 -> x=110-83=27 (off left). Clamp near axis at x=112, note AI. Place dot at left edge low.
      pi0.5 action expert AI ~10 -> x=309. memory-bound, sits on DRAM roof: T=2.59 -> y=415.
      pi0.5 prefill AI ~731 -> x=110+209*2.864=709. compute-bound ~ on Thor FP16 tcgen05 region, delivered 52.8-110 TFLOP/s -> use ~90 TFLOP/s log10=1.954 y=210 -->
    <!-- WBC -->
    <mxCell id="d_wbc" value="" style="ellipse;whiteSpace=wrap;html=0;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="116" y="438" width="11" height="11" as="geometry" /></mxCell>
    <mxCell id="ld_wbc" value="WBC MLP  AI≈0.4 — launch-bound, far left of every roof [L4/B.8]" style="text;html=0;fontSize=8;fontColor=#000000;labelBackgroundColor=#ffffff;align=left;" vertex="1" parent="1"><mxGeometry x="132" y="440" width="300" height="12" as="geometry" /></mxCell>

    <!-- pi0.5 action -->
    <mxCell id="d_act" value="" style="ellipse;whiteSpace=wrap;html=0;fillColor=#cc0000;strokeColor=#8b0000;" vertex="1" parent="1"><mxGeometry x="304" y="410" width="12" height="12" as="geometry" /></mxCell>
    <mxCell id="ld_act" value="π0.5 action expert  AI≈10 — memory-bound, on the DRAM roof [C.1]" style="text;html=0;fontSize=8;fontColor=#cc0000;labelBackgroundColor=#ffffff;align=left;" vertex="1" parent="1"><mxGeometry x="320" y="402" width="300" height="12" as="geometry" /></mxCell>

    <!-- pi0.5 prefill -->
    <mxCell id="d_pre" value="" style="ellipse;whiteSpace=wrap;html=0;fillColor=#cc0000;strokeColor=#8b0000;" vertex="1" parent="1"><mxGeometry x="703" y="204" width="12" height="12" as="geometry" /></mxCell>
    <mxCell id="ld_pre" value="π0.5 prefill  AI≈731 — compute-bound, delivers 52.8–110 TFLOP/s, 1.7–3.6× under the FP16 ceiling [C.1/A.3]" style="text;html=0;fontSize=8;fontColor=#cc0000;labelBackgroundColor=#ffffff;align=right;" vertex="1" parent="1"><mxGeometry x="400" y="222" width="300" height="24" as="geometry" /></mxCell>

    <!-- ridge note -->
    <mxCell id="ridge" value="π0.5 sustains ~35 TFLOP/s-equiv vs a 192.5 TFLOP/s FP16 ceiling: the datasheet NVFP4 TOPS never enters [C.1]" style="text;html=0;fontSize=8;align=center;fontStyle=2;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="300" y="300" width="360" height="24" as="geometry" /></mxCell>

