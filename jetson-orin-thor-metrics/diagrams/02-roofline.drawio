    <mxCell id="rl4" value="— dashed coloured = Orin counterpart of a Thor roof" style="text;html=0;fontSize=8;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="562" width="345" height="12" as="geometry" /></mxCell>
    <mxCell id="rl5" value="— red/black dot = measured π0.5 phase / WBC at its AI" style="text;html=0;fontSize=8;fontColor=#cc0000;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="576" width="345" height="12" as="geometry" /></mxCell>
    <mxCell id="rl6" value="— sloped line = memory roof (slope = measured bandwidth)" style="text;html=0;fontSize=8;fontColor=#cc0000;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="590" width="345" height="12" as="geometry" /></mxCell>
    <mxCell id="rl7" value="Axes approximate (hand-placed on log grid); values are exact per sources." style="text;html=0;fontSize=8;fontStyle=2;fontColor=#555555;align=left;" vertex="1" parent="1"><mxGeometry x="120" y="606" width="345" height="12" as="geometry" /></mxCell>

