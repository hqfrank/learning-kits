<mxfile host="app.diagrams.net"><diagram id="p01" name="01-shared-soc">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Thor SoC: CPU, GPU, and copy engines all funnel through ONE memory controller to one LPDDR pool" style="text;html=0;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="860" height="24" as="geometry" /></mxCell>
        <mxCell id="sub" value="NVIDIA Jetson Thor T5000 (Blackwell, sm_110), MAXN, GPU clocks locked. Edge labels are measured rates [source tag].  Orin is the same topology (16 SM, 4 MB L2, 177 GB/s DRAM)." style="text;html=0;fontSize=10;align=center;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="32" width="860" height="16" as="geometry" /></mxCell>

        <!-- SoC die outline -->
        <mxCell id="die" value="Thor integrated SoC die — no discrete GPU memory [00-platforms]" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=#333333;dashed=1;verticalAlign=top;fontSize=10;fontStyle=2;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="820" height="380" as="geometry" /></mxCell>

        <!-- CPU complex -->
        <mxCell id="cpu" value="CPU complex
14× Neoverse-V3AE
@ 2.60 GHz [00-platforms]" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="90" width="180" height="90" as="geometry" /></mxCell>

        <!-- GPU block containing SMs + SMSPs -->
        <mxCell id="gpu" value="GPU — 20 SMs (Blackwell) [00-platforms]" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="300" y="80" width="500" height="150" as="geometry" /></mxCell>
        <mxCell id="sm1" value="SM (×20)
128 FP32 cores
4 tensor cores (5th-gen tcgen05)
228 KB L1+shared" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f5e4;strokeColor=#82b366;fontSize=9;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="315" y="108" width="190" height="110" as="geometry" /></mxCell>
        <!-- SMSP sub-partitions -->
        <mxCell id="smsp1" value="SMSP 0" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#82b366;fontSize=8;" vertex="1" parent="1"><mxGeometry x="323" y="158" width="40" height="26" as="geometry" /></mxCell>
        <mxCell id="smsp2" value="SMSP 1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#82b366;fontSize=8;" vertex="1" parent="1"><mxGeometry x="366" y="158" width="40" height="26" as="geometry" /></mxCell>
        <mxCell id="smsp3" value="SMSP 2" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#82b366;fontSize=8;" vertex="1" parent="1"><mxGeometry x="409" y="158" width="40" height="26" as="geometry" /></mxCell>
        <mxCell id="smsp4" value="SMSP 3" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#82b366;fontSize=8;" vertex="1" parent="1"><mxGeometry x="452" y="158" width="40" height="26" as="geometry" /></mxCell>
        <mxCell id="smsplabel" value="4 sub-partitions/SM, 1 inst/cycle each [00-platforms]" style="text;html=0;fontSize=8;align=center;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="315" y="188" width="190" height="14" as="geometry" /></mxCell>

        <!-- Copy engines + memset/blit -->
        <mxCell id="ce" value="Copy engines (DMA)
H2D / D2H / D2D" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="525" y="108" width="130" height="52" as="geometry" /></mxCell>
        <mxCell id="blit" value="engine memset
(blit path — bypasses
queue arbitration)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;verticalAlign=top;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="665" y="108" width="125" height="52" as="geometry" /></mxCell>

        <!-- L2 cache -->
        <mxCell id="l2" value="Shared L2 cache — 32 MB (Thor; Orin 4 MB) [00-platforms]" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="260" width="740" height="46" as="geometry" /></mxCell>

        <!-- ONE memory controller -->
        <mxCell id="mc" value="ONE memory controller  (shared by every tenant — the single point of contention)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="330" width="740" height="44" as="geometry" /></mxCell>

        <!-- LPDDR -->
        <mxCell id="dram" value="LPDDR5X — 123 GB unified RAM, 256-bit, ~273 GB/s spec [00-platforms]" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="396" width="740" height="36" as="geometry" /></mxCell>

        <!-- Edges: GPU SM -> L2 (L2-resident read bw) -->
        <mxCell id="e_sm_l2" style="endArrow=classic;html=0;strokeColor=#cc0000;strokeWidth=2;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="gpu" target="l2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="l_sm_l2" value="L2-resident read 3790 GB/s [A.6]" style="text;html=0;fontSize=9;fontColor=#cc0000;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="470" y="236" width="190" height="16" as="geometry" /></mxCell>

        <!-- CPU -> MC -->
        <mxCell id="e_cpu_mc" style="endArrow=classic;html=0;strokeColor=#333333;strokeWidth=1.5;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.12;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cpu" target="mc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="114" y="320" /></Array></mxGeometry></mxCell>
        <mxCell id="l_cpu_mc" value="CPU hog floor 172 GB/s collapses control loop [L4]" style="text;html=0;fontSize=9;fontColor=#333333;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="200" height="28" as="geometry" /></mxCell>

        <!-- L2 -> MC -->
        <mxCell id="e_l2_mc" style="endArrow=classic;html=0;strokeColor=#333333;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l2" target="mc"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- MC -> DRAM measured read -->
        <mxCell id="e_mc_dram" style="endArrow=classic;startArrow=classic;html=0;strokeColor=#cc0000;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="mc" target="dram"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="l_mc_dram" value="DRAM read 259 GB/s measured (95% of spec) [A.6]; sustained 245 GB/s [B.6]" style="text;html=0;fontSize=9;fontColor=#cc0000;labelBackgroundColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="430" y="378" width="360" height="16" as="geometry" /></mxCell>

        <!-- CE -> L2/MC path (memset blit) -->
        <mxCell id="e_blit" style="endArrow=classic;html=0;strokeColor=#b85450;strokeWidth=2;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.9;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="blit" target="l2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="727" y="245" /></Array></mxGeometry></mxCell>
        <mxCell id="l_blit" value="memset blit slows a reader 2.33->4.01× [B.1]" style="text;html=0;fontSize=9;fontColor=#b85450;labelBackgroundColor=#ffffff;align=right;" vertex="1" parent="1"><mxGeometry x="600" y="238" width="200" height="16" as="geometry" /></mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="Legend" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;fontSize=10;fontStyle=1;align=left;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="452" width="400" height="112" as="geometry" /></mxCell>
        <mxCell id="leg_red" value="— red edge/label = MEASURED rate (this campaign)" style="text;html=0;fontSize=9;fontColor=#cc0000;align=left;" vertex="1" parent="1"><mxGeometry x="52" y="474" width="380" height="14" as="geometry" /></mxCell>
        <mxCell id="leg_black" value="— black edge = shared path / arbitration" style="text;html=0;fontSize=9;fontColor=#333333;align=left;" vertex="1" parent="1"><mxGeometry x="52" y="490" width="380" height="14" as="geometry" /></mxCell>
        <mxCell id="leg_dash" value="— dashed box = SoC die boundary (one physical memory)" style="text;html=0;fontSize=9;fontColor=#555555;align=left;" vertex="1" parent="1"><mxGeometry x="52" y="506" width="380" height="14" as="geometry" /></mxCell>
        <mxCell id="leg_pink" value="— pink = the single shared memory controller + blit violation path" style="text;html=0;fontSize=9;fontColor=#b85450;align=left;" vertex="1" parent="1"><mxGeometry x="52" y="522" width="380" height="14" as="geometry" /></mxCell>
        <mxCell id="leg_fact" value="Takeaway: no discrete GPU memory exists — every CPU-GPU contention result rests on this one controller [00-platforms, B.1]." style="text;html=0;fontSize=9;fontColor=#000000;align=left;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="52" y="538" width="380" height="24" as="geometry" /></mxCell>

