<mxfile host="app.diagrams.net"><diagram id="p_01_roles_and_the_boundary" name="01-roles-and-the-boundary"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="771" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="The reasoner proposes, only the coordinator invokes: one shared kernel owns every authority, and each experience owns only its story, reached through one small effect vocabulary" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="48" as="geometry" /></mxCell><mxCell id="visitor" value="VISITOR&#10;at a public&#10;demo stand" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=12;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="190" width="110" height="90" as="geometry" /></mxCell><mxCell id="reasoner" value="THE REASONER&#10;(a realtime speech-to-speech LLM session)&#10;&#10;OWNS everything said inside a phase: wording, tone, empathy, small detours&#10;&#10;MAY propose a physical act, as a typed intent from a closed list (its one tool)&#10;&#10;GETS a small per-phase context, e.g. 'this is the greeting; a wave is available'. It is never told it is bounded.&#10;&#10;RETURNS a turn result: typed intent + terminal speech status&#10;&#10;CHAT = bounded turns: 3 turns [I1] x 8 s [I2] = 24 s [calc] inside a 60 s session bound [I3]; one speech-output lease per turn" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="170" y="80" width="250" height="310" as="geometry" /></mxCell><mxCell id="coord" value="" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;dashed=1;fillColor=none;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="500" y="72" width="480" height="362" as="geometry" /></mxCell><mxCell id="coord_t" value="THE COORDINATOR = kernel + the selected experience. Deterministic code, one worker, one authoritative transition at a time. Only it invokes anything." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="510" y="76" width="460" height="34" as="geometry" /></mxCell><mxCell id="kernel" value="COORDINATOR KERNEL  (shared by every experience)&#10;&#10;owns: event admission and ordering | correlation | participant authority (who the visitor is) | safety preemption | command authority, leases and the visitor-audio permit | timer mechanics | cleanup and the proof that every store is clean | the lifecycle | evidence" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="515" y="116" width="450" height="130" as="geometry" /></mxCell><mxCell id="effects" value="EFFECT VOCABULARY - the only way out:&#10;invoke primitive | cancel primitive | start / cancel timer | request completion cleanup | report to operator" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="603" y="262" width="280" height="56" as="geometry" /></mxCell><mxCell id="exper" value="SELECTED EXPERIENCE  (one per coordinator process)&#10;pure reducer: (local state, read-only envelope, event) -&gt; (next local state, ordered effects)&#10;owns: its local story state, transition matrix, story invariants, and its own timeout, retry and participant POLICY choices" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="515" y="334" width="450" height="86" as="geometry" /></mxCell><mxCell id="pcat" value="PRIMITIVE CATALOG (out)&#10;every behaviour, speech act, gaze request and session service an experience may invoke" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1010" y="116" width="240" height="70" as="geometry" /></mxCell><mxCell id="icat" value="INPUT CATALOG (in)&#10;every input: ingress kind, payload, correlation, privacy, replay policy" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1010" y="200" width="240" height="70" as="geometry" /></mxCell><mxCell id="adapt" value="PER-TARGET CONTRACTS&#10;adapters (for primitives) and producers (for inputs), one per named target" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1010" y="290" width="240" height="62" as="geometry" /></mxCell><mxCell id="tgt" value="TARGETS&#10;simulation | physical robot" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1010" y="374" width="240" height="46" as="geometry" /></mxCell><mxCell id="never" value="WHAT EACH SIDE MAY NEVER DO&#10;An experience cannot call the robot middleware, the behaviour library, the browser, a model, the clock, the file system or the network (A0).&#10;The reasoner has no motion tool; its tool, context and ability sets are empty and it gets no camera images; its output never selects an experience, a state, a primitive or a command (A1, B6)." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="448" width="600" height="72" as="geometry" /></mxCell><mxCell id="shrink" value="WHAT THE KERNEL BUYS&#10;A single-experience coordinator named story actions directly: an effect list of about 30 kinds [I4]. The kernel replaces it with the handful of generic effects above plus the two catalogs. A new experience that recombines registered parts is an authoring task, with no kernel change (A0)." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="650" y="448" width="600" height="72" as="geometry" /></mxCell><mxCell id="alts" value="REJECTED ALTERNATIVES (A0):  one coordinator process per experience (safety and cleanup diverge)  |  one large reducer with configuration branches (one matrix for unrelated stories)  |  a workflow language (validation becomes an interpreter)  |  runtime plug-ins (weakens pinning and review)  |  an LLM that orchestrates at run time (model output cannot own safety, cleanup, identity or physical authority)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="532" width="1220" height="48" as="geometry" /></mxCell><mxCell id="legend" value="Legend:  purple = the reasoner  |  amber = the kernel and its authority  |  green = the experience (story only)  |  blue = catalogs, per-target contracts, targets  |  red = never allowed  |  dashed frame = the coordinator. Thick arrows = the path of one proposed act." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="592" width="1220" height="40" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Mechanisms: this kit's notes/ (named per line below) and glossary.md. Every number is loaded from ../constants.json by the key shown: [Pn] = public (cited); [In] = illustrative (a round design parameter that keeps the design's relations; never a measurement of any system); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/A0-one-experience-versus-many.md (kernel concerns, rejected alternatives, vocabulary shrink); A1-the-reasoner-and-the-coordinator.md (ownership table, proposal path); B1 (reducer signature); B3-the-effect-vocabulary.md (effect table); B5 (catalogs, targets); B6-conversation-and-model-boundaries.md (capability and output boundaries, bounded turns). [calc]: 24 s = 3 turns x 8 s; it fits inside the 60 s session bound.&#10;[I1] chat_turns_illustrative = 3 turns. illustrative: design parameter; bounded number of conversation turns in the example chat experience&#10;[I2] chat_turn_budget_s_illustrative = 8 s. illustrative: design parameter; per-turn time budget for one conversation turn&#10;[I3] chat_session_bound_s_illustrative = 60 s. illustrative: design parameter; upper bound on one kernel-owned conversation session&#10;[I4] old_effect_kinds_illustrative = 30 effect kinds. illustrative order of magnitude of a story-specific effect vocabulary in a single-experience coordinator, before the generic vocabulary replaced it" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="644" width="1220" height="111" as="geometry" /></mxCell><mxCell id="edge0" value="speech" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.44193548387096776;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="visitor" target="reasoner"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="speech" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0;exitY=0.5580645161290323;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="reasoner" target="visitor"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="typed intent&#10;(a proposal,&#10;never a command)" style="endArrow=classic;html=0;fontSize=9;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.25806451612903225;exitDx=0;exitDy=0;entryX=0;entryY=0.3384615384615385;entryDx=0;entryDy=0;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" parent="1" source="reasoner" target="kernel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="phase context;&#10;'not now'" style="endArrow=classic;html=0;fontSize=9;edgeStyle=none;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.45161290322580644;entryDx=0;entryDy=0;strokeColor=#d79b00;fontColor=#d79b00;" edge="1" parent="1" source="kernel" target="reasoner"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="admitted,&#10;ordered event" style="endArrow=classic;html=0;fontSize=9;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=0.06666666666666667;exitY=1;exitDx=0;exitDy=0;entryX=0.06666666666666667;entryY=0;entryDx=0;entryDy=0;strokeColor=#d79b00;fontColor=#d79b00;" edge="1" parent="1" source="kernel" target="exper"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge5" value="effects&#10;(validated&#10;before commit)" style="endArrow=classic;html=0;fontSize=9;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=0.9333333333333333;exitY=0;exitDx=0;exitDy=0;entryX=0.9333333333333333;entryY=1;entryDx=0;entryDy=0;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1" source="exper" target="kernel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="dispatch&#10;(after commit)" style="endArrow=classic;html=0;fontSize=9;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.26153846153846155;exitDx=0;exitDy=0;entryX=0;entryY=0.4857142857142857;entryDx=0;entryDy=0;strokeColor=#d79b00;fontColor=#d79b00;" edge="1" parent="1" source="kernel" target="pcat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge7" value="events" style="endArrow=classic;html=0;fontSize=9;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=0;exitY=0.35714285714285715;exitDx=0;exitDy=0;entryX=1;entryY=0.8384615384615385;entryDx=0;entryDy=0;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="icat" target="kernel"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge8" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="pcat" target="adapt"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1266" y="151" /><mxPoint x="1266" y="321" /></Array></mxGeometry></mxCell><mxCell id="edge9" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="adapt" target="icat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge10" value="commands out, observations in" style="endArrow=classic;html=0;fontSize=9;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="adapt" target="tgt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>