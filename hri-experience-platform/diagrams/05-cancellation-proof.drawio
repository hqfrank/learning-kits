<mxfile host="app.diagrams.net"><diagram id="p_05_cancellation_proof" name="05-cancellation-proof"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="777" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Cancelling is not releasing: claims are kept until positive quiescence proof, and every settle bound (1500 ms [I1]) sits inside the catalog ceiling and well inside the cleanup deadline (illustrative values)" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="48" as="geometry" /></mxCell><mxCell id="scale_t" value="TO SCALE (one axis, 94 px per second): the three bounds a cancellation lives inside" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="66" width="1220" height="22" as="geometry" /></mxCell><mxCell id="b_st_l" value="target settle bound 1500 ms [I1]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="96" width="254" height="26" as="geometry" /></mxCell><mxCell id="b_st" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="290" y="96" width="141" height="26" as="geometry" /></mxCell><mxCell id="b_ce_l" value="catalog-wide ceiling 2000 ms [I2]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="130" width="254" height="26" as="geometry" /></mxCell><mxCell id="b_ce" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="290" y="130" width="188" height="26" as="geometry" /></mxCell><mxCell id="b_ck_l" value="cleanup acknowledgement deadline 10 000 ms [I3]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="164" width="254" height="26" as="geometry" /></mxCell><mxCell id="b_ck" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="290" y="164" width="940" height="26" as="geometry" /></mxCell><mxCell id="tk0" value="0 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="260" y="208" width="60" height="16" as="geometry" /></mxCell><mxCell id="tk2000" value="2 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="448" y="208" width="60" height="16" as="geometry" /></mxCell><mxCell id="tk4000" value="4 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="636" y="208" width="60" height="16" as="geometry" /></mxCell><mxCell id="tk6000" value="6 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="824" y="208" width="60" height="16" as="geometry" /></mxCell><mxCell id="tk8000" value="8 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1012" y="208" width="60" height="16" as="geometry" /></mxCell><mxCell id="tk10000" value="10 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1200" y="208" width="60" height="16" as="geometry" /></mxCell><mxCell id="rel" value="Relation the design relies on: settle bound &lt;= ceiling &lt; cleanup deadline. Settle deadline = the EARLIER of (request time + settle bound) and any active cleanup deadline, so a cancellation never extends cleanup." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="498" y="98" width="560" height="50" as="geometry" /></mxCell><mxCell id="cancel" value="CANCEL PRIMITIVE&#10;targets the original invocation (no separate 'stop' primitive); idempotent" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="302" width="190" height="70" as="geometry" /></mxCell><mxCell id="settle" value="SETTLING&#10;every claim still held; the adapter must produce quiescence proof" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="250" y="302" width="220" height="70" as="geometry" /></mxCell><mxCell id="q1" value="positive proof before the settle deadline?" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="500" y="302" width="200" height="70" as="geometry" /></mxCell><mxCell id="rel1" value="RELEASE ALL the invocation's claims, at once" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="740" y="252" width="250" height="50" as="geometry" /></mxCell><mxCell id="forced" value="FORCED CLEANUP, reason 'cancellation stuck': keep every claim, refuse conflicting work" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="740" y="352" width="250" height="70" as="geometry" /></mxCell><mxCell id="q2" value="quiescence proved before the cleanup deadline?" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1020" y="352" width="230" height="70" as="geometry" /></mxCell><mxCell id="rel2" value="release, normal cleanup completes" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1020" y="252" width="230" height="50" as="geometry" /></mxCell><mxCell id="recov" value="RECOVERY (B2): claims stay in evidence, admission off, until operator recovery or a proven clean restart" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1020" y="452" width="230" height="64" as="geometry" /></mxCell><mxCell id="proof" value="WHAT COUNTS AS PROOF (each completion contract defines it)&#10;- physical action: terminal, and no longer holds the action slot&#10;- gaze lease: the gaze clear is acknowledged&#10;- speech stream: stopped or completed, AND its stop acknowledgement succeeded" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="452" width="470" height="76" as="geometry" /></mxCell><mxCell id="notproof" value="WHAT IS NOT PROOF&#10;lease expiry | readiness loss | adapter removal | a transport disconnect.&#10;Lease expiry only stops further forwarding of audio; the claim stays held until the stream proves it stopped." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="520" y="452" width="470" height="76" as="geometry" /></mxCell><mxCell id="revoke" value="KERNEL REVOCATIONS ARE UNCONDITIONAL: safety and reset, readiness loss, participant departure, cleanup and generation change cancel every primitive on every target. A catalog entry may add STRICTER revokers; it cannot remove or reorder these (B3)." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="540" width="1220" height="44" as="geometry" /></mxCell><mxCell id="legend" value="Legend:  bar lengths are to scale (one shared axis)  |  green = the experience's request and the clean exits  |  amber = kernel-held settlement  |  red = deadlines, non-proof, recovery  |  white = the kernel's checks." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="596" width="1220" height="40" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Mechanisms: this kit's notes/ (named per line below) and glossary.md. Every number is loaded from ../constants.json by the key shown: [Pn] = public (cited); [In] = illustrative (a round design parameter that keeps the design's relations; never a measurement of any system); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/B3-the-effect-vocabulary.md (cancellation proof, settle bound, ceiling, settle deadline, forced cleanup 'cancellation stuck', non-proof list, unconditional revocations); B2-state-ownership.md (cleanup failure enters recovery). Bars: length = value x 0.094 px/ms (drawing scale).&#10;[I1] cancel_settle_target_ms_illustrative = 1500 ms. illustrative: design parameter; one target adapter's bound for positive proof that a cancelled primitive is quiet. Must be &lt;= cancel_settle_ceiling_ms_illustrative and &lt; cleanup_ack_timeout_ms_illustrative&#10;[I2] cancel_settle_ceiling_ms_illustrative = 2000 ms. illustrative: design parameter; catalog-wide ceiling pinned in the deployment profile, shared by every target&#10;[I3] cleanup_ack_timeout_ms_illustrative = 10 000 ms. illustrative: design parameter; kernel cleanup acknowledgement deadline. Every settle bound must be strictly shorter" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="650" width="1220" height="111" as="geometry" /></mxCell><mxCell id="edge0" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="cancel" target="settle"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="settle" target="q1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="yes" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1" source="q1" target="rel1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="277" /></Array></mxGeometry></mxCell><mxCell id="edge3" value="no: the settle&#10;deadline passed" style="endArrow=classic;html=0;fontSize=9;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="q1" target="forced"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="387" /></Array></mxGeometry></mxCell><mxCell id="edge4" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="forced" target="q2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge5" value="yes" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1" source="q2" target="rel2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="no" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="q2" target="recov"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="line0" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="202" as="sourcePoint" /><mxPoint x="1230" y="202" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line1" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="202" as="sourcePoint" /><mxPoint x="290" y="207" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line2" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="478" y="202" as="sourcePoint" /><mxPoint x="478" y="207" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line3" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="666" y="202" as="sourcePoint" /><mxPoint x="666" y="207" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line4" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="854" y="202" as="sourcePoint" /><mxPoint x="854" y="207" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line5" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1042" y="202" as="sourcePoint" /><mxPoint x="1042" y="207" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line6" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1230" y="202" as="sourcePoint" /><mxPoint x="1230" y="207" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>