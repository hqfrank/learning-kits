<mxfile host="app.diagrams.net"><diagram id="p_03_state_ownership" name="03-state-ownership"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="753" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="The kernel owns the envelope; each experience owns only an opaque local story that runs inside the one shared phase 'in story', and cannot write anything around it" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="48" as="geometry" /></mxCell><mxCell id="env" value="" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;dashed=1;fillColor=none;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="820" height="440" as="geometry" /></mxCell><mxCell id="env_t" value="THE KERNEL ENVELOPE  (kernel-owned; an experience reads it through a read-only view)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="42" y="74" width="796" height="20" as="geometry" /></mxCell><mxCell id="fields" value="execution mode and lifecycle phase | deployment generation and session ID | provisional visitor candidate, active participant binding, reattach / departure / retirement state | capability health | visitor-audio permit (listening, per session) and speech-output lease (speaking, per turn), kept apart | action leases and per-invocation claims, open intervals, pending cancellations | timers, deadlines, pending commands | cleanup, safety, stop and recovery state | selected experience ID + revision | the opaque local state" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="45" y="98" width="790" height="74" as="geometry" /></mxCell><mxCell id="ph_t" value="LIFECYCLE PHASE - one closed set shared by every experience (listed in the order of note B2)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="45" y="180" width="790" height="18" as="geometry" /></mxCell><mxCell id="ph0" value="not ready" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="45" y="200" width="90" height="36" as="geometry" /></mxCell><mxCell id="ph1" value="ready" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="144" y="200" width="90" height="36" as="geometry" /></mxCell><mxCell id="ph2" value="selecting" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="243" y="200" width="90" height="36" as="geometry" /></mxCell><mxCell id="ph3" value="in story" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="342" y="200" width="90" height="36" as="geometry" /></mxCell><mxCell id="ph4" value="cleanup" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="441" y="200" width="90" height="36" as="geometry" /></mxCell><mxCell id="ph5" value="safe cleanup" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="540" y="200" width="90" height="36" as="geometry" /></mxCell><mxCell id="ph6" value="stopped" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="639" y="200" width="90" height="36" as="geometry" /></mxCell><mxCell id="ph7" value="recovery" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="738" y="200" width="90" height="36" as="geometry" /></mxCell><mxCell id="story" value="" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;dashed=1;fillColor=none;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="45" y="286" width="790" height="210" as="geometry" /></mxCell><mxCell id="story_t" value="LOCAL STORY STATE - private to the selected experience, opaque to the kernel, valid only in 'in story'. Example: the wave experience, story greet -&gt; await_wave -&gt; wave (B1)." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="57" y="290" width="770" height="34" as="geometry" /></mxCell><mxCell id="greet" value="greet&#10;(chapter)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="70" y="352" width="140" height="54" as="geometry" /></mxCell><mxCell id="await" value="await_wave&#10;starts a 10 s gesture-wait timer [I1]" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="290" y="352" width="200" height="54" as="geometry" /></mxCell><mxCell id="wave" value="wave&#10;(timer cancelled)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="640" y="352" width="170" height="54" as="geometry" /></mxCell><mxCell id="gno" value="gesture_not_observed&#10;(terminal local state)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="290" y="438" width="200" height="50" as="geometry" /></mxCell><mxCell id="gno_n" value="Its only effect: 'request completion cleanup'. A visitor-gesture input from any OTHER track is rejected at admission and never reaches this reducer (B4)." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="510" y="434" width="310" height="60" as="geometry" /></mxCell><mxCell id="recov" value="RECOVERY is kernel-owned: unresolved claims stay in evidence and visitor admission stays off. Only explicit operator recovery, or a clean restart that proves the old authority cannot act, leaves it. The first coordinator treated this timeout as a clean stop; the kernel design corrects that (B2)." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="525" width="820" height="58" as="geometry" /></mxCell><mxCell id="auth" value="PARTICIPANT AUTHORITY - kernel&#10;selects the candidate, ties a handshake to a track, authorises lock, retarget, reattach and departure, retires the participant, and passes the reducer a typed decision: provisional | locked | retargeted | reattached | departed.&#10;Current participant track = active binding's track, else the candidate's; none before selection or after retirement. Invariant, independent of any story state: never a candidate AND an active participant." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="870" y="70" width="380" height="150" as="geometry" /></mxCell><mxCell id="pol" value="PARTICIPANT POLICY - experience&#10;only its story response plus typed options the kernel exposes, e.g. 'lock the participant when the handshake times out: yes / no'. A new lock rule or grace is a kernel change and a safety review." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="870" y="228" width="380" height="72" as="geometry" /></mxCell><mxCell id="vals" value="AFTER EVERY REDUCTION, in order: 1 kernel invariants on the tentative envelope (cannot be waived) -&gt; 2 story validator (reads the envelope view, cannot change it). A failure commits nothing." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="870" y="308" width="380" height="62" as="geometry" /></mxCell><mxCell id="contract" value="LOCAL STATE CONTRACT: schema version | required state_name | deep immutability (scalars, enums, tuples, frozen records; no lists, maps, sets, callables) | one kernel-owned canonical encoding | equality = equal encodings. The simulation, browser and gateway may branch only on the kernel phase and on projector values, never on a local state name." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="870" y="378" width="380" height="98" as="geometry" /></mxCell><mxCell id="prof" value="TWO LEVELS OF PROFILE: the experience PROFILE (content-addressed) pins target, images, config and ABI digests, accepted inputs and primitives, catalog policy, readiness, cleanup, evidence and acceptance, and exactly one definition. The DEFINITION selects only story logic, so a story never picks its own privileges." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="870" y="484" width="380" height="98" as="geometry" /></mxCell><mxCell id="legend" value="Legend:  amber = kernel-owned  |  green = experience-owned  |  red = recovery  |  blue = deployment profile  |  dashed amber frame = the envelope, dashed green frame = the opaque story inside 'in story'. Only the transitions the notes state are drawn between phases; the others are not." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="596" width="1220" height="40" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Mechanisms: this kit's notes/ (named per line below) and glossary.md. Every number is loaded from ../constants.json by the key shown: [Pn] = public (cited); [In] = illustrative (a round design parameter that keeps the design's relations; never a measurement of any system); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/B2-state-ownership.md (envelope fields, lifecycle phases, two validators, participant authority vs policy, current participant track, local state contract, cleanup failure to recovery, two profile levels); B1-experiences-as-reducers.md (the wave example); B4 (admission of participant-bound inputs). Public: Harel, 'Statecharts', Science of Computer Programming 8(3), 1987 (a story nested inside one lifecycle state).&#10;[I1] gesture_wait_timeout_s_illustrative = 10 s. illustrative: design parameter; experience-policy timer for the 'await wave' local state of the example wave experience&#10;[I2] cleanup_ack_timeout_ms_illustrative = 10 000 ms. illustrative: design parameter; kernel cleanup acknowledgement deadline. Every settle bound must be strictly shorter" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="650" width="1220" height="87" as="geometry" /></mxCell><mxCell id="edge0" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1" source="greet" target="await"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="gesture = wave from the&#10;current participant track" style="endArrow=classic;html=0;fontSize=9;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1" source="await" target="wave"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="timer expiry" style="endArrow=classic;html=0;fontSize=9;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1" source="await" target="gno"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.43291139240506327;entryY=0;entryDx=0;entryDy=0;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1" source="ph3" target="story"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#d79b00;fontColor=#d79b00;" edge="1" parent="1" source="ph3" target="ph4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge5" value="cleanup deadline 10 000 ms [I2] passes without quiescence proof" style="endArrow=classic;html=0;fontSize=9;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="ph4" target="ph7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="486" y="262" /><mxPoint x="783" y="262" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>