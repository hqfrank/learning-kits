<mxfile host="app.diagrams.net"><diagram id="p_04_resource_claims" name="04-resource-claims"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="802" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Resource claims decide what may overlap: one physical action, one gaze lease and one conversation turn can run together, but two physical actions never can, because each needs the one action slot" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="48" as="geometry" /></mxCell><mxCell id="hk" value="contract kind  \  resource" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="170" height="40" as="geometry" /></mxCell><mxCell id="h0" value="action slot" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="200" y="70" width="118" height="40" as="geometry" /></mxCell><mxCell id="h1" value="body" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="318" y="70" width="118" height="40" as="geometry" /></mxCell><mxCell id="h2" value="head" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="436" y="70" width="118" height="40" as="geometry" /></mxCell><mxCell id="h3" value="gaze" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="554" y="70" width="118" height="40" as="geometry" /></mxCell><mxCell id="h4" value="audio out" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="672" y="70" width="118" height="40" as="geometry" /></mxCell><mxCell id="h5" value="listening" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="790" y="70" width="118" height="40" as="geometry" /></mxCell><mxCell id="k0" value="PHYSICAL ACTION&#10;wave, expression, handshake, canned robot TTS, composites" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=9;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="170" height="66" as="geometry" /></mxCell><mxCell id="c00" value="ALWAYS&#10;exclusive" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="200" y="110" width="118" height="66" as="geometry" /></mxCell><mxCell id="c01" value="optional" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;dashed=1;fillColor=#fff7ee;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="318" y="110" width="118" height="66" as="geometry" /></mxCell><mxCell id="c02" value="optional;&#10;never with gaze" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;dashed=1;fillColor=#fff7ee;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="436" y="110" width="118" height="66" as="geometry" /></mxCell><mxCell id="c03" value="optional;&#10;never with head" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;dashed=1;fillColor=#fff7ee;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="554" y="110" width="118" height="66" as="geometry" /></mxCell><mxCell id="c04" value="optional" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;dashed=1;fillColor=#fff7ee;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="672" y="110" width="118" height="66" as="geometry" /></mxCell><mxCell id="k1" value="GAZE LEASE&#10;set / clear a gaze target; priority derived from the gaze mode" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=9;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="176" width="170" height="66" as="geometry" /></mxCell><mxCell id="c10" value="-" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="200" y="176" width="118" height="66" as="geometry" /></mxCell><mxCell id="c11" value="-" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="318" y="176" width="118" height="66" as="geometry" /></mxCell><mxCell id="c12" value="-" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="436" y="176" width="118" height="66" as="geometry" /></mxCell><mxCell id="c13" value="EXACTLY this,&#10;exclusive" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="554" y="176" width="118" height="66" as="geometry" /></mxCell><mxCell id="c14" value="-" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="672" y="176" width="118" height="66" as="geometry" /></mxCell><mxCell id="k2" value="SESSION SERVICE&#10;conversation turn, enrolment, gift offer, greeting, operator alert" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=9;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="242" width="170" height="66" as="geometry" /></mxCell><mxCell id="c20" value="-" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="200" y="242" width="118" height="66" as="geometry" /></mxCell><mxCell id="c21" value="-" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="318" y="242" width="118" height="66" as="geometry" /></mxCell><mxCell id="c22" value="-" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="436" y="242" width="118" height="66" as="geometry" /></mxCell><mxCell id="c23" value="-" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="554" y="242" width="118" height="66" as="geometry" /></mxCell><mxCell id="c24" value="nothing, or&#10;exclusive via an&#10;output lease" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="672" y="242" width="118" height="66" as="geometry" /></mxCell><mxCell id="listen" value="NOT CLAIMABLE&#10;listening is the kernel's visitor-audio permit, not a resource" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="790" y="110" width="118" height="198" as="geometry" /></mxCell><mxCell id="rules" value="WHAT FOLLOWS (B3)&#10;- Every physical action claims the one action slot, so two physical actions never run at once.&#10;- Concurrency exists only BETWEEN kinds: one physical action + one gaze lease + one conversation turn.&#10;- Head and gaze drive the same actuators: no primitive claims both; an exclusive-head primitive is refused while a gaze lease is active.&#10;- Conversation speech (session service on an output lease) may overlap a wave; canned robot TTS cannot, it occupies the slot. A line + gesture is ONE composite primitive." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="928" y="70" width="322" height="238" as="geometry" /></mxCell><mxCell id="conf" value="CONFLICT MATRIX (closed; no primitive or experience may override it, B4):  action slot - an equal-or-lower priority request is deferred, a higher one preempts and waits for the old command's terminal cancellation  |  gaze - refuses lower priority, replaces at equal or higher after the prior clear succeeds  |  audio out - a conflict is refused  |  safety priority is reserved for the kernel" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="322" width="1220" height="44" as="geometry" /></mxCell><mxCell id="tl_t" value="THE SHOWCASE SCENARIO (C2), with the conservative first wave primitive (slot + body + head, all exclusive, no audio). Order only: the notes give no durations, so bar lengths are a drawing choice." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="382" width="1220" height="34" as="geometry" /></mxCell><mxCell id="lane_gaze" value="gaze (gaze lease)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="452" width="200" height="40" as="geometry" /></mxCell><mxCell id="track_gaze" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=#999999;strokeWidth=0.8;" vertex="1" parent="1"><mxGeometry x="238" y="452" width="1012" height="40" as="geometry" /></mxCell><mxCell id="lane_slot" value="action slot + body + head (wave)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="506" width="200" height="40" as="geometry" /></mxCell><mxCell id="track_slot" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=#999999;strokeWidth=0.8;" vertex="1" parent="1"><mxGeometry x="238" y="506" width="1012" height="40" as="geometry" /></mxCell><mxCell id="lane_aud" value="audio out (output lease per turn)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="560" width="200" height="40" as="geometry" /></mxCell><mxCell id="track_aud" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=#999999;strokeWidth=0.8;" vertex="1" parent="1"><mxGeometry x="238" y="560" width="1012" height="40" as="geometry" /></mxCell><mxCell id="g1" value="participant gaze" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="270" y="458" width="300" height="28" as="geometry" /></mxCell><mxCell id="g2" value="gaze reacquired" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1020" y="458" width="150" height="28" as="geometry" /></mxCell><mxCell id="w1" value="wave" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="720" y="512" width="150" height="28" as="geometry" /></mxCell><mxCell id="a1" value="speech turn" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="410" y="566" width="150" height="28" as="geometry" /></mxCell><mxCell id="a2" value="speech turn" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="690" y="566" width="160" height="28" as="geometry" /></mxCell><mxCell id="st0" value="1 participant gaze acquired" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="202" y="418" width="136" height="28" as="geometry" /></mxCell><mxCell id="st1" value="2 brokered speech overlaps gaze" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="352" y="418" width="136" height="28" as="geometry" /></mxCell><mxCell id="st2" value="3 positive gaze clear (ack)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="502" y="418" width="136" height="28" as="geometry" /></mxCell><mxCell id="st3" value="4 brokered speech overlaps the wave" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="652" y="418" width="136" height="28" as="geometry" /></mxCell><mxCell id="st4" value="5 authoritative wave completion" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="802" y="418" width="136" height="28" as="geometry" /></mxCell><mxCell id="st5" value="6 correlated gaze reacquisition" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="952" y="418" width="136" height="28" as="geometry" /></mxCell><mxCell id="st6" value="7 cleanup: no retained claim" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1102" y="418" width="136" height="28" as="geometry" /></mxCell><mxCell id="gap" value="Between 3 and 4 the gaze lease is cleared WITH acknowledgement before the wave starts: the wave claims the head exclusively. A lighter arm-only wave would be a later catalog revision with its own scenario (B3)." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="614" width="600" height="44" as="geometry" /></mxCell><mxCell id="proof" value="The video only illustrates the overlaps. The proof is the held intervals in the evidence (acquired -&gt; released per invocation), read from evidence fields, never inferred from presentation events (C2)." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="650" y="614" width="600" height="44" as="geometry" /></mxCell><mxCell id="legend" value="Legend:  matrix - solid amber = claim always held (exclusive) | dashed light amber = optional claim | white '-' = never claimed | red = not a resource.  Timeline - amber = gaze lease, green = physical action, purple = conversation turn; dashed verticals = the seven showcase steps in order." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="670" width="1220" height="40" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Mechanisms: this kit's notes/ (named per line below) and glossary.md. Every number is loaded from ../constants.json by the key shown: [Pn] = public (cited); [In] = illustrative (a round design parameter that keeps the design's relations; never a measurement of any system); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/B3-the-effect-vocabulary.md (contract kinds, resources and permitted claims, action slot, head vs gaze, speech vs canned TTS, composite primitives, conservative first wave claims); B4-kernel-interception-and-arbitration.md (closed conflict matrix); C2-the-conformance-ladder.md (showcase scenario order, held intervals, 'the video illustrates, the evidence proves'). This page carries no numeric design parameter." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="724" width="1220" height="62" as="geometry" /></mxCell><mxCell id="line0" value="" style="endArrow=none;html=0;strokeColor=#666666;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270" y="446" as="sourcePoint" /><mxPoint x="270" y="604" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line1" value="" style="endArrow=none;html=0;strokeColor=#666666;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="446" as="sourcePoint" /><mxPoint x="420" y="604" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line2" value="" style="endArrow=none;html=0;strokeColor=#666666;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="570" y="446" as="sourcePoint" /><mxPoint x="570" y="604" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line3" value="" style="endArrow=none;html=0;strokeColor=#666666;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="720" y="446" as="sourcePoint" /><mxPoint x="720" y="604" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line4" value="" style="endArrow=none;html=0;strokeColor=#666666;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="446" as="sourcePoint" /><mxPoint x="870" y="604" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line5" value="" style="endArrow=none;html=0;strokeColor=#666666;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="446" as="sourcePoint" /><mxPoint x="1020" y="604" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line6" value="" style="endArrow=none;html=0;strokeColor=#666666;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1170" y="446" as="sourcePoint" /><mxPoint x="1170" y="604" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>