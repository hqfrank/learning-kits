<mxfile host="app.diagrams.net"><diagram id="p_01_diagnosis_map" name="01-diagnosis-map"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="950" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Each service slows for its own reason: pool CPU from alone to the full stack, GPU turns from the full stack to full stack + VLA, and two of the largest full-stack numbers were our bench and a logging bug, not the platform" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=20;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1440" height="60" as="geometry" /></mxCell><mxCell id="sub" value="All measured values on this page are illustrative measurements: round teaching numbers that keep the shape of each finding (class in constants.json). Pre-registered verdicts are in bold quotes." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="22" y="70" width="1436" height="18" as="geometry" /></mxCell><mxCell id="h0" value="SERVICE and symptom&lt;br/&gt;alone -&amp;gt; full stack (-&amp;gt; + VLA)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fontStyle=1;fillColor=#e6e6e6;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="96" width="255" height="32" as="geometry" /></mxCell><mxCell id="h1" value="CAUSE supported by evidence (confidence)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fontStyle=1;fillColor=#e6e6e6;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="96" width="385" height="32" as="geometry" /></mxCell><mxCell id="h2" value="EXPERIMENT that showed it" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fontStyle=1;fillColor=#e6e6e6;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="700" y="96" width="385" height="32" as="geometry" /></mxCell><mxCell id="h3" value="CORRECTION kept visible&lt;br/&gt;(first reading -&amp;gt; corrected)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fontStyle=1;fillColor=#e6e6e6;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1100" y="96" width="350" height="32" as="geometry" /></mxCell><mxCell id="s0" value="&lt;b&gt;The depth camera service&lt;/b&gt;, frame rate&lt;br/&gt;30 Hz alone [camera_hz_alone, illustrative]; loses 5 Hz in the full stack [camera_full_stack_loss_hz, illustrative]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=11;spacing=6;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="132" width="255" height="90" as="geometry" /></mxCell><mxCell id="c0" value="&lt;b&gt;[CPU]&lt;/b&gt; Pool CPU load + the full stack's extra topic demand (fan-out); provisional.&lt;br/&gt;GPU sharing alone costs 0 Hz with an idle pool [camera_gpu_only_loss_hz, illustrative].&lt;br/&gt;Confidence: medium" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="132" width="385" height="90" as="geometry" /></mxCell><mxCell id="x0" value="&lt;b&gt;One load per window:&lt;/b&gt; GPU minor; pool &lt;b&gt;&quot;undecided at dose&quot;&lt;/b&gt;; fan-out a minor share (1 of 5 Hz [camera_fanout_loss_hz, illustrative]).&lt;br/&gt;&lt;b&gt;Weight arm:&lt;/b&gt; cpu.weight 100 -&amp;gt; 1000 [cpu_weight_default; weight_raised, illustrative]: verdict &lt;b&gt;&quot;split&quot;&lt;/b&gt;." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="700" y="132" width="385" height="90" as="geometry" /></mxCell><mxCell id="k0" value="&quot;The camera is GPU-bound&quot; -&amp;gt; weakened: GPU load alone cost it no frames; GPU + pool load together not tested.&lt;br/&gt;&quot;nice on its threads tests priority&quot; -&amp;gt; invalid test: each container is its own cgroup (note A3)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;dashed=1;dashPattern=6 4;fillColor=#f3ecf7;strokeColor=#9673a6;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1100" y="132" width="350" height="90" as="geometry" /></mxCell><mxCell id="s1" value="&lt;b&gt;The object detector&lt;/b&gt;, frame time&lt;br/&gt;100 -&amp;gt; 200 ms per frame [detector_frame_ms_solo_full, illustrative]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=11;spacing=6;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="232" width="255" height="90" as="geometry" /></mxCell><mxCell id="c1" value="&lt;b&gt;[CPU]&lt;/b&gt; alone -&amp;gt; full stack: run-queue wait is the largest added term, plus the same work running slower (medium-high).&lt;br/&gt;&lt;b&gt;[GPU]&lt;/b&gt; full stack -&amp;gt; + VLA: GPU time-slicing between processes (medium-high in a camera-plus-detector row; expected, not tested, in the full stack)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#e3f0ea;strokeColor=#5f8f9e;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="232" width="385" height="90" as="geometry" /></mxCell><mxCell id="x1" value="&lt;b&gt;Inventory:&lt;/b&gt; per-frame wait / run / blocked split (page 03).&lt;br/&gt;&lt;b&gt;Counters:&lt;/b&gt; same instructions, more cycles (page 04).&lt;br/&gt;&lt;b&gt;Dose series:&lt;/b&gt; &lt;b&gt;&quot;dose explains&quot;&lt;/b&gt;; the full stack placed on the curve is post-hoc (note B1)." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="700" y="232" width="385" height="90" as="geometry" /></mxCell><mxCell id="k1" value="&quot;CPU changes full stack -&amp;gt; + VLA are within spread&quot; -&amp;gt; withdrawn: with voice on in both, pool wait rises.&lt;br/&gt;&quot;SM contention&quot; -&amp;gt; time-slicing (no MPS, no overlap; page 05).&lt;br/&gt;&quot;neither alone&quot; -&amp;gt; the low end of a convex curve." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;dashed=1;dashPattern=6 4;fillColor=#f3ecf7;strokeColor=#9673a6;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1100" y="232" width="350" height="90" as="geometry" /></mxCell><mxCell id="s2" value="&lt;b&gt;Voice chain&lt;/b&gt; (the speech recognizer -&amp;gt; the dialogue engine), transcript p50&lt;br/&gt;600 -&amp;gt; 850 ms [transcript_latency_ms: alone, full, illustrative]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=11;spacing=6;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="332" width="255" height="90" as="geometry" /></mxCell><mxCell id="c2" value="&lt;b&gt;[BUG]&lt;/b&gt; A logging cost in the dialogue engine that grows with conversation history, on its asyncio thread: one INFO line per history item.&lt;br/&gt;Confidence: high for alone -&amp;gt; full stack" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="332" width="385" height="90" as="geometry" /></mxCell><mxCell id="x2" value="&lt;b&gt;Log filter&lt;/b&gt; in the full stack: context loop about 225 ms (my estimate from `ms_per_history_item` and `history_items`) -&amp;gt; 10 ms [context_build_ms_filtered, illustrative]; transcript p50 640 ms [transcript_latency_ms: full_filtered], near alone." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="700" y="332" width="385" height="90" as="geometry" /></mxCell><mxCell id="k2" value="Not the platform: the largest voice number was our own software's logging loop, O(history) (note A4)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;dashed=1;dashPattern=6 4;fillColor=#f3ecf7;strokeColor=#9673a6;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1100" y="332" width="350" height="90" as="geometry" /></mxCell><mxCell id="s3" value="&lt;b&gt;The interaction service&lt;/b&gt;, request accepted p50&lt;br/&gt;2 -&amp;gt; 40 ms [interaction_accepted_ms: alone, probe_on_its_core, illustrative]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=11;spacing=6;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="432" width="255" height="90" as="geometry" /></mxCell><mxCell id="c3" value="&lt;b&gt;[BENCH]&lt;/b&gt; Mostly our measurement probe on the same reserved core: about 90 % of the rise (my estimate from `interaction_accepted_ms`: (40 − 5) ÷ (40 − 2) ≈ 0.92).&lt;br/&gt;Confidence: high" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="432" width="385" height="90" as="geometry" /></mxCell><mxCell id="x3" value="&lt;b&gt;Probe move&lt;/b&gt; to a pool core: accepted p50 5 ms [interaction_accepted_ms: probe_moved].&lt;br/&gt;Predicted near alone: met; refutation rule not met." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="700" y="432" width="385" height="90" as="geometry" /></mxCell><mxCell id="k3" value="&quot;The platform is loaded, so the service's latency rises&quot; -&amp;gt; about 90 % of the rise was our probe on the service's core (page 02)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;dashed=1;dashPattern=6 4;fillColor=#f3ecf7;strokeColor=#9673a6;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1100" y="432" width="350" height="90" as="geometry" /></mxCell><mxCell id="s4" value="&lt;b&gt;The motor-control services&lt;/b&gt;, cycles for the same work&lt;br/&gt;1.4× to 2× the alone cycles [cycles_growth_range, illustrative]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=11;spacing=6;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="532" width="255" height="90" as="geometry" /></mxCell><mxCell id="c4" value="&lt;b&gt;[CPU]&lt;/b&gt; Same work, more cycles (IPC loss), no run-queue wait. Moving their cluster-mates away removes about two thirds (f = 0.65 [cluster_move_recovered, illustrative]); path not isolated.&lt;br/&gt;Confidence: medium" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="532" width="385" height="90" as="geometry" /></mxCell><mxCell id="x4" value="&lt;b&gt;Counters:&lt;/b&gt; instructions per unit growth 0.0 [instr_growth, illustrative]; cycles +40 % to +100 % [cycles_growth_range].&lt;br/&gt;&lt;b&gt;Cluster move:&lt;/b&gt; &lt;b&gt;&quot;most (or less board traffic)&quot;&lt;/b&gt;, f above the 0.5 line [cluster_move_class_line, illustrative]." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="700" y="532" width="385" height="90" as="geometry" /></mxCell><mxCell id="k4" value="Predicted &quot;part&quot; (f below the line) -&amp;gt; measured above it but close to it. Read as &quot;about two thirds&quot;, not a clean &quot;most&quot; (page 04)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;dashed=1;dashPattern=6 4;fillColor=#f3ecf7;strokeColor=#9673a6;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1100" y="532" width="350" height="90" as="geometry" /></mxCell><mxCell id="s5" value="&lt;b&gt;The VLA&lt;/b&gt;, offered 5 Hz [vla_offered_hz, illustrative]&lt;br/&gt;call 150 ms alone [vla_call_ms, illustrative]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=11;spacing=6;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="632" width="255" height="90" as="geometry" /></mxCell><mxCell id="c5" value="&lt;b&gt;[GPU]&lt;/b&gt; GPU-time-bound: it needs 0.6 s of GPU time per s, the stack leaves 0.4 [gpu_free_next_to_stack, illustrative] (my estimate from `vla_gpu_ms_per_call` and `vla_offered_hz`).&lt;br/&gt;Confidence: medium" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="632" width="385" height="90" as="geometry" /></mxCell><mxCell id="x5" value="&lt;b&gt;Budget&lt;/b&gt; (not a pre-registered test): 120 ms GPU work per call [vla_gpu_ms_per_call, illustrative]; the free time supports at most about 3.3 calls per s (my estimate from `gpu_free_next_to_stack` and `vla_gpu_ms_per_call`)." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="700" y="632" width="385" height="90" as="geometry" /></mxCell><mxCell id="k5" value="&quot;GPU need = call time × rate&quot; (0.75 s per s, my estimate from `vla_call_ms` and `vla_offered_hz`) -&amp;gt; no: a call contains CPU-side time; budget the GPU time per call (note C1)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;dashed=1;dashPattern=6 4;fillColor=#f3ecf7;strokeColor=#9673a6;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1100" y="632" width="350" height="90" as="geometry" /></mxCell><mxCell id="kgen" value="&lt;b&gt;Corrections not tied to one service:&lt;/b&gt;  &quot;A low SM issue rate means free room&quot; -&amp;gt; about half the kernel time (0.5 [kernel_time_sms_full_share, illustrative]) already fills the SMs on some resource, by launch configuration (&lt;b&gt;theoretical&lt;/b&gt;; note B2).   &quot;More GPU compute would not help&quot; -&amp;gt; multi-wave kernels would run in fewer waves on more SMs (expectation, not measured).   &quot;The vision encoder is several times slower than predicted&quot; -&amp;gt; the prediction used the bandwidth form, 6 ms [vision_pred_bandwidth_form_ms, illustrative], on a board where vision is compute-bound; the compute form gives 20–30 ms [vision_compute_form_ms, illustrative] (note B4)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;dashed=1;dashPattern=6 4;fillColor=#f3ecf7;strokeColor=#9673a6;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="738" width="1420" height="76" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br/&gt;Cause fill + tag: blue &lt;b&gt;[CPU]&lt;/b&gt; = shared CPU pool / caches; green &lt;b&gt;[GPU]&lt;/b&gt; = GPU time-slicing; teal = both (one per step); amber &lt;b&gt;[BENCH]&lt;/b&gt; / &lt;b&gt;[BUG]&lt;/b&gt; = our bench or our software, not the platform.&lt;br/&gt;Purple dashed box = a correction: the first reading and what replaced it.&lt;br/&gt;&lt;b&gt;Bold quoted verdicts&lt;/b&gt; = pre-registered classes, unchanged.&lt;br/&gt;Load levels: alone = one service; full stack = every module on, about 40 services [stack_services, illustrative]; + VLA = full stack plus a VLA (vision-language-action model) at its offered rate." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#f7f7f7;strokeColor=#bbbbbb;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="826" width="575" height="108" as="geometry" /></mxCell><mxCell id="src" value="&lt;b&gt;Sources.&lt;/b&gt; Every number is loaded from ../constants.json by spec01.py; its key is in brackets. Notes A0 (diagnosis map, corrections table), A1–A5, B1–B4, C1. Probe rates in the full stack are lower bounds; probe latencies are upper bounds (notes A1, A5).&lt;br/&gt;&lt;b&gt;Illustrative&lt;/b&gt; (round teaching numbers that keep the shape of a finding; not measurements): camera_hz_alone, camera_full_stack_loss_hz, camera_gpu_only_loss_hz, camera_fanout_loss_hz, weight_raised, detector_frame_ms_solo_full, transcript_latency_ms, ms_per_history_item, history_items, context_build_ms_filtered, interaction_accepted_ms, cycles_growth_range, cluster_move_recovered, instr_growth, cluster_move_class_line, vla_offered_hz, vla_call_ms, gpu_free_next_to_stack, vla_gpu_ms_per_call, kernel_time_sms_full_share, vision_pred_bandwidth_form_ms, vision_compute_form_ms, stack_services.&lt;br/&gt;&lt;b&gt;Public&lt;/b&gt;: cpu_weight_default = https://docs.kernel.org/admin-guide/cgroup-v2.html (cpu.weight)." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=#fff8dc;strokeColor=#d6b656;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="620" y="826" width="830" height="101" as="geometry" /></mxCell><mxCell id="e0" value="" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#777777;strokeWidth=1.5;" edge="1" parent="1" source="s0" target="c0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#777777;strokeWidth=1.5;" edge="1" parent="1" source="c0" target="x0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#777777;strokeWidth=1.5;" edge="1" parent="1" source="s1" target="c1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#777777;strokeWidth=1.5;" edge="1" parent="1" source="c1" target="x1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#777777;strokeWidth=1.5;" edge="1" parent="1" source="s2" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#777777;strokeWidth=1.5;" edge="1" parent="1" source="c2" target="x2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#777777;strokeWidth=1.5;" edge="1" parent="1" source="s3" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#777777;strokeWidth=1.5;" edge="1" parent="1" source="c3" target="x3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e8" value="" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#777777;strokeWidth=1.5;" edge="1" parent="1" source="s4" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#777777;strokeWidth=1.5;" edge="1" parent="1" source="c4" target="x4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#777777;strokeWidth=1.5;" edge="1" parent="1" source="s5" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#777777;strokeWidth=1.5;" edge="1" parent="1" source="c5" target="x5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>