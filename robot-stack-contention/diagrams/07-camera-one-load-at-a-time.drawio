<mxfile host="app.diagrams.net"><diagram id="p_07_camera_one_load_at_a_time" name="07-camera-one-load-at-a-time"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="796" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="GPU load alone costs the depth camera service no frames; shared-pool CPU wait costs it frames (0.3 Hz at half the full stack's wait [camera_pool_loss_hz: half_full_wait, illustrative]; the higher arm is void), so the pool verdict is &quot;undecided at dose&quot;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=20;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1400" height="60" as="geometry" /></mxCell><mxCell id="gp" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacing=6;fillColor=none;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="84" width="480" height="440" as="geometry" /></mxCell><mxCell id="gh" value="&lt;b&gt;Factor 1: GPU compute co-tenant, idle CPU pool&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=12;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="460" height="34" as="geometry" /></mxCell><mxCell id="gxt0" value="none" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60.0" y="406" width="60" height="15" as="geometry" /></mxCell><mxCell id="gxt1" value="max" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="313.8461538461538" y="406" width="60" height="15" as="geometry" /></mxCell><mxCell id="gyt0" value="0" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="364.22222222222223" width="44" height="16" as="geometry" /></mxCell><mxCell id="gyt1" value="2" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="308.6666666666667" width="44" height="16" as="geometry" /></mxCell><mxCell id="gyt2" value="4" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="253.1111111111111" width="44" height="16" as="geometry" /></mxCell><mxCell id="gyt3" value="6" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="197.55555555555554" width="44" height="16" as="geometry" /></mxCell><mxCell id="gyt4" value="8" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="142.0" width="44" height="16" as="geometry" /></mxCell><mxCell id="gxl" value="GPU dose; max = highest tested (no dose values here)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="90" y="422" width="330" height="18" as="geometry" /></mxCell><mxCell id="gyl" value="camera loss vs alone (Hz)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="126" width="380" height="18" as="geometry" /></mxCell><mxCell id="gfl" value="full stack, all loads together: 5 Hz [camera_full_stack_loss_hz, illustrative]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="94.0" y="213.33333333333334" width="320" height="18" as="geometry" /></mxCell><mxCell id="ga0" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#b9dfb0;strokeColor=#3f7f33;strokeWidth=1.8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="147.5" y="366.2" width="12" height="12" as="geometry" /></mxCell><mxCell id="ga1" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#b9dfb0;strokeColor=#3f7f33;strokeWidth=1.8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="210.9" y="366.2" width="12" height="12" as="geometry" /></mxCell><mxCell id="ga2" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#b9dfb0;strokeColor=#3f7f33;strokeWidth=1.8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="274.4" y="366.2" width="12" height="12" as="geometry" /></mxCell><mxCell id="ga3" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#b9dfb0;strokeColor=#3f7f33;strokeWidth=1.8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="337.8" y="366.2" width="12" height="12" as="geometry" /></mxCell><mxCell id="gal" value="0 Hz at every GPU dose tested [camera_gpu_only_loss_hz, illustrative] (dot count and spacing schematic)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#3f7f33;" vertex="1" parent="1"><mxGeometry x="115.38461538461539" y="332.22222222222223" width="300" height="32" as="geometry" /></mxCell><mxCell id="gbe" value="full stack + VLA dose: beyond the highest GPU arm (not tested)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="247.3846153846154" y="277.77777777777777" width="230" height="30" as="geometry" /></mxCell><mxCell id="gv" value="&lt;b&gt;&quot;GPU minor&quot;&lt;/b&gt;: no measurable loss at any GPU dose tested.&lt;br/&gt;A substantial GPU share had been predicted: &lt;b&gt;the prediction was wrong.&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="456" width="400" height="56" as="geometry" /></mxCell><mxCell id="pp" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacing=6;fillColor=none;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="515" y="84" width="480" height="440" as="geometry" /></mxCell><mxCell id="ph" value="&lt;b&gt;Factor 2: shared-pool CPU load&lt;/b&gt; [camera_pool_loss_hz]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=12;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="525" y="90" width="460" height="34" as="geometry" /></mxCell><mxCell id="above" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#f2f2f2;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="737.0" y="150" width="228.0" height="250" as="geometry" /></mxCell><mxCell id="pxt0" value="0" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="555.0" y="406" width="60" height="15" as="geometry" /></mxCell><mxCell id="pxt1" value="0.5" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="631.0" y="406" width="60" height="15" as="geometry" /></mxCell><mxCell id="pxt2" value="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="707.0" y="406" width="60" height="15" as="geometry" /></mxCell><mxCell id="pxt3" value="1.5" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="783.0" y="406" width="60" height="15" as="geometry" /></mxCell><mxCell id="pxt4" value="2" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="859.0" y="406" width="60" height="15" as="geometry" /></mxCell><mxCell id="pxt5" value="2.5" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="935.0" y="406" width="60" height="15" as="geometry" /></mxCell><mxCell id="pyt0" value="0" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="535" y="364.22222222222223" width="44" height="16" as="geometry" /></mxCell><mxCell id="pyt1" value="2" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="535" y="308.6666666666667" width="44" height="16" as="geometry" /></mxCell><mxCell id="pyt2" value="4" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="535" y="253.1111111111111" width="44" height="16" as="geometry" /></mxCell><mxCell id="pyt3" value="6" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="535" y="197.55555555555554" width="44" height="16" as="geometry" /></mxCell><mxCell id="pyt4" value="8" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="535" y="142.0" width="44" height="16" as="geometry" /></mxCell><mxCell id="pxl" value="camera's CPU wait ÷ the full stack's camera wait" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="585" y="422" width="380" height="18" as="geometry" /></mxCell><mxCell id="pyl" value="camera loss vs alone (Hz)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="535" y="126" width="430" height="18" as="geometry" /></mxCell><mxCell id="abl" value="above the full stack's wait:&lt;br/&gt;no valid arm" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="744.6" y="330.55555555555554" width="170" height="30" as="geometry" /></mxCell><mxCell id="pa0" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="578.0" y="365.2" width="14" height="14" as="geometry" /></mxCell><mxCell id="pa1" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#9fc0e8;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="654.0" y="356.9" width="14" height="14" as="geometry" /></mxCell><mxCell id="pa2" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;dashed=1;dashPattern=3 2;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="882.0" y="198.6" width="14" height="14" as="geometry" /></mxCell><mxCell id="pal1" value="&lt;b&gt;valid arm&lt;/b&gt;, half the wait:&lt;br/&gt;0.3 Hz" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="589.56" y="316.6666666666667" width="140" height="30" as="geometry" /></mxCell><mxCell id="pal2" value="twice the wait: 6 Hz&lt;br/&gt;&lt;b&gt;VOID&lt;/b&gt; (failed the rate gate)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="717.0" y="159.55555555555554" width="180" height="36" as="geometry" /></mxCell><mxCell id="fs" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#333333;strokeColor=#333333;strokeWidth=1.8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="730.0" y="226.3" width="14" height="14" as="geometry" /></mxCell><mxCell id="fsl" value="&lt;b&gt;full stack&lt;/b&gt;, all loads&lt;br/&gt;together: 5 Hz" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="569.0" y="215.33333333333334" width="160" height="30" as="geometry" /></mxCell><mxCell id="pv" value="&lt;b&gt;&quot;undecided at dose&quot;&lt;/b&gt;: the one valid arm lies below the full stack's wait; the higher arm is VOID, so it cannot decide the class." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="555" y="456" width="400" height="56" as="geometry" /></mxCell><mxCell id="sp" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacing=6;fillColor=none;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="540" width="975" height="120" as="geometry" /></mxCell><mxCell id="sh" value="&lt;b&gt;Factor 3: the full stack's extra topic subscribers (fan-out)&lt;/b&gt; cost 1 Hz [camera_fanout_loss_hz, illustrative]. Each factor's part of the full stack's 5 Hz camera loss:" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="546" width="955" height="34" as="geometry" /></mxCell><mxCell id="sl" value="loss, Hz" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="586" width="104" height="30" as="geometry" /></mxCell><mxCell id="ss0" value="fan-out 1 Hz, share 0.2" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;fillColor=none;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="140" y="586" width="164.0" height="30" as="geometry" /></mxCell><mxCell id="ss2" value="rest 4 Hz: not attributed (pool share undecided; loads not tested together)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;dashed=1;dashPattern=4 3;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="304.0" y="586" width="656.0" height="30" as="geometry" /></mxCell><mxCell id="sft" value="GPU part 0 Hz (no segment). Shares are my estimate from `camera_fanout_loss_hz`, `camera_full_stack_loss_hz` and `camera_gpu_only_loss_hz`; a post-hoc reading that keeps the VOID arm gives the pool a larger part and does not replace the verdict." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="140" y="622" width="840" height="32" as="geometry" /></mxCell><mxCell id="ctx" value="&lt;b&gt;Setup.&lt;/b&gt; The depth camera service keeps 30 Hz alone [camera_hz_alone, illustrative]. One factor per window, idle pool unless the factor is the pool. In the full stack it falls to 25 Hz (my estimate from `camera_hz_alone` and `camera_full_stack_loss_hz`)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#f7f7f7;strokeColor=#bbbbbb;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1010" y="84" width="410" height="72" as="geometry" /></mxCell><mxCell id="verd" value="&lt;b&gt;Pre-registered verdicts&lt;/b&gt;&lt;br/&gt;• GPU: &lt;b&gt;minor&lt;/b&gt;. No loss at any GPU dose tested.&lt;br/&gt;• Shared pool: &lt;b&gt;&quot;undecided at dose&quot;&lt;/b&gt;. The valid arm is below the full stack's wait.&lt;br/&gt;• Fan-out: &lt;b&gt;a minor share&lt;/b&gt;, about one fifth of the full-stack loss." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1010" y="166" width="410" height="90" as="geometry" /></mxCell><mxCell id="cav" value="&lt;b&gt;Caveats.&lt;/b&gt; &lt;b&gt;The three loads were not tested together.&lt;/b&gt; The GPU arms ran with frame-time slack that the full stack does not leave, and the full stack + VLA dose lies beyond the highest GPU arm. The two panels use different x axes; the black square is the same full-stack reference on the pool axis. The dotted line joins all pool arms, the VOID one included (post-hoc reading). Values are an illustrative measurement." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1010" y="266" width="410" height="124" as="geometry" /></mxCell><mxCell id="so" value="&lt;b&gt;Correction kept visible.&lt;/b&gt; The camera's loss is CPU-side; GPU load alone costs it nothing. &lt;b&gt;Read with page 06&lt;/b&gt;: the detector's GPU wait follows the others' GPU share, the camera's frame rate does not. Same GPU, different victims: the dose curve is per service, not per board (interpretation)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;dashed=1;dashPattern=6 4;fillColor=#f3ecf7;strokeColor=#9673a6;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1010" y="400" width="410" height="90" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br/&gt;green line + circles = GPU arms (valid), no dose values given&lt;br/&gt;filled blue circle = valid pool arm; hollow dashed blue circle = VOID window&lt;br/&gt;hollow solid blue circle = alone (zero loss by definition)&lt;br/&gt;black square = full-stack reference (all loads)&lt;br/&gt;grey dashed line = full-stack loss level&lt;br/&gt;grey shading = pool waits above the full stack's&lt;br/&gt;dotted = post-hoc reading; light-blue hatch = fan-out (CPU-side)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#f7f7f7;strokeColor=#bbbbbb;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="672" width="470" height="112" as="geometry" /></mxCell><mxCell id="src" value="&lt;b&gt;Sources.&lt;/b&gt; Note B1, &quot;The camera is different&quot;. Pool-arm x positions come from the field names of camera_pool_loss_hz (half / twice the full stack's wait). How to benchmark a robot stack: ../../robot-workload-benchmarking/.&lt;br/&gt;&lt;b&gt;Illustrative&lt;/b&gt; (round teaching numbers that keep the shape of a finding; not measurements): camera_pool_loss_hz, camera_full_stack_loss_hz, camera_gpu_only_loss_hz, camera_fanout_loss_hz, camera_hz_alone." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=#fff8dc;strokeColor=#d6b656;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="502" y="672" width="918" height="52" as="geometry" /></mxCell><mxCell id="l0" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="90.0" y="400.0" as="sourcePoint" /><mxPoint x="420.0" y="400.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l1" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="90.0" y="150.0" as="sourcePoint" /><mxPoin