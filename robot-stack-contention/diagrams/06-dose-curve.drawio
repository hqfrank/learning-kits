<mxfile host="app.diagrams.net"><diagram id="p_06_dose_curve" name="06-dose-curve"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="750" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="The object detector's added GPU wait follows the other processes' share of GPU time on a convex curve; the VLA sits on the compute co-tenant's curve, and a memory copy at the same GPU time adds nothing (illustrative numbers)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=20;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1400" height="60" as="geometry" /></mxCell><mxCell id="axt0" value="0" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="80.0" y="574" width="60" height="15" as="geometry" /></mxCell><mxCell id="axt1" value="10" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="164.44444444444446" y="574" width="60" height="15" as="geometry" /></mxCell><mxCell id="axt2" value="20" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="248.8888888888889" y="574" width="60" height="15" as="geometry" /></mxCell><mxCell id="axt3" value="30" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="333.3333333333333" y="574" width="60" height="15" as="geometry" /></mxCell><mxCell id="axt4" value="40" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="417.77777777777777" y="574" width="60" height="15" as="geometry" /></mxCell><mxCell id="axt5" value="50" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="502.2222222222222" y="574" width="60" height="15" as="geometry" /></mxCell><mxCell id="axt6" value="60" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="586.6666666666666" y="574" width="60" height="15" as="geometry" /></mxCell><mxCell id="axt7" value="70" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="671.1111111111111" y="574" width="60" height="15" as="geometry" /></mxCell><mxCell id="axt8" value="80" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="755.5555555555555" y="574" width="60" height="15" as="geometry" /></mxCell><mxCell id="axt9" value="90" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="840.0" y="574" width="60" height="15" as="geometry" /></mxCell><mxCell id="ayt0" value="0" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="560.0" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt1" value="20" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="511.1111111111111" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt2" value="40" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="462.22222222222223" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt3" value="60" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="413.33333333333337" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt4" value="80" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="364.44444444444446" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt5" value="100" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="315.55555555555554" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt6" value="120" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="266.6666666666667" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt7" value="140" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="217.77777777777777" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt8" value="160" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="168.8888888888889" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt9" value="180" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="120.0" width="44" height="16" as="geometry" /></mxCell><mxCell id="axl" value="O = other processes' share of GPU-active time (percentage points)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="110" y="590" width="760" height="18" as="geometry" /></mxCell><mxCell id="ayl" value="C = the detector's added blocked time (ms per frame, above the no-load window)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="104" width="810" height="18" as="geometry" /></mxCell><mxCell id="predl" value="dashed: predicted before the run, C at the high dose stays &lt;b&gt;below R&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="705.3333333333334" y="327.55555555555554" width="156.22222222222217" height="44" as="geometry" /></mxCell><mxCell id="p0" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#ffffff;strokeColor=#3f7f33;strokeWidth=1.8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="104.0" y="562.0" width="12" height="12" as="geometry" /></mxCell><mxCell id="p1" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#b9dfb0;strokeColor=#3f7f33;strokeWidth=1.8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="441.8" y="464.2" width="12" height="12" as="geometry" /></mxCell><mxCell id="p2" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#b9dfb0;strokeColor=#3f7f33;strokeWidth=1.8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="610.7" y="366.4" width="12" height="12" as="geometry" /></mxCell><mxCell id="p3" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#b9dfb0;strokeColor=#3f7f33;strokeWidth=1.8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="779.6" y="170.9" width="12" height="12" as="geometry" /></mxCell><mxCell id="pl0" value="&lt;b&gt;no load&lt;/b&gt;&lt;br/&gt;(O 0, C 0 ms)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="122.0" y="524.0" width="170" height="46" as="geometry" /></mxCell><mxCell id="pl1" value="&lt;b&gt;compute, low dose&lt;/b&gt;&lt;br/&gt;(O 40, C 40 ms)&lt;br/&gt;[dose_curve_points, illustrative]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="459.77777777777777" y="468.22222222222223" width="170" height="46" as="geometry" /></mxCell><mxCell id="pl2" value="&lt;b&gt;compute, middle dose&lt;/b&gt;&lt;br/&gt;(O 60, C 80 ms)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="438.66666666666663" y="338.44444444444446" width="170" height="46" as="geometry" /></mxCell><mxCell id="pl3" value="&lt;b&gt;compute, high dose&lt;/b&gt;&lt;br/&gt;(O 80, C 160 ms)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="577.5555555555555" y="160.8888888888889" width="200" height="46" as="geometry" /></mxCell><mxCell id="sl0" value="slope 1 ms per point [dose_slopes, illustrative]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#3f7f33;" vertex="1" parent="1"><mxGeometry x="128.8888888888889" y="485.1111111111111" width="190" height="30" as="geometry" /></mxCell><mxCell id="sl1" value="slope 2 ms per point [dose_slopes]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#3f7f33;" vertex="1" parent="1"><mxGeometry x="542.2222222222222" y="427.33333333333337" width="190" height="30" as="geometry" /></mxCell><mxCell id="sl2" value="slope 4 ms per point [dose_slopes]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#3f7f33;" vertex="1" parent="1"><mxGeometry x="711.1111111111111" y="280.6666666666667" width="190" height="30" as="geometry" /></mxCell><mxCell id="vla" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#333333;strokeColor=#333333;strokeWidth=1.8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="651.9" y="316.6" width="14" height="14" as="geometry" /></mxCell><mxCell id="vlal" value="&lt;b&gt;VLA arm = R&lt;/b&gt; (O 65, C 100 ms) [dose_vla_point, illustrative]&lt;br/&gt;C* = curve at O 65 = 100 ms, so C*/R = 1 (my estimate from `dose_curve_points` and `dose_vla_point`)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="363.3333333333333" y="201.33333333333331" width="300" height="62" as="geometry" /></mxCell><mxCell id="cpy" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;dashed=1;dashPattern=3 2;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="440.8" y="554.0" width="14" height="14" as="geometry" /></mxCell><mxCell id="cpyl" value="&lt;b&gt;memory-copy co-tenant&lt;/b&gt;, same GPU time as the low-dose arm: adds 0 ms [dram_null_added_ms, illustrative]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#8a5a00;" vertex="1" parent="1"><mxGeometry x="459.77777777777777" y="528.0" width="300" height="32" as="geometry" /></mxCell><mxCell id="corr" value="&lt;b&gt;Correction kept visible.&lt;/b&gt; The first test's class &quot;neither alone&quot; (C about 40 % of R, my estimate from `dose_curve_points` and `dose_vla_point`) came from a compute arm at about 40 points against the VLA's 65: the low end of a convex curve. The first class stands as recorded." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;dashed=1;dashPattern=6 4;fillColor=#f3ecf7;strokeColor=#9673a6;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="135.33333333333334" y="279.55555555555554" width="250" height="92" as="geometry" /></mxCell><mxCell id="verd" value="&lt;b&gt;Verdict as pre-registered: &quot;dose explains&quot;.&lt;/b&gt; The VLA point lies on the compute co-tenant's curve (C*/R = 1, my estimate from `dose_curve_points` and `dose_vla_point`). Each extra point of O costs more than the last: slopes 1 / 2 / 4 ms per point [dose_slopes]." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="905" y="84" width="515" height="64" as="geometry" /></mxCell><mxCell id="null" value="&lt;b&gt;What adds nothing measurable at the VLA's dose&lt;/b&gt;&lt;br/&gt;• DRAM traffic: the memory copy adds 0 ms [dram_null_added_ms].&lt;br/&gt;• SM issue rate: the compute co-tenant issues far more often than the VLA, yet costs the same at the same share.&lt;br/&gt;• Burst length: short vs long bursts at one share differ by 0 ms [burst_length_effect_ms, illustrative]." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="905" y="158" width="515" height="84" as="geometry" /></mxCell><mxCell id="wrong" value="&lt;b&gt;Two predictions were wrong&lt;/b&gt; (written before the run)&lt;br/&gt;• high dose: predicted below R, measured 1.6 R (my estimate from `dose_curve_points` and `dose_vla_point`).&lt;br/&gt;• burst length: predicted to matter, it did not. Bursts well below one time slice (under 1 ms) were not tested." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;dashed=1;dashPattern=5 3;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="905" y="252" width="515" height="62" as="geometry" /></mxCell><mxCell id="mech" value="&lt;b&gt;Why share, not traffic (page 05).&lt;/b&gt; &quot;Work launched to the compute engine from work queues belonging to different CUDA contexts cannot execute concurrently.&quot; [mps_no_concurrency_quote] Without MPS the contexts take turns of about 1–5 ms [timeslice_ms, illustrative], so the detector waits for the others' turns plus each switch. The split between slice waiting and switch cost was not measured." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#f7f7f7;strokeColor=#bbbbbb;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="905" y="324" width="515" height="84" as="geometry" /></mxCell><mxCell id="split" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacing=6;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="905" y="418" width="515" height="104" as="geometry" /></mxCell><mxCell id="splh" value="&lt;b&gt;In the full stack, next to the VLA, most of the detector's rise is GPU wait&lt;/b&gt; (ms per frame added) [detector_vla_added_blocked_wait_run, illustrative]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="913" y="422" width="499" height="34" as="geometry" /></mxCell><mxCell id="sb0" value="blocked 70" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="919" y="462" width="280.0" height="26" as="geometry" /></mxCell><mxCell id="sb1" value="CPU wait 20" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1199.0" y="462" width="80.0" height="26" as="geometry" /></mxCell><mxCell id="sb2" value="run 10" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;dashed=1;dashPattern=4 3;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1279.0" y="462" width="40.0" height="26" as="geometry" /></mxCell><mxCell id="splt" value="sum 100 ms per frame, full stack -&amp;gt; full stack + VLA (a different row from the dose curve; my estimate from `detector_vla_added_blocked_wait_run`)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="919" y="492" width="487" height="28" as="geometry" /></mxCell><mxCell id="cav" value="&lt;b&gt;Caveats.&lt;/b&gt; Measured in a reduced row (the depth camera service and the detector only), idle CPU pool, one window per arm. &lt;b&gt;In the full stack the mechanism is expected, not tested&lt;/b&gt;; full-stack windows sit below the curve in a post-hoc reading, because the detector also waits for the CPU there and meets less GPU contention per frame (not separated from other causes). The victim metric is blocked time: neither running nor waiting for a CPU, mostly waiting for the GPU. O removes the detector's own GPU time; added GPU busy would include it and understate the dose. Straight segments join the points; the curve between them is not measured. All measured values are an illustrative measurement." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="604" width="480" height="132" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br/&gt;green line + filled circles = compute co-tenant arms; hollow circle = no-load window&lt;br/&gt;black square = the VLA arm (R)&lt;br/&gt;hollow dashed orange square = memory-copy co-tenant&lt;br/&gt;dashed black line = prediction written before the run&lt;br/&gt;purple dashed box = a correction&lt;br/&gt;green box = the pre-registered verdict&lt;br/&gt;stacked bar: solid = illustrative measured share; dashed = slower run" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#f7f7f7;strokeColor=#bbbbbb;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="512" y="604" width="370" height="132" as="geometry" /></mxCell><mxCell id="src" value="&lt;b&gt;Sources.&lt;/b&gt; Note B1. Contexts and time-slicing: ../../nvidia-gpu-anatomy/ (note 07). C* and the ratios to R are straight-line arithmetic on the points.&lt;br/&gt;&lt;b&gt;Illustrative&lt;/b&gt; (round teaching numbers that keep the shape of a finding; not measurements): dose_curve_points, dose_slopes, dose_vla_point, dram_null_added_ms, burst_length_effect_ms, timeslice_ms, detector_vla_added_blocked_wait_run.&lt;br/&gt;&lt;b&gt;Public&lt;/b&gt;: mps_no_concurrency_quote = https://docs.nvidia.com/deploy/mps/architecture.html." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=#fff8dc;strokeColor=#d6b656;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="894" y="604" width="526" height="71" as="geometry" /></mxCell><mxCell id="l0" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110.0" y="568.0" as="sourcePoint" /><mxPoint x="870.0" y="568.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l1" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110.0" y="128.0" as="sourcePoint" /><mxPoint x="110.0" y="568.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l2" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#e6e6e6;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoi