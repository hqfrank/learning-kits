<mxfile host="app.diagrams.net"><diagram id="p_04_same_work_more_cycles" name="04-same-work-more-cycles"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="755" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Same work, more cycles: in the full stack fixed-work threads run the same instructions with 1.4× to 2× the cycles [cycles_growth_range, illustrative]; moving the motor-control services' cluster-mates removes about two thirds of the extra cycles (class &quot;most (or less board traffic)&quot;)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=20;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1400" height="60" as="geometry" /></mxCell><mxCell id="lpan" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacing=6;fillColor=none;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="84" width="690" height="520" as="geometry" /></mxCell><mxCell id="lhd" value="&lt;b&gt;Alone -&amp;gt; full stack, user-mode counts per fixed work unit&lt;/b&gt; (one bus cycle / one audio message / one detector frame), three fixed-work threads. Ratio to alone; the full-stack bar spans the range over the threads. Pre-registered class: &lt;b&gt;X2 &quot;slower work&quot;&lt;/b&gt; for all three." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="670" height="52" as="geometry" /></mxCell><mxCell id="ayt0" value="0×" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="472.0" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt1" value="0.5×" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="425.125" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt2" value="1×" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="378.25" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt3" value="1.5×" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="331.375" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt4" value="2×" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="284.5" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt5" value="2.5×" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="237.625" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt6" value="3×" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="190.75" width="44" height="16" as="geometry" /></mxCell><mxCell id="axl" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="110" y="502" width="570" height="18" as="geometry" /></mxCell><mxCell id="ayl" value="ratio to alone (alone = 1×)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="156" width="620" height="18" as="geometry" /></mxCell><mxCell id="al0" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;fillColor=#e4e4e4;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="137.2" y="386.2" width="40" height="93.8" as="geometry" /></mxCell><mxCell id="fl0" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#eeeeee;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="185.2" y="386.2" width="40" height="93.8" as="geometry" /></mxCell><mxCell id="lab0" value="1× (growth 0.0) [instr_growth, illustrative]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=bottom;align=center;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="113.25" y="340.25" width="136" height="44" as="geometry" /></mxCell><mxCell id="gn0" value="&lt;b&gt;instructions per unit&lt;/b&gt;&lt;br/&gt;left alone, right full stack" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="113.25" y="486.0" width="136" height="44" as="geometry" /></mxCell><mxCell id="al1" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;fillColor=#e4e4e4;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="279.8" y="386.2" width="40" height="93.8" as="geometry" /></mxCell><mxCell id="fl1" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#9fc0e8;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="327.8" y="348.8" width="40" height="131.2" as="geometry" /></mxCell><mxCell id="fh1" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;dashed=1;dashPattern=4 3;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="327.8" y="292.5" width="40" height="56.2" as="geometry" /></mxCell><mxCell id="lab1" value="1.4×–2× [cycles_growth_range]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=bottom;align=center;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="255.75" y="246.5" width="136" height="44" as="geometry" /></mxCell><mxCell id="gn1" value="&lt;b&gt;cycles per unit&lt;/b&gt;&lt;br/&gt;left alone, right full stack" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="255.75" y="486.0" width="136" height="44" as="geometry" /></mxCell><mxCell id="al2" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;fillColor=#e4e4e4;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="422.2" y="386.2" width="40" height="93.8" as="geometry" /></mxCell><mxCell id="fl2" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#1f3f73;strokeWidth=3;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="470.2" y="433.1" width="40" height="46.9" as="geometry" /></mxCell><mxCell id="fh2" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;dashed=1;dashPattern=4 3;fillColor=#ffffff;strokeColor=#1f3f73;strokeWidth=3;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="470.2" y="414.4" width="40" height="18.8" as="geometry" /></mxCell><mxCell id="lab2" value="0.5×–0.7× (drop 0.3–0.5) [ipc_drop_range, illustrative]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=bottom;align=center;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="398.25" y="340.25" width="136" height="44" as="geometry" /></mxCell><mxCell id="gn2" value="&lt;b&gt;IPC&lt;/b&gt;&lt;br/&gt;left alone, right full stack" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="398.25" y="486.0" width="136" height="44" as="geometry" /></mxCell><mxCell id="al3" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;fillColor=#e4e4e4;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="564.8" y="386.2" width="40" height="93.8" as="geometry" /></mxCell><mxCell id="fl3" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#f4f4f4;strokeColor=#555555;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="612.8" y="292.5" width="40" height="187.5" as="geometry" /></mxCell><mxCell id="fh3" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;dashed=1;dashPattern=4 3;fillColor=#ffffff;strokeColor=#555555;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="612.8" y="198.8" width="40" height="93.8" as="geometry" /></mxCell><mxCell id="lab3" value="2×–3× [l3_refill_ratio_range, illustrative]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=bottom;align=center;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="540.75" y="152.75" width="136" height="44" as="geometry" /></mxCell><mxCell id="gn3" value="&lt;b&gt;L3 refills per instruction (a hint, not a cause)&lt;/b&gt;&lt;br/&gt;left alone, right full stack" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="540.75" y="486.0" width="136" height="44" as="geometry" /></mxCell><mxCell id="clk" value="Clock unchanged (all cores locked). The motor loop is never preempted, so its slowdown is not run-queue wait. Kernel-mode instructions do rise for some threads; message fan-out, interrupt and scheduler work are not separated. My estimate: full-stack ratio = 1 + growth, IPC = 1 − drop." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="30" y="552" width="670" height="40" as="geometry" /></mxCell><mxCell id="rpan" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacing=6;fillColor=none;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="730" y="84" width="690" height="520" as="geometry" /></mxCell><mxCell id="rhd" value="&lt;b&gt;Cluster move: every service sharing the motor-control services' CPU cluster goes to the pool.&lt;/b&gt; X = the motor loop's user cycles per bus cycle; two arms, &quot;baseline&quot; (full stack) and &quot;moved&quot;, two windows each." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="740" y="90" width="670" height="52" as="geometry" /></mxCell><mxCell id="rnalone" value="&lt;b&gt;alone&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="738" y="156" width="156" height="34" as="geometry" /></mxCell><mxCell id="rbalone" value="X_alone" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#eeeeee;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="900" y="158" width="230" height="30" as="geometry" /></mxCell><mxCell id="rnmoved" value="&lt;b&gt;moved: cluster-mates moved&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="738" y="202" width="156" height="34" as="geometry" /></mxCell><mxCell id="rbmoved" value="X_moved" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;dashed=1;dashPattern=5 3;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="900" y="204" width="321.0" height="30" as="geometry" /></mxCell><mxCell id="rnbase" value="&lt;b&gt;baseline: full stack&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="738" y="248" width="156" height="34" as="geometry" /></mxCell><mxCell id="rbbase" value="X_base" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#9fc0e8;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="900" y="250" width="490" height="30" as="geometry" /></mxCell><mxCell id="br302" value="full-stack growth X_base − X_alone" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="894" y="294" width="230" height="16" as="geometry" /></mxCell><mxCell id="br324" value="removed X_base − X_moved" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="985.0" y="316" width="230" height="16" as="geometry" /></mxCell><mxCell id="schn" value="schematic: bar lengths show only the ratio f, not cycle counts" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="740" y="340" width="670" height="16" as="geometry" /></mxCell><mxCell id="fz1" value="&quot;part&quot; = predicted before the run" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;dashed=1;dashPattern=6 4;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="800.0" y="410" width="295.0" height="40" as="geometry" /></mxCell><mxCell id="fz2" value="&quot;most (or less board traffic)&quot;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1095.0" y="410" width="295.0" height="40" as="geometry" /></mxCell><mxCell id="fxt0" value="0" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="780.0" y="462" width="40" height="14" as="geometry" /></mxCell><mxCell id="fxt1" value="0.5" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1075.0" y="462" width="40" height="14" as="geometry" /></mxCell><mxCell id="fxt2" value="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1370.0" y="462" width="40" height="14" as="geometry" /></mxCell><mxCell id="fdot" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#1f3f73;strokeColor=#1f3f73;strokeWidth=1.8;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1177.5" y="388" width="12" height="12" as="geometry" /></mxCell><mxCell id="fval" value="&lt;b&gt;f = 0.65&lt;/b&gt; [cluster_move_recovered, illustrative], close to the line" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="933.5" y="366" width="500" height="18" as="geometry" /></mxCell><mxCell id="fdef" value="removed fraction f = (X_base − X_moved) ÷ (X_base − X_alone); dashed line = pre-registered class line 0.5 [cluster_move_class_line, illustrative]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="740" y="478" width="670" height="18" as="geometry" /></mxCell><mxCell id="whyopen" value="&lt;b&gt;Prediction failed; the path stays open.&lt;/b&gt; Predicted &quot;part&quot;; f lands above the line, so read it as &quot;about two thirds&quot;, not a clean &quot;most&quot;. (1) The two moved windows differ, and the spread reaches toward the line. (2) Board memory traffic fell in the moved arm, so the class carries &quot;(or less board traffic)&quot;. (3) The motor-control services' own load also fell. The other ~0.35 is not separated (my estimate from `cluster_move_recovered`: 1 − 0.65)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;dashed=1;dashPattern=6 4;fillColor=#f3ecf7;strokeColor=#9673a6;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="740" y="500" width="330" height="96" as="geometry" /></mxCell><mxCell id="cost" value="&lt;b&gt;The move is not a free fix.&lt;/b&gt; The moved services land on the pool: the camera loses 4 to 6 Hz [cluster_move_camera_cost_hz, illustrative]; other pool services and message delay get worse.&lt;br/&gt;Earlier cache A/B: a synthetic L3-footprint load on the neighbouring cores reproduced a slower motor loop; an L1-resident load reproduced nothing." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1080" y="500" width="330" height="96" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br/&gt;left: grey bar = alone (1×); coloured bar = full stack, solid to the low end of the range and dashed outline to the high end; thick dark-blue border = IPC; dashed horizontal line = alone level.&lt;br/&gt;right: grey = alone, mid-blue = baseline, light blue dashed = moved; dot = f; dashed outline / dashed line = the prediction and the pre-registered class line.&lt;br/&gt;purple dashed box = why the result is not a clean cause; amber = the cost of the fix." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#f7f7f7;strokeColor=#bbbbbb;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="618" width="436" height="121" as="geometry" /></mxCell><mxCell id="src" value="&lt;b&gt;Sources.&lt;/b&gt; Numbers loaded from ../constants.json by spec04.py; key in brackets. Note A2 (counters, cluster move, cache A/B). The cache mechanism is taught in ../../jetson-orin-thor-metrics/notes/B2-cache-level-interference.md.&lt;br/&gt;&lt;b&gt;Illustrative&lt;/b&gt; (round teaching numbers that keep the shape of a finding; not measurements): cycles_growth_range, instr_growth, ipc_drop_range, l3_refill_ratio_range, cluster_move_recovered, cluster_move_class_line, cluster_move_camera_cost_hz." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=#fff8dc;strokeColor=#d6b656;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="470" y="618" width="950" height="65" as="geometry" /></mxCell><mxCell id="l0" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110.0" y="480.0" as="sourcePoint" /><mxPoint x="680.0" y="480.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l1" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110.0" y="180.0" as="sourcePoint" /><mxPoint x="110.0" y="480.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l2" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#e6e6e6;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110.0" y="480.0" as="sourcePoint" /><mxPoint x="680.0" y="480.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l3" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="105.0" y="480.0" as="sourcePoint" /><mxPoint x="110.0" y="480.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l4" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#e6e6e6;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"