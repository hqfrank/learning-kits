<mxfile host="app.diagrams.net"><diagram id="p_05_gpu_time_slicing_vs_mps" name="05-gpu-time-slicing-vs-mps"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="868" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Without MPS two processes take turns on the whole GPU (each about half busy); under MPS one-SM kernels run side by side, but only for clients of one Linux user; a stack split over two users would stall" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=20;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1400" height="60" as="geometry" /></mxCell><mxCell id="lpan" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacing=6;fillColor=none;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="84" width="850" height="540" as="geometry" /></mxCell><mxCell id="h1" value="&lt;b&gt;No MPS: one CUDA context at a time (time-slicing).&lt;/b&gt; NVIDIA: &quot;Work launched to the compute engine from work queues belonging to different CUDA contexts cannot execute concurrently.&quot; [mps_no_concurrency_quote] Two clients, each launching one-SM test kernels. While B's context holds the GPU, A's kernels cannot run at all." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="92" width="830" height="54" as="geometry" /></mxCell><mxCell id="lgpu" value="&lt;b&gt;whole GPU&lt;/b&gt;&lt;br/&gt;(16 SMs)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="154" width="115" height="40" as="geometry" /></mxCell><mxCell id="s0" value="A runs" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#b9dfb0;strokeColor=#3f7f33;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="150.0" y="154" width="73.5" height="40" as="geometry" /></mxCell><mxCell id="s1" value="B runs" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;dashed=1;dashPattern=5 3;fillColor=#fbd3ad;strokeColor=#b8611a;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="239.5" y="154" width="73.5" height="40" as="geometry" /></mxCell><mxCell id="s2" value="A runs" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#b9dfb0;strokeColor=#3f7f33;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="329.0" y="154" width="73.5" height="40" as="geometry" /></mxCell><mxCell id="s3" value="B runs" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;dashed=1;dashPattern=5 3;fillColor=#fbd3ad;strokeColor=#b8611a;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="418.5" y="154" width="73.5" height="40" as="geometry" /></mxCell><mxCell id="s4" value="A runs" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#b9dfb0;strokeColor=#3f7f33;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="508.0" y="154" width="73.5" height="40" as="geometry" /></mxCell><mxCell id="s5" value="B runs" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;dashed=1;dashPattern=5 3;fillColor=#fbd3ad;strokeColor=#b8611a;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="597.5" y="154" width="73.5" height="40" as="geometry" /></mxCell><mxCell id="s6" value="A runs" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#b9dfb0;strokeColor=#3f7f33;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="687.0" y="154" width="73.5" height="40" as="geometry" /></mxCell><mxCell id="s7" value="B runs" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;dashed=1;dashPattern=5 3;fillColor=#fbd3ad;strokeColor=#b8611a;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="776.5" y="154" width="73.5" height="40" as="geometry" /></mxCell><mxCell id="swl" value="dotted ticks = context switch (state saved and restored, caches and TLBs refilled). A time slice is about 1–5 ms per context [timeslice_ms, illustrative], priority dependent. Schematic, not to scale. Board: 16 SMs [sm_count_orin]." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="150" y="200" width="700" height="30" as="geometry" /></mxCell><mxCell id="r1" value="each client busy &lt;b&gt;0.5&lt;/b&gt; of the time [mps_probe_busy_frac, illustrative] — the turns halve it" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#eeeeee;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="150" y="236" width="700" height="30" as="geometry" /></mxCell><mxCell id="h2" value="&lt;b&gt;MPS: one shared context; clients submit straight to the GPU.&lt;/b&gt; Each one-SM kernel gets its own SM, so the two run at the same time." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="290" width="830" height="36" as="geometry" /></mxCell><mxCell id="ml0" value="&lt;b&gt;SM 1&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="332" width="115" height="30" as="geometry" /></mxCell><mxCell id="m0" value="A runs (whole window)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#b9dfb0;strokeColor=#3f7f33;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="150" y="332" width="700" height="30" as="geometry" /></mxCell><mxCell id="ml1" value="&lt;b&gt;SM 2&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="368" width="115" height="30" as="geometry" /></mxCell><mxCell id="m1" value="B runs (whole window)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;dashed=1;dashPattern=5 3;fillColor=#fbd3ad;strokeColor=#b8611a;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="150" y="368" width="700" height="30" as="geometry" /></mxCell><mxCell id="ml2" value="&lt;b&gt;other SMs&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="404" width="115" height="30" as="geometry" /></mxCell><mxCell id="m2" value="idle in this test" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#f4f4f4;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="150" y="404" width="700" height="30" as="geometry" /></mxCell><mxCell id="r2" value="each client busy &lt;b&gt;1&lt;/b&gt; of the time [mps_probe_busy_frac] — as fast as alone" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#eeeeee;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="150" y="444" width="700" height="30" as="geometry" /></mxCell><mxCell id="capl" value="&lt;b&gt;thread cap&lt;/b&gt;&lt;br/&gt;(one client)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="486" width="115" height="40" as="geometry" /></mxCell><mxCell id="c0" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;fillColor=#b9dfb0;strokeColor=#3f7f33;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="150" y="492" width="26" height="28" as="geometry" /></mxCell><mxCell id="c1" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;fillColor=#b9dfb0;strokeColor=#3f7f33;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="180" y="492" width="26" height="28" as="geometry" /></mxCell><mxCell id="c2" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;fillColor=#b9dfb0;strokeColor=#3f7f33;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="210" y="492" width="26" height="28" as="geometry" /></mxCell><mxCell id="c3" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;fillColor=#b9dfb0;strokeColor=#3f7f33;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="240" y="492" width="26" height="28" as="geometry" /></mxCell><mxCell id="c4" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;dashed=1;dashPattern=3 3;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="270" y="492" width="26" height="28" as="geometry" /></mxCell><mxCell id="c5" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;dashed=1;dashPattern=3 3;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="492" width="26" height="28" as="geometry" /></mxCell><mxCell id="c6" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;dashed=1;dashPattern=3 3;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="330" y="492" width="26" height="28" as="geometry" /></mxCell><mxCell id="c7" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;dashed=1;dashPattern=3 3;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="360" y="492" width="26" height="28" as="geometry" /></mxCell><mxCell id="c8" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;dashed=1;dashPattern=3 3;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="390" y="492" width="26" height="28" as="geometry" /></mxCell><mxCell id="c9" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;dashed=1;dashPattern=3 3;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="420" y="492" width="26" height="28" as="geometry" /></mxCell><mxCell id="c10" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;dashed=1;dashPattern=3 3;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="450" y="492" width="26" height="28" as="geometry" /></mxCell><mxCell id="c11" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;dashed=1;dashPattern=3 3;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="480" y="492" width="26" height="28" as="geometry" /></mxCell><mxCell id="c12" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;dashed=1;dashPattern=3 3;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="510" y="492" width="26" height="28" as="geometry" /></mxCell><mxCell id="c13" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;dashed=1;dashPattern=3 3;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="540" y="492" width="26" height="28" as="geometry" /></mxCell><mxCell id="c14" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;dashed=1;dashPattern=3 3;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="570" y="492" width="26" height="28" as="geometry" /></mxCell><mxCell id="c15" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;dashed=1;dashPattern=3 3;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="600" y="492" width="26" height="28" as="geometry" /></mxCell><mxCell id="capt" value="CUDA_MPS_ACTIVE_THREAD_PERCENTAGE ([mps_thread_percentage_env]) set to a quarter -&amp;gt; 4 of 16 SMs visible [mps_cap_visible_sms, illustrative] (my estimate from `mps_cap_visible_sms` and `sm_count_orin`: 4 ÷ 16 = 25 %). An MPS feature: a share of SMs, not of time." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="150" y="522" width="700" height="32" as="geometry" /></mxCell><mxCell id="lo" value="&lt;b&gt;Launch cost:&lt;/b&gt; MPS minus no MPS 0 µs, against 10 µs for an empty kernel launched and synchronised each time and 2 µs queued [launch_overhead_us, illustrative]. NVIDIA: &quot;MPS clients submit work directly to the GPU without passing through the MPS server.&quot; [mps_launch_path_quote]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="562" width="830" height="56" as="geometry" /></mxCell><mxCell id="rpan" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="885" y="84" width="535" height="540" as="geometry" /></mxCell><mxCell id="rh" value="&lt;b&gt;The catch for the stack: Linux users.&lt;/b&gt; Single-user MPS: the control daemon runs one server per Linux user at a time; other users' clients are queued [mps_one_user]. Suppose the stack runs its services as two Linux users, with its GPU services split between them:" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="895" y="92" width="515" height="56" as="geometry" /></mxCell><mxCell id="u1" value="&lt;b&gt;Linux user 1&lt;/b&gt;&lt;br/&gt;• some of the GPU services" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacing=6;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="905" y="160" width="190" height="100" as="geometry" /></mxCell><mxCell id="u2" value="&lt;b&gt;Linux user 2&lt;/b&gt;&lt;br/&gt;• the other GPU services" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacing=6;dashed=1;dashPattern=5 3;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1210" y="160" width="190" height="100" as="geometry" /></mxCell><mxCell id="stall" value="&lt;b&gt;stall&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1095" y="158" width="115" height="50" as="geometry" /></mxCell><mxCell id="stall2" value="each queued behind the other" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1095" y="226" width="115" height="34" as="geometry" /></mxCell><mxCell id="stt" value="&lt;b&gt;Test step:&lt;/b&gt; a client of a second user next to a client of the daemon's user, under MPS: both hung until the daemon was stopped. As deployed, MPS would likely stall the services rather than share, which is worse than time-slicing (interpretation; not tested with the services)." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="895" y="270" width="515" height="66" as="geometry" /></mxCell><mxCell id="tegra" value="&lt;b&gt;Tegra limits&lt;/b&gt; (NVIDIA docs): not supported: -multiuser-server; GPU compute modes; under MPS: CUDA IPC, cooperative launches, client termination [mps_tegra_unsupported]. Dynamic parallelism: not supported under MPS [mps_dynamic_parallelism].&lt;br/&gt;Supported on Tegra Linux since CUDA 12.5 (Linux) [mps_tegra_since]. A fatal GPU fault in one client reaches every client." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="895" y="344" width="515" height="96" as="geometry" /></mxCell><mxCell id="dep" value="&lt;b&gt;Is a stack process ready for MPS?&lt;/b&gt; (note B3)&lt;br/&gt;&lt;b&gt;Code: yes&lt;/b&gt; — the CUDA driver attaches a process as a client when CUDA_MPS_PIPE_DIRECTORY points to a running daemon.&lt;br/&gt;&lt;b&gt;Libraries: not verified&lt;/b&gt; — the camera SDK, TensorRT, PyTorch, ONNX Runtime.&lt;br/&gt;&lt;b&gt;Deployment: not ready&lt;/b&gt; — (1) one Linux user for all GPU services, (2) the pipe directory in every GPU container, (3) the daemon started first, (4) fault handling in service supervision." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="895" y="450" width="515" height="164" as="geometry" /></mxCell><mxCell id="cav" value="&lt;b&gt;Caveats.&lt;/b&gt; Every result on this page is from synthetic test kernels: one block (one SM), spinning on the GPU clock, no memory traffic, board idle. The real services never ran under MPS. About half the services' kernel time already fills the SMs (0.5 [kernel_time_sms_full_share, illustrative], theoretical; note B2), so for them MPS mainly lets the other process start sooner. &lt;b&gt;The gain for real services is a hypothesis&lt;/b&gt;; under MPS, SM contention between processes appears for the first time." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="636" width="640" height="80" as="geometry" /></mxCell><mxCell id="next" value="&lt;b&gt;Correction kept visible (B1).&lt;/b&gt; An earlier reading listed &quot;SM contention&quot; between the object detector and the VLA. None of the dose tests ran MPS, so that cannot apply: without MPS the only sharing is turns.&lt;br/&gt;&lt;b&gt;Deciding test, not run:&lt;/b&gt; the depth camera service + the object detector + the VLA without MPS, with MPS, and with the VLA capped at two SM fractions; success = the detector's blocked time next to the VLA falls and no library fails." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;dashed=1;dashPattern=6 4;fillColor=#f3ecf7;strokeColor=#9673a6;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="672" y="636" width="748" height="80" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br/&gt;green, solid border, &quot;A&quot; = client A; orange, dashed border, &quot;B&quot; = client B&lt;br/&gt;dotted tick = context switch; grey band = the test result&lt;br/&gt;small squares = the board's SMs; filled = visible under the cap&lt;br/&gt;amber panel = deployment / software constraint (not the hardware)&lt;br/&gt;purple dashed = a correction" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#f7f7f7;strokeColor=#bbbbbb;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="728" width="500" height="124" as="geometry" /></mxCell><mxCell id="src" value="&lt;b&gt;Sources.&lt;/b&gt; Numbers and quotes loaded from ../constants.json by spec05.py; key in brackets. Notes B1, B3. Contexts, streams, time-slicing, MPS and MIG are taught in ../../nvidia-gpu-anatomy/notes/07-sharing-the-gpu.md.&lt;br/&gt;&lt;b&gt;Illustrative&lt;/b&gt; (round teaching numbers that keep the shape of a finding; not measurements): timeslice_ms, mps_probe_busy_frac, mps_cap_visible_sms, launch_overhead_us, kernel_time_sms_full_share.&lt;br/&gt;&lt;b&gt;Sibling&lt;/b&gt; (keys in a sibling public kit; paths relative to the kit folder): sm_count_orin = ../jetson-orin-thor-metrics/constants.json sm_count.orin.&lt;br/&gt;&lt;b&gt;Public&lt;/b&gt;: mps_no_concurrency_quote = https://docs.nvidia.com/deploy/mps/architecture.html; mps_thread_percentage_env = https://docs.nvidia.com/deploy/mps/when-to-use-mps.html; mps_launch_path_quote = https://docs.nvidia.com/deploy/mps/architecture.html; mps_one_user = https://docs.nvidia.com/deploy/mps/architecture.html; mps_tegra_unsupported = https://docs.nvidia.com/deploy/mps/when-to-use-mps.html ; https://docs.nvidia.com/cuda/cuda-for-tegra-appnote/index.html (section 4.6-4.7); mps_dynamic_parallelism = https://docs.nvidia.com/deploy/mps/when-to-use-mps.html; mps_tegra_since = https://docs.nvidia.com/cuda/cuda-for-tegra-appnote/index.html (section 4.6-4.7)." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=#fff8dc;strokeColor=#d6b656;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="532" y="728" width="888" height="124" as="geometry" /></mxCell><mxCell id="l0" value="" style="endArrow=none;startArrow=none;html=1;dashed=1;dashPattern=2 3;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="231.5" y="148.0" as="sourcePoint" /><mxPoint x="231.5" y="198.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l1" value="" style="endArrow=none;startArrow=none;html=1;dashed=1;dashPattern=2 3;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="321.0" y="148.0" as="sourcePoint" /><mxPoint x="321.0" y="198.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l2" value="" style="endArrow=none;startArrow=none;html=1;dashed=1;dashPattern=2 3;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410.5" y="148.0" as="sourcePoint" /><mxPoint x="410.5" y="198.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l3" value="" style="endArrow=none;startArrow=none;html=1;dashed=1;dashPattern=2 3;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500.0" y="148.0" as="sourcePoint" /><mxPoint x="500.0" y="198.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l4" value="" style="endArrow=none;startArrow=none;html=1;dashed=1;dashPattern=2 3;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="589.5" y="148.0" as="sourcePoint" /><mxPoint x="589.5" y="198.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l5" value="" style="endArrow=none;startArrow=none;html=1;dashed=1;dashPattern=2 3;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="679.0" y="148.0" as="sourcePoint" /><mxPoint x="679.0" y="198.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l6" value="" style="endArrow=none;startArrow=none;html=1;dashed=1;dashPattern=2 3;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="768.5" y="148.0" as="sourcePoint" /><mxPoint x="768.5" y="198.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l7" value="" style="endArrow=none;startArrow=none;html=1;dashed=1;dashPattern=6 4;strokeColor=#888888;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="30.0" y="282.0" as="sourcePoint" /><mxPoint x="860.0" y="282.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l8" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#d79b00;strokeWidth=2.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1099.0" y="206.0" as="sourcePoint" /><mxPoint x="1204.0" y="206.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l9" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#d79b00;strokeWidth=2.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1206.0" y="222.0" as="sourcePoint" /><mxPoint x="1101.