eWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="795" y="436" width="14" height="14" as="geometry" /></mxCell><mxCell id="wl1" value="wave 2" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="815" y="434" width="120" height="16" as="geometry" /></mxCell><mxCell id="w2_0" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#9fc0e8;strokeColor=#6c8ebf;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="555" y="456" width="14" height="14" as="geometry" /></mxCell><mxCell id="w2_1" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#9fc0e8;strokeColor=#6c8ebf;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="571" y="456" width="14" height="14" as="geometry" /></mxCell><mxCell id="w2_2" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#9fc0e8;strokeColor=#6c8ebf;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="587" y="456" width="14" height="14" as="geometry" /></mxCell><mxCell id="w2_3" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#9fc0e8;strokeColor=#6c8ebf;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="603" y="456" width="14" height="14" as="geometry" /></mxCell><mxCell id="w2_4" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#9fc0e8;strokeColor=#6c8ebf;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="619" y="456" width="14" height="14" as="geometry" /></mxCell><mxCell id="w2_5" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#9fc0e8;strokeColor=#6c8ebf;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="635" y="456" width="14" height="14" as="geometry" /></mxCell><mxCell id="w2_6" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#9fc0e8;strokeColor=#6c8ebf;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="651" y="456" width="14" height="14" as="geometry" /></mxCell><mxCell id="w2_7" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#9fc0e8;strokeColor=#6c8ebf;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="667" y="456" width="14" height="14" as="geometry" /></mxCell><mxCell id="w2_8" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;dashed=1;dashPattern=2 2;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="683" y="456" width="14" height="14" as="geometry" /></mxCell><mxCell id="w2_9" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;dashed=1;dashPattern=2 2;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="699" y="456" width="14" height="14" as="geometry" /></mxCell><mxCell id="w2_10" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;dashed=1;dashPattern=2 2;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="715" y="456" width="14" height="14" as="geometry" /></mxCell><mxCell id="w2_11" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;dashed=1;dashPattern=2 2;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="731" y="456" width="14" height="14" as="geometry" /></mxCell><mxCell id="w2_12" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;dashed=1;dashPattern=2 2;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="747" y="456" width="14" height="14" as="geometry" /></mxCell><mxCell id="w2_13" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;dashed=1;dashPattern=2 2;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="763" y="456" width="14" height="14" as="geometry" /></mxCell><mxCell id="w2_14" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;dashed=1;dashPattern=2 2;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="779" y="456" width="14" height="14" as="geometry" /></mxCell><mxCell id="w2_15" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;dashed=1;dashPattern=2 2;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="795" y="456" width="14" height="14" as="geometry" /></mxCell><mxCell id="wl2" value="wave 3 (partial)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="815" y="454" width="120" height="16" as="geometry" /></mxCell><mxCell id="wt" value="More SMs -&amp;gt; fewer waves: roughly in proportion for kernels with many waves; in steps, possibly none, for kernels with only a few waves, because the last wave rounds up; no gain where a kernel is limited by DRAM bandwidth, L2 or memory latency (not measured per kernel). &lt;b&gt;An expectation, not a measurement.&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="935" y="412" width="475" height="104" as="geometry" /></mxCell><mxCell id="corr" value="&lt;b&gt;Two corrections kept visible&lt;/b&gt;&lt;br/&gt;• &quot;A low issue rate means room for MPS&quot;: wrong. A register-bound GEMM fills its SMs with few warps, so issue is low while no other block fits.&lt;br/&gt;• &quot;More SMs mostly add idle SMs&quot;: wrong for multi-wave kernels." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;dashed=1;dashPattern=6 4;fillColor=#f3ecf7;strokeColor=#9673a6;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="532" width="500" height="84" as="geometry" /></mxCell><mxCell id="mps" value="&lt;b&gt;What it means for MPS (hypothesis, page 05).&lt;/b&gt; In the rest of the kernel time (small grids, partial last waves, kernels below 90 % on every resource) kernels of two processes could overlap. During full kernels MPS mainly lets the other process's blocks start as SM resources free up, instead of after a whole time slice and a context switch." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="532" y="532" width="440" height="84" as="geometry" /></mxCell><mxCell id="cav" value="&lt;b&gt;Caveats.&lt;/b&gt; Fill numbers are &lt;b&gt;theoretical&lt;/b&gt;, from launch configurations in solo traces; achieved occupancy, stall reasons and co-residency under MPS were not measured, nor why issue is low. Traces had limits (a different VLA model version; a replay-fed detector; an empty people-perception scene). The gauges on the left are a schematic." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="984" y="532" width="436" height="84" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br/&gt;green solid bar = share with SMs full; white bar, dashed green = warp-slot fill&lt;br/&gt;blue bar = share in &amp;gt; 1 wave; blue squares = SMs busy in a wave&lt;br/&gt;faint dotted bar = below the low end of a range&lt;br/&gt;gauges: solid = value or range low end; dashed = range high end or GPU-active share&lt;br/&gt;dashed vertical line = the &quot;full&quot; definition; purple dashed = a correction" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#f7f7f7;strokeColor=#bbbbbb;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="628" width="500" height="92" as="geometry" /></mxCell><mxCell id="src" value="&lt;b&gt;Sources.&lt;/b&gt; Note B2. Occupancy and issue rate: ../../nvidia-gpu-anatomy/ (note 03); board limits: ../../jetson-orin-thor-metrics/. The &quot;full&quot; threshold is read from the source text of kernel_time_sms_full_share.&lt;br/&gt;&lt;b&gt;Illustrative&lt;/b&gt; (round teaching numbers that keep the shape of a finding; not measurements): sm_issue_full_stack, gpu_active_full_stack, gemm_warp_slot_fill, kernel_time_sms_full_share, multiwave_share.&lt;br/&gt;&lt;b&gt;Sibling&lt;/b&gt; (keys in a sibling public kit; paths relative to the kit folder): max_warps_per_sm = ../jetson-orin-thor-metrics/constants.json max_warps_per_sm; registers_per_sm = ../jetson-orin-thor-metrics/constants.json registers_per_sm; l1_shared_per_sm_orin_kb = ../jetson-orin-thor-metrics/constants.json l1_shared_per_sm.orin; sm_count_orin = ../jetson-orin-thor-metrics/constants.json sm_count.orin.&lt;br/&gt;&lt;b&gt;Public&lt;/b&gt;: max_blocks_per_sm_cc87 = https://docs.nvidia.com/cuda/cuda-c-programming-guide/ (technical specifications per compute capability; occupancy); warp_size = https://docs.nvidia.com/cuda/cuda-c-programming-guide/ (technical specifications per compute capability; occupancy); register_alloc_unit_per_warp = https://docs.nvidia.com/cuda/cuda-c-programming-guide/ (technical specifications per compute capability; occupancy); max_registers_per_thread = https://docs.nvidia.com/cuda/cuda-c-programming-guide/ (technical specifications per compute capability; occupancy)." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=#fff8dc;strokeColor=#d6b656;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="532" y="628" width="888" height="118" as="geometry" /></mxCell><mxCell id="l0" value="" style="endArrow=none;startArrow=none;html=1;dashed=1;dashPattern=4 3;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460.0" y="242.0" as="sourcePoint" /><mxPoint x="460.0" y="278.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l1" value="" style="endArrow=none;startArrow=none;html=1;dashed=1;dashPattern=4 3;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460.0" y="362.0" as="sourcePoint" /><mxPoint x="460.0" y="398.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l2" value="" style="endArrow=none;startArrow=none;html=1;dashed=1;dashPattern=4 3;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460.0" y="422.0" as="sourcePoint" /><mxPoint x="460.0" y="458.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l3" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#dddddd;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="825.0" y="118.0" as="sourcePoint" /><mxPoint x="825.0" y="236.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l4" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#dddddd;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1065.0" y="118.0" as="sourcePoint" /><mxPoint x="1065.0" y="236.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l5" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#dddddd;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1305.0" y="118.0" as="sourcePoint" /><mxPoint x="1305.0" y="236.0" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>