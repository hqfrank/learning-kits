<mxfile host="app.diagrams.net"><diagram id="p_09_ridge_two_boards" name="09-ridge-two-boards"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="760" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="The same vision encoder sits well above the Orin's ridge (compute-bound: the compute form is right) but near Thor's effective ridge, where neither form alone is safe (illustrative encoder, sibling ceilings)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=20;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1400" height="60" as="geometry" /></mxCell><mxCell id="axt0" value="30" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="80.0" y="584" width="60" height="15" as="geometry" /></mxCell><mxCell id="axt1" value="100" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="263.00756084811815" y="584" width="60" height="15" as="geometry" /></mxCell><mxCell id="axt2" value="300" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="430.00000000000006" y="584" width="60" height="15" as="geometry" /></mxCell><mxCell id="axt3" value="1000" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="613.0075608481181" y="584" width="60" height="15" as="geometry" /></mxCell><mxCell id="axt4" value="3000" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="780.0" y="584" width="60" height="15" as="geometry" /></mxCell><mxCell id="ayt0" value="2" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="570.0" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt1" value="5" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="487.7088722004582" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt2" value="10" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="425.4580371377889" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt3" value="20" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="363.20720207511965" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt4" value="50" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="280.91607427557784" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt5" value="100" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="218.66523921290855" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt6" value="200" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="156.41440415023925" width="44" height="16" as="geometry" /></mxCell><mxCell id="axl" value="arithmetic intensity (FLOP per byte of DRAM traffic), log scale" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="110" y="600" width="700" height="18" as="geometry" /></mxCell><mxCell id="ayl" value="attainable rate (TFLOP/s), log scale" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="104" width="750" height="18" as="geometry" /></mxCell><mxCell id="bando" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;dashed=1;dashPattern=2 2;fillColor=#dbe7f5;strokeColor=#1f5fa8;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="286.9" y="349.4" width="523.1" height="36.4" as="geometry" /></mxCell><mxCell id="bandt" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;dashed=1;dashPattern=2 2;fillColor=#fbe3cc;strokeColor=#d9711c;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="500.0" y="213.7" width="310.0" height="36.4" as="geometry" /></mxCell><mxCell id="vl" value="&lt;b&gt;vision encoder&lt;/b&gt;, weight side&lt;br/&gt;500 FLOP/B [vision_encoder: intensity_flop_per_byte, illustrative]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#7b4f9d;" vertex="1" parent="1"><mxGeometry x="341.64706236572465" y="132" width="190" height="58" as="geometry" /></mxCell><mxCell id="rb0" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#1f5fa8;strokeColor=#1f5fa8;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="286.9" y="562" width="61.6" height="10" as="geometry" /></mxCell><mxCell id="rb1" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#d9711c;strokeColor=#d9711c;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="500.0" y="532" width="61.6" height="10" as="geometry" /></mxCell><mxCell id="rl0" value="Orin ridge (FLOP/B):&lt;br/&gt;shapes 96–144, roof 240" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#1f5fa8;" vertex="1" parent="1"><mxGeometry x="112.51250461949323" y="552" width="170" height="28" as="geometry" /></mxCell><mxCell id="rl1" value="Thor ridge (FLOP/B):&lt;br/&gt;shapes 390–585, roof 976" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#d9711c;" vertex="1" parent="1"><mxGeometry x="299.9318196640017" y="522" width="190" height="28" as="geometry" /></mxCell><mxCell id="tcl" value="&lt;b&gt;Thor&lt;/b&gt; tensor FP16&lt;br/&gt;192.5 TFLOP/s [tensor_fp16_thor]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#d9711c;" vertex="1" parent="1"><mxGeometry x="554.8733703002882" y="131.84701194537342" width="250" height="32" as="geometry" /></mxCell><mxCell id="tsl" value="Thor at shapes 77–115.5 TFLOP/s&lt;br/&gt;(x 0.4–0.6)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#d9711c;" vertex="1" parent="1"><mxGeometry x="664.2518049718823" y="215.723735594676" width="260" height="30" as="geometry" /></mxCell><mxCell id="ocl" value="&lt;b&gt;Orin&lt;/b&gt; tensor FP16 42.5 TFLOP/s [tensor_fp16_orin]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#1f5fa8;" vertex="1" parent="1"><mxGeometry x="609.0890562952984" y="273.5117321076631" width="300" height="28" as="geometry" /></mxCell><mxCell id="osl" value="Orin at shapes 17–25.5 TFLOP/s&lt;br/&gt;[shape_rate_fraction, illustrative]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#1f5fa8;" vertex="1" parent="1"><mxGeometry x="664.2518049718823" y="351.38845575696564" width="260" height="30" as="geometry" /></mxCell><mxCell id="obl" value="Orin DRAM read 177 GB/s [dram_read_orin]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#1f5fa8;" vertex="1" parent="1"><mxGeometry x="171.63194066948847" y="463.8921061379919" width="220" height="30" as="geometry" /></mxCell><mxCell id="tbl" value="Thor DRAM 197.3 GB/s, sustained by a pi0.5-class VLA [pi05_sustained_bandwidth_thor]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#d9711c;" vertex="1" parent="1"><mxGeometry x="114.98415369011359" y="250" width="200" height="44" as="geometry" /></mxCell><mxCell id="fp" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacing=6;fillColor=none;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="850" y="84" width="570" height="318" as="geometry" /></mxCell><mxCell id="fh" value="&lt;b&gt;Vision time: the two forms of the prediction vs an illustrative measurement&lt;/b&gt; (ms; 0.5 TFLOP, weights about 1 GB, my estimate from `vision_encoder`)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="860" y="90" width="550" height="34" as="geometry" /></mxCell><mxCell id="fxt0" value="0" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1005.0" y="352" width="30" height="14" as="geometry" /></mxCell><mxCell id="fxt1" value="4" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1050.0" y="352" width="30" height="14" as="geometry" /></mxCell><mxCell id="fxt2" value="8" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1095.0" y="352" width="30" height="14" as="geometry" /></mxCell><mxCell id="fxt3" value="12" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1140.0" y="352" width="30" height="14" as="geometry" /></mxCell><mxCell id="fxt4" value="16" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1185.0" y="352" width="30" height="14" as="geometry" /></mxCell><mxCell id="fxt5" value="20" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1230.0" y="352" width="30" height="14" as="geometry" /></mxCell><mxCell id="fxt6" value="24" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1275.0" y="352" width="30" height="14" as="geometry" /></mxCell><mxCell id="fxt7" value="28" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1320.0" y="352" width="30" height="14" as="geometry" /></mxCell><mxCell id="fxt8" value="32" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1365.0" y="352" width="30" height="14" as="geometry" /></mxCell><mxCell id="fxl" value="ms" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1388.0" y="352" width="24" height="14" as="geometry" /></mxCell><mxCell id="fn0" value="&lt;b&gt;Orin: bandwidth form&lt;br/&gt;(the first prediction)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=right;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="856" y="140" width="158" height="32" as="geometry" /></mxCell><mxCell id="fb0" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;dashed=1;dashPattern=5 3;fillColor=#ffffff;strokeColor=#1f5fa8;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1020.0" y="146" width="67.5" height="20" as="geometry" /></mxCell><mxCell id="fl0" value="6 ms [vision_pred_bandwidth_form_ms, illustrative]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#1f5fa8;" vertex="1" parent="1"><mxGeometry x="1091.5" y="142" width="200" height="30" as="geometry" /></mxCell><mxCell id="fn1" value="&lt;b&gt;Orin: compute form&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=right;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="856" y="180" width="158" height="32" as="geometry" /></mxCell><mxCell id="fb1" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#1f5fa8;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1245.0" y="186" width="112.5" height="20" as="geometry" /></mxCell><mxCell id="fl1" value="20–30 ms [vision_compute_form_ms, illustrative]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#1f5fa8;" vertex="1" parent="1"><mxGeometry x="1021.0" y="188" width="220" height="30" as="geometry" /></mxCell><mxCell id="fn2" value="&lt;b&gt;Thor: bandwidth form&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=right;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="856" y="240" width="158" height="32" as="geometry" /></mxCell><mxCell id="fb2" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;dashed=1;dashPattern=8 3 2 3;fillColor=#fff3e8;strokeColor=#d9711c;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1020.0" y="246" width="57.0" height="20" as="geometry" /></mxCell><mxCell id="fl2" value="about 5.1 ms" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#d9711c;" vertex="1" parent="1"><mxGeometry x="1081.0197668525088" y="242" width="200" height="30" as="geometry" /></mxCell><mxCell id="fn3" value="&lt;b&gt;Thor: compute, at roof&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=right;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="856" y="280" width="158" height="32" as="geometry" /></mxCell><mxCell id="fb3" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#fbd3ad;strokeColor=#d9711c;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1020.0" y="286" width="29.2" height="20" as="geometry" /></mxCell><mxCell id="fl3" value="about 2.6 ms" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#d9711c;" vertex="1" parent="1"><mxGeometry x="1053.2207792207791" y="282" width="200" height="30" as="geometry" /></mxCell><mxCell id="fn4" value="&lt;b&gt;Thor: compute, at shapes&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=right;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="856" y="320" width="158" height="32" as="geometry" /></mxCell><mxCell id="fb4" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#fbd3ad;strokeColor=#d9711c;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1068.7" y="326" width="24.4" height="20" as="geometry" /></mxCell><mxCell id="fl4" value="about 4.3–6.5 ms" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#d9711c;" vertex="1" parent="1"><mxGeometry x="1097.051948051948" y="322" width="200" height="30" as="geometry" /></mxCell><mxCell id="om" value="&lt;b&gt;measured 25 ms&lt;/b&gt; [vision_measured_ms_orin, illustrative]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="997.25" y="210" width="300" height="16" as="geometry" /></mxCell><mxCell id="tnm" value="Thor rows: my estimates from `vision_encoder`, `pi05_sustained_bandwidth_thor`, `tensor_fp16_thor` and `shape_rate_fraction`. No Thor vision time is given here." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="860" y="370" width="550" height="30" as="geometry" /></mxCell><mxCell id="orin" value="&lt;b&gt;Orin: the form was what mattered.&lt;/b&gt; Intensity ÷ ridge is about 2.1 at the roof, 3.5–5.2 at the shapes, so the encoder is compute-bound and the compute form brackets the measurement. The bandwidth form misses by about 4.2 times (my estimate from `vision_measured_ms_orin` and `vision_pred_bandwidth_form_ms`): the wrong form, not a slow encoder." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="850" y="412" width="570" height="80" as="geometry" /></mxCell><mxCell id="thor" value="&lt;b&gt;Thor: the data do not decide.&lt;/b&gt; Intensity ÷ ridge is about 0.51 at the roof, 0.85–1.28 at the shapes: the two forms give about the same time, so either roof could bind. Thor's compute roof is about 4.5× the Orin's, its bandwidth only about 1.1× (my estimate from the four sibling keys)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;dashed=1;dashPattern=8 3 2 3;fillColor=#fff3e8;strokeColor=#d9711c;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="850" y="502" width="570" height="80" as="geometry" /></mxCell><mxCell id="cav" value="&lt;b&gt;Caveats.&lt;/b&gt; The weight-side intensity is an upper bound for one pass; counting all DRAM traffic lowers it and moves the encoder toward the ridge on both boards. The shape-rate fraction is illustrative and &lt;b&gt;applied to Thor by assumption&lt;/b&gt;. Thor's bandwidth is a sustained value from a VLA, not a read peak: with Thor's read peak (259 GB/s [dram_read_thor]) the ridge is about 743 FLOP/B (my estimate from `tensor_fp16_thor` and `dram_read_thor`), about 3× the Orin's roof ridge rather than about 4×; the encoder stays near it. Axes are approximate; the labelled values are exact." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="630" width="470" height="118" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br/&gt;blue solid = Orin roofs; orange dash-dot = Thor roofs&lt;br/&gt;shaded dotted bands = GEMM rate at the model's own shapes&lt;br/&gt;purple dashed = the encoder's weight-side intensity&lt;br/&gt;right: dashed outline = the first prediction; black line = measurement&lt;br/&gt;bars under the plot = ridge at shapes; tick = at the roof" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#f7f7f7;strokeColor=#bbbbbb;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="502" y="630" width="400" height="118" as="geometry" /></mxCell><mxCell id="src" value="&lt;b&gt;Sources.&lt;/b&gt; Note B4. Roofline and ridge: ../../jetson-orin-thor-metrics/ (glossary, note C1). Ridges, weights and Thor times are my arithmetic.&lt;br/&gt;&lt;b&gt;Illustrative&lt;/b&gt; (round teaching numbers that keep the shape of a finding; not measurements): vision_encoder, shape_rate_fraction, vision_pred_bandwidth_form_ms, vision_compute_form_ms, vision_measured_ms_orin.&lt;br/&gt;&lt;b&gt;Sibling&lt;/b&gt; (keys in a sibling public kit; paths relative to the kit folder): tensor_fp16_thor = ../jetson-orin-thor-metrics/constants.json tensor_tcgen05_fp16.thor; tensor_fp16_orin = ../jetson-orin-thor-metrics/constants.json tensor_classic_fp16.orin; dram_read_orin = ../jetson-orin-thor-metrics/constants.json dram_bandwidth_read_measured.orin; pi05_sustained_bandwidth_thor = ../jetson-orin-thor-metrics/constants.json pi05_sustained_bandwidth; dram_read_thor = ../jetson-orin-thor-metrics/constants.json dram_bandwidth_read_measured.thor." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=#fff8dc;strokeColor=#d6b656;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="914" y="630" width="506" height="118" as="geometry" /></mxCell><mxCell id="l0" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110.0" y="578.0" as="sourcePoint" /><mxPoint x="810.0" y="578.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l1" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110.0" y="128.0" as="sourcePoint" /><mxPoint x="110.0" y="578.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l2" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#e6e6e6;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110.0" y="128.0" as="sourcePoint" /><mxPoint x="110.0" y="578.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l3" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110.0" y="578.0" as="sourcePoint" /><mxPoint x="110.0" y="583.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l4" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#e6e6e6;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="293.0" y="128.0" as="sourcePoint" /><mxPoint x="293.0" y="578.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l5" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="293.0" y="578.0" as="sourcePoint" /><mxPoint x="293.0" y="583.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l6" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#e6e6e6;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460.0" y="128.0" as="sourcePoint" /><mxPoint x="460.0" y="578.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l7" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460.0" y="578.0" as="sourcePoint" /><mxPoint x="460.0" y="583.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l8" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#e6e6e6;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="643.0" y="128.0" as="sourcePoint" /><mxPoint x="643.0" y="578.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l9" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="643.0" y="578.0" as="sourcePoint" /><mxPoint x="643.0" y="583.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l10" value="" style="endArrow=none;startArrow=none;html=1;st