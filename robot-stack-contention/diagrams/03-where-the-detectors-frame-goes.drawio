<mxfile host="app.diagrams.net"><diagram id="p_03_where_the_detectors_frame_goes" name="03-where-the-detectors-frame-goes"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="649" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="The object detector's frame: from alone to the full stack it grows mostly by CPU terms (run-queue wait + slower run); from the full stack to full stack + VLA it grows mostly by GPU-blocked time" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=20;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1420" height="60" as="geometry" /></mxCell><mxCell id="n0" value="&lt;b&gt;Alone&lt;/b&gt;&lt;br/&gt;[detector_frame_ms_solo_full, illustrative]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="14" y="84" width="206" height="64" as="geometry" /></mxCell><mxCell id="n1" value="&lt;b&gt;Full stack&lt;/b&gt;&lt;br/&gt;[detector_added_wait_run_blocked, illustrative]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="14" y="194" width="206" height="64" as="geometry" /></mxCell><mxCell id="n2" value="&lt;b&gt;Full stack + VLA&lt;/b&gt;&lt;br/&gt;[detector_vla_added_blocked_wait_run, illustrative]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="14" y="304" width="206" height="64" as="geometry" /></mxCell><mxCell id="solo" value="alone frame 100 ms&lt;br/&gt;(alone frame not split)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#e4e4e4;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="230.0" y="84" width="280.0" height="64" as="geometry" /></mxCell><mxCell id="fb" value="alone frame 100 ms" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#e4e4e4;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="230.0" y="194" width="280.0" height="64" as="geometry" /></mxCell><mxCell id="fw" value="+50&lt;br/&gt;wait" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#9fc0e8;strokeColor=#2f5d9a;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="510.0" y="194" width="140.0" height="64" as="geometry" /></mxCell><mxCell id="fr" value="+30&lt;br/&gt;run" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;dashed=1;dashPattern=5 3;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="650.0" y="194" width="84.0" height="64" as="geometry" /></mxCell><mxCell id="fk" value="+20&lt;br/&gt;blocked" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#b9dfb0;strokeColor=#3f7f33;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="734.0" y="194" width="56.0" height="64" as="geometry" /></mxCell><mxCell id="ftot" value="= &lt;b&gt;200 ms&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=12;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="796.0" y="214" width="120" height="24" as="geometry" /></mxCell><mxCell id="vb0" value="full-stack frame 200 ms" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#e4e4e4;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="230.0" y="304" width="560.0" height="64" as="geometry" /></mxCell><mxCell id="vk" value="+70&lt;br/&gt;blocked" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#b9dfb0;strokeColor=#3f7f33;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="790.0" y="304" width="196.0" height="64" as="geometry" /></mxCell><mxCell id="vw" value="+20&lt;br/&gt;wait" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#9fc0e8;strokeColor=#2f5d9a;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="986.0" y="304" width="56.0" height="64" as="geometry" /></mxCell><mxCell id="vr" value="+10&lt;br/&gt;run" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;dashed=1;dashPattern=5 3;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1042.0" y="304" width="28.0" height="64" as="geometry" /></mxCell><mxCell id="vtot" value="= about &lt;b&gt;300 ms&lt;/b&gt; (my estimate from `detector_frame_ms_solo_full` and `detector_vla_added_blocked_wait_run`)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="470.0" y="374" width="606" height="36" as="geometry" /></mxCell><mxCell id="tk0" value="0" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="210.0" y="441" width="40" height="16" as="geometry" /></mxCell><mxCell id="tk50" value="50" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="350.0" y="441" width="40" height="16" as="geometry" /></mxCell><mxCell id="tk100" value="100" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="490.0" y="441" width="40" height="16" as="geometry" /></mxCell><mxCell id="tk150" value="150" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="630.0" y="441" width="40" height="16" as="geometry" /></mxCell><mxCell id="tk200" value="200" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="770.0" y="441" width="40" height="16" as="geometry" /></mxCell><mxCell id="tk250" value="250" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="910.0" y="441" width="40" height="16" as="geometry" /></mxCell><mxCell id="tk300" value="300" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1050.0" y="441" width="40" height="16" as="geometry" /></mxCell><mxCell id="axl" value="ms per frame (the detector's own per-frame log, split by the inventory script)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="230" y="458" width="840.0" height="18" as="geometry" /></mxCell><mxCell id="ann1" value="&lt;b&gt;alone -&amp;gt; full stack: mostly CPU.&lt;/b&gt; Wait + run = 80 of +100 ms added; wait alone = 0.5 of it (my estimate from `detector_added_wait_run_blocked`). Clocks locked, so not frequency." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1110" y="186" width="330" height="80" as="geometry" /></mxCell><mxCell id="ann2" value="&lt;b&gt;full stack -&amp;gt; + VLA: mostly GPU.&lt;/b&gt; Blocked +70 of +100 ms added = 0.7 (my estimate from `detector_vla_added_blocked_wait_run`): GPU time-slicing between CUDA contexts (page 05)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1110" y="296" width="330" height="80" as="geometry" /></mxCell><mxCell id="corr" value="&lt;b&gt;Correction kept visible.&lt;/b&gt; Step 1 first said the pool changes from the full stack to full stack + VLA were &quot;within round-to-round spread&quot;. Withdrawn: one full stack + VLA round had no speech in its window. With voice on in both, pool wait rises. The GPU step is still the larger change." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;dashed=1;dashPattern=6 4;fillColor=#f3ecf7;strokeColor=#9673a6;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="492" width="450" height="74" as="geometry" /></mxCell><mxCell id="cav" value="&lt;b&gt;Caveats.&lt;/b&gt; &quot;Blocked&quot; = neither running nor waiting for a CPU (mostly GPU sync; also locks, I/O). The GPU mechanism was tested in a camera-plus-detector row with an idle pool; in the full stack it is expected, not tested (note B1). The + VLA total is my sum of the added terms." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="495" y="492" width="480" height="74" as="geometry" /></mxCell><mxCell id="rate" value="&lt;b&gt;What each term means.&lt;/b&gt; Wait = runnable, no free pool core (note A1, page 02). Added run = the same instructions needing more cycles (note A2, page 04). Blocked next to the VLA = waiting for other contexts' GPU turns (note B1, page 05)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="990" y="492" width="450" height="74" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt; grey = the previous level's frame; mid-blue, solid border = added run-queue wait (CPU); light blue, dashed border = added run time (CPU); green, solid border = added blocked time (mostly GPU sync); every term is also named in its bar. Bar lengths to scale (2.8 px per ms)." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#f7f7f7;strokeColor=#bbbbbb;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="578" width="600" height="55" as="geometry" /></mxCell><mxCell id="src" value="&lt;b&gt;Sources.&lt;/b&gt; Numbers loaded from ../constants.json by spec03.py; key in brackets. Notes A1 (per-frame decomposition, correction), B1 (the rise next to the VLA).&lt;br/&gt;&lt;b&gt;Illustrative&lt;/b&gt; (round teaching numbers that keep the shape of a finding; not measurements): detector_frame_ms_solo_full, detector_added_wait_run_blocked, detector_vla_added_blocked_wait_run." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=9;spacing=6;fillColor=#fff8dc;strokeColor=#d6b656;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="645" y="578" width="795" height="53" as="geometry" /></mxCell><mxCell id="l0" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#444444;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="230.0" y="434.0" as="sourcePoint" /><mxPoint x="1070.0" y="434.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l1" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#444444;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="230.0" y="434.0" as="sourcePoint" /><mxPoint x="230.0" y="440.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l2" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#444444;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="370.0" y="434.0" as="sourcePoint" /><mxPoint x="370.0" y="440.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l3" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#444444;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510.0" y="434.0" as="sourcePoint" /><mxPoint x="510.0" y="440.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l4" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#444444;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650.0" y="434.0" as="sourcePoint" /><mxPoint x="650.0" y="440.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l5" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#444444;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790.0" y="434.0" as="sourcePoint" /><mxPoint x="790.0" y="440.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l6" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#444444;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="930.0" y="434.0" as="sourcePoint" /><mxPoint x="930.0" y="440.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l7" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#444444;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070.0" y="434.0" as="sourcePoint" /><mxPoint x="1070.0" y="440.0" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>