      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="cpu" value="CPU cores
(14x on Thor)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="730" y="246" width="130" height="36" as="geometry" />
