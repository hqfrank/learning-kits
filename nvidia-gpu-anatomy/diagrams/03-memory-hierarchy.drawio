      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="finding" value="Two facts the kit stresses:  (1) L2-resident streaming is 12.4x (Orin) / 14.6x (Thor) faster than DRAM.  (2) L2 latency barely moved generation-to-generation (146 -&gt; 156 ns) while L2 capacity grew 8x.  Bigger L2 = more data stays resident, not resident data reached faster." style="text;html=0;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
      <mxGeometry x="60" y="372" width="800" height="54" as="geometry" />
    </mxCell>

    <mxCell id="legend" value="Legend:  blue = Orin measured   green = Thor measured   latency = dependent-load landmark   &quot;resident read&quot; = bandwidth when the working set fits that level.  Latency rises + bandwidth falls going down; capacity rises." style="text;html=0;align=left;verticalAlign=top;fontSize=10;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
      <mxGeometry x="60" y="434" width="800" height="40" as="geometry" />
    </mxCell>
    <mxCell id="src" value="Sources (constants.json): registers_per_sm 64K [Platforms Table 1]; l1_shared_per_sm 164/228 KB, l1_read_datapath 128 B/cyc [Platforms Table 1]; l2_size 4/32 MB, l2_dram_capacity_ratio 8x [Platforms Table 1]; l2_resident_read_bandwidth 2200/3790 GB/s [A.6]; dram_bandwidth_read_measured 177/259 GB/s [A.6]; l2_dram_bandwidth_ratio 12.4/14.6x [A.6]; latency_l1 29.9/25.3 ns, latency_l2 146/156 ns, latency_dram 675/510 ns [A.7].  Hierarchy + unified memory: CUDA Prog. Guide 1.2.3 (A-PM)." style="text;html=0;align=left;verticalAlign=top;fontSize=9;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
      <mxGeometry x="60" y="480" width="800" height="68" as="geometry" />
    </mxCell>
