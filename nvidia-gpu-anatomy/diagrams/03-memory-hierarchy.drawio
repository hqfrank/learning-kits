<mxfile host="app.diagrams.net"><diagram id="p03" name="03-memory-hierarchy"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="680" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />

    <mxCell id="title" value="Thor grew L2 8x (4 -&gt; 32 MB) but L2 latency did NOT change (146 -&gt; 156 ns): more data stays resident, not reached faster" style="text;html=0;align=center;verticalAlign=middle;fontSize=13;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="20" y="10" width="860" height="40" as="geometry" />
    </mxCell>

    <mxCell id="colhdr_scope" value="level  (fastest/smallest at top)" style="text;html=0;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1">
      <mxGeometry x="60" y="56" width="300" height="20" as="geometry" />
    </mxCell>
    <mxCell id="colhdr_orin" value="Orin (Ampere)" style="text;html=0;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
      <mxGeometry x="372" y="56" width="150" height="22" as="geometry" />
    </mxCell>
