datapath 128 B/cyc
latency 29.9 ns" style="rounded=0;whiteSpace=wrap;html=0;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
      <mxGeometry x="372" y="136" width="150" height="52" as="geometry" />
    </mxCell>
    <mxCell id="l1_t" value="228 KB
datapath 128 B/cyc
