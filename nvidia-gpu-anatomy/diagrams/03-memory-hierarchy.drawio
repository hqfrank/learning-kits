    <mxCell id="copy" value="Copy engines
(H2D/D2H/D2D)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="730" y="292" width="130" height="36" as="geometry" />
    </mxCell>
