    </mxCell>
    <mxCell id="s3e" value="1 tensor core (MMA unit)" style="rounded=0;whiteSpace=wrap;html=0;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
