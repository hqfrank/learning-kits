    <mxCell id="s3f" value="register file (slice of 64K)" style="rounded=0;whiteSpace=wrap;html=0;fontSize=9;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="466" y="314" width="172" height="24" as="geometry" />
    </mxCell>

    <mxCell id="s4a" value="warp scheduler + dispatch port
1 instruction / cycle" style="rounded=0;whiteSpace=wrap;html=0;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
      <mxGeometry x="666" y="116" width="172" height="40" as="geometry" />
    </mxCell>
    <mxCell id="s4b" value="32 FP32 lanes (CUDA cores)" style="rounded=0;whiteSpace=wrap;html=0;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
      <mxGeometry x="666" y="162" width="172" height="34" as="geometry" />
    </mxCell>
    <mxCell id="s4c" value="INT / ALU pipe" style="rounded=0;whiteSpace=wrap;html=0;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
      <mxGeometry x="666" y="202" width="172" height="28" as="geometry" />
    </mxCell>
    <mxCell id="s4d" value="LD/ST + SFU" style="rounded=0;whiteSpace=wrap;html=0;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
      <mxGeometry x="666" y="236" width="172" height="28" as="geometry" />
    </mxCell>
    <mxCell id="s4e" value="1 tensor core (MMA unit)" style="rounded=0;whiteSpace=wrap;html=0;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
      <mxGeometry x="666" y="270" width="172" height="40" as="geometry" />
    </mxCell>
