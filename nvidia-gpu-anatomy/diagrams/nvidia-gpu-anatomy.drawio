    <mxCell id="smsp3" value="SMSP 2" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=top;fontSize=11;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
      <mxGeometry x="456" y="92" width="192" height="252" as="geometry" />
    </mxCell>
    <mxCell id="smsp4" value="SMSP 3" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=top;fontSize=11;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
      <mxGeometry x="656" y="92" width="192" height="252" as="geometry" />
    </mxCell>

    <mxCell id="s1a" value="warp scheduler + dispatch port
1 instruction / cycle  (bound D=1)" style="rounded=0;whiteSpace=wrap;html=0;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
      <mxGeometry x="66" y="116" width="172" height="40" as="geometry" />
