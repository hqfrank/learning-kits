    <mxCell id="s1d" value="LD/ST + SFU" style="rounded=0;whiteSpace=wrap;html=0;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
      <mxGeometry x="66" y="236" width="172" height="28" as="geometry" />
    </mxCell>
    <mxCell id="s1e" value="1 tensor core (MMA unit)
Orin 3rd-gen | Thor 5th-gen tcgen05" style="rounded=0;whiteSpace=wrap;html=0;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
      <mxGeometry x="66" y="270" width="172" height="40" as="geometry" />
