    <mxCell id="smsp2" value="SMSP 1" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=top;fontSize=11;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
      <mxGeometry x="256" y="92" width="192" height="252" as="geometry" />
