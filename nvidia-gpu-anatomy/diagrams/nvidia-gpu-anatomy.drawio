    <mxCell id="s2e" value="1 tensor core (MMA unit)" style="rounded=0;whiteSpace=wrap;html=0;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
      <mxGeometry x="266" y="270" width="172" height="40" as="geometry" />
    </mxCell>
    <mxCell id="s2f" value="register file (slice of 64K)" style="rounded=0;whiteSpace=wrap;html=0;fontSize=9;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="266" y="314" width="172" height="24" as="geometry" />
