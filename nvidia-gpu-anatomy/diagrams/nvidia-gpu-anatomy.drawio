    <mxCell id="s2b" value="32 FP32 lanes (CUDA cores)" style="rounded=0;whiteSpace=wrap;html=0;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
