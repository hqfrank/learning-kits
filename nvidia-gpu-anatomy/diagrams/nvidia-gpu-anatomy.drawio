1 instruction / cycle" style="rounded=0;whiteSpace=wrap;html=0;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
      <mxGeometry x="466" y="116" width="172" height="40" as="geometry" />
    </mxCell>
    <mxCell id="s3b" value="32 FP32 lanes (CUDA cores)" style="rounded=0;whiteSpace=wrap;html=0;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
