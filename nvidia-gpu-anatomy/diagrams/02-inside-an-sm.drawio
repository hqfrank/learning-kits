    <mxCell id="shared1" value="L1 cache / shared memory  -  ONE unified array per SM, runtime carveout splits L1 vs shared
Orin 164 KB   |   Thor 228 KB      (L1 read datapath 128 B/cycle/SM, both)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=11;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
      <mxGeometry x="56" y="352" width="500" height="52" as="geometry" />
    </mxCell>
    <mxCell id="shared2" value="Register file:  65536 registers (64K) per SM, split per SMSP
Totals per SM: 128 FP32 cores (4 x 32) | 4 tensor cores | up to 48 warps = 1536 threads" style="rounded=1;whiteSpace=wrap;html=0;fontSize=11;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
      <mxGeometry x="568" y="352" width="280" height="52" as="geometry" />
    </mxCell>

    <mxCell id="bound" value="SM issue bound: 4 SMSP x 1 inst/cycle = at most 4 warp instructions per cycle. More FP32 cores do NOT raise issue rate - the dispatch port does." style="text;html=0;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
      <mxGeometry x="56" y="414" width="792" height="36" as="geometry" />
    </mxCell>

    <mxCell id="legend" value="Legend:  orange = scheduler/issue (the bound)   blue = CUDA-core / scalar pipes   purple = tensor core   red = register file   yellow = L1/shared" style="text;html=0;align=left;verticalAlign=top;fontSize=10;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
      <mxGeometry x="40" y="466" width="820" height="30" as="geometry" />
    </mxCell>
    <mxCell id="src" value="Sources (constants.json): smsp_per_sm=4; dispatch_bound_per_smsp=1 inst/cycle; fp32_cores_per_sm=128; tensor_cores_per_sm=4; registers_per_sm=65536; max_warps_per_sm=48; max_threads_per_sm=1536; l1_shared_per_sm 164/228 KB; l1_read_datapath=128 B/cycle/SM  [all Platforms Table 1].  Pipe inventory: SM-internals forums (B-FORUMS); SIMT in-order issue: CUDA Prog. Guide 3.2.2 (A-HW)." style="text;html=0;align=left;verticalAlign=top;fontSize=9;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
