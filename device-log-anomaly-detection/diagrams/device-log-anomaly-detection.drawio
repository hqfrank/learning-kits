keColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="660.0" y="476" width="60" height="15" as="geometry" /></mxCell><mxCell id="ayt0" value="0" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="462.0" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt1" value="0.2" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="390.0" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt2" value="0.4" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="318.0" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt3" value="0.6" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="246.0" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt4" value="0.8" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="174.0" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt5" value="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="102.0" width="44" height="16" as="geometry" /></mxCell><mxCell id="axl" value="E(h(x)) = mean splits needed to isolate the window, over the forest" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=11;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="90" y="492" width="600" height="18" as="geometry" /></mxCell><mxCell id="ayl" value="anomaly score s(x)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="86" width="650" height="18" as="geometry" /></mxCell><mxCell id="zA" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;dashed=1;dashPattern=4 3;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="90.0" y="110.0" width="112.5" height="72.0" as="geometry" /></mxCell><mxCell id="zAl" value="near 1: few, different -&amp;gt; anomalous" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="206.5" y="112.0" width="220" height="30" as="geometry" /></mxCell><mxCell id="curve" value="s = 2^(-E(h) / c(psi)), psi = 256 [1], c(256) = 10.24 [2]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="112.5" y="347.6" width="230" height="34" as="geometry" /></mxCell><mxCell id="l05" value="s = 0.5: E(h) equals c(psi); if all windows sit here, no distinct anomaly" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="97.5" y="292.0" width="250" height="30" as="geometry" /></mxCell><mxCell id="lhl" value="height limit ceil(log2 256) = 8 [3]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="394.0" y="426.8" width="150" height="30" as="geometry" /></mxCell><mxCell id="p3" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="196.5" y="168.8" width="12" height="12" as="geometry" /></mxCell><mxCell id="p3l" value="3 splits -&amp;gt; s = 0.82 [4]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="212.5" y="170.8" width="210" height="30" as="geometry" /></mxCell><mxCell id="pc" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="468.0" y="284.0" width="12" height="12" as="geometry" /></mxCell><mxCell id="pcl" value="10.24 splits -&amp;gt; s = 0.5 [5]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="480.0" y="256.0" width="200" height="30" as="geometry" /></mxCell><mxCell id="lowl" value="well below 0.5: deep in the crowd -&amp;gt; normal" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#5f9e4f;" vertex="1" parent="1"><mxGeometry x="502.5" y="362.0" width="190" height="30" as="geometry" /></mxCell><mxCell id="sk" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacing=6;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="760" y="100" width="500" height="220" as="geometry" /></mxCell><mxCell id="skt" value="&lt;b&gt;Why short paths mean anomalous&lt;/b&gt; (sketch, two template counts per window): random cuts isolate the odd window (red) in 3 cuts; a window inside the crowd needs many." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="766" y="104" width="488" height="34" as="geometry" /></mxCell><mxCell id="d0" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1001.3" y="261.3" width="8" height="8" as="geometry" /></mxCell><mxCell id="d1" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1002.3" y="243.1" width="8" height="8" as="geometry" /></mxCell><mxCell id="d2" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="978.4" y="245.3" width="8" height="8" as="geometry" /></mxCell><mxCell id="d3" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1047.8" y="259.3" width="8" height="8" as="geometry" /></mxCell><mxCell id="d4" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1045.3" y="255.5" width="8" height="8" as="geometry" /></mxCell><mxCell id="d5" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1023.4" y="254.1" width="8" height="8" as="geometry" /></mxCell><mxCell id="d6" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="953.4" y="268.8" width="8" height="8" as="geometry" /></mxCell><mxCell id="d7" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1027.2" y="261.0" width="8" height="8" as="geometry" /></mxCell><mxCell id="d8" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="952.5" y="211.6" width="8" height="8" as="geometry" /></mxCell><mxCell id="d9" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="979.8" y="239.7" width="8" height="8" as="geometry" /></mxCell><mxCell id="d10" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1020.4" y="249.0" width="8" height="8" as="geometry" /></mxCell><mxCell id="d11" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1027.7" y="235.9" width="8" height="8" as="geometry" /></mxCell><mxCell id="d12" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1020.5" y="258.7" width="8" height="8" as="geometry" /></mxCell><mxCell id="d13" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="987.5" y="287.8" width="8" height="8" as="geometry" /></mxCell><mxCell id="d14" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1028.9" y="276.3" width="8" height="8" as="geometry" /></mxCell><mxCell id="d15" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="988.9" y="233.7" width="8" height="8" as="geometry" /></mxCell><mxCell id="d16" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="998.3" y="247.7" width="8" height="8" as="geometry" /></mxCell><mxCell id="d17" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1031.5" y="255.5" width="8" height="8" as="geometry" /></mxCell><mxCell id="d18" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="994.8" y="228.9" width="8" height="8" as="geometry" /></mxCell><mxCell id="d19" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="992.3" y="276.9" width="8" height="8" as="geometry" /></mxCell><mxCell id="d20" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="982.5" y="255.4" width="8" height="8" as="geometry" /></mxCell><mxCell id="d21" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1024.5" y="217.2" width="8" height="8" as="geometry" /></mxCell><mxCell id="d22" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1011.6" y="278.7" width="8" height="8" as="geometry" /></mxCell><mxCell id="d23" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="941.5" y="242.9" width="8" height="8" as="geometry" /></mxCell><mxCell id="d24" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1006.4" y="232.0" width="8" height="8" as="geometry" /></mxCell><mxCell id="d25" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1026.9" y="248.6" width="8" height="8" as="geometry" /></mxCell><mxCell id="out" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1200" y="170" width="10" height="10" as="geometry" /></mxCell><mxCell id="cut0" value="cut 1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1143" y="296" width="30" height="16" as="geometry" /></mxCell><mxCell id="cut1" value="cut 2" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1226" y="212" width="30" height="16" as="geometry" /></mxCell><mxCell id="cut2" value="cut 3" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1164" y="146" width="30" height="16" as="geometry" /></mxCell><mxCell id="defs" value="&lt;b&gt;Defaults and the threshold&lt;/b&gt; [B3]&lt;br/&gt;- each tree is built on a sub-sample of psi = 256 points per tree; the forest has t = 100 trees [6]&lt;br/&gt;- c(n) = 2H(n-1) - 2(n-1)/n with H(i) = ln(i) + 0.5772156649 [7]&lt;br/&gt;- scikit-learn contamination='auto' uses offset -0.5 [8] on the shifted score; a numeric contamination flags that share of the training data. It is your alarm budget, not a property of the data." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#f7f7f7;strokeColor=#bbbbbb;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="760" y="334" width="500" height="100" as="geometry" /></mxCell><mxCell id="conf" value="&lt;b&gt;Read the score correctly&lt;/b&gt; [B3]: 0.82 means 'easy to isolate', not '82 % likely to be a bug'. Train on windows from devices believed healthy, or the forest learns faults as normal. It flags environmental anomalies too, so a second signal decides [C4]." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="1240" height="32" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt; — blue line = the score formula (exact); red square = the worked anomalous window; amber circle + dashed = the s = 0.5 reference; grey dotted = tree height limit; green dots = normal windows. Curve computed from c(256) loaded from constants.json." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#f7f7f7;strokeColor=#bbbbbb;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="562" width="1240" height="30" as="geometry" /></mxCell><mxCell id="sources" value="&lt;b&gt;Sources&lt;/b&gt; — every number is loaded from ../constants.json. [n] = public (real value, cited); [n*] = illustrative (an invented round number of realistic order of magnitude; never a measurement).&lt;br/&gt;[1] iforest_subsample_size_default = 256 points per tree — public; Liu, Ting, Zhou, 'Isolation Forest', ICDM 2008, §3 (psi = 256); scikit-learn IsolationForest documentation, (max_samples='auto' = min(256, n_samples))&lt;br/&gt;[2] iforest_c_256 = 10.24 splits — public; my arithmetic from c(n) = 2H(n-1) - 2(n-1)/n in Liu, Ting, Zhou, 'Isolation Forest', ICDM 2008, Eq. 1&lt;br/&gt;[3] iforest_height_limit_psi256 = 8 splits — public; ceil(log2 256); Liu, Ting, Zhou, 'Isolation Forest', ICDM 2008, §3; scikit-learn IsolationForest documentation, (max depth ceil(log2 n))&lt;br/&gt;[4] iforest_score_3_splits_psi256 = 0.82 score — public; my arithmetic: 2^(-3/10.24), from Liu, Ting, Zhou, 'Isolation Forest', ICDM 2008, Eq. 2&lt;br/&gt;[5] iforest_score_at_average_path = 0.5 score — public; Liu, Ting, Zhou, 'Isolation Forest', ICDM 2008, §2: E(h(x)) -&amp;gt; c(n) gives s -&amp;gt; 0.5&lt;br/&gt;[6] iforest_trees_default = 100 trees — public; Liu, Ting, Zhou, 'Isolation Forest', ICDM 2008, §3 (t = 100); scikit-learn IsolationForest documentation, (n_estimators=100)&lt;br/&gt;[7] euler_mascheroni = 0.5772156649 dimensionless — public; Liu, Ting, Zhou, 'Isolation Forest', ICDM 2008, §2, approximation H(i) ~ ln(i) + 0.5772156649&lt;br/&gt;[8] sklearn_iforest_offset_auto = -0.5 score offset — public; scikit-learn IsolationForest documentation, (offset_ = -0.5 when contamination='auto')" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#fff8dc;strokeColor=#d6b656;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="602" width="1240" height="134" as="geometry" /></mxCell><mxCell id="l0" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="90.0" y="470.0" as="sourcePoint" /><mxPoint x="690.0" y="470.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l1" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="90.0" y="110.0" as="sourcePoint" /><mxPoint x="90.0" y="470.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l2" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#e6e6e6;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="90.0" y="110.0" as="sourcePoint" /><mxPoint x