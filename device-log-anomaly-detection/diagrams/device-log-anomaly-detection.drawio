<mxfile host="app.diagrams.net"><diagram id="p_01_pipeline_cascade" name="01-pipeline-cascade"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="690" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Metrics choose which logs to read: a four-stage cascade narrows a fleet's logs to a few flagged windows and one ticket per fault, and an engineer still decides" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=20;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1240" height="56" as="geometry" /></mxCell><mxCell id="dev" value="&lt;b&gt;A DEVICE&lt;/b&gt; [A1]&lt;br/&gt;many components write one interleaved stream&lt;br/&gt;about 500 000 lines [1*] per device-day&lt;br/&gt;ring buffer of 4 MB [2*] overwrites old lines: only hours of history&lt;br/&gt;on-device retention 14 days [3*]&lt;br/&gt;sends metrics (all devices) and logs (on demand)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="88" width="240" height="130" as="geometry" /></mxCell><mxCell id="s1" value="&lt;b&gt;1 DETECT a change&lt;/b&gt; [B4, A2]&lt;br/&gt;family level: weighted-least-squares slope test on the daily share of devices&lt;br/&gt;device level: isolation forest on device-day metric vectors&lt;br/&gt;out: which metric, which devices, which days" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="88" width="225" height="130" as="geometry" /></mxCell><mxCell id="s2" value="&lt;b&gt;2 FETCH + PARSE&lt;/b&gt; [B1, B2]&lt;br/&gt;fetch logs only of the devices that drive the change, only for that time range&lt;br/&gt;line -&amp;gt; template ID + parameters (a few hundred templates, e.g. 400 templates [4*])&lt;br/&gt;cut windows, count templates per window" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="545" y="88" width="225" height="130" as="geometry" /></mxCell><mxCell id="s3" value="&lt;b&gt;3 SCORE + EXPLAIN&lt;/b&gt; [B3, B5]&lt;br/&gt;isolation forest on count vectors -&amp;gt; one score per window&lt;br/&gt;per-thread transition edges -&amp;gt; where the sequence left the normal path&lt;br/&gt;reduction: 20 windows [5*] flagged of 50 000 windows [6*]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="790" y="88" width="225" height="130" as="geometry" /></mxCell><mxCell id="s4" value="&lt;b&gt;4 GROUP + REPORT&lt;/b&gt; [B6]&lt;br/&gt;join metric + log anomaly per device-day&lt;br/&gt;hierarchical clustering: one cluster per symptom&lt;br/&gt;rank by devices hit and score; de-duplicate against open tickets; one ticket with the evidence attached" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1035" y="88" width="225" height="130" as="geometry" /></mxCell><mxCell id="up_l" value="logs: uploaded on demand only (after the fault), kept 60 days [7*] [A1]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="300" y="256" width="520" height="20" as="geometry" /></mxCell><mxCell id="ctx" value="pass context to stage 2: which metric fired + when (UTC vs device local time) [B5]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="304" y="220" width="230" height="30" as="geometry" /></mxCell><mxCell id="eng" value="&lt;b&gt;ENGINEER decides&lt;/b&gt; [C4]&lt;br/&gt;anomaly is not issue: confirm with a second signal before a ticket&lt;br/&gt;time per case 90 [8*] -&amp;gt; 15 min [9*]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1035" y="262" width="225" height="90" as="geometry" /></mxCell><mxCell id="fb" value="feedback: root-cause label (device defect / environmental / data artefact) -&amp;gt; ground truth [C1] + drop and direction rules [B4]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#5f9e4f;" vertex="1" parent="1"><mxGeometry x="300" y="334" width="720" height="20" as="geometry" /></mxCell><mxCell id="ond" value="&lt;b&gt;ON-DEVICE alternative&lt;/b&gt; [A0, B3]: a small sequence model (DeepLog-style LSTM, history h = 10 [10], normal if next template in top g = 9 [11]) reads every line before the ring buffer overwrites it, works offline, and raw logs never leave the device. Cost: it must fit the device's memory and power budget." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;dashed=1;dashPattern=6 4;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="372" width="600" height="74" as="geometry" /></mxCell><mxCell id="fls" value="&lt;b&gt;FLEET-SIDE (this cascade)&lt;/b&gt; [A0, B5]: ample compute, compares many devices, cheap and explainable forest. Sees only uploaded logs and kept time ranges; misses faults that never show in metrics. Started first: lower risk, a working result sooner, a path to a parallel (logs always analysed) form later." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="640" y="372" width="620" height="74" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt; — purple = the device and on-device work; blue = fleet-side cloud stages; amber = the human decision; green dashed = the feedback loop. Solid arrow = data flow; dashed purple = logs, which arrive only on demand. [A0] etc. = the kit note that explains the box." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#f7f7f7;strokeColor=#bbbbbb;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="458" width="1240" height="36" as="geometry" /></mxCell><mxCell id="sources" value="&lt;b&gt;Sources&lt;/b&gt; — every number is loaded from ../constants.json. [n] = public (real value, cited); [n*] = illustrative (an invented round number of realistic order of magnitude; never a measurement).&lt;br/&gt;[1*] lines_per_device_day = 500 000 lines — illustrative; (order of magnitude endorsed by the kit brief)&lt;br/&gt;[2*] ring_buffer_size = 4 MB (a few megabytes) — illustrative&lt;br/&gt;[3*] on_device_retention = 14 days — illustrative&lt;br/&gt;[4*] templates_per_component_set = 400 templates — illustrative; ('a few hundred')&lt;br/&gt;[5*] flagged_windows = 20 windows — illustrative&lt;br/&gt;[6*] windows_scanned = 50 000 windows — illustrative&lt;br/&gt;[7*] uploaded_log_retention = 60 days — illustrative&lt;br/&gt;[8*] time_per_case_before = 90 min — illustrative&lt;br/&gt;[9*] time_per_case_after = 15 min — illustrative&lt;br/&gt;[10] deeplog_history_h = 10 log keys — public; Du, Li, Zheng, Srikumar, 'DeepLog', CCS 2017, §5.1.3 defaults&lt;br/&gt;[11] deeplog_top_g = 9 candidates — public; Du, Li, Zheng, Srikumar, 'DeepLog', CCS 2017, §5.1.3 defaults" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#fff8dc;strokeColor=#d6b656;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="506" width="1240" height="170" as="geometry" /></mxCell><mxCell id="e0" value="" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="endArrow=classic;html=1;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="s4" target="eng"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l0" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260.0" y="130.0" as="sourcePoint" /><mxPoint x="300.0" y="130.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l1" value="" style="endArrow=classic;startArrow=none;html=1;dashed=1;dashPattern=6 4;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140.0" y="218.0" as="sourcePoint" /><mxPoint x="657.0" y="218.0" as="targetPoint" /><Array as="points"><mxPoint x="140.0" y="252.0" /><mxPoint x="657.0" y="252.0" /></Array></mxGeometry></mxCell><mxCell id="l2" value="" style="endArrow=classic;startArrow=none;html=1;dashed=1;dashPattern=6 4;strokeColor=#5f9e4f;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1035.0" y="330.0" as="sourcePoint" /><mxPoint x="300.0" y="180.0" as="targetPoint" /><Array as="points"><mxPoint x="282.0" y="330.0" /><mxPoint x="282.0" y="180.0" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p_02_line_to_count_vector" name="02-line-to-count-vector"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="844" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Parsing and windowing turn free text into a count matrix: every column is a template an engineer can read, and the order of events inside a window is lost" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=20;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1240" height="56" as="geometry" /></mxCell><mxCell id="ha" value="&lt;b&gt;A. Parse one line&lt;/b&gt; [A1, B1]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=12;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="600" height="18" as="geometry" /></mxCell><mxCell id="raw" value="&lt;b&gt;raw line&lt;/b&gt; (logcat threadtime layout)&lt;br/&gt;date time pid tid level tag: message&lt;br/&gt;... 812 845 I wpa_supplicant: CTRL-EVENT-DISCONNECTED bssid=aa:bb:cc:dd:ee:ff reason=3 locally_generated=1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#eeeeee;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="102" width="400" height="70" as="geometry" /></mxCell><mxCell id="tpl" value="&lt;b&gt;template&lt;/b&gt; = constant words, parameters replaced by &amp;lt;*&amp;gt;&lt;br/&gt;CTRL-EVENT-DISCONNECTED bssid=&amp;lt;*&amp;gt; reason=&amp;lt;*&amp;gt; locally_generated=&amp;lt;*&amp;gt;&lt;br/&gt;-&amp;gt; one stable template ID (a vocabulary of a few hundred, e.g. 400 templates [1*])" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="460" y="102" width="400" height="70" as="geometry" /></mxCell><mxCell id="par" value="&lt;b&gt;parameters&lt;/b&gt; = the run-time values, kept&lt;br/&gt;[aa:bb:cc:dd:ee:ff, 3, 1]&lt;br/&gt;reason 3 [2] = deauthenticated because leaving (IEEE 802.11); parameters often name the cause [B5]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="900" y="102" width="360" height="70" as="geometry" /></mxCell><mxCell id="hb" value="&lt;b&gt;B. Match it fast: a parse-tree matcher over a fixed template set&lt;/b&gt; [B1]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=12;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="186" width="800" height="18" as="geometry" /></mxCell><mxCell id="t1" value="layer 1&lt;br/&gt;component (tag)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="210" width="130" height="62" as="geometry" /></mxCell><mxCell id="t2" value="layer 2&lt;br/&gt;token count" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="175" y="210" width="130" height="62" as="geometry" /></mxCell><mxCell id="t3" value="one layer per token&lt;br/&gt;partial-token wildcards keep event=&amp;lt;*&amp;gt; and error=&amp;lt;*&amp;gt; apart" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="330" y="210" width="245" height="62" as="geometry" /></mxCell><mxCell id="t4" value="leaf&lt;br/&gt;template ID" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="600" y="210" width="120" height="62" as="geometry" /></mxCell><mxCell id="unm" value="no template matches -&amp;gt; &lt;b&gt;unmatched bucket&lt;/b&gt;: engineers review, add templates, rebuild the tree [C2]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;dashed=1;dashPattern=6 4;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="175" y="290" width="545" height="40" as="geometry" /></mxCell><mxCell id="srcp" value="&lt;b&gt;Where templates come from&lt;/b&gt; [B1]&lt;br/&gt;- mining (Drain, Spell) finds only what is in the sample. Example: a component with 100 print statements [3*], about 50 % [4*] on error or warning paths; a miner on normal logs finds 20 templates [5*]. The missing ones are the error paths detection needs.&lt;br/&gt;- source-code extraction: complete, but needs source access and upkeep.&lt;br/&gt;- Drain speed: 51.85–81.47 % [6] faster than the best online parser of its time, on 5 data sets [7] with more than 10 000 000 log messages [8]." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#f7f7f7;strokeColor=#bbbbbb;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="740" y="210" width="520" height="120" as="geometry" /></mxCell><mxCell id="hc" value="&lt;b&gt;C. Cut the parsed stream into windows&lt;/b&gt; [B2]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=12;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="352" width="700" height="18" as="geometry" /></mxCell><mxCell id="tk0" value="0 h" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="100.0" y="508" width="40" height="14" as="geometry" /></mxCell><mxCell id="tk6" value="6 h" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="232.0" y="508" width="40" height="14" as="geometry" /></mxCell><mxCell id="tk12" value="12 h" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="364.0" y="508" width="40" height="14" as="geometry" /></mxCell><mxCell id="tk18" value="18 h" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="496.0" y="508" width="40" height="14" as="geometry" /></mxCell><mxCell id="tk24" value="24 h" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="628.0" y="508" width="40" height="14" as="geometry" /></mxCell><mxCell id="lf" value="fixed" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="380" width="96" height="16" as="geometry" /></mxCell><mxCell id="fx0" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="120.0" y="380" width="22.0" height="16" as="geometry" /></mxCell><mxCell id="fx1" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="142.0" y="380" width="22.0" height="16" as="geometry" /></mxCell><mxCell id="fx2" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="164.0" y="380" width="22.0" height="16" as="geometry" /></mxCell><mxCell id="fx3" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="186.0" y="380" width="22.0" height="16" as="geometry" /></mxCell><mxCell id="fx4" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#dae8fc;s