etry"><mxPoint x="390.0" y="110.0" as="sourcePoint" /><mxPoint x="390.0" y="470.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l35" value="" style="endArrow=none;startArrow=none;html=1;dashed=1;dashPattern=2 3;strokeColor=#d79b00;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="474.0" y="290.0" as="sourcePoint" /><mxPoint x="474.0" y="470.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l36" value="" style="endArrow=none;startArrow=none;html=1;dashed=1;dashPattern=5 3;strokeColor=#d79b00;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140.0" y="142.0" as="sourcePoint" /><mxPoint x="1140.0" y="320.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l37" value="" style="endArrow=none;startArrow=none;html=1;dashed=1;dashPattern=5 3;strokeColor=#d79b00;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1140.0" y="210.0" as="sourcePoint" /><mxPoint x="1260.0" y="210.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l38" value="" style="endArrow=none;startArrow=none;html=1;dashed=1;dashPattern=5 3;strokeColor=#d79b00;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1180.0" y="142.0" as="sourcePoint" /><mxPoint x="1180.0" y="210.0" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p_04_fleet_trend_test" name="04-fleet-trend-test"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="924" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="The same 3 % jump can be noise in 100 devices but is a fleet change in 10 000: the share's standard error shrinks with sqrt(n), so the trend test weights each day by n (illustrative counts)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=20;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1240" height="56" as="geometry" /></mxCell><mxCell id="cp" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacing=6;fillColor=none;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="550" height="400" as="geometry" /></mxCell><mxCell id="cpt" value="&lt;b&gt;Share of devices that emitted a rare disconnect reason, one day&lt;/b&gt; [A2]&lt;br/&gt;dot = share; bar = +/- 1 standard error, SE = sqrt(p(1-p)/n)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="28" y="84" width="534" height="34" as="geometry" /></mxCell><mxCell id="ayt0" value="0" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="352.0" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt1" value="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="317.0" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt2" value="2" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="282.0" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt3" value="3" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="247.0" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt4" value="4" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="212.0" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt5" value="5" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="177.0" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt6" value="6" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="142.0" width="44" height="16" as="geometry" /></mxCell><mxCell id="axl" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=11;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="110" y="382" width="420" height="18" as="geometry" /></mxCell><mxCell id="ayl" value="share of devices (%)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="126" width="470" height="18" as="geometry" /></mxCell><mxCell id="dt0" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="208.0" y="248.0" width="14" height="14" as="geometry" /></mxCell><mxCell id="bl0" value="small family&lt;br/&gt;100 [1*] active,&lt;br/&gt;3 [2*] emit it&lt;br/&gt;SE = 1.7 pp [3*]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="120.0" y="366.0" width="190" height="66" as="geometry" /></mxCell><mxCell id="dt1" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="418.0" y="248.0" width="14" height="14" as="geometry" /></mxCell><mxCell id="bl1" value="large family&lt;br/&gt;10 000 [4*] active&lt;br/&gt;same share&lt;br/&gt;SE = 0.17 pp [5*]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#5f9e4f;" vertex="1" parent="1"><mxGeometry x="330.0" y="366.0" width="190" height="66" as="geometry" /></mxCell><mxCell id="cpn" value="Halve n and SE grows by sqrt 2. Three unlucky households can make the small-family jump; the large-family bar is ten times tighter (sqrt of 100x the devices). Share 3 % = 3 / 100, my arithmetic." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="28" y="438" width="534" height="40" as="geometry" /></mxCell><mxCell id="st0" value="&lt;b&gt;1 one series per slice&lt;/b&gt; [B4]: daily share p_t and active count n_t per (family, feature, category) over 8 weeks [6*] (56 daily points)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="590" y="80" width="670" height="56" as="geometry" /></mxCell><mxCell id="st1" value="&lt;b&gt;2 not ordinary least squares&lt;/b&gt; [B4]: Var(p_t) = p(1-p)/n_t changes day to day (weekends, outages, new cohorts): heteroscedastic; OLS gives a noisy day the same say and a wrong slope SE" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="590" y="146" width="670" height="56" as="geometry" /></mxCell><mxCell id="st2" value="&lt;b&gt;3 weighted least squares&lt;/b&gt; [B4]: weight w_t = n_t / (p_t(1-p_t)); minimise sum w_t (p_t - a - b t)^2. Use a pooled p when p_t is 0 or 1 (infinite weight)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="590" y="212" width="670" height="56" as="geometry" /></mxCell><mxCell id="st3" value="&lt;b&gt;4 test against a practical slope s&lt;/b&gt; [B4]: H0: b = s (not b = 0: with enough devices every slope is significant). One-sided p = 1 - Phi((b_hat - s) / se(b_hat))" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="590" y="278" width="670" height="56" as="geometry" /></mxCell><mxCell id="st4" value="&lt;b&gt;5 p-value -&amp;gt; score&lt;/b&gt; [B4]: score = -10 [7] log10(p), capped at 100 [8*]; see the ladder below" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="590" y="344" width="670" height="56" as="geometry" /></mxCell><mxCell id="st5" value="&lt;b&gt;6 filter direction, control false discoveries&lt;/b&gt; [B4]: drop good-direction changes; 10 000 series/day [9*] tested at p 0.01 give about 100 series/day [10*] by chance -&amp;gt; FDR control or rank and read the top" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="590" y="410" width="670" height="56" as="geometry" /></mxCell><mxCell id="lh" value="&lt;b&gt;p -&amp;gt; score ladder&lt;/b&gt; (each 10 points = 10x smaller p) [B4]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=12;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="600" height="18" as="geometry" /></mxCell><mxCell id="sc0" value="p = 0.1&lt;br/&gt;score 10 [11]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="589.0" width="120" height="41.0" as="geometry" /></mxCell><mxCell id="sc1" value="p = 0.01&lt;br/&gt;score 20 [11]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="160" y="582.0" width="120" height="48.0" as="geometry" /></mxCell><mxCell id="sc2" value="p = 1e-5&lt;br/&gt;score 50 [11]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="561.0" width="120" height="69.0" as="geometry" /></mxCell><mxCell id="sc3" value="p = 1e-10 (cap)&lt;br/&gt;score 100 [11]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="440" y="526.0" width="120" height="104.0" as="geometry" /></mxCell><mxCell id="fam" value="&lt;b&gt;Family level&lt;/b&gt; [B4]: WLS slope test on the share. Catches fleet-wide regressions (a release that raises disconnects). Few reports (e.g. 1 [12*] per week), each high impact." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="590" y="530" width="330" height="100" as="geometry" /></mxCell><mxCell id="devl" value="&lt;b&gt;Device level&lt;/b&gt; [B3, B4]: isolation forest on device-day vectors. Catches one device or household behaving oddly. Many reports, each lower impact and often environmental." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="930" y="530" width="330" height="100" as="geometry" /></mxCell><mxCell id="conf" value="&lt;b&gt;Read it correctly&lt;/b&gt; [B4]: the score is a confidence that the slope exceeds s, not a severity; a significant trend can be a router-firmware rollout, a holiday or a reporting change. Correlated daily residuals make se(b) too small: check with a weekly dummy." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="646" width="1240" height="32" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt; — red = small population (noisy); green = large population (precise); blue = estimation steps; amber = the decision steps (threshold, score); purple = device-level detection. pp = percentage points." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#f7f7f7;strokeColor=#bbbbbb;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="688" width="1240" height="30" as="geometry" /></mxCell><mxCell id="sources" value="&lt;b&gt;Sources&lt;/b&gt; — every number is loaded from ../constants.json. [n] = public (real value, cited); [n*] = illustrative (an invented round number of realistic order of magnitude; never a measurement).&lt;br/&gt;[1*] small_family_devices = 100 active devices — illustrative&lt;br/&gt;[2*] rare_reason_devices = 3 devices — illustrative&lt;br/&gt;[3*] rare_share_small_family_se = 1.7 percentage points — illustrative; my arithmetic: sqrt(0.03*0.97/100), from illustrative inputs&lt;br/&gt;[4*] large_family_devices = 10 000 active devices — illustrative&lt;br/&gt;[5*] rare_share_large_family_se = 0.17 percentage points — illustrative; my arithmetic: sqrt(0.03*0.97/10000), from illustrative inputs&lt;br/&gt;[6*] trend_series_length = weeks 8, daily_points 56 weeks / days — illustrative&lt;br/&gt;[7] phred_factor = 10 score points per decade of p — public; Ewing &amp;amp; Green, Genome Research 8:186-194, 1998: Q = -10 log10 P&lt;br/&gt;[8*] score_cap = 100 score — illustrative; cap (p = 1e-10)&lt;br/&gt;[9*] monitored_series = 10 000 series per day — illustrative&lt;br/&gt;[10*] multiple_testing_false_alarms = 100 series per day — illustrative; my arithmetic: 10 000 x 0.01, illustrative inputs&lt;br/&gt;[11] score_examples = p_0.1 10, p_0.01 20, p_1e-5 50, p_1e-10 100 score — public; my arithmetic from score = -10 log10(p)&lt;br/&gt;[12*] family_reports_per_week = 1 reports — illustrative" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#fff8dc;strokeColor=#d6b656;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="728" width="1240" height="182" as="geometry" /></mxCell><mxCell id="e0" value="" style="endArrow=classic;html=1;fontSize=10;exitX=0.04;exitY=1;exitDx=0;exitDy=0;entryX=0.04;entryY=0;entryDx=0;entryDy=0;strokeColor=#6c8ebf;strokeWidth=1.5;" edge="1" parent="1" source="st0" target="st1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="endArrow=classic;html=1;fontSize=10;exitX=0.04;exitY=1;exitDx=0;exitDy=0;entryX=0.04;entryY=0;entryDx=0;entryDy=0;strokeColor=#6c8ebf;strokeWidth=1.5;" edge="1" parent="1" source="st1" target="st2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="endArrow=classic;html=1;fontSize=10;exitX=0.04;exitY=1;exitDx=0;exitDy=0;entryX=0.04;entryY=0;entryDx=0;entryDy=0;strokeColor=#6c8ebf;strokeWidth=1.5;" edge="1" parent="1" source="st2" target="st3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="endArrow=classic;html=1;fontSize=10;exitX=0.04;exitY=1;exitDx=0;exitDy=0;entryX=0.04;entryY=0;entryDx=0;entryDy=0;strokeColor=#6c8ebf;strokeWidth=1.5;" edge="1" parent="1" source="st3" target="st4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="endArrow=classic;html=1;fontSize=10;exitX=0.04;exitY=1;exitDx=0;exitDy=0;entryX=0.04;entryY=0;entryDx=0;entryDy=0;strokeColor=#6c8ebf;strokeWidth=1.5;" edge="1" parent="1" source="st4" target="st5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l0" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110.0" y="360.0" as="sourcePoint" /><mxPoint x="530.0" y="360.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l1" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110.0" y="150.0" as="sourcePoint" /><mxPoint x="110.0" y="360.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l2" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#e6e6e6;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110.0" y="360.0" as="sourcePoint" /><mxPoint x="530.0" y="360.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l3" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="105.0" y="360.0" as="sourcePoint" /><mxPoint x="110.0" y="360.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l4" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#e6e6e6;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110.0" y="325.0" as="sourcePoint" /><mxPoint x="530.0" y="325.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l5" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="105.0" y="325.0" as="sourcePoint" /><mxPoint x="110.0" y="325.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l6" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#e6e6e6;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110.0" y="290.0" as="sourcePoint" /><mxPoint x="530.0" y="290.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l7" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="105.0" y="290.0" as="sourcePoint" /><mxPoint x="110.0" y="290.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l8" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#e6e6e6;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110.0" y="255.0" as="sourcePoint" /><mxPoint x="530.0" y="255.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l9" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="105.0" y="255.0" as="sourcePoint" /><mxPoint x="110.0" y="255.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l10" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#e6e6e6;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110.0" y="220.0" as="sourcePoint" /><mxPoint x="530.0" y="220.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l11" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="105.0" y="220.0" as="sourcePoint" /><mxPoint x="110.0" y="220.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l12" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#e6e6e6;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110.0" y="185.0" as="sourcePoint" /><mxPoint x="530.0" y="185.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l13" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="105.0" y="185.0" as="sourcePoint" /><mxPoint x="110.0" y="185.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l14" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#e6e6e6;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110.0" y="150.0" as="sourcePoint" /><mxPoint x="530.0" y="150.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l15" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="105.0" y="150.0" as="sourcePoint" /><mxPoint x="110.0" y="150.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l16" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#b85450;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="215.0" y="314.5" as="sourcePoint" /><mxPoint x="215.0" y="195.5" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l17" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#b85450;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="205.0" y="314.5" as="sourcePoint" /><mxPoint x="225.0" y="314.5" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l18" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#b85450;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="205.0" y="195.5" as="sourcePoint" /><mxPoint x="225.0" y="195.5" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l19" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#5f9e4f;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="425.0" y="260.9" as="sourcePoint" /><mxPoint x="425.0" y="249.1" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l20" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#5f9e4f;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="415.0" y="260.9" as="sourcePoint" /><mxPoint x="435.0" y="260.9" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l21" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#5f9e4f;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="415.0" y="249.1" as="sourcePoint" /><mxPoint x="435.0" y="249.1" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p_05_anomaly_to_root_cause" name="05-anomaly-to-root-cause"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="605" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Root cause starts where the sequence leaves the normal path: partition the log by thread, count transitions, and compare them with the golden sequence mined from many devices" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=20;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1240" height="56" as="geometry" /></mxCell><mxCell id="ha" value="&lt;b&gt;A. One interleaved stream, two threads&lt;/b&gt; [A1, B5] (toy lines)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=12;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="78" width="600" height="18" as="geometry" /></mxCell><mxCell id="r0" value="10:00:01.100   tid 845   scan start" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="300" height="22" as="geometry" /></mxCell><mxCell id="r1" value="10:00:01.100   tid 901   dhcp renew" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="124" width="300" height="22" as="geometry" /></mxCell><mxCell id="r2" value="10:00:01.230   tid 845   assoc start" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="148" width="300" height="22" as="geometry" /></mxCell><mxCell id="r3" value="10:00:01.231   tid 901   dhcp ack" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="172" width="300" height="22" as="geometry" /></mxCell><mxCell id="r4" value="10:00:01.480   tid 845   auth ok" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="196" width="300" height="22" as="geometry" /></mxCell><mxCell id="r5" value="10:00:01.480   tid 845   connected" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="220" width="300" height="22" as="geometry" /></mxCell><mxCell id="r6" value="10:00:05.010   tid 845   disconnected reason=15" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="244" width="300" height="22" as="geometry" /></mxCell><mxCell id="r7" value="10:00:05.020   tid 845   network bounce" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="268" width="300" height="22" as="geometry" /></mxCell><mxCell id="tie" value="same timestamp on two lines (ms resolution): true order unknown" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="296" width="300" height="32" as="geometry" /></mxCell><mxCell id="p1" value="&lt;b&gt;thread 845, sorted by time&lt;/b&gt;&lt;br/&gt;scan start -&amp;gt; assoc start -&amp;gt; auth ok -&amp;gt; connected -&amp;gt; disconnected -&amp;gt; network bounce" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="360" y="100" width="260" height="60" as="geometry" /></mxCell><mxCell id="p2" value="&lt;b&gt;thread 901&lt;/b&gt;&lt;br/&gt;dhcp renew -&amp;gt; dhcp ack" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="360" y="180" width="260" height="44" as="geometry" /></mxCell><mxCell id="bad" value="&lt;b&gt;trap: sort the whole log by time&lt;/b&gt;&lt;br/&gt;scan start -&amp;gt; dhcp renew -&amp;gt; assoc start -&amp;gt; dhcp ack ... gives edges that never happen in the code. Partition by pid/tid first." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;dashed=1;dashPattern=6 4;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="360" y="232" width="260" height="76" as="geometry" /></mxCell><mxCell id="mat" value="&lt;b&gt;Transition count matrix A (N x N templates)&lt;/b&gt; [B5]: for each consecutive pair (i, j) inside one thread, A[i][j] += 1. Skip the edge into a task-start template so one task's end is not linked to the next. Drop impossible timestamps (cache replayed after a reboot). Ties average out over many windows." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="336" width="600" height="60" as="geometry" /></mxCell><mxCell id="hb" value="&lt;b&gt;B. Workflow (empirical control-flow graph) from many healthy devices&lt;/b&gt; [B5]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=12;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="650" y="78" width="610" height="18" as="geometry" /></mxCell><mxCell id="g0" value="scanning" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fontStyle=1;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="650" y="104" width="140" height="40" as="geometry" /></mxCell><mxCell id="g1" value="associating" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fontStyle=1;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="805" y="104" width="140" height="40" as="geometry" /></mxCell><mxCell id="g2" value="authenticating" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fontStyle=1;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="960" y="104" width="140" height="40" as="geometry" /></mxCell><mxCell id="g3" value="connected" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fontStyle=1;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1115" y="104" width="140" height="40" as="geometry" /></mxCell><mxCell id="gold" value="golden sequence (green): the normal order for the task, shown next to the anomalous one" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#5f9e4f;" vertex="1" parent="1"><mxGeometry x="650" y="148" width="610" height="18" as="geometry" /></mxCell><mxCell id="ghost" value="association complete&lt;br/&gt;(expected child)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;dashed=1;dashPattern=6 4;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="805" y="196" width="160" height="44" as="geometry" /></mxCell><mxCell id="seqa" value="&lt;b&gt;sequence anomaly&lt;/b&gt;: an expected child does not appear within its usual lag after its parent (missing in thread 845)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="650" y="246" width="300" height="48" as="geometry" /></mxCell><mxCell id="disc" value="disconnected" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1115" y="210" width="140" height="40" as="geometry" /></mxCell><mxCell id="par" value="parameter: reason 15 = 4-way handshake timeout [1]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="945" y="160" width="166" height="40" as="geometry" /></mxCell><mxCell id="rec" value="reconnect success" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fontStyle=1;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1115" y="320" width="140" height="40" as="geometry" /></mxCell><mxCell id="bnc" value="network bounce" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fontStyle=1;dashed=1;dashPattern=6 4;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="960" y="320" width="140" height="40" as="geometry" /></mxCell><mxCell id="dista" value="&lt;b&gt;distribution anomaly&lt;/b&gt;: the probability of an edge changes. After 'disconnected' the share to 'reconnect success' (thick) falls, the share to 'network bounce' rises." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="650" y="300" width="300" height="60" as="geometry" /></mxCell><mxCell id="obs" value="The graph is the OBSERVED graph, not the code's: paths the code allows but healthy devices never take are absent, so their appearance is itself a signal. Normal transition statistics need many devices over long periods." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="650" y="368" width="610" height="46" as="geometry" /></mxCell><mxCell id="ctx" value="&lt;b&gt;1 Narrow the search (cascade)&lt;/b&gt; [B5]: the metric says which devices, roughly when, and what (e.g. disconnects with reason 15). Traps: metrics aggregated hourly or daily; device logs in local time, metrics in UTC." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="400" height="72" as="geometry" /></mxCell><mxCell id="tools" value="&lt;b&gt;2 Show the departure&lt;/b&gt; [B5]: golden sequence beside the anomalous one; state-machine search (ordered events + max time span -&amp;gt; every match with raw lines); a chosen parameter over time; replay through the print statements if templates map to code." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="440" y="420" width="400" height="72" as="geometry" /></mxCell><mxCell id="hum" value="&lt;b&gt;3 Hypothesis, not verdict&lt;/b&gt; [B5, C4]: the anomalous template is often a symptom downstream of the cause in another component (DHCP, time sync, a kernel driver). Output = top windows, top templates, the departing edge, the raw lines." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="860" y="420" width="400" height="72" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt; — blue / purple = lines of two threads; green = normal workflow and golden sequence (edge thickness = share of transitions); red dashed = anomaly (missing child, shifted edge, wrong sort); amber = the triggering event and the human step. Toy lines, no data." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#f7f7f7;strokeColor=#bbbbbb;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="504" width="1240" height="30" as="geometry" /></mxCell><mxCell id="sources" value="&lt;b&gt;Sources&lt;/b&gt; — every number is loaded from ../constants.json. [n] = public (real value, cited); [n*] = illustrative (an invented round number of realistic order of magnitude; never a measurement). Workflow idea: Du et al., DeepLog, CCS 2017, §4.4.&lt;br/&gt;[1] ieee80211_reason_4way_handshake_timeout = 15 reason code — public; IEEE Std 802.11 reason-code table; wpa_supplicant ieee802_11_defs.h (WLAN_REASON_4WAY_HANDSHAKE_TIMEOUT)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#fff8dc;strokeColor=#d6b656;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="544" width="1240" height="47" as="geometry" /></mxCell><mxCell id="e0" value="" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#5f9e4f;strokeWidth=2.5;" edge="1" parent="1" source="g0" target="g1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#5f9e4f;strokeWidth=2.5;" edge="1" parent="1" source="g1" target="g2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#5f9e4f;strokeWidth=2.5;" edge="1" parent="1" source="g2" target="g3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="endArrow=classic;html=1;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="g3" target="disc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="endArrow=classic;html=1;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#5f9e4f;strokeWidth=4;" edge="1" parent="1" source="disc" target="rec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="endArrow=classic;html=1;fontSize=10;dashed=1;dashPattern=6 4;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;strokeColor=#b85450;strokeWidth=1.5;" edge="1" parent="1" source="disc" target="bnc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="ctx" target="tools"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="tools" target="hum"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l0" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="320.0" y="136.0" as="sourcePoint" /><mxPoint x="360.0" y="136.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l1" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="320.0" y="200.0" as="sourcePoint" /><mxPoint x="360.0" y="200.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l2" value="" style="endArrow=classic;startArrow=none;html=1;dashed=1;dashPattern=5 3;strokeColor=#b85450;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="875.0" y="168.0" as="sourcePoint" /><mxPoint x="875.0" y="196.0" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p_06_evaluating_without_labels" name="06-evaluating-without-labels"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="686" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Catching 6 of 10 known faults says 'the method works', not 'it is better': the 95 % interval is 31–83 %, and it must be reported next to 4 of 10 pilot flags that were environmental (illustrative counts)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=20;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1240" height="56" as="geometry" /></mxCell><mxCell id="ha" value="&lt;b&gt;A. Building ground truth by hand&lt;/b&gt; [C1]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=12;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="390" height="18" as="geometry" /></mxCell><mxCell id="f0" value="&lt;b&gt;60 cases [1*]&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#eeeeee;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20.0" y="104" width="380.0" height="30" as="geometry" /></mxCell><mxCell id="fl0" value="candidate cases (lab faults + resolved user reports)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="20" y="136" width="380" height="30" as="geometry" /></mxCell><mxCell id="f1" value="&lt;b&gt;10 cases [2*]&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="128.33333333333331" y="170" width="163.33333333333334" height="30" as="geometry" /></mxCell><mxCell id="fl1" value="usable: production-format log, right time range, identified bug, closed ticket" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="20" y="202" width="380" height="30" as="geometry" /></mxCell><mxCell id="f2" value="&lt;b&gt;6 cases [3*]&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="137.0" y="236" width="146.0" height="30" as="geometry" /></mxCell><mxCell id="fl2" value="detected by the pipeline (backward validation)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="20" y="268" width="380" height="30" as="geometry" /></mxCell><mxCell id="hb" value="&lt;b&gt;B. Detection rate with its 95 % interval&lt;/b&gt; [C1]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=12;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="440" y="80" width="410" height="18" as="geometry" /></mxCell><mxCell id="bxt0" value="0" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="530.0" y="276" width="60" height="15" as="geometry" /></mxCell><mxCell id="bxt1" value="20" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="586.0" y="276" width="60" height="15" as="geometry" /></mxCell><mxCell id="bxt2" value="40" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="642.0" y="276" width="60" height="15" as="geometry" /></mxCell><mxCell id="bxt3" value="60" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="698.0" y="276" width="60" height="15" as="geometry" /></mxCell><mxCell id="bxt4" value="80" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="754.0" y="276" width="60" height="15" as="geometry" /></mxCell><mxCell id="bxt5" value="100" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="810.0" y="276" width="60" height="15" as="geometry" /></mxCell><mxCell id="bxl" value="detection rate (%)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=11;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="560" y="292" width="280" height="18" as="geometry" /></mxCell><mxCell id="byl" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="510" y="96" width="330" height="18" as="geometry" /></mxCell><mxCell id="pt0" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#ffffff;strokeColor=#5f9e4f;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="722.0" y="139.0" width="12" height="12" as="geometry" /></mxCell><mxCell id="rl0" value="Wilson, 6/10" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#5f9e4f;" vertex="1" parent="1"><mxGeometry x="440" y="136.0" width="116" height="18" as="geometry" /></mxCell><mxCell id="rv0" value="31–83 % [4*]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#5f9e4f;" vertex="1" parent="1"><mxGeometry x="636.8" y="119.0" width="200" height="16" as="geometry" /></mxCell><mxCell id="pt1" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#ffffff;strokeColor=#888888;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="722.0" y="189.0" width="12" height="12" as="geometry" /></mxCell><mxCell id="rl1" value="Wald, 6/10" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="440" y="186.0" width="116" height="18" as="geometry" /></mxCell><mxCell id="rv1" value="30–90 % [5*]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="634.0" y="169.0" width="200" height="16" as="geometry" /></mxCell><mxCell id="pt2" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="722.0" y="239.0" width="12" height="12" as="geometry" /></mxCell><mxCell id="rl2" value="Wilson, 60/100" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="440" y="236.0" width="116" height="18" as="geometry" /></mxCell><mxCell id="rv2" value="50–69 % [6*]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="690.0" y="219.0" width="200" height="16" as="geometry" /></mxCell><mxCell id="bn" value="point = 60 % (my arithmetic). Ten cases give about +/- 25 pp; 100 cases at the same rate narrow it. The Wald interval is too wide at the top and misbehaves near 0 and 1. Ten cases cannot rank this method against one that scored 50 %." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="440" y="320" width="410" height="70" as="geometry" /></mxCell><mxCell id="hc" value="&lt;b&gt;C. Detection rate needs its false-alarm rate&lt;/b&gt; [C1]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=12;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="880" y="80" width="380" height="18" as="geometry" /></mxCell><mxCell id="ch1" value="fault present" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="990" y="104" width="130" height="18" as="geometry" /></mxCell><mxCell id="ch2" value="no fault" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1120" y="104" width="130" height="18" as="geometry" /></mxCell><mxCell id="rh1" value="flagged" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="880" y="138" width="106" height="18" as="geometry" /></mxCell><mxCell id="rh2" value="not flagged" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="880" y="182" width="106" height="18" as="geometry" /></mxCell><mxCell id="cm00" value="TP" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fontStyle=1;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="990" y="126" width="130" height="44" as="geometry" /></mxCell><mxCell id="cm01" value="FP&lt;br/&gt;false alarm" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1120" y="126" width="130" height="44" as="geometry" /></mxCell><mxCell id="cm10" value="FN&lt;br/&gt;miss" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="990" y="170" width="130" height="44" as="geometry" /></mxCell><mxCell id="cm11" value="TN" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fontStyle=1;fillColor=#eeeeee;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1120" y="170" width="130" height="44" as="geometry" /></mxCell><mxCell id="cmf" value="detection rate (recall) = TP / (TP + FN); precision = TP / (TP + FP); false-alarm share of flags = 1 - precision. Flag everything and recall is 100 %." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="880" y="220" width="380" height="48" as="geometry" /></mxCell><mxCell id="pil" value="forward pilot: 10 tickets [7*], of which 4 [8*] environmental" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="880" y="286" width="380" height="18" as="geometry" /></mxCell><mxCell id="tk0" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="880" y="308" width="30" height="30" as="geometry" /></mxCell><mxCell id="tk1" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="916" y="308" width="30" height="30" as="geometry" /></mxCell><mxCell id="tk2" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="952" y="308" width="30" height="30" as="geometry" /></mxCell><mxCell id="tk3" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="988" y="308" width="30" height="30" as="geometry" /></mxCell><mxCell id="tk4" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1024" y="308" width="30" height="30" as="geometry" /></mxCell><mxCell id="tk5" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1060" y="308" width="30" height="30" as="geometry" /></mxCell><mxCell id="tk6" value="env" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;dashed=1;dashPattern=4 3;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1096" y="308" width="30" height="30" as="geometry" /></mxCell><mxCell id="tk7" value="env" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;dashed=1;dashPattern=4 3;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1132" y="308" width="30" height="30" as="geometry" /></mxCell><mxCell id="tk8" value="env" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;dashed=1;dashPattern=4 3;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1168" y="308" width="30" height="30" as="geometry" /></mxCell><mxCell id="tk9" value="env" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;dashed=1;dashPattern=4 3;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1204" y="308" width="30" height="30" as="geometry" /></mxCell><mxCell id="pil2" value="environmental = the customer's access point or internet, not the device [C4]. Confirm with a second signal before a ticket." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="880" y="342" width="380" height="46" as="geometry" /></mxCell><mxCell id="bw" value="&lt;b&gt;Backward validation&lt;/b&gt; [C1]: start from a known fault, find the snippet, check the detector flags the same device and window. Record: what, when, caught?, if not why and is it fixable. Necessary, not sufficient." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="400" width="400" height="86" as="geometry" /></mxCell><mxCell id="fw" value="&lt;b&gt;Forward pilot&lt;/b&gt; [C1]: a few cases a week to domain experts with no prior answer. Ask in order: is the output enough to start? what is missing? was the right anomaly flagged? Speed the cycle with a historical set and time-ordered cross-validation (train early, validate later, roll forward)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="440" y="400" width="400" height="86" as="geometry" /></mxCell><mxCell id="ms" value="&lt;b&gt;The misses name the missing signals&lt;/b&gt; [C1, C4]: Wi-Fi disconnects caused by the DHCP client; 'cannot register' caused by failed time sync; reboots from a kernel-driver assertion (kernel buffer); a log that ends at the crash; stateful order-dependent faults (need sequences). Fixable misses become the roadmap." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="860" y="400" width="400" height="86" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt; — green = caught / Wilson interval / forward step; grey dashed = Wald interval; blue = usable cases, the 100-case interval and device-fault tickets; red dashed = false alarms (environmental); amber = misses. Circle = point estimate." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#f7f7f7;strokeColor=#bbbbbb;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="498" width="1240" height="30" as="geometry" /></mxCell><mxCell id="sources" value="&lt;b&gt;Sources&lt;/b&gt; — every number is loaded from ../constants.json. [n] = public (real value, cited); [n*] = illustrative (an invented round number of realistic order of magnitude; never a measurement). Wilson interval: Wilson, JASA 1927; NIST e-Handbook §7.2.4.1. Precision/recall as in Du et al., DeepLog, CCS 2017, §5.1.&lt;br/&gt;[1*] ground_truth_candidates = 60 cases — illustrative&lt;br/&gt;[2*] ground_truth_usable = 10 cases — illustrative&lt;br/&gt;[3*] ground_truth_detected = 6 cases — illustrative&lt;br/&gt;[4*] detection_rate_wilson95_6of10 = 31–83 % — illustrative; my arithmetic: Wilson score interval for 6/10 (illustrative counts)&lt;br/&gt;[5*] detection_rate_wald95_6of10 = 30–90 % — illustrative; my arithmetic: normal (Wald) interval for 6/10, clipped/rounded (illustrative counts)&lt;br/&gt;[6*] detection_rate_wilson95_60of100 = 50–69 % — illustrative; my arithmetic: Wilson score interval for 60/100 (illustrative counts)&lt;br/&gt;[7*] pilot_tickets = 10 tickets — illustrative&lt;br/&gt;[8*] pilot_environmental = 4 tickets — illustrative" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#fff8dc;strokeColor=#d6b656;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="538" width="1240" height="134" as="geometry" /></mxCell><mxCell id="e0" value="" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="bw" target="fw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="fw" target="ms"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l0" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560.0" y="270.0" as="sourcePoint" /><mxPoint x="840.0" y="270.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l1" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560.0" y="120.0" as="sourcePoint" /><mxPoint x="560.0" y="270.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l2" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#e6e6e6;strokeWidth=1;" edge="1" parent