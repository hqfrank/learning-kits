<mxfile host="app.diagrams.net"><diagram id="p_05_anomaly_to_root_cause" name="05-anomaly-to-root-cause"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="605" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Root cause starts where the sequence leaves the normal path: partition the log by thread, count transitions, and compare them with the golden sequence mined from many devices" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=20;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1240" height="56" as="geometry" /></mxCell><mxCell id="ha" value="&lt;b&gt;A. One interleaved stream, two threads&lt;/b&gt; [A1, B5] (toy lines)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=12;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="78" width="600" height="18" as="geometry" /></mxCell><mxCell id="r0" value="10:00:01.100   tid 845   scan start" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="300" height="22" as="geometry" /></mxCell><mxCell id="r1" value="10:00:01.100   tid 901   dhcp renew" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="124" width="300" height="22" as="geometry" /></mxCell><mxCell id="r2" value="10:00:01.230   tid 845   assoc start" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="148" width="300" height="22" as="geometry" /></mxCell><mxCell id="r3" value="10:00:01.231   tid 901   dhcp ack" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="172" width="300" height="22" as="geometry" /></mxCell><mxCell id="r4" value="10:00:01.480   tid 845   auth ok" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="196" width="300" height="22" as="geometry" /></mxCell><mxCell id="r5" value="10:00:01.480   tid 845   connected" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="220" width="300" height="22" as="geometry" /></mxCell><mxCell id="r6" value="10:00:05.010   tid 845   disconnected reason=15" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="244" width="300" height="22" as="geometry" /></mxCell><mxCell id="r7" value="10:00:05.020   tid 845   network bounce" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="268" width="300" height="22" as="geometry" /></mxCell><mxCell id="tie" value="same timestamp on two lines (ms resolution): true order unknown" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="296" width="300" height="32" as="geometry" /></mxCell><mxCell id="p1" value="&lt;b&gt;thread 845, sorted by time&lt;/b&gt;&lt;br/&gt;scan start -&amp;gt; assoc start -&amp;gt; auth ok -&amp;gt; connected -&amp;gt; disconnected -&amp;gt; network bounce" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="360" y="100" width="260" height="60" as="geometry" /></mxCell><mxCell id="p2" value="&lt;b&gt;thread 901&lt;/b&gt;&lt;br/&gt;dhcp renew -&amp;gt; dhcp ack" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="360" y="180" width="260" height="44" as="geometry" /></mxCell><mxCell id="bad" value="&lt;b&gt;trap: sort the whole log by time&lt;/b&gt;&lt;br/&gt;scan start -&amp;gt; dhcp renew -&amp;gt; assoc start -&amp;gt; dhcp ack ... gives edges that never happen in the code. Partition by pid/tid first." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;dashed=1;dashPattern=6 4;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="360" y="232" width="260" height="76" as="geometry" /></mxCell><mxCell id="mat" value="&lt;b&gt;Transition count matrix A (N x N templates)&lt;/b&gt; [B5]: for each consecutive pair (i, j) inside one thread, A[i][j] += 1. Skip the edge into a task-start template so one task's end is not linked to the next. Drop impossible timestamps (cache replayed after a reboot). Ties average out over many windows." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="336" width="600" height="60" as="geometry" /></mxCell><mxCell id="hb" value="&lt;b&gt;B. Workflow (empirical control-flow graph) from many healthy devices&lt;/b&gt; [B5]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=12;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="650" y="78" width="610" height="18" as="geometry" /></mxCell><mxCell id="g0" value="scanning" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fontStyle=1;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="650" y="104" width="140" height="40" as="geometry" /></mxCell><mxCell id="g1" value="associating" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fontStyle=1;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="805" y="104" width="140" height="40" as="geometry" /></mxCell><mxCell id="g2" value="authenticating" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fontStyle=1;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="960" y="104" width="140" height="40" as="geometry" /></mxCell><mxCell id="g3" value="connected" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fontStyle=1;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1115" y="104" width="140" height="40" as="geometry" /></mxCell><mxCell id="gold" value="golden sequence (green): the normal order for the task, shown next to the anomalous one" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#5f9e4f;" vertex="1" parent="1"><mxGeometry x="650" y="148" width="610" height="18" as="geometry" /></mxCell><mxCell id="ghost" value="association complete&lt;br/&gt;(expected child)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;dashed=1;dashPattern=6 4;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="805" y="196" width="160" height="44" as="geometry" /></mxCell><mxCell id="seqa" value="&lt;b&gt;sequence anomaly&lt;/b&gt;: an expected child does not appear within its usual lag after its parent (missing in thread 845)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="650" y="246" width="300" height="48" as="geometry" /></mxCell><mxCell id="disc" value="disconnected" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1115" y="210" width="140" height="40" as="geometry" /></mxCell><mxCell id="par" value="parameter: reason 15 = 4-way handshake timeout [1]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="945" y="160" width="166" height="40" as="geometry" /></mxCell><mxCell id="rec" value="reconnect success" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fontStyle=1;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1115" y="320" width="140" height="40" as="geometry" /></mxCell><mxCell id="bnc" value="network bounce" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fontStyle=1;dashed=1;dashPattern=6 4;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="960" y="320" width="140" height="40" as="geometry" /></mxCell><mxCell id="dista" value="&lt;b&gt;distribution anomaly&lt;/b&gt;: the probability of an edge changes. After 'disconnected' the share to 'reconnect success' (thick) falls, the share to 'network bounce' rises." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="650" y="300" width="300" height="60" as="geometry" /></mxCell><mxCell id="obs" value="The graph is the OBSERVED graph, not the code's: paths the code allows but healthy devices never take are absent, so their appearance is itself a signal. Normal transition statistics need many devices over long periods." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="650" y="368" width="610" height="46" as="geometry" /></mxCell><mxCell id="ctx" value="&lt;b&gt;1 Narrow the search (cascade)&lt;/b&gt; [B5]: the metric says which devices, roughly when, and what (e.g. disconnects with reason 15). Traps: metrics aggregated hourly or daily; device logs in local time, metrics in UTC." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="420" width="400" height="72" as="geometry" /></mxCell><mxCell id="tools" value="&lt;b&gt;2 Show the departure&lt;/b&gt; [B5]: golden sequence beside the anomalous one; state-machine search (ordered events + max time span -&amp;gt; every match with raw lines); a chosen parameter over time; replay through the print statements if templates map to code." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="440" y="420" width="400" height="72" as="geometry" /></mxCell><mxCell id="hum" value="&lt;b&gt;3 Hypothesis, not verdict&lt;/b&gt; [B5, C4]: the anomalous template is often a symptom downstream of the cause in another component (DHCP, time sync, a kernel driver). Output = top windows, top templates, the departing edge, the raw lines." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="860" y="420" width="400" height="72" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt; — blue / purple = lines of two threads; green = normal workflow and golden sequence (edge thickness = share of transitions); red dashed = anomaly (missing child, shifted edge, wrong sort); amber = the triggering event and the human step. Toy lines, no data." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#f7f7f7;strokeColor=#bbbbbb;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="504" width="1240" height="30" as="geometry" /></mxCell><mxCell id="sources" value="&lt;b&gt;Sources&lt;/b&gt; — every number is loaded from ../constants.json. [n] = public (real value, cited); [n*] = illustrative (an invented round number of realistic order of magnitude; never a measurement). Workflow idea: Du et al., DeepLog, CCS 2017, §4.4.&lt;br/&gt;[1] ieee80211_reason_4way_handshake_timeout = 15 reason code — public; IEEE Std 802.11 reason-code table; wpa_supplicant ieee802_11_defs.h (WLAN_REASON_4WAY_HANDSHAKE_TIMEOUT)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#fff8dc;strokeColor=#d6b656;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="544" width="1240" height="47" as="geometry" /></mxCell><mxCell id="e0" value="" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#5f9e4f;strokeWidth=2.5;" edge="1" parent="1" source="g0" target="g1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#5f9e4f;strokeWidth=2.5;" edge="1" parent="1" source="g1" target="g2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#5f9e4f;strokeWidth=2.5;" edge="1" parent="1" source="g2" target="g3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="endArrow=classic;html=1;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="g3" target="disc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="endArrow=classic;html=1;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#5f9e4f;strokeWidth=4;" edge="1" parent="1" source="disc" target="rec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="endArrow=classic;html=1;fontSize=10;dashed=1;dashPattern=6 4;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;strokeColor=#b85450;strokeWidth=1.5;" edge="1" parent="1" source="disc" target="bnc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="ctx" target="tools"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="tools" target="hum"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l0" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="320.0" y="136.0" as="sourcePoint" /><mxPoint x="360.0" y="136.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l1" value="" style="endArrow=classic;startArrow=none;html=1;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="320.0" y="200.0" as="sourcePoint" /><mxPoint x="360.0" y="200.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l2" value="" style="endArrow=classic;startArrow=none;html=1;dashed=1;dashPattern=5 3;strokeColor=#b85450;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="875.0" y="168.0" as="sourcePoint" /><mxPoint x="875.0" y="196.0" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>