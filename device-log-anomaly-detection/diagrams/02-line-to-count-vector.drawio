<mxfile host="app.diagrams.net"><diagram id="p_02_line_to_count_vector" name="02-line-to-count-vector"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="844" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Parsing and windowing turn free text into a count matrix: every column is a template an engineer can read, and the order of events inside a window is lost" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=20;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1240" height="56" as="geometry" /></mxCell><mxCell id="ha" value="&lt;b&gt;A. Parse one line&lt;/b&gt; [A1, B1]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=12;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="600" height="18" as="geometry" /></mxCell><mxCell id="raw" value="&lt;b&gt;raw line&lt;/b&gt; (logcat threadtime layout)&lt;br/&gt;date time pid tid level tag: message&lt;br/&gt;... 812 845 I wpa_supplicant: CTRL-EVENT-DISCONNECTED bssid=aa:bb:cc:dd:ee:ff reason=3 locally_generated=1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#eeeeee;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="102" width="400" height="70" as="geometry" /></mxCell><mxCell id="tpl" value="&lt;b&gt;template&lt;/b&gt; = constant words, parameters replaced by &amp;lt;*&amp;gt;&lt;br/&gt;CTRL-EVENT-DISCONNECTED bssid=&amp;lt;*&amp;gt; reason=&amp;lt;*&amp;gt; locally_generated=&amp;lt;*&amp;gt;&lt;br/&gt;-&amp;gt; one stable template ID (a vocabulary of a few hundred, e.g. 400 templates [1*])" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="460" y="102" width="400" height="70" as="geometry" /></mxCell><mxCell id="par" value="&lt;b&gt;parameters&lt;/b&gt; = the run-time values, kept&lt;br/&gt;[aa:bb:cc:dd:ee:ff, 3, 1]&lt;br/&gt;reason 3 [2] = deauthenticated because leaving (IEEE 802.11); parameters often name the cause [B5]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="900" y="102" width="360" height="70" as="geometry" /></mxCell><mxCell id="hb" value="&lt;b&gt;B. Match it fast: a parse-tree matcher over a fixed template set&lt;/b&gt; [B1]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=12;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="186" width="800" height="18" as="geometry" /></mxCell><mxCell id="t1" value="layer 1&lt;br/&gt;component (tag)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="210" width="130" height="62" as="geometry" /></mxCell><mxCell id="t2" value="layer 2&lt;br/&gt;token count" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="175" y="210" width="130" height="62" as="geometry" /></mxCell><mxCell id="t3" value="one layer per token&lt;br/&gt;partial-token wildcards keep event=&amp;lt;*&amp;gt; and error=&amp;lt;*&amp;gt; apart" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="330" y="210" width="245" height="62" as="geometry" /></mxCell><mxCell id="t4" value="leaf&lt;br/&gt;template ID" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="600" y="210" width="120" height="62" as="geometry" /></mxCell><mxCell id="unm" value="no template matches -&amp;gt; &lt;b&gt;unmatched bucket&lt;/b&gt;: engineers review, add templates, rebuild the tree [C2]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;dashed=1;dashPattern=6 4;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="175" y="290" width="545" height="40" as="geometry" /></mxCell><mxCell id="srcp" value="&lt;b&gt;Where templates come from&lt;/b&gt; [B1]&lt;br/&gt;- mining (Drain, Spell) finds only what is in the sample. Example: a component with 100 print statements [3*], about 50 % [4*] on error or warning paths; a miner on normal logs finds 20 templates [5*]. The missing ones are the error paths detection needs.&lt;br/&gt;- source-code extraction: complete, but needs source access and upkeep.&lt;br/&gt;- Drain speed: 51.85–81.47 % [6] faster than the best online parser of its time, on 5 data sets [7] with more than 10 000 000 log messages [8]." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#f7f7f7;strokeColor=#bbbbbb;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="740" y="210" width="520" height="120" as="geometry" /></mxCell><mxCell id="hc" value="&lt;b&gt;C. Cut the parsed stream into windows&lt;/b&gt; [B2]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=12;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="352" width="700" height="18" as="geometry" /></mxCell><mxCell id="tk0" value="0 h" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="100.0" y="508" width="40" height="14" as="geometry" /></mxCell><mxCell id="tk6" value="6 h" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="232.0" y="508" width="40" height="14" as="geometry" /></mxCell><mxCell id="tk12" value="12 h" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="364.0" y="508" width="40" height="14" as="geometry" /></mxCell><mxCell id="tk18" value="18 h" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="496.0" y="508" width="40" height="14" as="geometry" /></mxCell><mxCell id="tk24" value="24 h" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="628.0" y="508" width="40" height="14" as="geometry" /></mxCell><mxCell id="lf" value="fixed" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="380" width="96" height="16" as="geometry" /></mxCell><mxCell id="fx0" value="" style="rounded=0;whiteSpace=wrap;html=1;vertical