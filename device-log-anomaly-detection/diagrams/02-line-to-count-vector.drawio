lor=#5f9e4f;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="142.0" y="458" width="55.0" height="16" as="geometry" /></mxCell><mxCell id="ss1" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="230.0" y="458" width="26.400000000000006" height="16" as="geometry" /></mxCell><mxCell id="ss2" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="318.0" y="458" width="88.0" height="16" as="geometry" /></mxCell><mxCell id="ss3" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="461.0" y="458" width="22.0" height="16" as="geometry" /></mxCell><mxCell id="ss4" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="538.0" y="458" width="77.0" height="16" as="geometry" /></mxCell><mxCell id="lss2" value="session = one execution path, needs an ID (HDFS block IDs; device logs rarely have one). Public defaults (BGL): fixed 1 h [10], sliding 6 h [11] with step 1 h." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="524" width="640" height="30" as="geometry" /></mxCell><mxCell id="hm" value="&lt;b&gt;D. Count templates per window: the event count matrix&lt;/b&gt; [B2]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=12;spacing=6;fillColor=none;str