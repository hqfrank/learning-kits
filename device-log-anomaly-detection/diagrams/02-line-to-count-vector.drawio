er;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="872" y="464" width="46" height="22" as="geometry" /></mxCell><mxCell id="m3_3" value="0" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="918" y="464" width="46" height="22" as="geometry" /></mxCell><mxCell id="m3_4" value="0" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="964" y="464" width="46" height="22" as="geometry" /></mxCell><mxCell id="mr4" value="w5" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="720" y="486" width="60" height="22" as="geometry" /></mxCell><mxCell id="m4_0" value="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="780" y="486" width="46" height="22" as="geometry" /></mxCell><mxCell id="m4_1" value="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="826" y="486" width="46" height="22" as="geometry" /></mxCell><mxCell id="m4_2" value="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="872" y="486" width="46" height="22" as="geometry" /></mxCell><mxCell id="m4_3" value="0" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="918" y="486" width="46" height="22" as="geometry" /></mxCell><mxCell id="m4_4" value="0" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=10;spacing=6;fillColor=#ffffff;strokeColor=#888888;strokeWidth=1;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="964" y="486" width="46" height="22" as="geometry" /></mxCell><mxCell id="mnote" value="toy counts, not data. w3 has unusual counts (red): the kind of row an isolation forest isolates fast [B3]." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="720" y="512" width="290" height="44" as="geometry" /></mxCell><mxCell id="ord" value="&lt;b&gt;order is lost&lt;/b&gt;&lt;br/&gt;w4 = T1 T2 T3&lt;br/&gt;w5 = T1 T3 T2&lt;br/&gt;same vector [1, 1, 1, 0, 0]&lt;br/&gt;an order fault is invisible to counts -&amp;gt; transition edges [B5]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;dashed=1;dashPattern=6 4;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1030" y="376" width="230" height="128" as="geometry" /></mxCell><mxCell id="trade" value="&lt;b&gt;Window length is a design choice&lt;/b&gt; [B2]: longer -&amp;gt; denser vector, frequency changes easier to see, but a short burst is diluted and the earliest alarm is later. Shorter -&amp;gt; faster, better time localisation, but mostly zeros and normal jitter looks large. Set it from the fault classes you care about." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="562" width="1240" height="46" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt; — grey = raw text; green = templates / template columns; amber = parameters, sliding windows and design choices; blue = index layers, fixed windows and window rows; red dashed = where information is lost or left unmatched." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#f7f7f7;strokeColor=#bbbbbb;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="618" width="1240" height="30" as="geometry" /></mxCell><mxCell id="sources" value="&lt;b&gt;Sources&lt;/b&gt; — every number is loaded from ../constants.json. [n] = public (real value, cited); [n*] = illustrative (an invented round number of realistic order of magnitude; never a measurement).&lt;br/&gt;[1*] templates_per_component_set = 400 templates — illustrative; ('a few hundred')&lt;br/&gt;[2] ieee80211_reason_deauth_leaving = 3 reason code — public; IEEE Std 802.11 reason-code table; wpa_supplicant ieee802_11_defs.h (WLAN_REASON_DEAUTH_LEAVING)&lt;br/&gt;[3*] component_print_statements = 100 print statements — illustrative&lt;br/&gt;[4*] component_error_warning_share = 50 % of print statements — illustrative; ('about half')&lt;br/&gt;[5*] miner_templates_found = 20 templates — illustrative&lt;br/&gt;[6] drain_runtime_improvement = 51.85–81.47 % — public; He, Zhu, Zheng, Lyu, 'Drain', ICWS 2017, abstract (vs best online parser of its time)&lt;br/&gt;[7] drain_eval_datasets = 5 data sets — public; He, Zhu, Zheng, Lyu, 'Drain', ICWS 2017, abstract&lt;br/&gt;[8] drain_eval_messages_min = 10 000 000 log messages — public; He, Zhu, Zheng, Lyu, 'Drain', ICWS 2017, abstract ('more than 10 million')&lt;br/&gt;[9*] window_example = day 24, window 1, step 0.25, windows 93 h / count — illustrative; inputs; windows = (24-1)/0.25 + 1, my arithmetic&lt;br/&gt;[10] he2016_fixed_window_default = 1 h — public; He, Zhu, He, Lyu, 'Experience Report: System Log Analysis for Anomaly Detection', ISSRE 2016, §IV-B&lt;br/&gt;[11] he2016_sliding_window_default = window 6, step 1 h — public; He, Zhu, He, Lyu, 'Experience Report: System Log Analysis for Anomaly Detection', ISSRE 2016, §IV-B" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#fff8dc;strokeColor=#d6b656;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="658" width="1240" height="172" as="geometry" /></mxCell><mxCell id="e0" value="" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="raw" target="tpl"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="tpl" target="par"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="t1" target="t2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="t2" target="t3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="t3" target="t4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l0" value="" style="endArrow=classic;startArrow=none;html=1;dashed=1;dashPattern=4 3;strokeColor=#b85450;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="452.0" y="272.0" as="sourcePoint" /><mxPoint x="452.0" y="290.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l1" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120.0" y="502.0" as="sourcePoint" /><mxPoint x="648.0" y="502.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l2" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120.0" y="502.0" as="sourcePoint" /><mxPoint x="120.0" y="507.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l3" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="252.0" y="502.0" as="sourcePoint" /><mxPoint x="252.0" y="507.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l4" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="384.0" y="502.0" as="sourcePoint" /><mxPoint x="384.0" y="507.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l5" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="516.0" y="502.0" as="sourcePoint" /><mxPoint x="516.0" y="507.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l6" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="648.0" y="502.0" as="sourcePoint" /><mxPoint x="648.0" y="507.0" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>