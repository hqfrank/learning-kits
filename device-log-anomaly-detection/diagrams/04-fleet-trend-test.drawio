<mxfile host="app.diagrams.net"><diagram id="p_04_fleet_trend_test" name="04-fleet-trend-test"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="924" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="The same 3 % jump can be noise in 100 devices but is a fleet change in 10 000: the share's standard error shrinks with sqrt(n), so the trend test weights each day by n (illustrative counts)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=20;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1240" height="56" as="geometry" /></mxCell><mxCell id="cp" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacing=6;fillColor=none;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="550" height="400" as="geometry" /></mxCell><mxCell id="cpt" value="&lt;b&gt;Share of devices that emitted a rare disconnect reason, one day&lt;/b&gt; [A2]&lt;br/&gt;dot = share; bar = +/- 1 standard error, SE = sqrt(p(1-p)/n)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="28" y="84" width="534" height="34" as="geometry" /></mxCell><mxCell id="ayt0" value="0" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="352.0" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt1" value="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="317.0" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt2" value="2" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="282.0" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt3" value="3" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="247.0" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt4" value="4" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="212.0" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt5" value="5" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="177.0" width="44" height="16" as="geometry" /></mxCell><mxCell id="ayt6" value="6" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="142.0" width="44" height="16" as="geometry" /></mxCell><mxCell id="axl" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=11;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="110" y="382" width="420" height="18" as="geometry" /></mxCell><mxCell id="ayl" value="share of devices (%)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="126" width="470" height="18" as="geometry" /></mxCell><mxCell id="dt0" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="208.0" y="248.0" width="14" height="14" as="geometry" /></mxCell><mxCell id="bl0" value="small family&lt;br/&gt;100 [1*] active,&lt;br/&gt;3 [2*] emit it&lt;br/&gt;SE = 1.7 pp [3*]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="120.0" y="366.0" width="190" height="66" as="geometry" /></mxCell><mxCell id="dt1" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="418.0" y="248.0" width="14" height="14" as="geometry" /></mxCell><mxCell id="bl1" value="large family&lt;br/&gt;10 000 [4*] active&lt;br/&gt;same share&lt;br/&gt;SE = 0.17 pp [5*]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#5f9e4f;" vertex="1" parent="1"><mxGeometry x="330.0" y="366.0" width="190" height="66" as="geometry" /></mxCell><mxCell id="cpn" value="Halve n and SE grows by sqrt 2. Three unlucky households can make the small-family jump; the large-family bar is ten times tighter (sqrt of 100x the devices). Share 3 % = 3 / 100, my arithmetic." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="28" y="438" width="534" height="40" as="geometry" /></mxCell><mxCell id="st0" value="&lt;b&gt;1 one series per slice&lt;/b&gt; [B4]: daily share p_t and active count n_t per (family, feature, category) over 8 weeks [6*] (56 daily points)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="590" y="80" width="670" height="56" as="geometry" /></mxCell><mxCell id="st1" value="&lt;b&gt;2 not ordinary least squares&lt;/b&gt; [B4]: Var(p_t) = p(1-p)/n_t changes day to day (weekends, outages, new cohorts): heteroscedastic; OLS gives a noisy day the same say and a wrong slope SE" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="590" y="146" width="670" height="56" as="geometry" /></mxCell><mxCell id="st2" value="&lt;b&gt;3 weighted least squares&lt;/b&gt; [B4]: weight w_t = n_t / (p_t(1-p_t)); minimise sum w_t (p_t - a - b t)^2. Use a pooled p when p_t is 0 or 1 (infinite weight)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="590" y="212" width="670" height="56" as="geometry" /></mxCell><mxCell id="st3" value="&lt;b&gt;4 test against a practical slope s&lt;/b&gt; [B4]: H0: b = s (not b = 0: with enough devices every slope is significant). One-sided p = 1 - Phi((b_hat - s) / se(b_hat))" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="590" y="278" width="670" height="56" as="geometry" /></mxCell><mxCell id="st4" value="&lt;b&gt;5 p-value -&amp;gt; score&lt;/b&gt; [B4]: score = -10 [7] log10(p), capped at 100 [8*]; see the ladder below" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="590" y="344" width="670" height="56" as="geometry" /></mxCell><mxCell id="st5" value="&lt;b&gt;6 filter direction, control false discoveries&lt;/b&gt; [B4]: drop good-direction changes; 10 000 series/day [9*] tested at p 0.01 give about 100 series/day [10*] by chance -&amp;gt; FDR control or rank and read the top" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="590" y="410" width="670" height="56" as="geometry" /></mxCell><mxCell id="lh" value="&lt;b&gt;p -&amp;gt; score ladder&lt;/b&gt; (each 10 points = 10x smaller p) [B4]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=12;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="600" height="18" as="geometry" /></mxCell><mxCell id="sc0" value="p = 0.1&lt;br/&gt;score 10 [11]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="589.0" width="120" height="41.0" as="geometry" /></mxCell><mxCell id="sc1" value="p = 0.01&lt;br/&gt;score 20 [11]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="160" y="582.0" width="120" height="48.0" as="geometry" /></mxCell><mxCell id="sc2" value="p = 1e-5&lt;br/&gt;score 50 [11]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="300" y="561.0" width="120" height="69.0" as="geometry" /></mxCell><mxCell id="sc3" value="p = 1e-10 (cap)&lt;br/&gt;score 100 [11]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="440" y="526.0" width="120" height="104.0" as="geometry" /></mxCell><mxCell id="fam" value="&lt;b&gt;Family level&lt;/b&gt; [B4]: WLS slope test on the share. Catches fleet-wide regressions (a release that raises disconnects). Few reports (e.g. 1 [12*] per week), each high impact." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="590" y="530" width="330" height="100" as="geometry" /></mxCell><mxCell id="devl" value="&lt;b&gt;Device level&lt;/b&gt; [B3, B4]: isolation forest on device-day vectors. Catches one device or household behaving oddly. Many reports, each lower impact and often environmental." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="930" y="530" width="330" height="100" as="geometry" /></mxCell><mxCell id="conf" value="&lt;b&gt;Read it correctly&lt;/b&gt; [B4]: the score is a confidence that the slope exceeds s, not a severity; a significant trend can be a router-firmware rollout, a holiday or a reporting change. Correlated daily residuals make se(b) too small: check with a weekly dummy." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="646" width="1240" height="32" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt; — red = small population (noisy); green = large population (precise); blue = estimation steps; amber = the decision steps (threshold, score); purple = device-level detection. pp = percentage points." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#f7f7f7;strokeColor=#bbbbbb;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="688" width="1240" height="30" as="geometry" /></mxCell><mxCell id="sources" value="&lt;b&gt;Sources&lt;/b&gt; — every number is loaded from ../constants.json. [n] = public (real value, cited); [n*] = illustrative (an invented round number of realistic order of magnitude; never a measurement).&lt;br/&gt;[1*] small_family_devices = 100 active devices — illustrative&lt;br/&gt;[2*] rare_reason_devices = 3 devices — illustrative&lt;br/&gt;[3*] rare_share_small_family_se = 1.7 percentage points — illustrative; my arithmetic: sqrt(0.03*0.97/100), from illustrative inputs&lt;br/&gt;[4*] large_family_devices = 10 000 active devices — illustrative&lt;br/&gt;[5*] rare_share_large_family_se = 0.17 percentage points — illustrative; my arithmetic: sqrt(0.03*0.97/10000), from illustrative inputs&lt;br/&gt;[6*] trend_series_length = weeks 8, daily_points 56 weeks / days — illustrative&lt;br/&gt;[7] phred_factor = 10 score points per decade of p — public; Ewing &amp;amp; Green, Genome Research 8:186-194, 1998: Q = -10 log10 P&lt;br/&gt;[8*] score_cap = 100 score — illustrative; cap (p = 1e-10)&lt;br/&gt;[9*] monitored_series = 10 000 series per day — illustrative&lt;br/&gt;[10*] multiple_testing_false_alarms = 100 series per day — illustrative; my arithmetic: 10 000 x 0.01, illustrative inputs&lt;br/&gt;[11] score_examples = p_0.1 10, p_0.01 20, p_1e-5 50, p_1e-10 100 score — public; my arithmetic from score = -10 log10(p)&lt;br/&gt;[12*] family_reports_per_week = 1 reports — illustrative" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#fff8dc;strokeColor=#d6b656;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="728" width="1240" height="182" as="geometry" /></mxCell><mxCell id="e0" value="" style="endArrow=classic;html=1;fontSize=10;exitX=0.04;exitY=1;exitDx=0;exitDy=0;entryX=0.04;entryY=0;entryDx=0;entryDy=0;strokeColor=#6c8ebf;strokeWidth=1.5;" edge="1" parent="1" source="st0" target="st1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="endArrow=classic;html=1;fontSize=10;exitX=0.04;exitY=1;exitDx=0;exitDy=0;entryX=0.04;entryY=0;entryDx=0;entryDy=0;strokeColor=#6c8ebf;strokeWidth=1.5;" edge="1" parent="1" source="st1" target="st2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="endArrow=classic;html=1;fontSize=10;exitX=0.04;exitY=1;exitDx=0;exitDy=0;entryX=0.04;entryY=0;entryDx=0;entryDy=0;strokeColor=#6c8ebf;strokeWidth=1.5;" edge="1" parent="1" source="st2" target="st3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="endArrow=classic;html=1;fontSize=10;exitX=0.04;exitY=1;exitDx=0;exitDy=0;entryX=0.04;entryY=0;entryDx=0;entryDy=0;strokeColor=#6c8ebf;strokeWidth=1.5;" edge="1" parent="1" source="st3" target="st4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="endArrow=classic;html=1;fontSize=10;exitX=0.04;exitY=1;exitDx=0;exitDy=0;entryX=0.04;entryY=0;entryDx=0;entryDy=0;strokeColor=#6c8ebf;strokeWidth=1.5;" edge="1" parent="1" source="st4" target="st5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l0" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110.0" y="360.0" as="sourcePoint" /><mxPoint x="530.0" y="360.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l1" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110.0" y="150.0" as="sourcePoint" /><mxPoint x="110.0" y="360.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l2" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#e6e6e6;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110.0" y="360.0" as="sourcePoint" /><mxPoint x="530.0" y="360.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l3" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="105.0" y="360.0" as="sourcePoint" /><mxPoint x="110.0" y="360.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l4" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#e6e6e6;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110.0" y="325.0" as="sourcePoint" /><mxPoint x="530.0" y="325.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l5" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="105.0" y="325.0" as="sourcePoint" /><mxPoint x="110.0" y="325.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l6" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#e6e6e6;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110.0" y="290.0" as="sourcePoint" /><mxPoint x="530.0" y="290.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l7" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="105.0" y="290.0" as="sourcePoint" /><mxPoint x="110.0" y="290.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l8" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#e6e6e6;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110.0" y="255.0" as="sourcePoint" /><mxPoint x="530.0" y="255.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l9" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="105.0" y="255.0" as="sourcePoint" /><mxPoint x="110.0" y="255.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l10" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#e6e6e6;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110.0" y="220.0" as="sourcePoint" /><mxPoint x="530.0" y="220.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l11" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="105.0" y="220.0" as="sourcePoint" /><mxPoint x="110.0" y="220.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l12" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#e6e6e6;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110.0" y="185.0" as="sourcePoint" /><mxPoint x="530.0" y="185.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l13" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="105.0" y="185.0" as="sourcePoint" /><mxPoint x="110.0" y="185.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l14" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#e6e6e6;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110.0" y="150.0" as="sourcePoint" /><mxPoint x="530.0" y="150.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l15" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="105.0" y="150.0" as="sourcePoint" /><mxPoint x="110.0" y="150.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l16" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#b85450;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="215.0" y="314.5" as="sourcePoint" /><mxPoint x="215.0" y="195.5" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l17" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#b85450;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="205.0" y="314.5" as="sourcePoint" /><mxPoint x="225.0" y="314.5" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l18" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#b85450;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="205.0" y="195.5" as="sourcePoint" /><mxPoint x="225.0" y="195.5" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l19" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#5f9e4f;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="425.0" y="260.9" as="sourcePoint" /><mxPoint x="425.0" y="249.1" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l20" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#5f9e4f;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="415.0" y="260.9" as="sourcePoint" /><mxPoint x="435.0" y="260.9" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l21" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#5f9e4f;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="415.0" y="249.1" as="sourcePoint" /><mxPoint x="435.0" y="249.1" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>