<mxfile host="app.diagrams.net"><diagram id="p_06_evaluating_without_labels" name="06-evaluating-without-labels"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="686" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Catching 6 of 10 known faults says 'the method works', not 'it is better': the 95 % interval is 31–83 %, and it must be reported next to 4 of 10 pilot flags that were environmental (illustrative counts)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=left;fontSize=20;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1240" height="56" as="geometry" /></mxCell><mxCell id="ha" value="&lt;b&gt;A. Building ground truth by hand&lt;/b&gt; [C1]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=12;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="390" height="18" as="geometry" /></mxCell><mxCell id="f0" value="&lt;b&gt;60 cases [1*]&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#eeeeee;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20.0" y="104" width="380.0" height="30" as="geometry" /></mxCell><mxCell id="fl0" value="candidate cases (lab faults + resolved user reports)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="20" y="136" width="380" height="30" as="geometry" /></mxCell><mxCell id="f1" value="&lt;b&gt;10 cases [2*]&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="128.33333333333331" y="170" width="163.33333333333334" height="30" as="geometry" /></mxCell><mxCell id="fl1" value="usable: production-format log, right time range, identified bug, closed ticket" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="20" y="202" width="380" height="30" as="geometry" /></mxCell><mxCell id="f2" value="&lt;b&gt;6 cases [3*]&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="137.0" y="236" width="146.0" height="30" as="geometry" /></mxCell><mxCell id="fl2" value="detected by the pipeline (backward validation)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="20" y="268" width="380" height="30" as="geometry" /></mxCell><mxCell id="hb" value="&lt;b&gt;B. Detection rate with its 95 % interval&lt;/b&gt; [C1]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=12;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="440" y="80" width="410" height="18" as="geometry" /></mxCell><mxCell id="bxt0" value="0" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="530.0" y="276" width="60" height="15" as="geometry" /></mxCell><mxCell id="bxt1" value="20" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="586.0" y="276" width="60" height="15" as="geometry" /></mxCell><mxCell id="bxt2" value="40" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="642.0" y="276" width="60" height="15" as="geometry" /></mxCell><mxCell id="bxt3" value="60" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="698.0" y="276" width="60" height="15" as="geometry" /></mxCell><mxCell id="bxt4" value="80" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="754.0" y="276" width="60" height="15" as="geometry" /></mxCell><mxCell id="bxt5" value="100" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="810.0" y="276" width="60" height="15" as="geometry" /></mxCell><mxCell id="bxl" value="detection rate (%)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=11;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="560" y="292" width="280" height="18" as="geometry" /></mxCell><mxCell id="byl" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=11;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="510" y="96" width="330" height="18" as="geometry" /></mxCell><mxCell id="pt0" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#ffffff;strokeColor=#5f9e4f;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="722.0" y="139.0" width="12" height="12" as="geometry" /></mxCell><mxCell id="rl0" value="Wilson, 6/10" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#5f9e4f;" vertex="1" parent="1"><mxGeometry x="440" y="136.0" width="116" height="18" as="geometry" /></mxCell><mxCell id="rv0" value="31–83 % [4*]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#5f9e4f;" vertex="1" parent="1"><mxGeometry x="636.8" y="119.0" width="200" height="16" as="geometry" /></mxCell><mxCell id="pt1" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#ffffff;strokeColor=#888888;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="722.0" y="189.0" width="12" height="12" as="geometry" /></mxCell><mxCell id="rl1" value="Wald, 6/10" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="440" y="186.0" width="116" height="18" as="geometry" /></mxCell><mxCell id="rv1" value="30–90 % [5*]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#888888;" vertex="1" parent="1"><mxGeometry x="634.0" y="169.0" width="200" height="16" as="geometry" /></mxCell><mxCell id="pt2" value="" style="ellipse;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="722.0" y="239.0" width="12" height="12" as="geometry" /></mxCell><mxCell id="rl2" value="Wilson, 60/100" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="440" y="236.0" width="116" height="18" as="geometry" /></mxCell><mxCell id="rv2" value="50–69 % [6*]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="690.0" y="219.0" width="200" height="16" as="geometry" /></mxCell><mxCell id="bn" value="point = 60 % (my arithmetic). Ten cases give about +/- 25 pp; 100 cases at the same rate narrow it. The Wald interval is too wide at the top and misbehaves near 0 and 1. Ten cases cannot rank this method against one that scored 50 %." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="440" y="320" width="410" height="70" as="geometry" /></mxCell><mxCell id="hc" value="&lt;b&gt;C. Detection rate needs its false-alarm rate&lt;/b&gt; [C1]" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=12;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="880" y="80" width="380" height="18" as="geometry" /></mxCell><mxCell id="ch1" value="fault present" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="990" y="104" width="130" height="18" as="geometry" /></mxCell><mxCell id="ch2" value="no fault" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontSize=10;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1120" y="104" width="130" height="18" as="geometry" /></mxCell><mxCell id="rh1" value="flagged" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="880" y="138" width="106" height="18" as="geometry" /></mxCell><mxCell id="rh2" value="not flagged" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=right;fontSize=10;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="880" y="182" width="106" height="18" as="geometry" /></mxCell><mxCell id="cm00" value="TP" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fontStyle=1;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="990" y="126" width="130" height="44" as="geometry" /></mxCell><mxCell id="cm01" value="FP&lt;br/&gt;false alarm" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1120" y="126" width="130" height="44" as="geometry" /></mxCell><mxCell id="cm10" value="FN&lt;br/&gt;miss" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="990" y="170" width="130" height="44" as="geometry" /></mxCell><mxCell id="cm11" value="TN" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=11;spacing=6;fontStyle=1;fillColor=#eeeeee;strokeColor=#888888;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1120" y="170" width="130" height="44" as="geometry" /></mxCell><mxCell id="cmf" value="detection rate (recall) = TP / (TP + FN); precision = TP / (TP + FP); false-alarm share of flags = 1 - precision. Flag everything and recall is 100 %." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="880" y="220" width="380" height="48" as="geometry" /></mxCell><mxCell id="pil" value="forward pilot: 10 tickets [7*], of which 4 [8*] environmental" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="880" y="286" width="380" height="18" as="geometry" /></mxCell><mxCell id="tk0" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="880" y="308" width="30" height="30" as="geometry" /></mxCell><mxCell id="tk1" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="916" y="308" width="30" height="30" as="geometry" /></mxCell><mxCell id="tk2" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="952" y="308" width="30" height="30" as="geometry" /></mxCell><mxCell id="tk3" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="988" y="308" width="30" height="30" as="geometry" /></mxCell><mxCell id="tk4" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1024" y="308" width="30" height="30" as="geometry" /></mxCell><mxCell id="tk5" value="" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1060" y="308" width="30" height="30" as="geometry" /></mxCell><mxCell id="tk6" value="env" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;dashed=1;dashPattern=4 3;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1096" y="308" width="30" height="30" as="geometry" /></mxCell><mxCell id="tk7" value="env" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;dashed=1;dashPattern=4 3;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1132" y="308" width="30" height="30" as="geometry" /></mxCell><mxCell id="tk8" value="env" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;dashed=1;dashPattern=4 3;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1168" y="308" width="30" height="30" as="geometry" /></mxCell><mxCell id="tk9" value="env" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=middle;align=center;fontSize=9;spacing=6;dashed=1;dashPattern=4 3;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1204" y="308" width="30" height="30" as="geometry" /></mxCell><mxCell id="pil2" value="environmental = the customer's access point or internet, not the device [C4]. Confirm with a second signal before a ticket." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="880" y="342" width="380" height="46" as="geometry" /></mxCell><mxCell id="bw" value="&lt;b&gt;Backward validation&lt;/b&gt; [C1]: start from a known fault, find the snippet, check the detector flags the same device and window. Record: what, when, caught?, if not why and is it fixable. Necessary, not sufficient." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="400" width="400" height="86" as="geometry" /></mxCell><mxCell id="fw" value="&lt;b&gt;Forward pilot&lt;/b&gt; [C1]: a few cases a week to domain experts with no prior answer. Ask in order: is the output enough to start? what is missing? was the right anomaly flagged? Speed the cycle with a historical set and time-ordered cross-validation (train early, validate later, roll forward)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#d5e8d4;strokeColor=#5f9e4f;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="440" y="400" width="400" height="86" as="geometry" /></mxCell><mxCell id="ms" value="&lt;b&gt;The misses name the missing signals&lt;/b&gt; [C1, C4]: Wi-Fi disconnects caused by the DHCP client; 'cannot register' caused by failed time sync; reboots from a kernel-driver assertion (kernel buffer); a log that ends at the crash; stateful order-dependent faults (need sequences). Fixable misses become the roadmap." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="860" y="400" width="400" height="86" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt; — green = caught / Wilson interval / forward step; grey dashed = Wald interval; blue = usable cases, the 100-case interval and device-fault tickets; red dashed = false alarms (environmental); amber = misses. Circle = point estimate." style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#f7f7f7;strokeColor=#bbbbbb;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="498" width="1240" height="30" as="geometry" /></mxCell><mxCell id="sources" value="&lt;b&gt;Sources&lt;/b&gt; — every number is loaded from ../constants.json. [n] = public (real value, cited); [n*] = illustrative (an invented round number of realistic order of magnitude; never a measurement). Wilson interval: Wilson, JASA 1927; NIST e-Handbook §7.2.4.1. Precision/recall as in Du et al., DeepLog, CCS 2017, §5.1.&lt;br/&gt;[1*] ground_truth_candidates = 60 cases — illustrative&lt;br/&gt;[2*] ground_truth_usable = 10 cases — illustrative&lt;br/&gt;[3*] ground_truth_detected = 6 cases — illustrative&lt;br/&gt;[4*] detection_rate_wilson95_6of10 = 31–83 % — illustrative; my arithmetic: Wilson score interval for 6/10 (illustrative counts)&lt;br/&gt;[5*] detection_rate_wald95_6of10 = 30–90 % — illustrative; my arithmetic: normal (Wald) interval for 6/10, clipped/rounded (illustrative counts)&lt;br/&gt;[6*] detection_rate_wilson95_60of100 = 50–69 % — illustrative; my arithmetic: Wilson score interval for 60/100 (illustrative counts)&lt;br/&gt;[7*] pilot_tickets = 10 tickets — illustrative&lt;br/&gt;[8*] pilot_environmental = 4 tickets — illustrative" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=10;spacing=6;fillColor=#fff8dc;strokeColor=#d6b656;strokeWidth=1.5;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="538" width="1240" height="134" as="geometry" /></mxCell><mxCell id="e0" value="" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="bw" target="fw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="endArrow=classic;html=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#333333;strokeWidth=2;" edge="1" parent="1" source="fw" target="ms"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l0" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560.0" y="270.0" as="sourcePoint" /><mxPoint x="840.0" y="270.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l1" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560.0" y="120.0" as="sourcePoint" /><mxPoint x="560.0" y="270.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l2" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#e6e6e6;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560.0" y="120.0" as="sourcePoint" /><mxPoint x="560.0" y="270.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l3" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560.0" y="270.0" as="sourcePoint" /><mxPoint x="560.0" y="275.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l4" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#e6e6e6;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="616.0" y="120.0" as="sourcePoint" /><mxPoint x="616.0" y="270.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="l5" value="" style="endArrow=none;startArrow=none;html=1;strokeColor=#333333;st