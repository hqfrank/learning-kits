<mxfile host="app.diagrams.net"><diagram id="p_02_socks5_connect_and_remote_dns" name="02-socks5-connect-and-remote-dns"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1083" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="With socks5h the phone, not the cloud, resolves the name: the cloud listener reads only the destination, forwards the SOCKS5 bytes unchanged, and after one success reply the stream is a plain byte pipe" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="44" as="geometry" /></mxCell><mxCell id="h_tool" value="AGENT TOOL&#10;(SOCKS5 client)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="220" height="46" as="geometry" /></mxCell><mxCell id="h_lis" value="PASSTHROUGH LISTENER&#10;localhost:10080 [I8]" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="360" y="70" width="220" height="46" as="geometry" /></mxCell><mxCell id="h_ph" value="PHONE&#10;(SOCKS5 server + resolver)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="710" y="70" width="220" height="46" as="geometry" /></mxCell><mxCell id="h_site" value="WEB SITE" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1022" y="70" width="220" height="46" as="geometry" /></mxCell><mxCell id="cloud_lab" value="cloud instance" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="30" y="122" width="300" height="18" as="geometry" /></mxCell><mxCell id="phone_lab" value="user's network" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#82b366;" vertex="1" parent="1"><mxGeometry x="660" y="122" width="300" height="18" as="geometry" /></mxCell><mxCell id="m0a" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="139" y="159" width="2" height="2" as="geometry" /></mxCell><mxCell id="m0b" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="469" y="159" width="2" height="2" as="geometry" /></mxCell><mxCell id="m1a" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="469" y="201" width="2" height="2" as="geometry" /></mxCell><mxCell id="m1b" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="139" y="201" width="2" height="2" as="geometry" /></mxCell><mxCell id="m2a" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="139" y="243" width="2" height="2" as="geometry" /></mxCell><mxCell id="m2b" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="469" y="243" width="2" height="2" as="geometry" /></mxCell><mxCell id="m3a" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="469" y="319" width="2" height="2" as="geometry" /></mxCell><mxCell id="m3b" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="819" y="319" width="2" height="2" as="geometry" /></mxCell><mxCell id="m4a" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="819" y="361" width="2" height="2" as="geometry" /></mxCell><mxCell id="m4b" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="469" y="361" width="2" height="2" as="geometry" /></mxCell><mxCell id="m5a" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="469" y="403" width="2" height="2" as="geometry" /></mxCell><mxCell id="m5b" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="819" y="403" width="2" height="2" as="geometry" /></mxCell><mxCell id="m6a" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="819" y="515" width="2" height="2" as="geometry" /></mxCell><mxCell id="m6b" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1131" y="515" width="2" height="2" as="geometry" /></mxCell><mxCell id="m7a" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="819" y="557" width="2" height="2" as="geometry" /></mxCell><mxCell id="m7b" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="469" y="557" width="2" height="2" as="geometry" /></mxCell><mxCell id="m8a" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="469" y="599" width="2" height="2" as="geometry" /></mxCell><mxCell id="m8b" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="139" y="599" width="2" height="2" as="geometry" /></mxCell><mxCell id="n_lis" value="the listener parses the destination only, for the cloud deny list (C1); the name is up to 255 octets [P7]" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=9;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="310" y="256" width="320" height="34" as="geometry" /></mxCell><mxCell id="n_ph" value="7  RESOLVES THE NAME with the phone's own resolver -&gt; the server a local user would get; destination filter on the RESOLVED address (no private ranges, ports 80/443 [I9]), then connects to that exact address" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=9;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="670" y="418" width="300" height="62" as="geometry" /></mxCell><mxCell id="pipe_a" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="139" y="643" width="2" height="2" as="geometry" /></mxCell><mxCell id="pipe_b" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1131" y="643" width="2" height="2" as="geometry" /></mxCell><mxCell id="cmp_h" value="THE ONE LETTER THAT MATTERS: the client URL decides who resolves the name (curl documentation; RFC 1928 allows both)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="680" width="1220" height="20" as="geometry" /></mxCell><mxCell id="c5" value="socks5://  -  the CLIENT resolves, in the cloud&#10;CONNECT carries ATYP 0x01 IPv4 (10 bytes) or 0x04 IPv6 (22 bytes) with an address. The DNS answer was picked for the cloud region, so the phone connects to a server far from the user: exit address and server choice disagree." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="704" width="600" height="62" as="geometry" /></mxCell><mxCell id="c5h" value="socks5h://  -  the PROXY resolves, on the phone (chosen)&#10;CONNECT carries ATYP 0x03 with the name. The phone's resolver picks the server a local user gets: exit address and server choice agree, and no separate DNS proxy is needed. The browser spells this socks5:// (it always resolves on the proxy side)." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="650" y="704" width="600" height="62" as="geometry" /></mxCell><mxCell id="fail" value="Failure replies from the phone [P6]:  0x02 = filter refused (the proxy's own policy, not the site)  |  0x04 = name did not resolve  |  0x05 = the site refused TCP  |  0x01 = general failure (also the listener's answer when the tunnel has no free stream)." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="778" width="1220" height="40" as="geometry" /></mxCell><mxCell id="legend" value="Legend: bold arrows carry the destination NAME or open a connection | green = cloud-&gt;phone path | blue lanes = cloud instance | green lanes = user's network | grey = notes. Bytes shown as hex." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="830" width="1220" height="26" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Every number is loaded from ../constants.json by the key shown. [Pn] = public (an RFC or other public document, or my arithmetic on one); [In] = illustrative (a design parameter or a round value of the right order; never a measurement of a real deployment); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/B1-socks5-in-ten-minutes.md (two exchanges, field layouts, reply codes, socks5 vs socks5h, passthrough); notes/A1-the-end-to-end-picture.md (one request end to end; browser socks5:// spelling); notes/C1-threat-model.md (filter after DNS, on the exact address). In 1 the '01' is NMETHODS = 1 and the '00' in 3 is RSV; L = name length.&#10;[P1] socks5_version = 5 VER byte (0x05). public: RFC 1928 §3&#10;[P2] socks5_methods = {no_auth: 0x00, gssapi: 0x01, username_password: 0x02, no_acceptable_methods: 0xFF} METHOD byte. public: RFC 1928 §3&#10;[P3] socks5_commands = {connect: 0x01, bind: 0x02, udp_associate: 0x03} CMD byte. public: RFC 1928 §4&#10;[P4] socks5_atyp = {ipv4: 0x01, domain: 0x03, ipv6: 0x04} ATYP byte. public: RFC 1928 §4-5&#10;[P5] socks5_message_sizes = {method_request_one_method: 3, method_reply: 2, connect_ipv4: 10, connect_ipv6: 22, connect_domain: 7 + L (L = name length), reply_ipv4: 10} bytes. public: my arithmetic from the field layouts in RFC 1928 §3-6 (VER, CMD/REP, RSV, ATYP, address, 2-byte port)&#10;[P6] socks5_reply_codes = {0x00: succeeded, 0x01: general SOCKS server failure, 0x02: connection not allowed by ruleset, 0x03: network unreachable, 0x04: host unreachable, 0x05: connection refused, 0x06: TTL expired, 0x07: command not supported, 0x08: address type not supported} REP byte. public: RFC 1928 §6&#10;[P7] socks5_domain_max_len = 255 octets. public: RFC 1928 §5: the domain name is prefixed by a one-octet length&#10;[I8] socks_listen_port_illustrative = 10080 TCP port bound to localhost. illustrative: design parameter; chosen away from socks5_conventional_port to avoid clashes with other software&#10;[I9] allowed_ports_illustrative = [80, 443] destination TCP ports allowed by the phone filter. illustrative: design parameter: the HTTP and HTTPS well-known ports only (first release)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="870" width="1220" height="197" as="geometry" /></mxCell><mxCell id="edge0" value="1  method request  0x05 01 0x00  (3 bytes) [P1][P2][P5]" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="m0a" target="m0b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="2  method reply  0x05 0x00  (2 bytes): the listener answers this itself" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="m1a" target="m1b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="3  CONNECT  0x05 0x01 00 ATYP 0x03 len name port  (7 + L bytes) [P3][P4]" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="m2a" target="m2b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="4  open a new QUIC stream; forward the original method request" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="m3a" target="m3b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="5  method reply 0x05 0x00" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="m4a" target="m4b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge5" value="6  forward the original CONNECT bytes unchanged (still the NAME)" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="m5a" target="m5b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="8  TCP connect from the phone's address" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="m6a" target="m6b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge7" value="9  reply REP 0x00 succeeded (10 bytes) [P6]" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="m7a" target="m7b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge8" value="10  reply passed to the tool unchanged" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="m8a" target="m8b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge9" value="11  TLS 1.3 + HTTP, end to end between tool and site: the QUIC stream is now a byte pipe; listener and phone see only TLS records" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1" source="pipe_a" target="pipe_b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="line0" value="" style="endArrow=none;html=0;strokeColor=#999999;strokeWidth=1.2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="116" as="sourcePoint" /><mxPoint x="140" y="664" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line1" value="" style="endArrow=none;html=0;strokeColor=#999999;strokeWidth=1.2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="116" as="sourcePoint" /><mxPoint x="470" y="256" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line2" value="" style="endArrow=none;html=0;strokeColor=#999999;strokeWidth=1.2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="116" as="sourcePoint" /><mxPoint x="820" y="418" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line3" value="" style="endArrow=none;html=0;strokeColor=#999999;strokeWidth=1.2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1132" y="116" as="sourcePoint" /><mxPoint x="1132" y="664" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line4" value="" style="endArrow=none;html=0;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="645" y="120" as="sourcePoint" /><mxPoint x="645" y="664" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line5" value="" style="endArrow=none;html=0;strokeColor=#999999;strokeWidth=1.2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="290" as="sourcePoint" /><mxPoint x="470" y="664" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line6" value="" style="endArrow=none;html=0;strokeColor=#999999;strokeWidth=1.2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="820" y="480" as="sourcePoint" /><mxPoint x="820" y="664" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>