<mxfile host="app.diagrams.net"><diagram id="p_01_two_paths" name="01-two-paths"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="750" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Two paths, both dialled by the phone: HTTPS tells it where the tunnel is and which certificate to trust; QUIC carries one stream per tool TCP connection, and the site sees the phone's address" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="44" as="geometry" /></mxCell><mxCell id="f_cloud" value="CLOUD SIDE: the agent instance sits in a private subnet" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=12;fontStyle=1;dashed=1;fillColor=none;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="560" height="420" as="geometry" /></mxCell><mxCell id="f_mid" value="PUBLIC EDGE" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=12;fontStyle=1;dashed=1;fillColor=none;strokeColor=#d79b00;strokeWidth=2;fontColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="610" y="70" width="220" height="420" as="geometry" /></mxCell><mxCell id="f_phone" value="USER'S NETWORK" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=12;fontStyle=1;dashed=1;fillColor=none;strokeColor=#82b366;strokeWidth=2;fontColor=#82b366;" vertex="1" parent="1"><mxGeometry x="850" y="70" width="240" height="420" as="geometry" /></mxCell><mxCell id="tool" value="AGENT TOOL (curl, an HTTP library)&#10;reads ALL_PROXY = socks5h://localhost:10080 [I1]&#10;set once at boot; speaks SOCKS5 to the listener; no tool code changes" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="250" height="90" as="geometry" /></mxCell><mxCell id="noproxy" value="NO_PROXY list: localhost, the metadata address 169.254.169.254 [P7], internal suffixes, the model API and cloud APIs&#10;-&gt; these never go through the phone" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="50" y="240" width="250" height="100" as="geometry" /></mxCell><mxCell id="listener" value="PASSTHROUGH LISTENER&#10;localhost:10080 [I1], always up&#10;reads CONNECT only for a deny list, then forwards the SOCKS5 bytes unchanged" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="330" y="110" width="240" height="100" as="geometry" /></mxCell><mxCell id="quic" value="QUIC SERVER  UDP :4433 [I2]&#10;private ALPN socks5-over-quic&#10;self-signed certificate made at boot&#10;opens 1 stream per tool connection" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="330" y="262" width="240" height="100" as="geometry" /></mxCell><mxCell id="api" value="ASSISTANT SERVICE API&#10;existing HTTPS chat API, user login&#10;config endpoint: host, port, fingerprint, ALPN, single-use token" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="330" y="385" width="240" height="85" as="geometry" /></mxCell><mxCell id="direct" value="SITE REACHED DIRECT&#10;from the cloud address (no phone connected, or a NO_PROXY match): sees a data-centre IP" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="630" y="105" width="180" height="115" as="geometry" /></mxCell><mxCell id="fd" value="ANYCAST UDP FRONT DOOR&#10;static public 203.0.113.x [P9]; one public port per instance from 20000-29999 [I3]; deny-by-default; does NOT filter sources" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="630" y="257" width="170" height="120" as="geometry" /></mxCell><mxCell id="htp" value="HTTPS TUNNEL PROVIDER for the control channel (TCP only: cannot carry the UDP data path)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="630" y="385" width="180" height="85" as="geometry" /></mxCell><mxCell id="nat" value="HOME OR CARRIER NAT&#10;sees only an outbound UDP flow; no port forwarding. Keepalive every 10 s [I5] stays under the 30 s NAT assumption [P6]" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="870" y="105" width="200" height="115" as="geometry" /></mxCell><mxCell id="phone" value="PHONE APP (in the foreground, during a chat)&#10;&#10;1  calls the config endpoint over HTTPS&#10;2  dials QUIC, checks the pinned fingerprint and ALPN&#10;3  SOCKS5 server: resolves the name with its own resolver&#10;4  destination filter: no private ranges; ports 80/443 [I8] only&#10;5  opens TCP from the phone's address" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="885" y="257" width="190" height="213" as="geometry" /></mxCell><mxCell id="site" value="WEB SITE&#10;sees the PHONE's address; the DNS answer was picked for the phone's location (socks5h)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1110" y="105" width="150" height="155" as="geometry" /></mxCell><mxCell id="legend" value="Legend:  green bold arrows = the data path (QUIC over UDP, then TCP from the phone)  |  purple = the control channel (HTTPS over TCP, the app's existing login)  |  grey dashed = direct connection from the cloud address  |  blue = cloud instance  |  amber = public edge  |  green boxes = user's network.  The two paths share no state. Arrows point the way each connection is dialled." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=11;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="507" width="1230" height="44" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Every number is loaded from ../constants.json by the key shown. [Pn] = public (an RFC or other public document, or my arithmetic on one); [In] = illustrative (a design parameter or a round value of the right order; never a measurement of a real deployment); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/A1-the-end-to-end-picture.md (two paths, one request, static environment, NO_PROXY, direct fallback); notes/B3-who-dials-whom.md (phone dials out, cloud opens streams, port map, no source filter, NAT keepalive); B4 (pin, ALPN); B5 (config call, token); C1 (phone destination filter). Front-door address: only the first three octets of a documentation range are shown.&#10;[I1] socks_listen_port_illustrative = 10080 TCP port bound to localhost. illustrative: design parameter; chosen away from socks5_conventional_port to avoid clashes with other software&#10;[I2] quic_listen_port_illustrative = 4433 UDP port on the cloud instance. illustrative: design parameter (a common QUIC example port)&#10;[I3] front_door_port_range_illustrative = [20000, 29999] public UDP ports on the anycast front door. illustrative: design parameter: one static public port per private instance&#10;[I4] phone_max_incoming_streams_illustrative = 64 concurrent server-initiated bidirectional streams. illustrative: design parameter: the effective concurrency cap of the whole tunnel&#10;[I5] keepalive_illustrative = 10 s. illustrative: design parameter: below udp_nat_idle_assumption and below one third of conn_idle_timeout_illustrative&#10;[P6] udp_nat_idle_assumption = 30 s. public: RFC 9308 §3.2 (applications can assume a NAT binding may expire after 30 s of inactivity)&#10;[P7] metadata_address = 169.254.169.254 IPv4 address. public: link-local address used by the instance metadata services of several public clouds (provider documentation); inside RFC 3927 169.254.0.0/16&#10;[I8] allowed_ports_illustrative = [80, 443] destination TCP ports allowed by the phone filter. illustrative: design parameter: the HTTP and HTTPS well-known ports only (first release)&#10;[P9] documentation_addresses = {ipv4: [192.0.2.0/24, 198.51.100.0/24, 203.0.113.0/24], ipv6: 2001:db8::/32} CIDR. public: RFC 5737; RFC 3849 (all example addresses in this kit come from these ranges)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="562" width="1230" height="172" as="geometry" /></mxCell><mxCell id="edge0" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="tool" target="listener"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="1 new QUIC stream per tool TCP connection (cap 64 [I4])" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="listener" target="quic"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="QUIC/UDP&#10;phone&#10;dials" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="phone" target="fd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="port map -&gt;&#10;private :4433" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="fd" target="quic"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="HTTPS" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#7b4f9e;fontColor=#7b4f9e;" edge="1" parent="1" source="phone" target="htp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge5" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#7b4f9e;fontColor=#7b4f9e;" edge="1" parent="1" source="htp" target="api"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="TCP from the&#10;phone's address" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="phone" target="site"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1185" y="290" /></Array></mxGeometry></mxCell><mxCell id="edge7" value="direct fallback" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="listener" target="direct"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>