<mxfile host="app.diagrams.net"><diagram id="p_05_trust_and_admission" name="05-trust-and-admission"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="918" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Trust in the tunnel is borrowed from the app's HTTPS login: the certificate fingerprint and a single-use token arrive over HTTPS, then the QUIC handshake must match the pin and the ALPN, and stream 0 must present the token" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="44" as="geometry" /></mxCell><mxCell id="h_srv" value="CLOUD INSTANCE&#10;QUIC server" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="66" width="220" height="42" as="geometry" /></mxCell><mxCell id="h_api" value="ASSISTANT SERVICE API&#10;(HTTPS, user login)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="390" y="66" width="220" height="42" as="geometry" /></mxCell><mxCell id="h_ph" value="PHONE APP" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="720" y="66" width="220" height="42" as="geometry" /></mxCell><mxCell id="boot" value="AT FIRST BOOT&#10;new ECDSA P-256 key in a pre-created mode-600 file; self-signed certificate, validity 5 years [I2]; SHA-256 fingerprint (32 bytes, 64 hex chars [P1]) stored for the config endpoint" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="300" height="74" as="geometry" /></mxCell><mxCell id="m0a" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="829" y="139" width="2" height="2" as="geometry" /></mxCell><mxCell id="m0b" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="499" y="139" width="2" height="2" as="geometry" /></mxCell><mxCell id="m1a" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="499" y="189" width="2" height="2" as="geometry" /></mxCell><mxCell id="m1b" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="829" y="189" width="2" height="2" as="geometry" /></mxCell><mxCell id="m2a" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="829" y="259" width="2" height="2" as="geometry" /></mxCell><mxCell id="m2b" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="169" y="259" width="2" height="2" as="geometry" /></mxCell><mxCell id="m3a" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="169" y="309" width="2" height="2" as="geometry" /></mxCell><mxCell id="m3b" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="829" y="309" width="2" height="2" as="geometry" /></mxCell><mxCell id="m4a" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="829" y="359" width="2" height="2" as="geometry" /></mxCell><mxCell id="m4b" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="169" y="359" width="2" height="2" as="geometry" /></mxCell><mxCell id="m5a" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="169" y="409" width="2" height="2" as="geometry" /></mxCell><mxCell id="m5b" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="829" y="409" width="2" height="2" as="geometry" /></mxCell><mxCell id="m6a" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="829" y="459" width="2" height="2" as="geometry" /></mxCell><mxCell id="m6b" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="169" y="459" width="2" height="2" as="geometry" /></mxCell><mxCell id="m7a" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="169" y="509" width="2" height="2" as="geometry" /></mxCell><mxCell id="m7b" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="829" y="509" width="2" height="2" as="geometry" /></mxCell><mxCell id="fails" value="HOW EACH CHECK FAILS&#10;&#10;Wrong certificate (stale front-door mapping, man in the middle): fingerprint mismatch -&gt; handshake fails; the phone shows 'failed', no traffic flows.&#10;&#10;Wrong ALPN (a scanner offering h3): TLS alert 120 [P18] -&gt; QUIC close 0x0178 = 0x0100 + 120 [P16][P19]&#10;&#10;Unsupported certificate algorithm (Ed25519 with one native phone stack): alert 40 [P17] -&gt; close 0x0128; fix: ECDSA P-256.&#10;&#10;Spoofed source address: never answers the Retry from that address -&gt; no handshake state, at most 3600 bytes sent [P9].&#10;&#10;Token reused, expired, unknown or wrong device: stream 0 answer invalid_token -&gt; fetch a new config. Previous token keeps a 5 s grace [I6] for an in-flight retry." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="960" y="120" width="290" height="330" as="geometry" /></mxCell><mxCell id="legend" value="Legend: purple = control channel (HTTPS over TCP) | green = QUIC data path | amber = address validation (Retry) | red panel = failure modes. Bold steps carry the two things the phone must match (pin, ALPN) and the one thing the server must check (token). The pin authenticates the server to the phone; the token authenticates the phone to the server." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="554" width="1220" height="42" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Every number is loaded from ../constants.json by the key shown. [Pn] = public (an RFC or other public document, or my arithmetic on one); [In] = illustrative (a design parameter or a round value of the right order; never a measurement of a real deployment); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/B4-trust-without-a-ca.md (boot-time certificate, pinning, ALPN gate, close-code decoding, rotation); notes/B5-the-control-stream.md (config call, token rules, length-prefixed hello, error codes); notes/C1-threat-model.md threats 3-4 (Retry, amplification limit, admission table). [calc]: close codes asserted equal to quic_crypto_error_base + alert; 3 x 1200 = 3600.&#10;[P1] sha256_digest = {bytes: 32, hex_chars: 64} bytes / hexadecimal characters. public: FIPS 180-4; my arithmetic for hex length&#10;[I2] cert_validity_illustrative = 5 years. illustrative: design parameter: long, because the instance lifetime bounds the key in practice&#10;[I3] config_rate_limit_illustrative = {requests: 1, per_seconds: 10} config requests per user. illustrative: design parameter&#10;[I4] token_bits_illustrative = 256 bits from a cryptographic random source. illustrative: design parameter&#10;[I5] token_lifetime_illustrative = 30 s. illustrative: design parameter: single-use connection token&#10;[I6] token_grace_illustrative = 5 s. illustrative: design parameter: the previous token stays valid this long after a new one is issued&#10;[P7] quic_min_client_initial_datagram = 1200 bytes (UDP payload). public: RFC 9000 §14.1&#10;[P8] quic_amplification_factor = 3 x bytes received from an unvalidated address. public: RFC 9000 §8.1&#10;[P9] quic_amplification_budget_one_initial = 3600 bytes. public: my arithmetic: quic_amplification_factor x quic_min_client_initial_datagram&#10;[P10] retry_integrity_tag = 128 bits. public: RFC 9001 §5.8&#10;[I11] control_length_prefix_illustrative = 4 bytes, big-endian unsigned length. illustrative: design parameter (control-stream framing)&#10;[I12] control_msg_max_illustrative = 512 bytes of JSON. illustrative: design parameter&#10;[I13] control_payload_timeout_illustrative = 3 s from length prefix to complete payload. illustrative: design parameter&#10;[I14] socks_listen_port_illustrative = 10080 TCP port bound to localhost. illustrative: design parameter; chosen away from socks5_conventional_port to avoid clashes with other software&#10;[P15] quic_first_stream_ids = {client_bidi: [0, 4, 8], server_bidi: [1, 5, 9]} stream IDs. public: my arithmetic from RFC 9000 §2.1: IDs of one type increase by 4&#10;[P16] quic_crypto_error_base = 0x0100 QUIC transport error code; CRYPTO_ERROR = 0x0100 + TLS alert. public: RFC 9000 §20.1; RFC 9001 §4.8&#10;[P17] tls_alert_handshake_failure = 40 TLS alert number. public: RFC 8446 §6&#10;[P18] tls_alert_no_application_protocol = 120 TLS alert number. public: RFC 7301 §3.2&#10;[P19] quic_close_codes_example = {handshake_failure: 0x0128, no_application_protocol: 0x0178} QUIC CONNECTION_CLOSE error code. public: my arithmetic: quic_crypto_error_base + tls_alert_handshake_failure / tls_alert_no_application_protocol" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="608" width="1220" height="294" as="geometry" /></mxCell><mxCell id="edge0" value="1  GET config, device ID in a header (rate limit 1 per 10 s [I3])" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#7b4f9e;fontColor=#7b4f9e;" edge="1" parent="1" source="m0a" target="m0b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="2  {enabled, host, port, certFingerprint, alpn, connectionToken}&#10;token: 256 random bits [I4], single use, 30 s [I5], device-bound" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#7b4f9e;fontColor=#7b4f9e;" edge="1" parent="1" source="m1a" target="m1b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="3  QUIC Initial, at least 1200 bytes [P7] (via the front door)" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="m2a" target="m2b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="4  Retry + address-validation token (128-bit integrity tag [P10]): no crypto work yet; reply budget 3 x 1200 = 3600 bytes [P8][P9]" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#d79b00;fontColor=#d79b00;" edge="1" parent="1" source="m3a" target="m3b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="5  Initial again, returning the Retry token -&gt; TLS 1.3 handshake, ALPN socks5-over-quic" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="m4a" target="m4b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge5" value="6  certificate -&gt; phone hashes the leaf DER and compares with the pin from step 2" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="m5a" target="m5b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="7  stream 0 [P15]: 4-byte length [I11] + JSON {deviceId, platform, token}  (max 512 bytes [I12], within 3 s [I13])" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="m6a" target="m6b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge7" value="8  token + device checked BEFORE attach -&gt; {socksPort: 10080} [I14], or an error code" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=0.5;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="m7a" target="m7b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="line0" value="" style="endArrow=none;html=0;strokeColor=#999999;strokeWidth=1.2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="194" as="sourcePoint" /><mxPoint x="170" y="540" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line1" value="" style="endArrow=none;html=0;strokeColor=#999999;strokeWidth=1.2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="500" y="108" as="sourcePoint" /><mxPoint x="500" y="540" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line2" value="" style="endArrow=none;html=0;strokeColor=#999999;strokeWidth=1.2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="108" as="sourcePoint" /><mxPoint x="830" y="540" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line3" value="" style="endArrow=none;html=0;strokeColor=#999999;strokeWidth=1.2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="170" y="108" as="sourcePoint" /><mxPoint x="170" y="120" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>