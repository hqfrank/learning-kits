<mxfile host="app.diagrams.net"><diagram id="p_03_deadlines_and_commit_point" name="03-deadlines-and-commit-point"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="786" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Every wait before the CONNECT reply has a deadline, so a dead phone becomes an invisible switch to a direct connection; after the reply reaches the tool the connection is committed and a failure is a reset (illustrative deadlines)" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="44" as="geometry" /></mxCell><mxCell id="axis_h" value="LISTENER STEPS FOR ONE TOOL CONNECTION. Bars are the longest wait allowed at each step, to scale (30 px per second); they are maxima, not a typical timeline." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="86" width="1220" height="20" as="geometry" /></mxCell><mxCell id="r1_l" value="steps 1-4  read method request, answer 'no auth', read CONNECT, cloud deny list, tunnel present?" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="430" height="46" as="geometry" /></mxCell><mxCell id="r1_n" value="no wait: no tunnel -&gt; direct connection now" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="470" y="120" width="780" height="46" as="geometry" /></mxCell><mxCell id="r5_l" value="step 5  open a stream to the phone [I1]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="174" width="430" height="46" as="geometry" /></mxCell><mxCell id="r5" value="8 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="470" y="182" width="240" height="32" as="geometry" /></mxCell><mxCell id="r5_n" value="stream cap 64 [I8] reached -&gt; REP 0x01 at once, no queue [P7]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="722" y="174" width="528" height="46" as="geometry" /></mxCell><mxCell id="r6_l" value="step 6  forward method request, wait for the phone's method reply (answered from memory) [I2]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="228" width="430" height="46" as="geometry" /></mxCell><mxCell id="r6" value="3 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="470" y="236" width="90" height="32" as="geometry" /></mxCell><mxCell id="r7_l" value="step 7  forward CONNECT, wait for the phone's reply [I3]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="282" width="430" height="46" as="geometry" /></mxCell><mxCell id="r7" value="20 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="470" y="290" width="600" height="32" as="geometry" /></mxCell><mxCell id="dns" value="phone DNS worst 10 s [I4]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="470" y="326" width="300" height="26" as="geometry" /></mxCell><mxCell id="pcon" value="phone TCP connect 8 s [I5]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="770" y="326" width="240" height="26" as="geometry" /></mxCell><mxCell id="sum" value="10 + 8 = 18 s [calc], under the 20 s deadline: a slow but live phone is not cut off" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1020" y="324" width="230" height="30" as="geometry" /></mxCell><mxCell id="tk0" value="0 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="372" width="40" height="16" as="geometry" /></mxCell><mxCell id="tk4" value="4 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="570" y="372" width="40" height="16" as="geometry" /></mxCell><mxCell id="tk8" value="8 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="690" y="372" width="40" height="16" as="geometry" /></mxCell><mxCell id="tk12" value="12 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="810" y="372" width="40" height="16" as="geometry" /></mxCell><mxCell id="tk16" value="16 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="930" y="372" width="40" height="16" as="geometry" /></mxCell><mxCell id="tk20" value="20 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1050" y="372" width="40" height="16" as="geometry" /></mxCell><mxCell id="tk24" value="24 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1170" y="372" width="40" height="16" as="geometry" /></mxCell><mxCell id="zone_a" value="HANDSHAKE PHASE (steps 1-7): fallback is INVISIBLE&#10;&#10;The tool has received only the 'no auth' reply and is still waiting for its CONNECT reply. If any deadline fires, the listener closes the phone stream and opens a DIRECT connection from the cloud address instead. The tool cannot tell, except by its exit address.&#10;&#10;Without these deadlines a dead phone would block each read until the QUIC idle timeout (30 s [I9])." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="432" width="600" height="112" as="geometry" /></mxCell><mxCell id="zone_b" value="RELAY (step 8): COMMITTED, failure is a RESET&#10;&#10;After the CONNECT reply the tool starts TLS through the phone; its TLS session is bound to the phone's TCP connection to the site, so no fallback is possible. An idle relay closes after 120 s [I6]; an active transfer that loses the phone gets a partial response and a reset. The tool's HTTP client retries on a new connection, which goes direct if the tunnel is gone." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="650" y="432" width="600" height="112" as="geometry" /></mxCell><mxCell id="commit" value="COMMIT POINT: CONNECT reply sent to the tool" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="545" y="396" width="190" height="30" as="geometry" /></mxCell><mxCell id="legend" value="Legend: blue bars = listener deadlines (cloud side) | green bars = the phone-side work the CONNECT deadline must cover | blue panel = invisible fallback zone | red panel = committed zone." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="558" width="1220" height="26" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Every number is loaded from ../constants.json by the key shown. [Pn] = public (an RFC or other public document, or my arithmetic on one); [In] = illustrative (a design parameter or a round value of the right order; never a measurement of a real deployment); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/C2-limits-and-failure-handling.md (handshake-phase table, the invariant, deadlines matched to the work, what the tool sees, fail fast on stream exhaustion). [calc]: 10 + 8 = 18 s.&#10;[I1] stream_open_timeout_illustrative = 8 s. illustrative: design parameter: listener waits this long to open a stream to the phone&#10;[I2] method_reply_deadline_illustrative = 3 s. illustrative: design parameter: the phone's method reply is in-memory, so a short deadline detects a dead phone quickly&#10;[I3] connect_reply_deadline_illustrative = 20 s. illustrative: design parameter: must exceed phone_dns_worst_illustrative + phone_connect_timeout_illustrative&#10;[I4] phone_dns_worst_illustrative = 10 s. illustrative: design parameter: worst legitimate resolver time with retries&#10;[I5] phone_connect_timeout_illustrative = 8 s. illustrative: design parameter: phone-side TCP connect timeout&#10;[I6] relay_idle_timeout_illustrative = 120 s without a byte in either direction. illustrative: design parameter (per relayed TCP connection)&#10;[P7] socks5_reply_codes = {0x00: succeeded, 0x01: general SOCKS server failure, 0x02: connection not allowed by ruleset, 0x03: network unreachable, 0x04: host unreachable, 0x05: connection refused, 0x06: TTL expired, 0x07: command not supported, 0x08: address type not supported} REP byte. public: RFC 1928 §6&#10;[I8] phone_max_incoming_streams_illustrative = 64 concurrent server-initiated bidirectional streams. illustrative: design parameter: the effective concurrency cap of the whole tunnel&#10;[I9] conn_idle_timeout_illustrative = 30 s. illustrative: design parameter (QUIC max_idle_timeout on both ends)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="598" width="1220" height="172" as="geometry" /></mxCell><mxCell id="edge0" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#333333;fontColor=#333333;" edge="1" parent="1" source="zone_a" target="zone_b"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="line0" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="114" as="sourcePoint" /><mxPoint x="470" y="366" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line1" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="366" as="sourcePoint" /><mxPoint x="1190" y="366" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line2" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="366" as="sourcePoint" /><mxPoint x="470" y="371" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line3" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="590" y="366" as="sourcePoint" /><mxPoint x="590" y="371" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line4" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="710" y="366" as="sourcePoint" /><mxPoint x="710" y="371" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line5" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="366" as="sourcePoint" /><mxPoint x="830" y="371" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line6" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="950" y="366" as="sourcePoint" /><mxPoint x="950" y="371" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line7" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1070" y="366" as="sourcePoint" /><mxPoint x="1070" y="371" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line8" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="366" as="sourcePoint" /><mxPoint x="1190" y="371" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>