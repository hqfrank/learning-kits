<mxfile host="app.diagrams.net"><diagram id="p_04_latency_budget" name="04-latency-budget"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="760" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Through the phone the first response byte costs about 5x (Wi-Fi) to 10x (cellular) [calc] the direct path, because every round trip after CONNECT travels cloud -&gt; phone -&gt; site and back (illustrative model)" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="44" as="geometry" /></mxCell><mxCell id="hdr" value="Time to first response byte, server time excluded. Bar length to scale: 1.25 px per ms. Segment labels give the cost of each step." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="82" width="1220" height="20" as="geometry" /></mxCell><mxCell id="l0" value="direct from the cloud (no phone)&#10;total 60 ms [I5]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="108" width="380" height="50" as="geometry" /></mxCell><mxCell id="b0_0" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="420" y="112" width="25" height="42" as="geometry" /></mxCell><mxCell id="b0_1" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="445" y="112" width="25" height="42" as="geometry" /></mxCell><mxCell id="b0_2" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="470" y="112" width="25" height="42" as="geometry" /></mxCell><mxCell id="dlab" value="TCP 20 + TLS 1.3 20 + HTTP 20  (each one RTTcs: the cloud talks to the site directly)" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="505" y="112" width="600" height="42" as="geometry" /></mxCell><mxCell id="l1" value="via phone, Wi-Fi&#10;total 320 ms [I5]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="170" width="380" height="50" as="geometry" /></mxCell><mxCell id="b1_0" value="SOCKS5 method&#10;50" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="420" y="174" width="62" height="42" as="geometry" /></mxCell><mxCell id="b1_1" value="CONNECT&#10;RTTcp + DNS + RTTps = 110" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="482" y="174" width="138" height="42" as="geometry" /></mxCell><mxCell id="b1_2" value="TLS 1.3&#10;RTTcp + RTTps = 80" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="620" y="174" width="100" height="42" as="geometry" /></mxCell><mxCell id="b1_3" value="HTTP req/resp&#10;RTTcp + RTTps = 80" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="720" y="174" width="100" height="42" as="geometry" /></mxCell><mxCell id="l2" value="via phone, Wi-Fi, pipelined (not used by the source)&#10;total 270 ms [I5]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="232" width="380" height="50" as="geometry" /></mxCell><mxCell id="b2_0" value="CONNECT&#10;RTTcp + DNS + RTTps = 110" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;dashed=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="420" y="236" width="138" height="42" as="geometry" /></mxCell><mxCell id="b2_1" value="TLS 1.3&#10;RTTcp + RTTps = 80" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;dashed=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="558" y="236" width="100" height="42" as="geometry" /></mxCell><mxCell id="b2_2" value="HTTP req/resp&#10;RTTcp + RTTps = 80" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;dashed=1;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="658" y="236" width="100" height="42" as="geometry" /></mxCell><mxCell id="l3" value="via phone, cellular&#10;total 600 ms [I5]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="294" width="380" height="50" as="geometry" /></mxCell><mxCell id="b3_0" value="SOCKS5 method&#10;RTTcp = 120" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="420" y="298" width="150" height="42" as="geometry" /></mxCell><mxCell id="b3_1" value="CONNECT&#10;RTTcp + DNS + RTTps = 180" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="570" y="298" width="225" height="42" as="geometry" /></mxCell><mxCell id="b3_2" value="TLS 1.3&#10;RTTcp + RTTps = 150" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="795" y="298" width="188" height="42" as="geometry" /></mxCell><mxCell id="b3_3" value="HTTP req/resp&#10;RTTcp + RTTps = 150" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="983" y="298" width="188" height="42" as="geometry" /></mxCell><mxCell id="l4" value="via phone, cellular, pipelined (not used by the source)&#10;total 480 ms [I5]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=11;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="356" width="380" height="50" as="geometry" /></mxCell><mxCell id="b4_0" value="CONNECT&#10;RTTcp + DNS + RTTps = 180" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;dashed=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="420" y="360" width="225" height="42" as="geometry" /></mxCell><mxCell id="b4_1" value="TLS 1.3&#10;RTTcp + RTTps = 150" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;dashed=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="645" y="360" width="188" height="42" as="geometry" /></mxCell><mxCell id="b4_2" value="HTTP req/resp&#10;RTTcp + RTTps = 150" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;dashed=1;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="833" y="360" width="188" height="42" as="geometry" /></mxCell><mxCell id="t0" value="0 ms" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="395" y="424" width="50" height="16" as="geometry" /></mxCell><mxCell id="t100" value="100 ms" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="520" y="424" width="50" height="16" as="geometry" /></mxCell><mxCell id="t200" value="200 ms" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="645" y="424" width="50" height="16" as="geometry" /></mxCell><mxCell id="t300" value="300 ms" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="770" y="424" width="50" height="16" as="geometry" /></mxCell><mxCell id="t400" value="400 ms" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="895" y="424" width="50" height="16" as="geometry" /></mxCell><mxCell id="t500" value="500 ms" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1020" y="424" width="50" height="16" as="geometry" /></mxCell><mxCell id="t600" value="600 ms" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1145" y="424" width="50" height="16" as="geometry" /></mxCell><mxCell id="inputs" value="INPUTS (all illustrative round values)&#10;RTTcp cloud&lt;-&gt;phone: Wi-Fi 50 ms, cellular 120 ms [I1]&#10;RTTps phone&lt;-&gt;site: 30 ms [I2]&#10;DNS on the phone: 30 ms [I4]&#10;RTTcs cloud&lt;-&gt;site: 20 ms [I3]" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="452" width="600" height="80" as="geometry" /></mxCell><mxCell id="why" value="READING IT&#10;- The two SOCKS5 exchanges add RTTcp each; DNS moves to the phone.&#10;- Direct = TCP + TLS 1.3 handshakes (2 round trips [P6]) + one HTTP exchange.&#10;- Pipelining: the phone always picks 'no auth', so the listener could send method request and CONNECT together and save one RTTcp (dashed bars; an idea the source does not use)." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="650" y="452" width="600" height="80" as="geometry" /></mxCell><mxCell id="legend" value="Legend: amber = SOCKS5 method exchange | green = CONNECT (includes phone DNS and the phone's TCP connect) | blue = TLS 1.3 handshake | white = HTTP exchange | grey = direct TCP | dashed = pipelined variant." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="544" width="1220" height="26" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Every number is loaded from ../constants.json by the key shown. [Pn] = public (an RFC or other public document, or my arithmetic on one); [In] = illustrative (a design parameter or a round value of the right order; never a measurement of a real deployment); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/A1-the-end-to-end-picture.md (latency model table, pipelining idea); notes/B2-quic-for-this-job.md (handshake round trips). [calc]: segment costs from the inputs; each row sum is asserted equal to ttfb_model_illustrative; ratios 320 / 60 = 5.3 and 600 / 60 = 10.0. The kit's latency targets (latency_target_illustrative) are not drawn: the illustrative Wi-Fi p50 target sits below this modelled floor, so the two illustrative values do not agree.&#10;[I1] rtt_cloud_phone_illustrative = {wifi: 50, cellular: 120} ms. illustrative: round round-trip times between a cloud region and a phone&#10;[I2] rtt_phone_site_illustrative = 30 ms. illustrative: round RTT from the phone's network to a nearby site&#10;[I3] rtt_cloud_site_illustrative = 20 ms. illustrative: round RTT from a cloud region to a site&#10;[I4] phone_dns_typical_illustrative = 30 ms. illustrative: round resolver time on the phone&#10;[I5] ttfb_model_illustrative = {wifi: 320, cellular: 600, wifi_pipelined: 270, cellular_pipelined: 480, direct_from_cloud: 60} ms to first response byte (server time excluded). illustrative: my arithmetic in A1 from the rtt_* and phone_dns_typical_illustrative values: method 1 x RTTcp + CONNECT (RTTcp + DNS + RTTps) + TLS 1.3 (RTTcp + RTTps) + HTTP (RTTcp + RTTps); pipelined removes one RTTcp; direct = 3 x RTTcs&#10;[P6] quic_handshake_round_trips = {quic_tls13_new: 1, quic_0rtt_resumed: 0, tcp_plus_tls13: 2, tcp_plus_tls12: 3} round trips before application data. public: RFC 9000 §7 and RFC 9001 §4; RFC 8446 §2 (TLS 1.3 1-RTT); TCP three-way handshake (RFC 9293) adds one; my arithmetic for the sums" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="584" width="1220" height="160" as="geometry" /></mxCell><mxCell id="line0" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="104" as="sourcePoint" /><mxPoint x="420" y="418" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line1" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="418" as="sourcePoint" /><mxPoint x="1232.5" y="418" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line2" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420.0" y="418" as="sourcePoint" /><mxPoint x="420.0" y="423" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line3" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="545.0" y="418" as="sourcePoint" /><mxPoint x="545.0" y="423" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line4" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="670.0" y="418" as="sourcePoint" /><mxPoint x="670.0" y="423" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line5" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="795.0" y="418" as="sourcePoint" /><mxPoint x="795.0" y="423" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line6" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="920.0" y="418" as="sourcePoint" /><mxPoint x="920.0" y="423" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line7" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1045.0" y="418" as="sourcePoint" /><mxPoint x="1045.0" y="423" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line8" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1170.0" y="418" as="sourcePoint" /><mxPoint x="1170.0" y="423" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>