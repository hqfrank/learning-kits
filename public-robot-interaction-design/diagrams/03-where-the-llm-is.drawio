<mxfile host="app.diagrams.net"><diagram id="p_03_where_the_llm_is" name="03-where-the-llm-is"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="944" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Only ONE box in the stack is a language model: perception, the engage trigger, the body and the gaze are plain code that unit tests can prove; the model's behaviour can only be measured live" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="46" as="geometry" /></mxCell><mxCell id="mic" value="MICROPHONE ARRAY&#10;audio in" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="104" width="160" height="58" as="geometry" /></mxCell><mxCell id="cam" value="HEAD CAMERA&#10;frames stay inside the stand" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="262" width="160" height="58" as="geometry" /></mxCell><mxCell id="percep" value="VISITOR PERCEPTION - not an LLM&#10;small vision and audio models: face detector, face embedding (anonymous session id), active-speaker detection, voice embedding; direction-of-arrival fusion; state machine absent -&gt; arming -&gt; engaged" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="240" y="222" width="250" height="126" as="geometry" /></mxCell><mxCell id="trigger" value="ENGAGE TRIGGER - not an LLM&#10;one deterministic edge: 'engaged' -&gt; one system message to greet. Cooldown, re-arm on idle, wake-word precedence, fail closed if perception is stale" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="240" y="404" width="250" height="92" as="geometry" /></mxCell><mxCell id="reasoner" value="THE REASONER - the only LLM&#10;a realtime speech-to-speech session: audio in and out, server-side VAD, function calling; the only 'vision' is a camera frame per utterance.&#10;&#10;Wrapped by: a local wake-word gate; TRIAGE (a per-utterance LLM decision: accept or ignore); a barge-in guard; context compaction; tracing.&#10;Behaviour lives in prompt files: base identity and safety &lt;- stand profile &lt;- one file per ability" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="560" y="78" width="320" height="206" as="geometry" /></mxCell><mxCell id="spk" value="LOUDSPEAKER&#10;robot voice out" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="640" y="336" width="160" height="46" as="geometry" /></mxCell><mxCell id="behav" value="BEHAVIOUR LIBRARY - not an LLM&#10;a behaviour tree at 100 Hz [I1] with blended priority layers; face lights, eyebrows and a nod follow the voice output level" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="950" y="78" width="300" height="100" as="geometry" /></mxCell><mxCell id="gaze" value="GAZE CONTROLLER - not an LLM&#10;active-speaker bearing -&gt; gaze policy -&gt; head-pose command (diagram 05)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="950" y="230" width="300" height="86" as="geometry" /></mxCell><mxCell id="gw" value="ROBOT GATEWAY - not an LLM&#10;the only component that talks to the robot middleware; a few intent verbs: speak, play pose, look at, hand over, cancel, health" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="950" y="376" width="300" height="92" as="geometry" /></mxCell><mxCell id="rails_h" value="TWO DESIGNS IN THE SOURCES" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="520" width="600" height="20" as="geometry" /></mxCell><mxCell id="rt0a" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fontStyle=1;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="544" width="150" height="24" as="geometry" /></mxCell><mxCell id="rt0b" value="on-rails (designed first)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="180" y="544" width="225" height="24" as="geometry" /></mxCell><mxCell id="rt0c" value="speech-to-speech (as built)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="405" y="544" width="225" height="24" as="geometry" /></mxCell><mxCell id="rt1a" value="where the LLM sits" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="568" width="150" height="24" as="geometry" /></mxCell><mxCell id="rt1b" value="inside one beat, fixed intents and output schema" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="180" y="568" width="225" height="24" as="geometry" /></mxCell><mxCell id="rt1c" value="the voice AND the sequencer" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="405" y="568" width="225" height="24" as="geometry" /></mxCell><mxCell id="rt2a" value="robustness in noise" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="592" width="150" height="24" as="geometry" /></mxCell><mxCell id="rt2b" value="high" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="180" y="592" width="225" height="24" as="geometry" /></mxCell><mxCell id="rt2c" value="lower" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="405" y="592" width="225" height="24" as="geometry" /></mxCell><mxCell id="rt3a" value="latency" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="616" width="150" height="24" as="geometry" /></mxCell><mxCell id="rt3b" value="near zero for canned lines" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="180" y="616" width="225" height="24" as="geometry" /></mxCell><mxCell id="rt3c" value="one model round trip" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="405" y="616" width="225" height="24" as="geometry" /></mxCell><mxCell id="rt4a" value="auditability" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="640" width="150" height="24" as="geometry" /></mxCell><mxCell id="rt4b" value="every line enumerable, testable in CI" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="180" y="640" width="225" height="24" as="geometry" /></mxCell><mxCell id="rt4c" value="not enumerable: safety is measured" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="405" y="640" width="225" height="24" as="geometry" /></mxCell><mxCell id="rt5a" value="charm" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="664" width="150" height="24" as="geometry" /></mxCell><mxCell id="rt5b" value="repetitive without pools" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="180" y="664" width="225" height="24" as="geometry" /></mxCell><mxCell id="rt5c" value="varied" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="405" y="664" width="225" height="24" as="geometry" /></mxCell><mxCell id="rails_n" value="Likely posture under crowd noise: a hybrid (canned openers, live follow-ups). A voice pack of pre-rendered lines is always the floor." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="692" width="600" height="34" as="geometry" /></mxCell><mxCell id="lad_h" value="AUTOMATIC, FAIL-CLOSED AUDIO LADDER (each step down is more robust)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="660" y="520" width="590" height="20" as="geometry" /></mxCell><mxCell id="st0" value="1  open microphone, full duplex (listens while speaking)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="660" y="546" width="590" height="34" as="geometry" /></mxCell><mxCell id="st1" value="2  half duplex: microphone closed while the robot speaks" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="700" y="586" width="550" height="34" as="geometry" /></mxCell><mxCell id="st2" value="3  push-to-talk" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="740" y="626" width="510" height="34" as="geometry" /></mxCell><mxCell id="st3" value="4  canned lines + gestures driven by a hidden operator (Wizard-of-Oz floor): the visitor cannot tell" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="780" y="666" width="470" height="34" as="geometry" /></mxCell><mxCell id="lad_n" value="A cloud call is never awaited on the critical path: a stall falls back to a canned line from the beat's pool." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="660" y="708" width="590" height="34" as="geometry" /></mxCell><mxCell id="inv" value="DESIGN INVARIANTS. Camera data stays inside the stand; only bearings, flags and actions cross to the robot.  Visitor context enriches conversation, never control: mood may shape a line, never a state transition.  A safety supervisor sits above the state machine and pre-empts any state.  Free conversation stays off the gateway seam.  The reasoner never returns to idle by itself: consumers infer 'conversation over', e.g. after 5 s of quiet listening [I2].  Exactly one publisher of the reasoner state." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="738" width="1220" height="46" as="geometry" /></mxCell><mxCell id="legend" value="Legend: purple, thick border = the one language model (and its prompt-owned behaviour) | blue = perception and trigger (plain code) | green = body and gaze | grey = sensors, speaker, gateway | purple arrows = model output, blue = perception output, green = motion commands." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="802" width="1220" height="26" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Every number is loaded from ../constants.json by the key shown. [Pn] = public (a paper, standard or physics value, or my arithmetic on one); [In] = illustrative (a round design value of the right order; never a measurement of a real robot or visitor); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/B1-the-voice-pipeline.md (components as built, one visitor end to end, on-rails versus open conversation, reasoner as sequencer, degradation, design invariants, 'how it is designed and tested'); Wizard-of-Oz after Kelley 1984; cascade and speech-to-speech designs after Skantze 2021 (both cited in B1).&#10;[I1] behaviour_tick_illustrative = 100 Hz. illustrative behaviour-library update rate&#10;[I2] wind_down_quiet_illustrative = 5 s. illustrative quiet-listening time after which a supervisor infers 'conversation over'" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="842" width="1220" height="86" as="geometry" /></mxCell><mxCell id="edge0" value="audio, through a local wake-word gate" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.16;entryDx=0;entryDy=0;strokeColor=#7b4f9e;fontColor=#7b4f9e;" edge="1" parent="1" source="mic" target="reasoner"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="audio for DoA and voice" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;strokeColor=#3d6aa3;fontColor=#3d6aa3;" edge="1" parent="1" source="mic" target="percep"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="110" y="200" /><mxPoint x="290" y="200" /></Array></mxGeometry></mxCell><mxCell id="edge2" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.65;entryDx=0;entryDy=0;strokeColor=#3d6aa3;fontColor=#3d6aa3;" edge="1" parent="1" source="cam" target="percep"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="engaged" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#3d6aa3;fontColor=#3d6aa3;" edge="1" parent="1" source="percep" target="trigger"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="one system message: greet" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.1;entryY=1;entryDx=0;entryDy=0;strokeColor=#3d6aa3;fontColor=#3d6aa3;" edge="1" parent="1" source="trigger" target="reasoner"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="592" y="450" /></Array></mxGeometry></mxCell><mxCell id="edge5" value="speaker labels, evidence for triage" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.18;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;strokeColor=#3d6aa3;fontColor=#3d6aa3;" edge="1" parent="1" source="percep" target="reasoner"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="active-speaker bearing" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.62;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="percep" target="gaze"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge7" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#7b4f9e;fontColor=#7b4f9e;" edge="1" parent="1" source="reasoner" target="spk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge8" value="gesture tool call; returns on completion" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;strokeColor=#7b4f9e;fontColor=#7b4f9e;" edge="1" parent="1" source="reasoner" target="behav"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge9" value="state: accepted speaker = addressee" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;strokeColor=#7b4f9e;fontColor=#7b4f9e;" edge="1" parent="1" source="reasoner" target="gaze"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge10" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="behav" target="gw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1266" y="128" /><mxPoint x="1266" y="422" /></Array></mxGeometry></mxCell><mxCell id="edge11" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="gaze" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>