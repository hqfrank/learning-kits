<mxfile host="app.diagrams.net"><diagram id="p_02_dwell_budget" name="02-dwell-budget"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1160" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Beats add up to a dwell time, dwell plus reset is the cycle, and the cycle sets visitors per hour: 80 s [I1] + 20 s [I2] = 100 s [I3] -&gt; 36 per hour [I4] in theory, about 25 [I5] in a real queue (illustrative budget)" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="46" as="geometry" /></mxCell><mxCell id="a_h" value="A. ONE VISIT AS TIMED BEATS, to scale (5.6 px per second). Each bar starts where the previous beat ends." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="72" width="1220" height="20" as="geometry" /></mxCell><mxCell id="l_beat_greet_illustrative" value="greet: look up, wave, one short line: 6 s [I6]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="108" width="340" height="22" as="geometry" /></mxCell><mxCell id="b_beat_greet_illustrative" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="111" width="33" height="18" as="geometry" /></mxCell><mxCell id="l_beat_reply_window_illustrative" value="reply window: listening armed after the line ends: 12 s [I7]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="132" width="340" height="22" as="geometry" /></mxCell><mxCell id="b_beat_reply_window_illustrative" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="413" y="135" width="67" height="18" as="geometry" /></mxCell><mxCell id="l_beat_converse_illustrative" value="converse: a few turns (largest, most variable): 35 s [I8]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="156" width="340" height="22" as="geometry" /></mxCell><mxCell id="b_beat_converse_illustrative" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="480" y="159" width="196" height="18" as="geometry" /></mxCell><mxCell id="l_beat_offer_illustrative" value="offer: self-serve gift, includes the take timer: 15 s [I9]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="180" width="340" height="22" as="geometry" /></mxCell><mxCell id="b_beat_offer_illustrative" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="676" y="183" width="84" height="18" as="geometry" /></mxCell><mxCell id="l_beat_celebrate_illustrative" value="celebrate: 8 s [I10]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="204" width="340" height="22" as="geometry" /></mxCell><mxCell id="b_beat_celebrate_illustrative" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="207" width="44" height="18" as="geometry" /></mxCell><mxCell id="l_beat_goodbye_illustrative" value="goodbye: 4 s [I11]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="228" width="340" height="22" as="geometry" /></mxCell><mxCell id="b_beat_goodbye_illustrative" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="805" y="231" width="22" height="18" as="geometry" /></mxCell><mxCell id="l_reset_turnover_illustrative" value="reset and turnover (pure overhead): 20 s [I2]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="252" width="340" height="22" as="geometry" /></mxCell><mxCell id="b_reset_turnover_illustrative" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="828" y="255" width="112" height="18" as="geometry" /></mxCell><mxCell id="l_take" value="inside the offer: no-take timer 12 s [I12]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="276" width="340" height="22" as="geometry" /></mxCell><mxCell id="b_take" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;dashed=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="676" y="282" width="67" height="12" as="geometry" /></mxCell><mxCell id="l_turn" value="inside converse: one visitor turn is capped at 10 s [I13]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="340" height="22" as="geometry" /></mxCell><mxCell id="b_turn" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;dashed=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="480" y="306" width="56" height="12" as="geometry" /></mxCell><mxCell id="l_typ" value="typical interaction = sum of the six beats: 80 s [I1] [calc]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="330" width="340" height="22" as="geometry" /></mxCell><mxCell id="b_typ" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="333" width="448" height="18" as="geometry" /></mxCell><mxCell id="l_cyc" value="cycle = interaction + reset: 100 s [I3] [calc]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="354" width="340" height="22" as="geometry" /></mxCell><mxCell id="b_cyc" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="357" width="560" height="18" as="geometry" /></mxCell><mxCell id="l_ina" value="global inactivity timeout (any beat -&gt; goodbye): 45 s [I14]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="378" width="340" height="22" as="geometry" /></mxCell><mxCell id="b_ina" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;dashed=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="381" width="251" height="18" as="geometry" /></mxCell><mxCell id="l_cap" value="'chatty visitor' cap and session-lease maximum: 150 s [I15]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="402" width="340" height="22" as="geometry" /></mxCell><mxCell id="b_cap" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;dashed=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="405" width="840" height="18" as="geometry" /></mxCell><mxCell id="tk0" value="0 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="360" y="436" width="40" height="16" as="geometry" /></mxCell><mxCell id="tk25" value="25 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="500" y="436" width="40" height="16" as="geometry" /></mxCell><mxCell id="tk50" value="50 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="640" y="436" width="40" height="16" as="geometry" /></mxCell><mxCell id="tk75" value="75 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="780" y="436" width="40" height="16" as="geometry" /></mxCell><mxCell id="tk100" value="100 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="920" y="436" width="40" height="16" as="geometry" /></mxCell><mxCell id="tk125" value="125 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1060" y="436" width="40" height="16" as="geometry" /></mxCell><mxCell id="tk150" value="150 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1200" y="436" width="40" height="16" as="geometry" /></mxCell><mxCell id="note_a" value="Timeouts are failsafes set ABOVE the intended length, not targets.&#10;&#10;The greet line is short on purpose: the reply window opens only when it ends, so a longer greeting delays the visitor's natural reply." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="970" y="108" width="280" height="96" as="geometry" /></mxCell><mxCell id="b_h" value="B. THE ARITHMETIC RUNS BOTH WAYS: the cycle sets the queue, and the queue sets how long any beat may be." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="464" width="1220" height="20" as="geometry" /></mxCell><mxCell id="c1" value="cycle&#10;100 s [I3]" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="490" width="150" height="58" as="geometry" /></mxCell><mxCell id="c2" value="3600 s / cycle&#10;= 36 visitors per hour [I4] [calc]" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="197" y="490" width="200" height="58" as="geometry" /></mxCell><mxCell id="c3" value="x queue friction 0.7 [I16]&#10;= about 25 per hour [I5] [calc]" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="414" y="490" width="250" height="58" as="geometry" /></mxCell><mxCell id="c4" value="x show day 6 h [I17]&#10;= about 150 visits per day [I18] [calc]" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="681" y="490" width="250" height="58" as="geometry" /></mxCell><mxCell id="c5" value="feeds other gates: endurance gate 150 cycles without intervention [I19]; gift tray and refill cadence must keep up" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="948" y="490" width="300" height="58" as="geometry" /></mxCell><mxCell id="b_note" value="Throughput is 3600 divided by the CYCLE, not by the dwell: the reset counts. Need more visitors per hour? Cap the converse beat (largest, most variable) or shorten the reset; every second removed from the reset returns to visitors. Report the dwell distribution (median and a high percentile), not only the mean: the cap exists for the tail." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="558" width="1220" height="36" as="geometry" /></mxCell><mxCell id="c_h" value="C. THE RESPONSIVENESS BUDGET: from the visitor's consent action to a VISIBLE listening signal, every stage named (to scale, ms)." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="608" width="1220" height="20" as="geometry" /></mxCell><mxCell id="l_det" value="budget 500 ms [I20] = detection 300 ms [I21] + permit, audio gate, indicator 200 ms [I22]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="674" width="340" height="28" as="geometry" /></mxCell><mxCell id="m_det" value="detect" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="678" width="245" height="22" as="geometry" /></mxCell><mxCell id="m_sig" value="permit + gate + light" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="625" y="678" width="164" height="22" as="geometry" /></mxCell><mxCell id="mt0" value="0 ms" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="350" y="720" width="60" height="16" as="geometry" /></mxCell><mxCell id="mt200" value="200 ms" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="514" y="720" width="60" height="16" as="geometry" /></mxCell><mxCell id="mt400" value="400 ms" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="678" y="720" width="60" height="16" as="geometry" /></mxCell><mxCell id="mt600" value="600 ms" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="842" y="720" width="60" height="16" as="geometry" /></mxCell><mxCell id="mt800" value="800 ms" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1006" y="720" width="60" height="16" as="geometry" /></mxCell><mxCell id="mt1000" value="1000 ms" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1170" y="720" width="60" height="16" as="geometry" /></mxCell><mxCell id="rf100" value="0.1 s feels instant [P23]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="466" y="638" width="230" height="16" as="geometry" /></mxCell><mxCell id="rf200" value="typical human turn gap 200 ms [P24]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#7b4f9e;" vertex="1" parent="1"><mxGeometry x="548" y="654" width="230" height="16" as="geometry" /></mxCell><mxCell id="rf1000" value="1 s flow-of-thought limit [P25]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="966" y="654" width="230" height="16" as="geometry" /></mxCell><mxCell id="c_note" value="The robot need not match humans, but each stage is measured on the real robot and network." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="806" y="676" width="385" height="30" as="geometry" /></mxCell><mxCell id="legend" value="Legend: solid bars = planned beat lengths | dashed bars = timers and caps (failsafes) | dashed vertical lines = totals (A) or public reference limits (C). All robot durations are illustrative design values, not measurements." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="749" width="1220" height="26" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Every number is loaded from ../constants.json by the key shown. [Pn] = public (a paper, standard or physics value, or my arithmetic on one); [In] = illustrative (a round design value of the right order; never a measurement of a real robot or visitor); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/A2-beats-and-dwell-budget.md (budget table, from beats to throughput, short beats that start early, the responsiveness budget, 'throughput is 3600 divided by the cycle'); C2 for the endurance gate. [calc]: 80 = sum of six beats; 80 + 20 = 100 s; 3600 / 100 = 36 per hour; 36 x 0.7 = 25 (rounded); 25 x 6 h = 150 visits; 300 + 200 = 500 ms.&#10;[I1] interaction_typical_illustrative = 80 s. illustrative: my arithmetic: sum of the six beat_*_illustrative values&#10;[I2] reset_turnover_illustrative = 20 s. illustrative time to reset and let the next visitor step up&#10;[I3] cycle_illustrative = 100 s. illustrative: my arithmetic: interaction_typical_illustrative + reset_turnover_illustrative&#10;[I4] throughput_theoretical_illustrative = 36 visitors per hour. illustrative: my arithmetic: 3600 s / cycle_illustrative&#10;[I5] throughput_realistic_illustrative = 25 visitors per hour. illustrative: my arithmetic: throughput_theoretical_illustrative x queue_friction_factor_illustrative, rounded&#10;[I6] beat_greet_illustrative = 6 s. illustrative beat length&#10;[I7] beat_reply_window_illustrative = 12 s. illustrative listening-armed window after the greeting&#10;[I8] beat_converse_illustrative = 35 s. illustrative conversation beat (a few turns)&#10;[I9] beat_offer_illustrative = 15 s. illustrative self-serve gift offer including the take timer&#10;[I10] beat_celebrate_illustrative = 8 s. illustrative&#10;[I11] beat_goodbye_illustrative = 4 s. illustrative&#10;[I12] take_timer_illustrative = 12 s. illustrative no-take timeout inside beat_offer_illustrative&#10;[I13] per_turn_cap_illustrative = 10 s. illustrative cap on one visitor turn&#10;[I14] inactivity_timeout_illustrative = 45 s. illustrative global inactivity timeout&#10;[I15] interaction_cap_illustrative = 150 s. illustrative 'chatty visitor' cap and session-lease maximum&#10;[I16] queue_friction_factor_illustrative = 0.7 dimensionless. illustrative discount for crowd and queue friction&#10;[I17] show_day_illustrative = 6 h. illustrative show day&#10;[I18] visits_per_day_illustrative = 150 visits. illustrative: my arithmetic: throughput_realistic_illustrative x show_day_illustrative&#10;[I19] consecutive_cycles_gate_illustrative = 150 visitor cycles without intervention. illustrative launch gate&#10;[I20] listening_indicator_budget_illustrative = 500 ms from consent action to visible listening signal. illustrative design budget; chosen below response_limit_flow&#10;[I21] listening_indicator_detect_illustrative = 300 ms (detection share of the budget). illustrative split of listening_indicator_budget_illustrative&#10;[I22] listening_indicator_signal_illustrative = 200 ms (permit + gate + indicator share). illustrative split; sums with listening_indicator_detect_illustrative to the budget&#10;[P23] response_limit_instant = 0.1 s. public: Nielsen 1993, ch. 5&#10;[P24] turn_gap_typical = 200 ms. public: Stivers et al., 'Universals and cultural variation in turn-taking in conversation', PNAS 106(26), 2009: offsets between turns cluster around a short gap of about 200 ms across 10 languages&#10;[P25] response_limit_flow = 1 s. public: Nielsen, Usability Engineering, 1993, ch. 5: about 1 s is the limit for the user's flow of thought to stay uninterrupted; 0.1 s feels instantaneous; 10 s loses attention" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="789" width="1220" height="355" as="geometry" /></mxCell><mxCell id="edge0" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#3d6aa3;fontColor=#3d6aa3;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#3d6aa3;fontColor=#3d6aa3;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#3d6aa3;fontColor=#3d6aa3;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#3d6aa3;fontColor=#3d6aa3;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="line0" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="104" as="sourcePoint" /><mxPoint x="380" y="430" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line1" value="" style="endArrow=none;html=