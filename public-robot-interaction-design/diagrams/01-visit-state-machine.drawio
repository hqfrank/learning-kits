<mxfile host="app.diagrams.net"><diagram id="p_01_visit_state_machine" name="01-visit-state-machine"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="800" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="A visit is a small state machine: every offering hangs off one hub and is offered at most once, so every visit provably ends; the language model only supplies the words inside each state (3 illustrative offerings [I1])" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="46" as="geometry" /></mxCell><mxCell id="chat" value="CHAT&#10;offering 1" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="90" width="125" height="58" as="geometry" /></mxCell><mxCell id="gift" value="A SMALL GIFT&#10;offering 2 (self-serve)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="520" y="90" width="125" height="58" as="geometry" /></mxCell><mxCell id="photo" value="A PHOTO&#10;offering 3 (visitor's phone)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="660" y="90" width="125" height="58" as="geometry" /></mxCell><mxCell id="waiting" value="WAITING&#10;(attract posture)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="255" width="135" height="64" as="geometry" /></mxCell><mxCell id="arrival" value="ARRIVAL&#10;generic hello, never the last word: always followed by one specific thing" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="205" y="240" width="190" height="94" as="geometry" /></mxCell><mxCell id="hub" value="OFFER HUB&#10;the robot raises ONE offering, or the visitor asks for one; all offerings are equals" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="240" width="200" height="94" as="geometry" /></mxCell><mxCell id="celebrate" value="CELEBRATE&#10;a reaction, brief; only with something safe now, else skip silently" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="700" y="255" width="160" height="70" as="geometry" /></mxCell><mxCell id="noans" value="NO ANSWER&#10;name one SPECIFIC thing (never an open 'what would you like?')" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="390" width="200" height="70" as="geometry" /></mxCell><mxCell id="talk" value="JUST TALKING&#10;repeated decline or 'I'm fine': offering stops, the robot stays warm" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="690" y="390" width="170" height="70" as="geometry" /></mxCell><mxCell id="closing" value="CLOSING&#10;goodbye; every offering mentioned at least once" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="520" width="200" height="58" as="geometry" /></mxCell><mxCell id="reset" value="RESET (close the visit)&#10;confirmed stop of speech and motion, then delete ALL per-visit state" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="205" y="510" width="190" height="78" as="geometry" /></mxCell><mxCell id="staff" value="NEEDS STAFF&#10;reset could not be confirmed: no new visit on top" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="515" width="135" height="68" as="geometry" /></mxCell><mxCell id="arr_note" value="Steps out of view and returns within a short window = the SAME visit: no fresh hello, no repeated offers." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="205" y="340" width="190" height="60" as="geometry" /></mxCell><mxCell id="hub_note" value="each offering returns to the hub; offerings never connect to each other" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="380" y="72" width="420" height="18" as="geometry" /></mxCell><mxCell id="g_walk" value="GLOBAL: the visitor walks away -&gt; CLOSING, from any state. A silence is not a departure; a departure is never answered as a silence." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="610" width="405" height="44" as="geometry" /></mxCell><mxCell id="g_safe" value="GLOBAL: SAFETY PAUSE pre-empts every state and stays stopped until staff clear it; the hardware power cut is never a software call." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="610" width="410" height="44" as="geometry" /></mxCell><mxCell id="inv_h" value="THE RULES THAT MUST ALWAYS HOLD (invariants)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="885" y="70" width="365" height="28" as="geometry" /></mxCell><mxCell id="inv" value="1  The robot offers first: the visit never depends on the visitor knowing what to ask.&#10;2  Silence never strands the visit: name one specific thing.&#10;3  One thing at a time: one offering per turn, never a list (unless asked 'what can you do?').&#10;4  A no is a no: a declined offering is not raised again; a repeated decline stops all offering.&#10;5  Nothing stays a secret: every offering is MENTIONED once before goodbye (unless the visitor left, declined or asked to stop).&#10;6  Offering always runs out: each offering is OFFERED at most once, so the visit terminates.&#10;7  Celebration is a reaction, never a request, and never reopens what 4 or 6 closed.&#10;8  The robot never claims to remember anyone: after the reset a returning person is a stranger." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="885" y="98" width="365" height="222" as="geometry" /></mxCell><mxCell id="mention" value="MENTION vs OFFER: two flags, never one.&#10;A mention says a thing exists and expects no answer; an offer names it and waits for yes or no. Rule 5 is discharged by a mention; rule 6 caps offers. Merge the flags and one of the two rules breaks." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="885" y="334" width="365" height="92" as="geometry" /></mxCell><mxCell id="track" value="THE HUB TRACKS, per visit (all deleted by the reset): offerings available now, mentioned, offered, declined; consecutive unanswered offers; whether offering is still permitted; whether a celebration is possible; the offering completed last (never offered next). A celebration changes none of these." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="885" y="440" width="365" height="100" as="geometry" /></mxCell><mxCell id="legend" value="Legend: blue = visit states | green = offerings (solid arrow = raised or asked, dashed = back to the hub) | amber = no-answer and celebration paths | red = safety and staff states. Transition hygiene: stop BEFORE start; the stop is confirmed, not assumed." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="670" width="1220" height="26" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Every number is loaded from ../constants.json by the key shown. [Pn] = public (a paper, standard or physics value, or my arithmetic on one); [In] = illustrative (a round design value of the right order; never a measurement of a real robot or visitor); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/A1-the-experience-as-a-state-machine.md (overview states, arrival, offer hub, following the lead, celebrating and closing, the eight invariants, state the hub must track, transition hygiene); B1 (safety supervisor above the state machine). Termination argument: a finite offering set with at most one offer each ends every visit (A1, 'How it is designed and tested').&#10;[I1] offerings_illustrative = 3 offerings (chat, a small gift, a photo). illustrative offering set" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="710" width="1220" height="74" as="geometry" /></mxCell><mxCell id="edge0" value="someone arrives" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#3d6aa3;fontColor=#3d6aa3;" edge="1" parent="1" source="waiting" target="arrival"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#3d6aa3;fontColor=#3d6aa3;" edge="1" parent="1" source="arrival" target="hub"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.12;exitY=0;exitDx=0;exitDy=0;entryX=0.45;entryY=1;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="hub" target="chat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="chat" target="hub"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.45;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="hub" target="gift"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge5" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.62;entryY=0;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="gift" target="hub"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.82;exitY=0;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="hub" target="photo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge7" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=0.55;exitY=1;exitDx=0;exitDy=0;entryX=0.95;entryY=0;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="photo" target="hub"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge8" value="it landed" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;strokeColor=#b37400;fontColor=#b37400;" edge="1" parent="1" source="hub" target="celebrate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge9" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;strokeColor=#b37400;fontColor=#b37400;" edge="1" parent="1" source="celebrate" target="hub"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge10" value="silence" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.35;exitY=1;exitDx=0;exitDy=0;entryX=0.35;entryY=0;entryDx=0;entryDy=0;strokeColor=#b37400;fontColor=#b37400;" edge="1" parent="1" source="hub" target="noans"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge11" value="answers" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;strokeColor=#b37400;fontColor=#b37400;" edge="1" parent="1" source="noans" target="hub"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge12" value="repeated decline" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.92;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;strokeColor=#3d6aa3;fontColor=#3d6aa3;" edge="1" parent="1" source="hub" target="talk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge13" value="still nothing: close gently" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#b37400;fontColor=#b37400;" edge="1" parent="1" source="noans" target="closing"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge14" value="visitor done" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#3d6aa3;fontColor=#3d6aa3;" edge="1" parent="1" source="talk" target="closing"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="775" y="549" /></Array></mxGeometry></mxCell><mxCell id="edge15" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#3d6aa3;fontColor=#3d6aa3;" edge="1" parent="1" source="closing" target="reset"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge16" value="confirmed" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.12;exitY=0;exitDx=0;exitDy=0;entryX=0.6;entryY=1;entryDx=0;entryDy=0;strokeColor=#3d6aa3;fontColor=#3d6aa3;" edge="1" parent="1" source="reset" target="waiting"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge17" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="reset" target="staff"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>