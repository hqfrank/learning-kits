<mxfile host="app.diagrams.net"><diagram id="p_01_visit_state_machine" name="01-visit-state-machine"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="800" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="A visit is a small state machine: every offering hangs off one hub and is offered at most once, so every visit provably ends; the language model only supplies the words inside each state (3 illustrative offerings [I1])" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="46" as="geometry" /></mxCell><mxCell id="chat" value="CHAT&#10;offering 1" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="90" width="125" height="58" as="geometry" /></mxCell><mxCell id="gift" value="A SMALL GIFT&#10;offering 2 (self-serve)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="520" y="90" width="125" height="58" as="geometry" /></mxCell><mxCell id="photo" value="A PHOTO&#10;offering 3 (visitor's phone)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="660" y="90" width="125" height="58" as="geometry" /></mxCell><mxCell id="waiting" value="WAITING&#10;(attract posture)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="255" width="135" height="64" as="geometry" /></mxCell><mxCell id="arrival" value="ARRIVAL&#10;generic hello, never the last word: always followed by one specific thing" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="205" y="240" width="190" height="94" as="geometry" /></mxCell><mxCell id="hub" value="OFFER HUB&#10;the robot raises ONE offering, or the visitor asks for one; all offerings are equals" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="240" width="200" height="94" as="geometry" /></mxCell><mxCell id="celebrate" value="CELEBRATE&#10;a reaction, brief; only with something safe now, else skip silently" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="700" y="255" width="160" height="70" as="geometry" /></mxCell><mxCell id="noans" value="NO ANSWER&#10;name one SPECIFIC thing (never an open 'what would you like?')" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="390" width="200" height="70" as="geometry" /></mxCell><mxCell id="talk" value="JUST TALKING&#10;repeated decline or 'I'm fine': offering stops, the robot stays warm" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="690" y="390" width="170" height="70" as="geometry" /></mxCell><mxCell id="closing" value="CLOSING&#10;goodbye; every offering mentioned at least once" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="520" width="200" height="58" as="geometry" /></mxCell><mxCell id="reset" value="RESET (close the visit)&#10;confirmed stop of speech and motion, then delete ALL per-visit state" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="205" y="510" width="190" height="78" as="geometry" /></mxCell><mxCell id="staff" value="NEEDS STAFF&#10;reset could not be confirmed: no new visit on top" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="515" width="135" height="68" as="geometry" /></mxCell><mxCell id="arr_note" value="Steps out of view and returns within a short window = the SAME visit: no fresh hello, no repeated offers." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="205" y="340" width="190" height="60" as="geometry" /></mxCell><mxCell id="hub_note" value="each offering returns to the hub; offerings never connect to each other" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="380" y="72" width="420" height="18" as="geometry" /></mxCell><mxCell id="g_walk" value="GLOBAL: the visitor walks away -&gt; CLOSING, from any state. A silence is not a departure; a departure is never answered as a silence." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="610" width="405" height="44" as="geometry" /></mxCell><mxCell id="g_safe" value="GLOBAL: SAFETY PAUSE pre-empts every state and stays stopped until staff clear it; the hardware power cut is never a software call." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="450" y="610" width="410" height="44" as="geometry" /></mxCell><mxCell id="inv_h" value="THE RULES THAT MUST ALWAYS HOLD (invariants)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="885" y="70" width="365" height="28" as="geometry" /></mxCell><mxCell id="inv" value="1  The robot offers first: the visit never depends on the visitor knowing what to ask.&#10;2  Silence never strands the visit: name one specific thing.&#10;3  One thing at a time: one offering per turn, never a list (unless asked 'what can you do?').&#10;4  A no is a no: a declined offering is not raised again; a repeated decline stops all offering.&#10;5  Nothing stays a secret: every offering is MENTIONED once before goodbye (unless the visitor left, declined or asked to stop).&#10;6  Offering always runs out: each offering is OFFERED at most once, so the visit terminates.&#10;7  Celebration is a reaction, never a request, and never reopens what 4 or 6 closed.&#10;8  The robot never claims to remember anyone: after the reset a returning person is a stranger." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="885" y="98" width="365" height="222" as="geometry" /></mxCell><mxCell id="mention" value="MENTION vs OFFER: two flags, never one.&#10;A mention says a thing exists and expects no answer; an offer names it and waits for yes or no. Rule 5 is discharged by a mention; rule 6 caps offers. Merge the flags and one of the two rules breaks." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="885" y="334" width="365" height="92" as="geometry" /></mxCell><mxCell id="track" value="THE HUB TRACKS, per visit (all deleted by the reset): offerings available now, mentioned, offered, declined; consecutive unanswered offers; whether offering is still permitted; whether a celebration is possible; the offering completed last (never offered next). A celebration changes none of these." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="885" y="440" width="365" height="100" as="geometry" /></mxCell><mxCell id="legend" value="Legend: blue = visit states | green = offerings (solid arrow = raised or asked, dashed = back to the hub) | amber = no-answer and celebration paths | red = safety and staff states. Transition hygiene: stop BEFORE start; the stop is confirmed, not assumed." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="670" width="1220" height="26" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Every number is loaded from ../constants.json by the key shown. [Pn] = public (a paper, standard or physics value, or my arithmetic on one); [In] = illustrative (a round design value of the right order; never a measurement of a real robot or visitor); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/A1-the-experience-as-a-state-machine.md (overview states, arrival, offer hub, following the lead, celebrating and closing, the eight invariants, state the hub must track, transition hygiene); B1 (safety supervisor above the state machine). Termination argument: a finite offering set with at most one offer each ends every visit (A1, 'How it is designed and tested').&#10;[I1] offerings_illustrative = 3 offerings (chat, a small gift, a photo). illustrative offering set" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="710" width="1220" height="74" as="geometry" /></mxCell><mxCell id="edge0" value="someone arrives" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#3d6aa3;fontColor=#3d6aa3;" edge="1" parent="1" source="waiting" target="arrival"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#3d6aa3;fontColor=#3d6aa3;" edge="1" parent="1" source="arrival" target="hub"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.12;exitY=0;exitDx=0;exitDy=0;entryX=0.45;entryY=1;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="hub" target="chat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="chat" target="hub"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.45;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="hub" target="gift"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge5" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.62;entryY=0;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="gift" target="hub"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.82;exitY=0;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="hub" target="photo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge7" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=0.55;exitY=1;exitDx=0;exitDy=0;entryX=0.95;entryY=0;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="photo" target="hub"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge8" value="it landed" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.35;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;strokeColor=#b37400;fontColor=#b37400;" edge="1" parent="1" source="hub" target="celebrate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge9" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;strokeColor=#b37400;fontColor=#b37400;" edge="1" parent="1" source="celebrate" target="hub"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge10" value="silence" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.35;exitY=1;exitDx=0;exitDy=0;entryX=0.35;entryY=0;entryDx=0;entryDy=0;strokeColor=#b37400;fontColor=#b37400;" edge="1" parent="1" source="hub" target="noans"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge11" value="answers" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;strokeColor=#b37400;fontColor=#b37400;" edge="1" parent="1" source="noans" target="hub"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge12" value="repeated decline" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.92;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;strokeColor=#3d6aa3;fontColor=#3d6aa3;" edge="1" parent="1" source="hub" target="talk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge13" value="still nothing: close gently" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#b37400;fontColor=#b37400;" edge="1" parent="1" source="noans" target="closing"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge14" value="visitor done" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#3d6aa3;fontColor=#3d6aa3;" edge="1" parent="1" source="talk" target="closing"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="775" y="549" /></Array></mxGeometry></mxCell><mxCell id="edge15" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#3d6aa3;fontColor=#3d6aa3;" edge="1" parent="1" source="closing" target="reset"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge16" value="confirmed" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.12;exitY=0;exitDx=0;exitDy=0;entryX=0.6;entryY=1;entryDx=0;entryDy=0;strokeColor=#3d6aa3;fontColor=#3d6aa3;" edge="1" parent="1" source="reset" target="waiting"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge17" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="reset" target="staff"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p_02_dwell_budget" name="02-dwell-budget"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1160" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Beats add up to a dwell time, dwell plus reset is the cycle, and the cycle sets visitors per hour: 80 s [I1] + 20 s [I2] = 100 s [I3] -&gt; 36 per hour [I4] in theory, about 25 [I5] in a real queue (illustrative budget)" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="46" as="geometry" /></mxCell><mxCell id="a_h" value="A. ONE VISIT AS TIMED BEATS, to scale (5.6 px per second). Each bar starts where the previous beat ends." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="72" width="1220" height="20" as="geometry" /></mxCell><mxCell id="l_beat_greet_illustrative" value="greet: look up, wave, one short line: 6 s [I6]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="108" width="340" height="22" as="geometry" /></mxCell><mxCell id="b_beat_greet_illustrative" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="111" width="33" height="18" as="geometry" /></mxCell><mxCell id="l_beat_reply_window_illustrative" value="reply window: listening armed after the line ends: 12 s [I7]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="132" width="340" height="22" as="geometry" /></mxCell><mxCell id="b_beat_reply_window_illustrative" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="413" y="135" width="67" height="18" as="geometry" /></mxCell><mxCell id="l_beat_converse_illustrative" value="converse: a few turns (largest, most variable): 35 s [I8]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="156" width="340" height="22" as="geometry" /></mxCell><mxCell id="b_beat_converse_illustrative" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="480" y="159" width="196" height="18" as="geometry" /></mxCell><mxCell id="l_beat_offer_illustrative" value="offer: self-serve gift, includes the take timer: 15 s [I9]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="180" width="340" height="22" as="geometry" /></mxCell><mxCell id="b_beat_offer_illustrative" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="676" y="183" width="84" height="18" as="geometry" /></mxCell><mxCell id="l_beat_celebrate_illustrative" value="celebrate: 8 s [I10]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="204" width="340" height="22" as="geometry" /></mxCell><mxCell id="b_beat_celebrate_illustrative" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="760" y="207" width="44" height="18" as="geometry" /></mxCell><mxCell id="l_beat_goodbye_illustrative" value="goodbye: 4 s [I11]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="228" width="340" height="22" as="geometry" /></mxCell><mxCell id="b_beat_goodbye_illustrative" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="805" y="231" width="22" height="18" as="geometry" /></mxCell><mxCell id="l_reset_turnover_illustrative" value="reset and turnover (pure overhead): 20 s [I2]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="252" width="340" height="22" as="geometry" /></mxCell><mxCell id="b_reset_turnover_illustrative" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="828" y="255" width="112" height="18" as="geometry" /></mxCell><mxCell id="l_take" value="inside the offer: no-take timer 12 s [I12]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="276" width="340" height="22" as="geometry" /></mxCell><mxCell id="b_take" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;dashed=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="676" y="282" width="67" height="12" as="geometry" /></mxCell><mxCell id="l_turn" value="inside converse: one visitor turn is capped at 10 s [I13]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="300" width="340" height="22" as="geometry" /></mxCell><mxCell id="b_turn" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;dashed=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="480" y="306" width="56" height="12" as="geometry" /></mxCell><mxCell id="l_typ" value="typical interaction = sum of the six beats: 80 s [I1] [calc]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="330" width="340" height="22" as="geometry" /></mxCell><mxCell id="b_typ" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="333" width="448" height="18" as="geometry" /></mxCell><mxCell id="l_cyc" value="cycle = interaction + reset: 100 s [I3] [calc]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="354" width="340" height="22" as="geometry" /></mxCell><mxCell id="b_cyc" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="357" width="560" height="18" as="geometry" /></mxCell><mxCell id="l_ina" value="global inactivity timeout (any beat -&gt; goodbye): 45 s [I14]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="378" width="340" height="22" as="geometry" /></mxCell><mxCell id="b_ina" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;dashed=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="381" width="251" height="18" as="geometry" /></mxCell><mxCell id="l_cap" value="'chatty visitor' cap and session-lease maximum: 150 s [I15]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="402" width="340" height="22" as="geometry" /></mxCell><mxCell id="b_cap" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;dashed=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="405" width="840" height="18" as="geometry" /></mxCell><mxCell id="tk0" value="0 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="360" y="436" width="40" height="16" as="geometry" /></mxCell><mxCell id="tk25" value="25 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="500" y="436" width="40" height="16" as="geometry" /></mxCell><mxCell id="tk50" value="50 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="640" y="436" width="40" height="16" as="geometry" /></mxCell><mxCell id="tk75" value="75 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="780" y="436" width="40" height="16" as="geometry" /></mxCell><mxCell id="tk100" value="100 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="920" y="436" width="40" height="16" as="geometry" /></mxCell><mxCell id="tk125" value="125 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1060" y="436" width="40" height="16" as="geometry" /></mxCell><mxCell id="tk150" value="150 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1200" y="436" width="40" height="16" as="geometry" /></mxCell><mxCell id="note_a" value="Timeouts are failsafes set ABOVE the intended length, not targets.&#10;&#10;The greet line is short on purpose: the reply window opens only when it ends, so a longer greeting delays the visitor's natural reply." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="970" y="108" width="280" height="96" as="geometry" /></mxCell><mxCell id="b_h" value="B. THE ARITHMETIC RUNS BOTH WAYS: the cycle sets the queue, and the queue sets how long any beat may be." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="464" width="1220" height="20" as="geometry" /></mxCell><mxCell id="c1" value="cycle&#10;100 s [I3]" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="490" width="150" height="58" as="geometry" /></mxCell><mxCell id="c2" value="3600 s / cycle&#10;= 36 visitors per hour [I4] [calc]" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="197" y="490" width="200" height="58" as="geometry" /></mxCell><mxCell id="c3" value="x queue friction 0.7 [I16]&#10;= about 25 per hour [I5] [calc]" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="414" y="490" width="250" height="58" as="geometry" /></mxCell><mxCell id="c4" value="x show day 6 h [I17]&#10;= about 150 visits per day [I18] [calc]" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="681" y="490" width="250" height="58" as="geometry" /></mxCell><mxCell id="c5" value="feeds other gates: endurance gate 150 cycles without intervention [I19]; gift tray and refill cadence must keep up" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="948" y="490" width="300" height="58" as="geometry" /></mxCell><mxCell id="b_note" value="Throughput is 3600 divided by the CYCLE, not by the dwell: the reset counts. Need more visitors per hour? Cap the converse beat (largest, most variable) or shorten the reset; every second removed from the reset returns to visitors. Report the dwell distribution (median and a high percentile), not only the mean: the cap exists for the tail." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="558" width="1220" height="36" as="geometry" /></mxCell><mxCell id="c_h" value="C. THE RESPONSIVENESS BUDGET: from the visitor's consent action to a VISIBLE listening signal, every stage named (to scale, ms)." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="608" width="1220" height="20" as="geometry" /></mxCell><mxCell id="l_det" value="budget 500 ms [I20] = detection 300 ms [I21] + permit, audio gate, indicator 200 ms [I22]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="674" width="340" height="28" as="geometry" /></mxCell><mxCell id="m_det" value="detect" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="380" y="678" width="245" height="22" as="geometry" /></mxCell><mxCell id="m_sig" value="permit + gate + light" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="625" y="678" width="164" height="22" as="geometry" /></mxCell><mxCell id="mt0" value="0 ms" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="350" y="720" width="60" height="16" as="geometry" /></mxCell><mxCell id="mt200" value="200 ms" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="514" y="720" width="60" height="16" as="geometry" /></mxCell><mxCell id="mt400" value="400 ms" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="678" y="720" width="60" height="16" as="geometry" /></mxCell><mxCell id="mt600" value="600 ms" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="842" y="720" width="60" height="16" as="geometry" /></mxCell><mxCell id="mt800" value="800 ms" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1006" y="720" width="60" height="16" as="geometry" /></mxCell><mxCell id="mt1000" value="1000 ms" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1170" y="720" width="60" height="16" as="geometry" /></mxCell><mxCell id="rf100" value="0.1 s feels instant [P23]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="466" y="638" width="230" height="16" as="geometry" /></mxCell><mxCell id="rf200" value="typical human turn gap 200 ms [P24]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#7b4f9e;" vertex="1" parent="1"><mxGeometry x="548" y="654" width="230" height="16" as="geometry" /></mxCell><mxCell id="rf1000" value="1 s flow-of-thought limit [P25]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="966" y="654" width="230" height="16" as="geometry" /></mxCell><mxCell id="c_note" value="The robot need not match humans, but each stage is measured on the real robot and network." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="806" y="676" width="385" height="30" as="geometry" /></mxCell><mxCell id="legend" value="Legend: solid bars = planned beat lengths | dashed bars = timers and caps (failsafes) | dashed vertical lines = totals (A) or public reference limits (C). All robot durations are illustrative design values, not measurements." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="749" width="1220" height="26" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Every number is loaded from ../constants.json by the key shown. [Pn] = public (a paper, standard or physics value, or my arithmetic on one); [In] = illustrative (a round design value of the right order; never a measurement of a real robot or visitor); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/A2-beats-and-dwell-budget.md (budget table, from beats to throughput, short beats that start early, the responsiveness budget, 'throughput is 3600 divided by the cycle'); C2 for the endurance gate. [calc]: 80 = sum of six beats; 80 + 20 = 100 s; 3600 / 100 = 36 per hour; 36 x 0.7 = 25 (rounded); 25 x 6 h = 150 visits; 300 + 200 = 500 ms.&#10;[I1] interaction_typical_illustrative = 80 s. illustrative: my arithmetic: sum of the six beat_*_illustrative values&#10;[I2] reset_turnover_illustrative = 20 s. illustrative time to reset and let the next visitor step up&#10;[I3] cycle_illustrative = 100 s. illustrative: my arithmetic: interaction_typical_illustrative + reset_turnover_illustrative&#10;[I4] throughput_theoretical_illustrative = 36 visitors per hour. illustrative: my arithmetic: 3600 s / cycle_illustrative&#10;[I5] throughput_realistic_illustrative = 25 visitors per hour. illustrative: my arithmetic: throughput_theoretical_illustrative x queue_friction_factor_illustrative, rounded&#10;[I6] beat_greet_illustrative = 6 s. illustrative beat length&#10;[I7] beat_reply_window_illustrative = 12 s. illustrative listening-armed window after the greeting&#10;[I8] beat_converse_illustrative = 35 s. illustrative conversation beat (a few turns)&#10;[I9] beat_offer_illustrative = 15 s. illustrative self-serve gift offer including the take timer&#10;[I10] beat_celebrate_illustrative = 8 s. illustrative&#10;[I11] beat_goodbye_illustrative = 4 s. illustrative&#10;[I12] take_timer_illustrative = 12 s. illustrative no-take timeout inside beat_offer_illustrative&#10;[I13] per_turn_cap_illustrative = 10 s. illustrative cap on one visitor turn&#10;[I14] inactivity_timeout_illustrative = 45 s. illustrative global inactivity timeout&#10;[I15] interaction_cap_illustrative = 150 s. illustrative 'chatty visitor' cap and session-lease maximum&#10;[I16] queue_friction_factor_illustrative = 0.7 dimensionless. illustrative discount for crowd and queue friction&#10;[I17] show_day_illustrative = 6 h. illustrative show day&#10;[I18] visits_per_day_illustrative = 150 visits. illustrative: my arithmetic: throughput_realistic_illustrative x show_day_illustrative&#10;[I19] consecutive_cycles_gate_illustrative = 150 visitor cycles without intervention. illustrative launch gate&#10;[I20] listening_indicator_budget_illustrative = 500 ms from consent action to visible listening signal. illustrative design budget; chosen below response_limit_flow&#10;[I21] listening_indicator_detect_illustrative = 300 ms (detection share of the budget). illustrative split of listening_indicator_budget_illustrative&#10;[I22] listening_indicator_signal_illustrative = 200 ms (permit + gate + indicator share). illustrative split; sums with listening_indicator_detect_illustrative to the budget&#10;[P23] response_limit_instant = 0.1 s. public: Nielsen 1993, ch. 5&#10;[P24] turn_gap_typical = 200 ms. public: Stivers et al., 'Universals and cultural variation in turn-taking in conversation', PNAS 106(26), 2009: offsets between turns cluster around a short gap of about 200 ms across 10 languages&#10;[P25] response_limit_flow = 1 s. public: Nielsen, Usability Engineering, 1993, ch. 5: about 1 s is the limit for the user's flow of thought to stay uninterrupted; 0.1 s feels instantaneous; 10 s loses attention" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="789" width="1220" height="355" as="geometry" /></mxCell><mxCell id="edge0" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#3d6aa3;fontColor=#3d6aa3;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#3d6aa3;fontColor=#3d6aa3;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#3d6aa3;fontColor=#3d6aa3;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#3d6aa3;fontColor=#3d6aa3;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="line0" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="104" as="sourcePoint" /><mxPoint x="380" y="430" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line1" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="430" as="sourcePoint" /><mxPoint x="1220.0" y="430" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line2" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380.0" y="430" as="sourcePoint" /><mxPoint x="380.0" y="435" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line3" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520.0" y="430" as="sourcePoint" /><mxPoint x="520.0" y="435" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line4" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="660.0" y="430" as="sourcePoint" /><mxPoint x="660.0" y="435" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line5" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="800.0" y="430" as="sourcePoint" /><mxPoint x="800.0" y="435" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line6" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="940.0" y="430" as="sourcePoint" /><mxPoint x="940.0" y="435" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line7" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1080.0" y="430" as="sourcePoint" /><mxPoint x="1080.0" y="435" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line8" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220.0" y="430" as="sourcePoint" /><mxPoint x="1220.0" y="435" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line9" value="" style="endArrow=none;html=0;strokeColor=#3d6aa3;strokeWidth=1.2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="828.0" y="104" as="sourcePoint" /><mxPoint x="828.0" y="430" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line10" value="" style="endArrow=none;html=0;strokeColor=#666666;strokeWidth=1.2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="940.0" y="104" as="sourcePoint" /><mxPoint x="940.0" y="430" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line11" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="670" as="sourcePoint" /><mxPoint x="380" y="714" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line12" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="714" as="sourcePoint" /><mxPoint x="1241.0" y="714" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line13" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380.0" y="714" as="sourcePoint" /><mxPoint x="380.0" y="719" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line14" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="544.0" y="714" as="sourcePoint" /><mxPoint x="544.0" y="719" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line15" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="708.0" y="714" as="sourcePoint" /><mxPoint x="708.0" y="719" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line16" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="872.0" y="714" as="sourcePoint" /><mxPoint x="872.0" y="719" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line17" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1036.0" y="714" as="sourcePoint" /><mxPoint x="1036.0" y="719" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line18" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1200.0" y="714" as="sourcePoint" /><mxPoint x="1200.0" y="719" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line19" value="" style="endArrow=none;html=0;strokeColor=#666666;strokeWidth=1.4;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="462.0" y="652" as="sourcePoint" /><mxPoint x="462.0" y="714" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line20" value="" style="endArrow=none;html=0;strokeColor=#7b4f9e;strokeWidth=1.4;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="544.0" y="668" as="sourcePoint" /><mxPoint x="544.0" y="714" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line21" value="" style="endArrow=none;html=0;strokeColor=#b85450;strokeWidth=1.4;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1200.0" y="668" as="sourcePoint" /><mxPoint x="1200.0" y="714" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p_03_where_the_llm_is" name="03-where-the-llm-is"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="944" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Only ONE box in the stack is a language model: perception, the engage trigger, the body and the gaze are plain code that unit tests can prove; the model's behaviour can only be measured live" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="46" as="geometry" /></mxCell><mxCell id="mic" value="MICROPHONE ARRAY&#10;audio in" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="104" width="160" height="58" as="geometry" /></mxCell><mxCell id="cam" value="HEAD CAMERA&#10;frames stay inside the stand" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="262" width="160" height="58" as="geometry" /></mxCell><mxCell id="percep" value="VISITOR PERCEPTION - not an LLM&#10;small vision and audio models: face detector, face embedding (anonymous session id), active-speaker detection, voice embedding; direction-of-arrival fusion; state machine absent -&gt; arming -&gt; engaged" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="240" y="222" width="250" height="126" as="geometry" /></mxCell><mxCell id="trigger" value="ENGAGE TRIGGER - not an LLM&#10;one deterministic edge: 'engaged' -&gt; one system message to greet. Cooldown, re-arm on idle, wake-word precedence, fail closed if perception is stale" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="240" y="404" width="250" height="92" as="geometry" /></mxCell><mxCell id="reasoner" value="THE REASONER - the only LLM&#10;a realtime speech-to-speech session: audio in and out, server-side VAD, function calling; the only 'vision' is a camera frame per utterance.&#10;&#10;Wrapped by: a local wake-word gate; TRIAGE (a per-utterance LLM decision: accept or ignore); a barge-in guard; context compaction; tracing.&#10;Behaviour lives in prompt files: base identity and safety &lt;- stand profile &lt;- one file per ability" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="560" y="78" width="320" height="206" as="geometry" /></mxCell><mxCell id="spk" value="LOUDSPEAKER&#10;robot voice out" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="640" y="336" width="160" height="46" as="geometry" /></mxCell><mxCell id="behav" value="BEHAVIOUR LIBRARY - not an LLM&#10;a behaviour tree at 100 Hz [I1] with blended priority layers; face lights, eyebrows and a nod follow the voice output level" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="950" y="78" width="300" height="100" as="geometry" /></mxCell><mxCell id="gaze" value="GAZE CONTROLLER - not an LLM&#10;active-speaker bearing -&gt; gaze policy -&gt; head-pose command (diagram 05)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="950" y="230" width="300" height="86" as="geometry" /></mxCell><mxCell id="gw" value="ROBOT GATEWAY - not an LLM&#10;the only component that talks to the robot middleware; a few intent verbs: speak, play pose, look at, hand over, cancel, health" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="950" y="376" width="300" height="92" as="geometry" /></mxCell><mxCell id="rails_h" value="TWO DESIGNS IN THE SOURCES" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="520" width="600" height="20" as="geometry" /></mxCell><mxCell id="rt0a" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fontStyle=1;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="544" width="150" height="24" as="geometry" /></mxCell><mxCell id="rt0b" value="on-rails (designed first)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="180" y="544" width="225" height="24" as="geometry" /></mxCell><mxCell id="rt0c" value="speech-to-speech (as built)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="405" y="544" width="225" height="24" as="geometry" /></mxCell><mxCell id="rt1a" value="where the LLM sits" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="568" width="150" height="24" as="geometry" /></mxCell><mxCell id="rt1b" value="inside one beat, fixed intents and output schema" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="180" y="568" width="225" height="24" as="geometry" /></mxCell><mxCell id="rt1c" value="the voice AND the sequencer" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="405" y="568" width="225" height="24" as="geometry" /></mxCell><mxCell id="rt2a" value="robustness in noise" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="592" width="150" height="24" as="geometry" /></mxCell><mxCell id="rt2b" value="high" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="180" y="592" width="225" height="24" as="geometry" /></mxCell><mxCell id="rt2c" value="lower" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="405" y="592" width="225" height="24" as="geometry" /></mxCell><mxCell id="rt3a" value="latency" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="616" width="150" height="24" as="geometry" /></mxCell><mxCell id="rt3b" value="near zero for canned lines" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="180" y="616" width="225" height="24" as="geometry" /></mxCell><mxCell id="rt3c" value="one model round trip" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="405" y="616" width="225" height="24" as="geometry" /></mxCell><mxCell id="rt4a" value="auditability" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="640" width="150" height="24" as="geometry" /></mxCell><mxCell id="rt4b" value="every line enumerable, testable in CI" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="180" y="640" width="225" height="24" as="geometry" /></mxCell><mxCell id="rt4c" value="not enumerable: safety is measured" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="405" y="640" width="225" height="24" as="geometry" /></mxCell><mxCell id="rt5a" value="charm" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="664" width="150" height="24" as="geometry" /></mxCell><mxCell id="rt5b" value="repetitive without pools" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="180" y="664" width="225" height="24" as="geometry" /></mxCell><mxCell id="rt5c" value="varied" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="405" y="664" width="225" height="24" as="geometry" /></mxCell><mxCell id="rails_n" value="Likely posture under crowd noise: a hybrid (canned openers, live follow-ups). A voice pack of pre-rendered lines is always the floor." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="692" width="600" height="34" as="geometry" /></mxCell><mxCell id="lad_h" value="AUTOMATIC, FAIL-CLOSED AUDIO LADDER (each step down is more robust)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="660" y="520" width="590" height="20" as="geometry" /></mxCell><mxCell id="st0" value="1  open microphone, full duplex (listens while speaking)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="660" y="546" width="590" height="34" as="geometry" /></mxCell><mxCell id="st1" value="2  half duplex: microphone closed while the robot speaks" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="700" y="586" width="550" height="34" as="geometry" /></mxCell><mxCell id="st2" value="3  push-to-talk" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="740" y="626" width="510" height="34" as="geometry" /></mxCell><mxCell id="st3" value="4  canned lines + gestures driven by a hidden operator (Wizard-of-Oz floor): the visitor cannot tell" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="780" y="666" width="470" height="34" as="geometry" /></mxCell><mxCell id="lad_n" value="A cloud call is never awaited on the critical path: a stall falls back to a canned line from the beat's pool." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="660" y="708" width="590" height="34" as="geometry" /></mxCell><mxCell id="inv" value="DESIGN INVARIANTS. Camera data stays inside the stand; only bearings, flags and actions cross to the robot.  Visitor context enriches conversation, never control: mood may shape a line, never a state transition.  A safety supervisor sits above the state machine and pre-empts any state.  Free conversation stays off the gateway seam.  The reasoner never returns to idle by itself: consumers infer 'conversation over', e.g. after 5 s of quiet listening [I2].  Exactly one publisher of the reasoner state." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="738" width="1220" height="46" as="geometry" /></mxCell><mxCell id="legend" value="Legend: purple, thick border = the one language model (and its prompt-owned behaviour) | blue = perception and trigger (plain code) | green = body and gaze | grey = sensors, speaker, gateway | purple arrows = model output, blue = perception output, green = motion commands." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="802" width="1220" height="26" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Every number is loaded from ../constants.json by the key shown. [Pn] = public (a paper, standard or physics value, or my arithmetic on one); [In] = illustrative (a round design value of the right order; never a measurement of a real robot or visitor); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/B1-the-voice-pipeline.md (components as built, one visitor end to end, on-rails versus open conversation, reasoner as sequencer, degradation, design invariants, 'how it is designed and tested'); Wizard-of-Oz after Kelley 1984; cascade and speech-to-speech designs after Skantze 2021 (both cited in B1).&#10;[I1] behaviour_tick_illustrative = 100 Hz. illustrative behaviour-library update rate&#10;[I2] wind_down_quiet_illustrative = 5 s. illustrative quiet-listening time after which a supervisor infers 'conversation over'" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="842" width="1220" height="86" as="geometry" /></mxCell><mxCell id="edge0" value="audio, through a local wake-word gate" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.16;entryDx=0;entryDy=0;strokeColor=#7b4f9e;fontColor=#7b4f9e;" edge="1" parent="1" source="mic" target="reasoner"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="audio for DoA and voice" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;strokeColor=#3d6aa3;fontColor=#3d6aa3;" edge="1" parent="1" source="mic" target="percep"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="110" y="200" /><mxPoint x="290" y="200" /></Array></mxGeometry></mxCell><mxCell id="edge2" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.65;entryDx=0;entryDy=0;strokeColor=#3d6aa3;fontColor=#3d6aa3;" edge="1" parent="1" source="cam" target="percep"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="engaged" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#3d6aa3;fontColor=#3d6aa3;" edge="1" parent="1" source="percep" target="trigger"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="one system message: greet" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.1;entryY=1;entryDx=0;entryDy=0;strokeColor=#3d6aa3;fontColor=#3d6aa3;" edge="1" parent="1" source="trigger" target="reasoner"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="592" y="450" /></Array></mxGeometry></mxCell><mxCell id="edge5" value="speaker labels, evidence for triage" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.18;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;strokeColor=#3d6aa3;fontColor=#3d6aa3;" edge="1" parent="1" source="percep" target="reasoner"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="active-speaker bearing" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.62;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="percep" target="gaze"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge7" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#7b4f9e;fontColor=#7b4f9e;" edge="1" parent="1" source="reasoner" target="spk"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge8" value="gesture tool call; returns on completion" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;strokeColor=#7b4f9e;fontColor=#7b4f9e;" edge="1" parent="1" source="reasoner" target="behav"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge9" value="state: accepted speaker = addressee" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;strokeColor=#7b4f9e;fontColor=#7b4f9e;" edge="1" parent="1" source="reasoner" target="gaze"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge10" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="behav" target="gw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1266" y="128" /><mxPoint x="1266" y="422" /></Array></mxGeometry></mxCell><mxCell id="edge11" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="gaze" target="gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p_04_who_is_speaking" name="04-who-is-speaking"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1130" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Who is speaking: the face's moving mouth SELECTS, the coarse microphone bearing only gates and corroborates, and when the voice has no face the label is 'unidentified', because a confident wrong name costs more than no name" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="46" as="geometry" /></mxCell><mxCell id="sc_h" value="A. TOP-DOWN SCENE AT THE STAND (positions are a drawing choice, not data)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="570" height="20" as="geometry" /></mxCell><mxCell id="fov_l" value="head-camera field of view 90 deg [I11]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#2d7d2d;" vertex="1" parent="1"><mxGeometry x="52" y="288" width="170" height="30" as="geometry" /></mxCell><mxCell id="win_l" value="amber dashed = face window +-40 deg [I10] = gate 15 deg [I9] + half a bin [calc]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#b37400;" vertex="1" parent="1"><mxGeometry x="30" y="130" width="300" height="34" as="geometry" /></mxCell><mxCell id="bin_l" value="grey dashed = on-chip direction bins, 45 deg each (8 directions) [I8]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="96" width="260" height="30" as="geometry" /></mxCell><mxCell id="v1" value="" style="rounded=1;whiteSpace=wrap;html=0;arcSize=30;verticalAlign=middle;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="271" y="327" width="30" height="30" as="geometry" /></mxCell><mxCell id="v1_l" value="visitor_1&#10;mouth moving" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="168" y="328" width="100" height="30" as="geometry" /></mxCell><mxCell id="v2" value="" style="rounded=1;whiteSpace=wrap;html=0;arcSize=30;verticalAlign=middle;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="351" y="290" width="30" height="30" as="geometry" /></mxCell><mxCell id="v2_l" value="visitor_2&#10;silent" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="384" y="291" width="100" height="30" as="geometry" /></mxCell><mxCell id="by" value="" style="rounded=1;whiteSpace=wrap;html=0;arcSize=30;verticalAlign=middle;align=center;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="152" y="437" width="30" height="30" as="geometry" /></mxCell><mxCell id="by_l" value="bystander, outside&#10;the window, silent" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="49" y="438" width="100" height="30" as="geometry" /></mxCell><mxCell id="ph" value="" style="rounded=1;whiteSpace=wrap;html=0;arcSize=30;verticalAlign=middle;align=center;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="501" y="441" width="30" height="30" as="geometry" /></mxCell><mxCell id="ph_l" value="a phone playing&#10;speech, OFF camera" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="534" y="442" width="100" height="30" as="geometry" /></mxCell><mxCell id="robot" value="ROBOT&#10;mic array" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="269" y="537" width="92" height="34" as="geometry" /></mxCell><mxCell id="sc_n1" value="visitor_1 and visitor_2 share ONE bin and both sit inside the window: the bearing ABSTAINS and defers to active-speaker detection, which picks visitor_1 by the moving mouth." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="590" width="270" height="84" as="geometry" /></mxCell><mxCell id="sc_n2" value="The phone's bearing has NO face: positive evidence for 'unidentified'. It must not be pinned on the silent person in front. While the robot itself speaks, and for 400 ms after [I12], DoA evidence is ignored (the loudest direction may be the robot)." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="315" y="590" width="285" height="84" as="geometry" /></mxCell><mxCell id="phys" value="WHY A SMALL ARRAY IS COARSE (public physics)&#10;sound 343 m/s [P1] -&gt; largest delay across a 10 cm pair 292 us [P2]&#10;one sample at 16 kHz = 62.5 us [P3] = 2.1 cm of path [P4] -&gt; an integer lag resolves only about 12.4 deg near broadside [P5]&#10;phase wraps above c / 2d: 3.4 kHz for a 5 cm pair [P6], 1.7 kHz for 10 cm [P7] (spatial aliasing)&#10;So estimators interpolate below one sample (GCC-PHAT, SRP-PHAT), and small chips often report only a bin." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="630" y="70" width="620" height="86" as="geometry" /></mxCell><mxCell id="rule" value="FUSION RULE (an invariant, not a tuning default): ASD selects among visible faces; DoA gates, breaks ties and corroborates; the loudest direction never selects on its own. DoA binds to a visual track, never stands alone." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="630" y="166" width="620" height="50" as="geometry" /></mxCell><mxCell id="tier_h" value="TIERED LABELS after speech start (to scale): attach now, refine, repair before the NEXT turn" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="630" y="282" width="620" height="20" as="geometry" /></mxCell><mxCell id="tb_T0" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="640" y="306" width="36" height="18" as="geometry" /></mxCell><mxCell id="tl_T0" value="T0 250 ms [I13]: DoA x visible faces; never blocks a response" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="684" y="306" width="566" height="18" as="geometry" /></mxCell><mxCell id="tb_T1" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="640" y="328" width="145" height="18" as="geometry" /></mxCell><mxCell id="tl_T1" value="T1 by 1 s [I14]: ASD picks the talker; re-evaluated every frame" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="793" y="328" width="457" height="18" as="geometry" /></mxCell><mxCell id="tb_T2" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="640" y="350" width="580" height="18" as="geometry" /></mxCell><mxCell id="tl_T2" value="T2 up to 4 s [I15]: voice and face embeddings confirm or repair" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="646" y="350" width="570" height="18" as="geometry" /></mxCell><mxCell id="tt0" value="0 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="625" y="380" width="30" height="14" as="geometry" /></mxCell><mxCell id="tt1" value="1 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="770" y="380" width="30" height="14" as="geometry" /></mxCell><mxCell id="tt2" value="2 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="915" y="380" width="30" height="14" as="geometry" /></mxCell><mxCell id="tt3" value="3 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1060" y="380" width="30" height="14" as="geometry" /></mxCell><mxCell id="tt4" value="4 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1205" y="380" width="30" height="14" as="geometry" /></mxCell><mxCell id="lad_h" value="ATTRIBUTION LADDER, per turn (first rung that succeeds wins)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="630" y="406" width="620" height="20" as="geometry" /></mxCell><mxCell id="l1" value="1  ASD among faces big enough to score (at least 40 px wide [I19])" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="630" y="428" width="190" height="92" as="geometry" /></mxCell><mxCell id="l2" value="2  voice match: turn of 1.2 s or more [I16], cosine 0.55 [I17] and margin 0.15 [I18]; the only path that can name an off-camera voice" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="845" y="428" width="200" height="92" as="geometry" /></mxCell><mxCell id="l3" value="3  ABSTAIN: visitor_id null + a reason (off camera, contradicted, too short, blend). No sentinel id." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1070" y="428" width="180" height="92" as="geometry" /></mxCell><mxCell id="resp" value="'SHOULD I RESPOND?' is about DIRECTEDNESS: under doubt, lean toward answering. An over-response is recoverable ('oh, were you asking me?'); silence toward an engaged visitor is not. Directedness ('someone off camera is addressing you') ships in the same change as abstention." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="690" width="600" height="62" as="geometry" /></mxCell><mxCell id="who" value="'WHO SAID IT?' is about IDENTITY: be strict. A churning id stream cost 30% more input tokens per response [I20], and one wrong bind passed to the next 4 turns [I21] through a 'last active speaker' fallback. A missing label is far cheaper than a wrong one." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="650" y="690" width="600" height="62" as="geometry" /></mxCell><mxCell id="legend" value="Legend: circles = people or sound sources (green = talking, blue = silent visitor, grey = bystander, red = off-camera source) | green lines = camera field of view | amber dashed = face-matching window | grey dashed = direction bins." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="766" width="1220" height="26" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Every number is loaded from ../constants.json by the key shown. [Pn] = public (a paper, standard or physics value, or my arithmetic on one); [In] = illustrative (a round design value of the right order; never a measurement of a real robot or visitor); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/B2-who-is-speaking.md (DoA basics, the fusion rule, tiered labels, the robot's own voice, honest abstention, voices banked carefully, passing attribution to the model; 'check the input-size gate'). [calc]: window = 15 + 45 / 2, rounded to 40 deg; checked 0.10 m / 343 m/s = 292 us and asin(343 m/s x 62.5 us / 10 cm) = 12.4 deg.&#10;[P1] speed_of_sound_20c = 343 m/s. public: dry air at 20 degrees C (standard physics value)&#10;[P2] tdoa_max_10cm = 292 us. public: my arithmetic: 0.10 m / speed_of_sound_20c, the largest delay between two microphones 10 cm apart (sound arriving along the axis)&#10;[P3] sample_period_16k = 62.5 us. public: my arithmetic: 1 / 16 000 Hz&#10;[P4] sample_path_16k = 2.1 cm of path difference per sample. public: my arithmetic: speed_of_sound_20c x sample_period_16k&#10;[P5] one_sample_angle_10cm_16k = 12.4 degrees near broadside. public: my arithmetic: asin(sample_path_16k / 10 cm); why integer-lag cross-correlation is coarse and sub-sample interpolation (GCC-PHAT peak interpolation) is used&#10;[P6] spatial_alias_5cm = 3.4 kHz. public: my arithmetic: f &lt; c / (2 d) with d = 5 cm; above this a pair's phase difference wraps (spatial aliasing)&#10;[P7] spatial_alias_10cm = 1.7 kHz. public: my arithmetic: f &lt; c / (2 d) with d = 10 cm&#10;[I8] doa_bin_illustrative = 45 degrees per direction bin (8 bins). illustrative coarse on-chip direction-of-arrival quantisation&#10;[I9] doa_face_gate_illustrative = 15 degrees (nominal gate between a bearing and a face). illustrative&#10;[I10] doa_effective_window_illustrative = 40 degrees either side (gate widened by bin uncertainty). illustrative: my arithmetic, rounded: doa_face_gate_illustrative + half of doa_bin_illustrative&#10;[I11] fov_true_illustrative = 90 degrees. illustrative true horizontal field of view of the head camera&#10;[I12] self_speech_tail_illustrative = 400 ms. illustrative suppression tail after the robot stops speaking (reverberation decay + label latency)&#10;[I13] label_t0_illustrative = 250 ms after speech start. illustrative first provisional speaker label&#10;[I14] label_t1_illustrative = 1 s. illustrative mouth-motion refinement&#10;[I15] label_t2_illustrative = 4 s (latest). illustrative voice-identity confirmation at or after end of turn&#10;[I16] voice_embedding_min_illustrative = 1.2 s. illustrative minimum speech for a usable voice embedding; public speaker-verification work reports degradation for utterances of a few seconds or less&#10;[I17] voice_match_cosine_illustrative = 0.55 cosine similarity. illustrative match gate&#10;[I18] voice_match_margin_illustrative = 0.15 cosine (top-1 minus top-2). illustrative margin gate&#10;[I19] asd_min_face_illustrative = 40 px face width. illustrative input-size gate of an active-speaker detector&#10;[I20] id_churn_token_cost_illustrative = 0.3 fractional increase in input tokens per response. illustrative cost of a churning speaker-id stream to a speech-to-speech model&#10;[I21] cascade_turns_illustrative = 4 turns. illustrative number of later turns that inherit one wrong bind through a 'last active speaker' fallback" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="806" width="1220" height="308" as="geometry" /></mxCell><mxCell id="edge0" value="no" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="no" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="l2" target="l3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="line0" value="" style="endArrow=none;html=0;strokeColor=#aaaaaa;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="315" y="545" as="sourcePoint" /><mxPoint x="189" y="240" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line1" value="" style="endArrow=none;html=0;strokeColor=#aaaaaa;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="315" y="545" as="sourcePoint" /><mxPoint x="441" y="240" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line2" value="" style="endArrow=none;html=0;strokeColor=#aaaaaa;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="315" y="545" as="sourcePoint" /><mxPoint x="10" y="419" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line3" value="" style="endArrow=none;html=0;strokeColor=#aaaaaa;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="315" y="545" as="sourcePoint" /><mxPoint x="620" y="419" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line4" value="" style="endArrow=none;html=0;strokeColor=#2d7d2d;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="315" y="545" as="sourcePoint" /><mxPoint x="96" y="326" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line5" value="" style="endArrow=none;html=0;strokeColor=#2d7d2d;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="315" y="545" as="sourcePoint" /><mxPoint x="534" y="326" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line6" value="" style="endArrow=none;html=0;strokeColor=#b37400;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="315" y="545" as="sourcePoint" /><mxPoint x="219" y="430" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line7" value="" style="endArrow=none;html=0;strokeColor=#b37400;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="315" y="545" as="sourcePoint" /><mxPoint x="411" y="430" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line8" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="374" as="sourcePoint" /><mxPoint x="1220" y="374" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line9" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="374" as="sourcePoint" /><mxPoint x="640" y="379" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line10" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="785" y="374" as="sourcePoint" /><mxPoint x="785" y="379" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line11" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="930" y="374" as="sourcePoint" /><mxPoint x="930" y="379" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line12" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1075" y="374" as="sourcePoint" /><mxPoint x="1075" y="379" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line13" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220" y="374" as="sourcePoint" /><mxPoint x="1220" y="379" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p_05_gaze_gates" name="05-gaze-gates"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1049" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Gaze: aim the head only on trustworthy evidence, through gates in a fixed order where every failed gate means HOLD STILL, because a confident wrong turn tells a group the robot is talking to someone else" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="46" as="geometry" /></mxCell><mxCell id="L1" value="ATTRIBUTION&#10;who, and their bearing in ITS camera frame" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="186" height="56" as="geometry" /></mxCell><mxCell id="L2" value="FACE SELECTOR&#10;hysteresis, dropout grace" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="237" y="70" width="186" height="56" as="geometry" /></mxCell><mxCell id="L3" value="INTEREST LAYER&#10;what should the head do? one cell of the state matrix" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="444" y="70" width="186" height="56" as="geometry" /></mxCell><mxCell id="L4" value="GAZE POLICY&#10;may I aim now? the ordered gates below" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="651" y="70" width="186" height="56" as="geometry" /></mxCell><mxCell id="L5" value="HEAD CONTROLLER&#10;eased glide, nod overlay" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="858" y="70" width="186" height="56" as="geometry" /></mxCell><mxCell id="L6" value="ROBOT GATEWAY&#10;frame composition, limits, the only publisher" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1065" y="70" width="186" height="56" as="geometry" /></mxCell><mxCell id="lay_n" value="The policy emits INTENT, never angles. Decision code is pure: driven by injected inputs and a clock, testable without a robot, camera or middleware. Whom the speech is FOR comes from the reasoner's triage verdict, not from vision." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="30" y="130" width="1220" height="18" as="geometry" /></mxCell><mxCell id="g_h" value="THE GAZE POLICY: ordered gates (the order is the safety argument)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="168" width="620" height="20" as="geometry" /></mxCell><mxCell id="g0" value="1 STALENESS: never act on an old label" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="192" width="500" height="36" as="geometry" /></mxCell><mxCell id="g1" value="2 EVIDENCE: lock-eligible (mouth-motion winner, bearing-matched face, accepted by triage) / attention-only (a glance at most) / refused" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="232" width="500" height="36" as="geometry" /></mxCell><mxCell id="g2" value="3 SELF-SPEECH: while the robot speaks and for a tail, do not switch visitor (DoA may point at the robot); keep pursuing the locked face" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="272" width="500" height="36" as="geometry" /></mxCell><mxCell id="g3" value="4 SLEW HOLD: bearings taken during a head pan are the least trustworthy" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="312" width="500" height="36" as="geometry" /></mxCell><mxCell id="g4" value="5 DEADBAND: ignore changes under 0.05 rad [I1] (about 3 deg)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="352" width="500" height="36" as="geometry" /></mxCell><mxCell id="g5" value="6 DWELL: no re-aim within 2 s [I2]" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="392" width="500" height="36" as="geometry" /></mxCell><mxCell id="g6" value="7 CONTESTED: labels alternate faster than the dwell -&gt; hold; never average two speakers" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="432" width="500" height="36" as="geometry" /></mxCell><mxCell id="g7" value="8 PURSUIT: follow the same locked face frame by frame; disengage on face loss" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="472" width="500" height="36" as="geometry" /></mxCell><mxCell id="g8" value="9 SECTOR GLANCE: off-camera directed speech, bearing stable 0.6 s [I3], robot quiet -&gt; one glance, time-boxed to 3 s [I4]" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="512" width="500" height="36" as="geometry" /></mxCell><mxCell id="hold" value="HOLD&#10;&#10;keep the current aim; log the suppressed decision with a reason&#10;&#10;(a gaze that does not happen is the interesting case)" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="560" y="192" width="90" height="356" as="geometry" /></mxCell><mxCell id="aim" value="AIM: hand an eased glide to the head controller" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="556" width="500" height="34" as="geometry" /></mxCell><mxCell id="g_leg" value="green = pass, go to the next gate | red dashed = fail -&gt; HOLD. When unsure, hold still; gaze loss degrades to the old nearest-visitor gaze, never to no gaze." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="30" y="594" width="620" height="30" as="geometry" /></mxCell><mxCell id="frame" value="FRAMES. Composition rule: target yaw = MEASURED neck yaw + head-camera bearing, then clip. Using the COMMANDED yaw lets error pile up and the head 'walks away'. A bearing travels with its frame name; null, never 0, means 'no bearing'.&#10;Field of view: a face at a true 30 deg [I5] on a 90 deg camera [I6], converted linearly with a leftover 60 deg default [I7], reads 17.3 deg [I8] [calc]: the head under-turns by 12.7 deg [calc]. With the right FOV the linear formula still reads 26 deg [I9]; the pinhole form atan((x - cx) / fx) is exact (largest linear error about 4.1 deg [P10])." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="680" y="168" width="570" height="96" as="geometry" /></mxCell><mxCell id="motion" value="GLIDE, NOT SACCADE. A human 40 deg saccade takes about 109 ms [P13] (21 ms + 2.2 ms per deg [P11] [P12]). The team chose not to imitate it: every move is a smoothstep glide s = 3t^2 - 2t^3, duration growing with distance, peak speed capped at 1.5 rad/s [I14]. It arrives on both axes together, with zero speed at both ends and a clean completion event. Exponential smoothing (alpha 0.1 per 50 Hz tick [I15]) reaches 95 % in about 0.57 s [I16] but never finishes cleanly." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="680" y="274" width="570" height="84" as="geometry" /></mxCell><mxCell id="duty_h" value="DUTY CYCLE: share of time looking at the addressee. Plain alternation (5 s gaze [I19], 2 s away [I20]) gives 0.71 [I21] [calc]: inside the listening band, outside the speaking band." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="680" y="370" width="570" height="34" as="geometry" /></mxCell><mxCell id="dl_listening" value="robot design band, listening: 0.65-0.85 [I17]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="680" y="408" width="168" height="30" as="geometry" /></mxCell><mxCell id="db_listening" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1108" y="414" width="77" height="18" as="geometry" /></mxCell><mxCell id="dh_listening" value="human 0.75 [P22]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=right;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#7b4f9e;" vertex="1" parent="1"><mxGeometry x="1035" y="434" width="110" height="14" as="geometry" /></mxCell><mxCell id="dl_speaking" value="robot design band, speaking: 0.35-0.55 [I18]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="680" y="448" width="168" height="30" as="geometry" /></mxCell><mxCell id="db_speaking" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="991" y="454" width="78" height="18" as="geometry" /></mxCell><mxCell id="dh_speaking" value="human 0.41 [P23]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#7b4f9e;" vertex="1" parent="1"><mxGeometry x="1018" y="474" width="110" height="14" as="geometry" /></mxCell><mxCell id="dd" value="alternation 0.71" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1136" y="476" width="120" height="14" as="geometry" /></mxCell><mxCell id="dp0" value="0 %" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="835" y="498" width="40" height="14" as="geometry" /></mxCell><mxCell id="dp25" value="25 %" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="932" y="498" width="40" height="14" as="geometry" /></mxCell><mxCell id="dp50" value="50 %" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1030" y="498" width="40" height="14" as="geometry" /></mxCell><mxCell id="dp75" value="75 %" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1127" y="498" width="40" height="14" as="geometry" /></mxCell><mxCell id="dp100" value="100 %" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1225" y="498" width="40" height="14" as="geometry" /></mxCell><mxCell id="duty_n" value="So a seeded scheduler tracks the cumulative duty and draws randomised episode lengths (people notice periodicity). Live use then moved the look-away to an eyebrow beat: a head look-away took the face out of frame and the head oscillated." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="680" y="516" width="570" height="44" as="geometry" /></mxCell><mxCell id="legend" value="Legend: amber = gates and design bands | red = hold / self-speech | green = motion | blue = frames | purple ticks = public human gaze shares (the bands bracket them) | red dashed = plain alternation." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="638" width="1220" height="26" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Every number is loaded from ../constants.json by the key shown. [Pn] = public (a paper, standard or physics value, or my arithmetic on one); [In] = illustrative (a round design value of the right order; never a measurement of a real robot or visitor); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/B3-gaze.md (why nearest is wrong, layers, trust, frames, arbitration, gates, the state matrix and duty cycle, motion quality, 'how it is designed and tested'). [calc]: pinhole offset (x - 0.5) = tan(30) / tan(90 / 2) / 2; linear reading = offset x FOV; under-turn = 30 - 17.3; duty = 5 / (5 + 2); asserted in the spec: 21 + 2.2 x 40 = 109 ms and ln(0.05) / ln(1 - 0.1) / 50 = 0.57 s.&#10;[I1] gaze_deadband_illustrative = 0.05 rad (about 3 deg). illustrative re-aim deadband&#10;[I2] gaze_dwell_illustrative = 2 s. illustrative minimum time between re-aims&#10;[I3] sector_glance_hold_illustrative = 0.6 s. illustrative bearing stability needed before an off-camera glance&#10;[I4] sector_glance_box_illustrative = 3 s. illustrative time box for an off-camera acquisition glance&#10;[I5] fov_example_bearing_true = 30 degrees. illustrative true bearing of a face used in the field-of-view example&#10;[I6] fov_true_illustrative = 90 degrees. illustrative true horizontal field of view of the head camera&#10;[I7] fov_default_illustrative = 60 degrees. illustrative placeholder horizontal field of view left from a development webcam&#10;[I8] fov_example_linear_wrong_fov = 17.3 degrees. illustrative: my arithmetic: pixel position of fov_example_bearing_true under a pinhole camera with fov_true_illustrative, converted back with the linear formula and fov_default_illustrative&#10;[I9] fov_example_linear_right_fov = 26 degrees. illustrative: my arithmetic: the same pixel converted with the linear formula and fov_true_illustrative&#10;[P10] linear_vs_pinhole_max_err_90 = 4.1 degrees (largest near halfway to the edge). public: my arithmetic: max over u of atan(u tan 45 deg) - 45 u deg for a 90 deg field of view&#10;[P11] saccade_duration_intercept = 21 ms. public: Carpenter, Movements of the Eyes, 1988: saccade duration ~ 21 ms + 2.2 ms per degree (main-sequence approximation; Bahill, Clark &amp; Stark 1975)&#10;[P12] saccade_duration_slope = 2.2 ms per degree. public: Carpenter 1988&#10;[P13] saccade_40deg_duration = 109 ms. public: my arithmetic from saccade_duration_intercept and saccade_duration_slope at 40 degrees&#10;[I14] head_slew_cap_illustrative = 1.5 rad/s (about 86 deg/s). illustrative peak head speed cap&#10;[I15] head_ema_alpha_illustrative = 0.1 per tick at 50 Hz. illustrative exponential smoothing of a head setpoint&#10;[I16] head_ema_t95_illustrative = 0.57 s to 95 %. illustrative: my arithmetic: ln(0.05) / ln(1 - head_ema_alpha_illustrative) / 50 Hz&#10;[I17] gaze_band_listening_illustrative = [0.65, 0.85] fraction of time looking at the addressee. illustrative design band, bracketing gaze_listener_share&#10;[I18] gaze_band_speaking_illustrative = [0.35, 0.55] fraction of time looking at the addressee. illustrative design band, bracketing gaze_speaker_share&#10;[I19] gaze_episode_mean_illustrative = 5 s. illustrative mean gaze episode&#10;[I20] lookaway_mean_illustrative = 2 s. illustrative mean look-away&#10;[I21] alternation_duty_illustrative = 0.71 fraction. illustrative: my arithmetic: gaze_episode_mean_illustrative / (gaze_episode_mean_illustrative + lookaway_mean_illustrative); inside the listening band, outside the speaking band&#10;[P22] gaze_listener_share = 0.75 fraction of listening time spent looking at the speaker. public: Argyle &amp; Ingham, 'Gaze, mutual gaze and proximity', Semiotica 6, 1972; summarised in Argyle &amp; Cook, Gaze and Mutual Gaze, 1976 (commonly cited dyadic figures)&#10;[P23] gaze_speaker_share = 0.41 fraction of speaking time spent looking at the listener. public: Argyle &amp; Ingham 1972; Argyle &amp; Cook 1976" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="678" width="1220" height="355" as="geometry" /></mxCell><mxCell id="edge0" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="L1" target="L2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="L2" target="L3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge2" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="L3" target="L4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge3" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="L4" target="L5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge4" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="L5" target="L6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge5" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.06;exitY=1;exitDx=0;exitDy=0;entryX=0.06;entryY=0;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="g0" target="g1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge6" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.06;exitY=1;exitDx=0;exitDy=0;entryX=0.06;entryY=0;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="g1" target="g2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge7" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.06;exitY=1;exitDx=0;exitDy=0;entryX=0.06;entryY=0;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="g2" target="g3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge8" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.06;exitY=1;exitDx=0;exitDy=0;entryX=0.06;entryY=0;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="g3" target="g4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge9" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.06;exitY=1;exitDx=0;exitDy=0;entryX=0.06;entryY=0;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="g4" target="g5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge10" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.06;exitY=1;exitDx=0;exitDy=0;entryX=0.06;entryY=0;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="g5" target="g6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge11" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.06;exitY=1;exitDx=0;exitDy=0;entryX=0.06;entryY=0;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="g6" target="g7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge12" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.06;exitY=1;exitDx=0;exitDy=0;entryX=0.06;entryY=0;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="g7" target="g8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge13" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.05056179775280899;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="g0" target="hold"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge14" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.16292134831460675;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="g1" target="hold"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge15" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2752808988764045;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="g2" target="hold"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge16" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.38764044943820225;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="g3" target="hold"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge17" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="g4" target="hold"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge18" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6123595505617978;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="g5" target="hold"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge19" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7247191011235955;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="g6" target="hold"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge20" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8370786516853933;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="g7" target="hold"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge21" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.949438202247191;entryDx=0;entryDy=0;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1" source="g8" target="hold"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge22" value="" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=0.06;exitY=1;exitDx=0;exitDy=0;entryX=0.06;entryY=0;entryDx=0;entryDy=0;strokeColor=#2d7d2d;fontColor=#2d7d2d;" edge="1" parent="1" source="g8" target="aim"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="line0" value="" style="endArrow=none;html=0;strokeColor=#7b4f9e;strokeWidth=2.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1148" y="410" as="sourcePoint" /><mxPoint x="1148" y="436" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line1" value="" style="endArrow=none;html=0;strokeColor=#7b4f9e;strokeWidth=2.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1015" y="450" as="sourcePoint" /><mxPoint x="1015" y="476" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line2" value="" style="endArrow=none;html=0;strokeColor=#b85450;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1132" y="406" as="sourcePoint" /><mxPoint x="1132" y="488" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line3" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="855" y="492" as="sourcePoint" /><mxPoint x="1245.0" y="492" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line4" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="855.0" y="492" as="sourcePoint" /><mxPoint x="855.0" y="497" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line5" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="952.5" y="492" as="sourcePoint" /><mxPoint x="952.5" y="497" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line6" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1050.0" y="492" as="sourcePoint" /><mxPoint x="1050.0" y="497" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line7" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1147.5" y="492" as="sourcePoint" /><mxPoint x="1147.5" y="497" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line8" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1245.0" y="492" as="sourcePoint" /><mxPoint x="1245.0" y="497" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p_06_guard_blind_spot" name="06-guard-blind-spot"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1010" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Why the clever guard was turned off: an onset grace of 2 s [I2] cannot tell a 1.5 s greeting [I1] followed by a 200 ms human reply [P3] from the robot hearing itself, so the visitor's first word was rejected and one rejection ended the visit" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="46" as="geometry" /></mxCell><mxCell id="t_h" value="A. THE NEW OPENING, to scale (one visit, time from the robot's speech onset). Positions of the visitor's reply follow the public turn gap." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="72" width="1220" height="20" as="geometry" /></mxCell><mxCell id="ln_robot" value="robot loudspeaker" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="102" width="290" height="40" as="geometry" /></mxCell><mxCell id="ln_mic" value="processed microphone channel (what the model hears)" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="148" width="290" height="40" as="geometry" /></mxCell><mxCell id="ln_guard" value="spectral barge-in guard" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="194" width="290" height="40" as="geometry" /></mxCell><mxCell id="ln_visitor" value="visitor" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="240" width="290" height="40" as="geometry" /></mxCell><mxCell id="ln_model" value="the reasoner (speech-to-speech model)" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="286" width="290" height="40" as="geometry" /></mxCell><mxCell id="b_greet" value="perception-triggered greeting 1.5 s [I1]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="330" y="108" width="330" height="30" as="geometry" /></mxCell><mxCell id="b_leak" value="self-hearing leaks 0.2-0.8 s [I4]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="374" y="154" width="132" height="30" as="geometry" /></mxCell><mxCell id="b_supp" value="late suppression: -20 dB [I5]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="506" y="154" width="154" height="30" as="geometry" /></mxCell><mxCell id="b_grace" value="ONSET GRACE 2 s [I2]: VAD onsets here are rejected" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;dashed=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="330" y="200" width="440" height="30" as="geometry" /></mxCell><mxCell id="b_reply" value="first reply starts at 1.7 s [calc]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="704" y="246" width="286" height="30" as="geometry" /></mxCell><mxCell id="b_rej" value="REJECTED" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="700" y="202" width="92" height="26" as="geometry" /></mxCell><mxCell id="b_idle" value="holds an unanswered greeting, stops listening -&gt; the robot goes idle: the visit is over" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="759" y="292" width="451" height="30" as="geometry" /></mxCell><mxCell id="gap_l" value="greeting ends at 1.5 s; the reply follows after the typical human gap of 200 ms [P3] -&gt;" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#2d7d2d;" vertex="1" parent="1"><mxGeometry x="352" y="246" width="346" height="30" as="geometry" /></mxCell><mxCell id="tk0" value="0 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="310" y="342" width="40" height="14" as="geometry" /></mxCell><mxCell id="tk5" value="0.5 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="420" y="342" width="40" height="14" as="geometry" /></mxCell><mxCell id="tk10" value="1 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="530" y="342" width="40" height="14" as="geometry" /></mxCell><mxCell id="tk15" value="1.5 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="640" y="342" width="40" height="14" as="geometry" /></mxCell><mxCell id="tk20" value="2 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="750" y="342" width="40" height="14" as="geometry" /></mxCell><mxCell id="tk25" value="2.5 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="860" y="342" width="40" height="14" as="geometry" /></mxCell><mxCell id="tk30" value="3 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="970" y="342" width="40" height="14" as="geometry" /></mxCell><mxCell id="tk35" value="3.5 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1080" y="342" width="40" height="14" as="geometry" /></mxCell><mxCell id="tk40" value="4 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1190" y="342" width="40" height="14" as="geometry" /></mxCell><mxCell id="t_note" value="The guard's design argued 'a rejection costs at most one utterance'. Here that utterance was the first reply to the greeting, so it cost the whole visit. The interaction design changed underneath the defence; the code, tests and promotion rule stayed, only the default moved to OFF (with a boot-log line confirming the setting). A platform audio update had also removed most of the self-hearing it was built for." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="360" width="1220" height="34" as="geometry" /></mxCell><mxCell id="s_h" value="B. WHY PHANTOM BARGE-INS HAPPEN" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="412" width="400" height="20" as="geometry" /></mxCell><mxCell id="src_m" value="(a) THE ROBOT'S OWN MOTORS: impulsive rumble, mostly 60-250 Hz [I12]. Head moving vs holding: raw microphone +8 dB [I8], processed channel +20 dB [I9] (gain control winds up with no speech present); the motion was 3 dB [I10] louder than a nearby talker. Noise-only clips came back as words 5 of 5 times [I11]. Feedback cancellation cannot help: motors have no reference signal." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="436" width="400" height="100" as="geometry" /></mxCell><mxCell id="src_v" value="(b) THE ROBOT'S OWN VOICE: 15 dB [I6] above the room floor during every robot speech window; suppression is late and incomplete, likely because a clipped return is nonlinear and no linear canceller removes it." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="544" width="400" height="62" as="geometry" /></mxCell><mxCell id="g_h" value="C. THE GUARD (what it does when it is on)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="460" y="412" width="380" height="20" as="geometry" /></mxCell><mxCell id="g_txt" value="Only when VAD would interrupt the robot: for each 200 ms sub-window [I13] at a 50 ms stride [I14], score = 10 log10(E[400-3000 Hz [I15]] / E[rumble band]); keep the MAXIMUM, because one clear vowel is enough. Fail OPEN on any error: 'a deaf robot is a product failure'." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="460" y="436" width="380" height="74" as="geometry" /></mxCell><mxCell id="sd0" value="0 dB" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="462" y="558" width="36" height="14" as="geometry" /></mxCell><mxCell id="sd2" value="2 dB" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="522" y="558" width="36" height="14" as="geometry" /></mxCell><mxCell id="sd4" value="4 dB" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="582" y="558" width="36" height="14" as="geometry" /></mxCell><mxCell id="sd6" value="6 dB" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="642" y="558" width="36" height="14" as="geometry" /></mxCell><mxCell id="sd8" value="8 dB" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="702" y="558" width="36" height="14" as="geometry" /></mxCell><mxCell id="sd10" value="10 dB" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="762" y="558" width="36" height="14" as="geometry" /></mxCell><mxCell id="s_ph" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="480" y="530" width="90" height="16" as="geometry" /></mxCell><mxCell id="s_rl" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="720" y="530" width="90" height="16" as="geometry" /></mxCell><mxCell id="s_phl" value="motor onsets up to 3 dB [I16]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="480" y="512" width="170" height="16" as="geometry" /></mxCell><mxCell id="s_thl" value="threshold 5 dB [I17]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#b37400;" vertex="1" parent="1"><mxGeometry x="590" y="572" width="120" height="16" as="geometry" /></mxCell><mxCell id="s_rll" value="real onsets from 8 dB [I18]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=right;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#2d7d2d;" vertex="1" parent="1"><mxGeometry x="670" y="512" width="140" height="16" as="geometry" /></mxCell><mxCell id="s_n" value="Perfect separation on one robot, one room and one talker is a FIT, not a generalisation." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="460" y="590" width="380" height="30" as="geometry" /></mxCell><mxCell id="p_h" value="D. SHIP A GUARD BY A WRITTEN RULE" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="870" y="412" width="380" height="20" as="geometry" /></mxCell><mxCell id="p_rule" value="Shadow mode first (log would-be decisions, change nothing). Default ON needs ALL of: 60 in-scope evaluations [I19]; 15 scripted real barge-ins, none rejected [I20]; 85 % of motor onsets rejected [I21]; a 3 dB worst-case margin [I22]." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="870" y="436" width="380" height="66" as="geometry" /></mxCell><mxCell id="p_meas" value="Every turn-taking change gets TWO measurements, on the robot, moving and speaking, in venue noise: phantom turns caused (false barge-ins, ghost wakes) and real turns lost (rejected barge-ins, missed starts), with sample sizes. Barge-in itself stops the robot only after a 0.4 s debounce [I7]." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="870" y="512" width="380" height="94" as="geometry" /></mxCell><mxCell id="legend" value="Legend: purple = robot speech | red = self-hearing, rejection and failure | amber dashed = the onset grace and the guard threshold | green = the visitor's real speech | grey = suppressed channel. Durations and dB are illustrative except the public turn gap." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="634" width="1220" height="26" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Every number is loaded from ../constants.json by the key shown. [Pn] = public (a paper, standard or physics value, or my arithmetic on one); [In] = illustrative (a round design value of the right order; never a measurement of a real robot or visitor); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/B4-turn-taking-and-self-hearing.md (how a barge-in is handled, two sources of phantom barge-ins, the spectral barge-in guard, why the clever guard was turned off, 'how it is designed and tested'); Stivers et al. 2009 for the turn gap. [calc]: reply onset = greeting 1.5 s + gap 0.2 s = 1.7 s, which is under the 2 s grace. The reply's length on the canvas is a drawing choice.&#10;[I1] proactive_greeting_illustrative = 1.5 s. illustrative length of a perception-triggered greeting; shorter than guard_onset_grace_illustrative&#10;[I2] guard_onset_grace_illustrative = 2 s. illustrative 'self-hearing grace' after robot speech onset&#10;[P3] turn_gap_typical = 200 ms. public: Stivers et al., 'Universals and cultural variation in turn-taking in conversation', PNAS 106(26), 2009: offsets between turns cluster around a short gap of about 200 ms across 10 languages&#10;[I4] self_hearing_leak_window_illustrative = [0.2, 0.8] s after robot sound onset. illustrative window before late self-sound suppression engages&#10;[I5] self_hearing_suppressed_drop_illustrative = 20 dB. illustrative drop of the processed channel once suppression engages&#10;[I6] self_hearing_lift_illustrative = 15 dB above the room floor on the processed channel during robot speech. illustrative&#10;[I7] barge_in_debounce_illustrative = 0.4 s. illustrative debounce between a 'speech started' event and abandoning the robot's turn&#10;[I8] actuator_lift_raw_illustrative = 8 dB (raw microphone, head moving vs holding). illustrative&#10;[I9] actuator_lift_processed_illustrative = 20 dB (processed channel, head moving vs holding). illustrative; larger than actuator_lift_raw_illustrative because automatic gain control winds up&#10;[I10] motion_over_speech_processed_illustrative = 3 dB (robot's own motion louder than a nearby talker on the processed channel). illustrative&#10;[I11] noise_only_transcripts_illustrative = [5, 5] [attempts producing words, attempts]. illustrative: every noise-only clip sent to a transcription model came back as words&#10;[I12] guard_low_band_illustrative = [60, 250] Hz. illustrative actuator-rumble band&#10;[I13] guard_subwindow_illustrative = 200 ms. illustrative sub-window of the spectral barge-in guard&#10;[I14] guard_stride_illustrative = 50 ms. illustrative stride&#10;[I15] guard_speech_band_illustrative = [400, 3000] Hz. illustrative speech band&#10;[I16] guard_phantom_max_illustrative = 3 dB. illustrative highest score of motor-noise onsets in a fitted set&#10;[I17] guard_threshold_illustrative = 5 dB. illustrative decision threshold on the max sub-window speech-to-rumble ratio&#10;[I18] guard_real_min_illustrative = 8 dB. illustrative lowest score of real speech onsets in a fitted set&#10;[I19] guard_promo_evaluations_illustrative = 60 in-scope evaluations. illustrative promotion criterion&#10;[I20] guard_promo_real_bargeins_illustrative = 15 scripted real barge-ins, none rejected. illustrative promotion criterion&#10;[I21] guard_promo_reject_rate_illustrative = 0.85 fraction of motor-noise onsets rejected. illustrative promotion criterion&#10;[I22] guard_promo_margin_illustrative = 3 dB worst-case class margin. illustrative promotion criterion" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="674" width="1220" height="320" as="geometry" /></mxCell><mxCell id="line0" value="" style="endArrow=none;html=0;strokeColor=#dddddd;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="145" as="sourcePoint" /><mxPoint x="1210.0" y="145" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line1" value="" style="endArrow=none;html=0;strokeColor=#dddddd;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="191" as="sourcePoint" /><mxPoint x="1210.0" y="191" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line2" value="" style="endArrow=none;html=0;strokeColor=#dddddd;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="237" as="sourcePoint" /><mxPoint x="1210.0" y="237" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line3" value="" style="endArrow=none;html=0;strokeColor=#dddddd;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="283" as="sourcePoint" /><mxPoint x="1210.0" y="283" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line4" value="" style="endArrow=none;html=0;strokeColor=#dddddd;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="329" as="sourcePoint" /><mxPoint x="1210.0" y="329" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line5" value="" style="endArrow=none;html=0;strokeColor=#2d7d2d;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="704" y="108" as="sourcePoint" /><mxPoint x="704" y="322" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line6" value="" style="endArrow=none;html=0;strokeColor=#b37400;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry re