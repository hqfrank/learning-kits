<mxfile host="app.diagrams.net"><diagram id="p_04_who_is_speaking" name="04-who-is-speaking"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="1130" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Who is speaking: the face's moving mouth SELECTS, the coarse microphone bearing only gates and corroborates, and when the voice has no face the label is 'unidentified', because a confident wrong name costs more than no name" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=17;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="46" as="geometry" /></mxCell><mxCell id="sc_h" value="A. TOP-DOWN SCENE AT THE STAND (positions are a drawing choice, not data)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="70" width="570" height="20" as="geometry" /></mxCell><mxCell id="fov_l" value="head-camera field of view 90 deg [I11]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#2d7d2d;" vertex="1" parent="1"><mxGeometry x="52" y="288" width="170" height="30" as="geometry" /></mxCell><mxCell id="win_l" value="amber dashed = face window +-40 deg [I10] = gate 15 deg [I9] + half a bin [calc]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#b37400;" vertex="1" parent="1"><mxGeometry x="30" y="130" width="300" height="34" as="geometry" /></mxCell><mxCell id="bin_l" value="grey dashed = on-chip direction bins, 45 deg each (8 directions) [I8]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="96" width="260" height="30" as="geometry" /></mxCell><mxCell id="v1" value="" style="rounded=1;whiteSpace=wrap;html=0;arcSize=30;verticalAlign=middle;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="271" y="327" width="30" height="30" as="geometry" /></mxCell><mxCell id="v1_l" value="visitor_1&#10;mouth moving" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="168" y="328" width="100" height="30" as="geometry" /></mxCell><mxCell id="v2" value="" style="rounded=1;whiteSpace=wrap;html=0;arcSize=30;verticalAlign=middle;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="351" y="290" width="30" height="30" as="geometry" /></mxCell><mxCell id="v2_l" value="visitor_2&#10;silent" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="384" y="291" width="100" height="30" as="geometry" /></mxCell><mxCell id="by" value="" style="rounded=1;whiteSpace=wrap;html=0;arcSize=30;verticalAlign=middle;align=center;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="152" y="437" width="30" height="30" as="geometry" /></mxCell><mxCell id="by_l" value="bystander, outside&#10;the window, silent" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="49" y="438" width="100" height="30" as="geometry" /></mxCell><mxCell id="ph" value="" style="rounded=1;whiteSpace=wrap;html=0;arcSize=30;verticalAlign=middle;align=center;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="501" y="441" width="30" height="30" as="geometry" /></mxCell><mxCell id="ph_l" value="a phone playing&#10;speech, OFF camera" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="534" y="442" width="100" height="30" as="geometry" /></mxCell><mxCell id="robot" value="ROBOT&#10;mic array" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="269" y="537" width="92" height="34" as="geometry" /></mxCell><mxCell id="sc_n1" value="visitor_1 and visitor_2 share ONE bin and both sit inside the window: the bearing ABSTAINS and defers to active-speaker detection, which picks visitor_1 by the moving mouth." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="590" width="270" height="84" as="geometry" /></mxCell><mxCell id="sc_n2" value="The phone's bearing has NO face: positive evidence for 'unidentified'. It must not be pinned on the silent person in front. While the robot itself speaks, and for 400 ms after [I12], DoA evidence is ignored (the loudest direction may be the robot)." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="315" y="590" width="285" height="84" as="geometry" /></mxCell><mxCell id="phys" value="WHY A SMALL ARRAY IS COARSE (public physics)&#10;sound 343 m/s [P1] -&gt; largest delay across a 10 cm pair 292 us [P2]&#10;one sample at 16 kHz = 62.5 us [P3] = 2.1 cm of path [P4] -&gt; an integer lag resolves only about 12.4 deg near broadside [P5]&#10;phase wraps above c / 2d: 3.4 kHz for a 5 cm pair [P6], 1.7 kHz for 10 cm [P7] (spatial aliasing)&#10;So estimators interpolate below one sample (GCC-PHAT, SRP-PHAT), and small chips often report only a bin." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="630" y="70" width="620" height="86" as="geometry" /></mxCell><mxCell id="rule" value="FUSION RULE (an invariant, not a tuning default): ASD selects among visible faces; DoA gates, breaks ties and corroborates; the loudest direction never selects on its own. DoA binds to a visual track, never stands alone." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="630" y="166" width="620" height="50" as="geometry" /></mxCell><mxCell id="tier_h" value="TIERED LABELS after speech start (to scale): attach now, refine, repair before the NEXT turn" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="630" y="282" width="620" height="20" as="geometry" /></mxCell><mxCell id="tb_T0" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="640" y="306" width="36" height="18" as="geometry" /></mxCell><mxCell id="tl_T0" value="T0 250 ms [I13]: DoA x visible faces; never blocks a response" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="684" y="306" width="566" height="18" as="geometry" /></mxCell><mxCell id="tb_T1" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="640" y="328" width="145" height="18" as="geometry" /></mxCell><mxCell id="tl_T1" value="T1 by 1 s [I14]: ASD picks the talker; re-evaluated every frame" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="793" y="328" width="457" height="18" as="geometry" /></mxCell><mxCell id="tb_T2" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="640" y="350" width="580" height="18" as="geometry" /></mxCell><mxCell id="tl_T2" value="T2 up to 4 s [I15]: voice and face embeddings confirm or repair" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="646" y="350" width="570" height="18" as="geometry" /></mxCell><mxCell id="tt0" value="0 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="625" y="380" width="30" height="14" as="geometry" /></mxCell><mxCell id="tt1" value="1 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="770" y="380" width="30" height="14" as="geometry" /></mxCell><mxCell id="tt2" value="2 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="915" y="380" width="30" height="14" as="geometry" /></mxCell><mxCell id="tt3" value="3 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1060" y="380" width="30" height="14" as="geometry" /></mxCell><mxCell id="tt4" value="4 s" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1205" y="380" width="30" height="14" as="geometry" /></mxCell><mxCell id="lad_h" value="ATTRIBUTION LADDER, per turn (first rung that succeeds wins)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="630" y="406" width="620" height="20" as="geometry" /></mxCell><mxCell id="l1" value="1  ASD among faces big enough to score (at least 40 px wide [I19])" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="630" y="428" width="190" height="92" as="geometry" /></mxCell><mxCell id="l2" value="2  voice match: turn of 1.2 s or more [I16], cosine 0.55 [I17] and margin 0.15 [I18]; the only path that can name an off-camera voice" style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="845" y="428" width="200" height="92" as="geometry" /></mxCell><mxCell id="l3" value="3  ABSTAIN: visitor_id null + a reason (off camera, contradicted, too short, blend). No sentinel id." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=center;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1070" y="428" width="180" height="92" as="geometry" /></mxCell><mxCell id="resp" value="'SHOULD I RESPOND?' is about DIRECTEDNESS: under doubt, lean toward answering. An over-response is recoverable ('oh, were you asking me?'); silence toward an engaged visitor is not. Directedness ('someone off camera is addressing you') ships in the same change as abstention." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="690" width="600" height="62" as="geometry" /></mxCell><mxCell id="who" value="'WHO SAID IT?' is about IDENTITY: be strict. A churning id stream cost 30% more input tokens per response [I20], and one wrong bind passed to the next 4 turns [I21] through a 'last active speaker' fallback. A missing label is far cheaper than a wrong one." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=top;align=left;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="650" y="690" width="600" height="62" as="geometry" /></mxCell><mxCell id="legend" value="Legend: circles = people or sound sources (green = talking, blue = silent visitor, grey = bystander, red = off-camera source) | green lines = camera field of view | amber dashed = face-matching window | grey dashed = direction bins." style="rounded=1;whiteSpace=wrap;html=0;arcSize=16;verticalAlign=middle;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="766" width="1220" height="26" as="geometry" /></mxCell><mxCell id="sources" value="Sources. Every number is loaded from ../constants.json by the key shown. [Pn] = public (a paper, standard or physics value, or my arithmetic on one); [In] = illustrative (a round design value of the right order; never a measurement of a real robot or visitor); [calc] = my arithmetic on tagged values.&#10;Mechanism: notes/B2-who-is-speaking.md (DoA basics, the fusion rule, tiered labels, the robot's own voice, honest abstention, voices banked carefully, passing attribution to the model; 'check the input-size gate'). [calc]: window = 15 + 45 / 2, rounded to 40 deg; checked 0.10 m / 343 m/s = 292 us and asin(343 m/s x 62.5 us / 10 cm) = 12.4 deg.&#10;[P1] speed_of_sound_20c = 343 m/s. public: dry air at 20 degrees C (standard physics value)&#10;[P2] tdoa_max_10cm = 292 us. public: my arithmetic: 0.10 m / speed_of_sound_20c, the largest delay between two microphones 10 cm apart (sound arriving along the axis)&#10;[P3] sample_period_16k = 62.5 us. public: my arithmetic: 1 / 16 000 Hz&#10;[P4] sample_path_16k = 2.1 cm of path difference per sample. public: my arithmetic: speed_of_sound_20c x sample_period_16k&#10;[P5] one_sample_angle_10cm_16k = 12.4 degrees near broadside. public: my arithmetic: asin(sample_path_16k / 10 cm); why integer-lag cross-correlation is coarse and sub-sample interpolation (GCC-PHAT peak interpolation) is used&#10;[P6] spatial_alias_5cm = 3.4 kHz. public: my arithmetic: f &lt; c / (2 d) with d = 5 cm; above this a pair's phase difference wraps (spatial aliasing)&#10;[P7] spatial_alias_10cm = 1.7 kHz. public: my arithmetic: f &lt; c / (2 d) with d = 10 cm&#10;[I8] doa_bin_illustrative = 45 degrees per direction bin (8 bins). illustrative coarse on-chip direction-of-arrival quantisation&#10;[I9] doa_face_gate_illustrative = 15 degrees (nominal gate between a bearing and a face). illustrative&#10;[I10] doa_effective_window_illustrative = 40 degrees either side (gate widened by bin uncertainty). illustrative: my arithmetic, rounded: doa_face_gate_illustrative + half of doa_bin_illustrative&#10;[I11] fov_true_illustrative = 90 degrees. illustrative true horizontal field of view of the head camera&#10;[I12] self_speech_tail_illustrative = 400 ms. illustrative suppression tail after the robot stops speaking (reverberation decay + label latency)&#10;[I13] label_t0_illustrative = 250 ms after speech start. illustrative first provisional speaker label&#10;[I14] label_t1_illustrative = 1 s. illustrative mouth-motion refinement&#10;[I15] label_t2_illustrative = 4 s (latest). illustrative voice-identity confirmation at or after end of turn&#10;[I16] voice_embedding_min_illustrative = 1.2 s. illustrative minimum speech for a usable voice embedding; public speaker-verification work reports degradation for utterances of a few seconds or less&#10;[I17] voice_match_cosine_illustrative = 0.55 cosine similarity. illustrative match gate&#10;[I18] voice_match_margin_illustrative = 0.15 cosine (top-1 minus top-2). illustrative margin gate&#10;[I19] asd_min_face_illustrative = 40 px face width. illustrative input-size gate of an active-speaker detector&#10;[I20] id_churn_token_cost_illustrative = 0.3 fractional increase in input tokens per response. illustrative cost of a churning speaker-id stream to a speech-to-speech model&#10;[I21] cascade_turns_illustrative = 4 turns. illustrative number of later turns that inherit one wrong bind through a 'last active speaker' fallback" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="806" width="1220" height="308" as="geometry" /></mxCell><mxCell id="edge0" value="no" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge1" value="no" style="endArrow=classic;html=0;fontSize=10;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#666666;fontColor=#666666;" edge="1" parent="1" source="l2" target="l3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="line0" value="" style="endArrow=none;html=0;strokeColor=#aaaaaa;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="315" y="545" as="sourcePoint" /><mxPoint x="189" y="240" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line1" value="" style="endArrow=none;html=0;strokeColor=#aaaaaa;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="315" y="545" as="sourcePoint" /><mxPoint x="441" y="240" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line2" value="" style="endArrow=none;html=0;strokeColor=#aaaaaa;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="315" y="545" as="sourcePoint" /><mxPoint x="10" y="419" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line3" value="" style="endArrow=none;html=0;strokeColor=#aaaaaa;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="315" y="545" as="sourcePoint" /><mxPoint x="620" y="419" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line4" value="" style="endArrow=none;html=0;strokeColor=#2d7d2d;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="315" y="545" as="sourcePoint" /><mxPoint x="96" y="326" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line5" value="" style="endArrow=none;html=0;strokeColor=#2d7d2d;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="315" y="545" as="sourcePoint" /><mxPoint x="534" y="326" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line6" value="" style="endArrow=none;html=0;strokeColor=#b37400;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="315" y="545" as="sourcePoint" /><mxPoint x="219" y="430" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line7" value="" style="endArrow=none;html=0;strokeColor=#b37400;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="315" y="545" as="sourcePoint" /><mxPoint x="411" y="430" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line8" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="374" as="sourcePoint" /><mxPoint x="1220" y="374" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line9" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="374" as="sourcePoint" /><mxPoint x="640" y="379" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line10" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="785" y="374" as="sourcePoint" /><mxPoint x="785" y="379" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line11" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="930" y="374" as="sourcePoint" /><mxPoint x="930" y="379" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line12" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1075" y="374" as="sourcePoint" /><mxPoint x="1075" y="379" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line13" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220" y="374" as="sourcePoint" /><mxPoint x="1220" y="379" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>