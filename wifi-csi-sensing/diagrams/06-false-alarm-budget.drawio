<mxfile host="app.diagrams.net"><diagram id="p_06_false_alarm_budget" name="06-false-alarm-budget"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="702" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="uline0" value="" style="endArrow=none;html=0;strokeColor=#e2e2e2;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="112.0" as="sourcePoint" /><mxPoint x="620" y="112.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="uline1" value="" style="endArrow=none;html=0;strokeColor=#e2e2e2;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="168.0" as="sourcePoint" /><mxPoint x="620" y="168.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="uline2" value="" style="endArrow=none;html=0;strokeColor=#e2e2e2;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="224.0" as="sourcePoint" /><mxPoint x="620" y="224.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="uline3" value="" style="endArrow=none;html=0;strokeColor=#e2e2e2;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="280.0" as="sourcePoint" /><mxPoint x="620" y="280.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="uline4" value="" style="endArrow=none;html=0;strokeColor=#e2e2e2;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="336.0" as="sourcePoint" /><mxPoint x="620" y="336.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="uline5" value="" style="endArrow=none;html=0;strokeColor=#e2e2e2;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="392.0" as="sourcePoint" /><mxPoint x="620" y="392.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="uline6" value="" style="endArrow=none;html=0;strokeColor=#e2e2e2;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="448.0" as="sourcePoint" /><mxPoint x="620" y="448.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="title" value="&quot;1% FPR&quot; is about 26 000 false alarms per home per month - a budget of 4 needs a per-window FPR near 1.5 x 10⁻⁶: fix the budget first" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=15;fontStyle=1;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="34" as="geometry" /></mxCell><mxCell id="chart" value="Per-window false-positive rate (log scale) and what it means at one decision per 1 s [1]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="620" height="470" as="geometry" /></mxCell><mxCell id="ax_l" value="left: per-window FPR | right of axis: false&#10;alarms per 30 days [2] (my arithmetic)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="36" y="470" width="240" height="36" as="geometry" /></mxCell><mxCell id="tk1" value="10⁻¹" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="86" y="103" width="58" height="18" as="geometry" /></mxCell><mxCell id="tm1" value="259 200 / month" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="156" y="114" width="90" height="16" as="geometry" /></mxCell><mxCell id="tk2" value="10⁻²" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="86" y="159" width="58" height="18" as="geometry" /></mxCell><mxCell id="tm2" value="25 920 / month" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="156" y="170" width="90" height="16" as="geometry" /></mxCell><mxCell id="tk3" value="10⁻³" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="86" y="215" width="58" height="18" as="geometry" /></mxCell><mxCell id="tm3" value="2592 / month" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="156" y="226" width="90" height="16" as="geometry" /></mxCell><mxCell id="tk4" value="10⁻⁴" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="86" y="271" width="58" height="18" as="geometry" /></mxCell><mxCell id="tm4" value="259 / month" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="156" y="282" width="90" height="16" as="geometry" /></mxCell><mxCell id="tk5" value="10⁻⁵" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="86" y="327" width="58" height="18" as="geometry" /></mxCell><mxCell id="tm5" value="26 / month" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="156" y="338" width="90" height="16" as="geometry" /></mxCell><mxCell id="tk6" value="10⁻⁶" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="86" y="383" width="58" height="18" as="geometry" /></mxCell><mxCell id="tm6" value="3 / month" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="156" y="394" width="90" height="16" as="geometry" /></mxCell><mxCell id="tk7" value="10⁻⁷" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="86" y="439" width="58" height="18" as="geometry" /></mxCell><mxCell id="tm7" value="0.26 / month" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="156" y="450" width="90" height="16" as="geometry" /></mxCell><mxCell id="res" value="Research operating point: TPR at 1% FPR [B3]&#10;= about 26 000 false windows per month (my arithmetic)" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="142" width="330" height="52" as="geometry" /></mxCell><mxCell id="bud" value="Product budget: an illustrative 4 false alarms per home per month [3]&#10;-&gt; per-window FPR near 1.5 x 10⁻⁶ if every false window counts" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="355" width="330" height="52" as="geometry" /></mxCell><mxCell id="gap" value="gap: about 3.8 orders of magnitude&#10;(3 to 4, my arithmetic)&#10;Partly closed by: merging touching false windows into one EVENT; requiring several positive windows in a row - both cost latency [C1]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="330" y="208" width="290" height="96" as="geometry" /></mxCell><mxCell id="lad_h" value="The KPI ladder: four stages, same six KPIs at each [C1]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="670" y="58" width="580" height="24" as="geometry" /></mxCell><mxCell id="col_home" value="home level" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="790" y="86" width="225" height="24" as="geometry" /></mxCell><mxCell id="col_room" value="room level" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1025" y="86" width="225" height="24" as="geometry" /></mxCell><mxCell id="row_m" value="motion&#10;(person moves)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=right;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="670" y="114" width="110" height="70" as="geometry" /></mxCell><mxCell id="row_p" value="presence&#10;(moving or still)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=right;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="670" y="192" width="110" height="70" as="geometry" /></mxCell><mxCell id="st1" value="1  motion anywhere in the home?&#10;hard part: non-human change" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="790" y="114" width="225" height="70" as="geometry" /></mxCell><mxCell id="st2" value="2  which room has motion?&#10;hard part: adjacent rooms through walls" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1025" y="114" width="225" height="70" as="geometry" /></mxCell><mxCell id="st3" value="3  anyone home, moving or still?&#10;hard part: a still person barely changes the CSI" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="790" y="192" width="225" height="70" as="geometry" /></mxCell><mxCell id="st4" value="4  which room is a person in?&#10;hard part: both of the above" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1025" y="192" width="225" height="70" as="geometry" /></mxCell><mxCell id="six" value="Six KPIs per stage: TPR, FPR, TNR, FNR (wrong room counts as a miss), BLIND-SPOT ratio (area or rooms where errors exceed a threshold), EFFECTIVE-COVERAGE ratio (area or rooms where TPR and TNR both pass). The last two turn an average into a map: a good average can still fail one room every day." style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=top;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="670" y="274" width="580" height="96" as="geometry" /></mxCell><mxCell id="time" value="Time to detect (start of motion -&gt; first positive) and time to clear (exit -&gt; &quot;empty&quot;): report both as distributions with a high percentile, not a mean. State window-level vs event-level for every number." style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=top;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="670" y="380" width="580" height="66" as="geometry" /></mxCell><mxCell id="fld" value="Why it matters (ILLUSTRATIVE): a lab demo looked near-perfect before false-positive cases were tested; the later field study at the product budget reached about 0.5 TPR against a target of 0.9 [4]. Causes: CSI outliers, drift over time, chip CSI quality [C1]." style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=top;align=left;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="670" y="456" width="580" height="72" as="geometry" /></mxCell><mxCell id="legend" value="Legend: red = research operating point / field shortfall | green = product budget, stage 1 | blue, amber, red stages = increasing difficulty | grey ticks = false alarms per 30 days at that FPR. Report every KPI per scenario (near a device, near the AP, door, far, room with no device, small motion, still, empty) [C1, C2]." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="540" width="1220" height="44" as="geometry" /></mxCell><mxCell id="src" value="Numbers (all loaded from constants.json):&#10;[1] window_short_illustrative - ILLUSTRATIVE; round analysis window used in early single-link work; internal I1/I2&#10;[2] seconds_per_30_days - public; arithmetic: 30 x 86400&#10;[3] false_alarm_budget_illustrative - ILLUSTRATIVE; illustrative product-level false-alarm budget; internal I7&#10;[4] field_tpr_vs_target_illustrative - ILLUSTRATIVE; illustrative field shortfall at a false-alarm budget of a few per month; internal I7&#10;Arithmetic (my arithmetic, as in [C1]): decisions per 30 days = seconds_per_30_days / window; false windows at 1% FPR = 0.01 x that; budget FPR = budget / decisions. Notes: [B3] TPR at fixed FPR; [C1] KPIs; [C2] scenario taxonomy. Public ref: Fawcett 2006 (ROC)." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=9;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="596" width="1220" height="92" as="geometry" /></mxCell><mxCell id="line0" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="112.0" as="sourcePoint" /><mxPoint x="150" y="448.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line1" value="" style="endArrow=none;html=0;strokeColor=#b85450;strokeWidth=2.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="168.0" as="sourcePoint" /><mxPoint x="300" y="168.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line2" value="" style="endArrow=none;html=0;strokeColor=#82b366;strokeWidth=2.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="381.4482003287532" as="sourcePoint" /><mxPoint x="300" y="381.4482003287532" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line3" value="" style="endArrow=classic;html=0;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="315" y="196.0" as="sourcePoint" /><mxPoint x="315" y="351.4482003287532" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>