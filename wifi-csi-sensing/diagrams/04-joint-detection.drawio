<mxfile host="app.diagrams.net"><diagram id="p_04_joint_detection" name="04-joint-detection"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="814" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="uline0" value="" style="endArrow=none;html=0;strokeColor=#6c8ebf;strokeWidth=2.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="196.84" y="109.46075949367089" as="sourcePoint" /><mxPoint x="125.16" y="111.72911392405064" as="targetPoint" /></mxGeometry></mxCell><mxCell id="uline1" value="" style="endArrow=none;html=0;strokeColor=#6c8ebf;strokeWidth=2.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="291.12" y="121.72171875" as="sourcePoint" /><mxPoint x="456.88" y="168.98921875" as="targetPoint" /></mxGeometry></mxCell><mxCell id="uline2" value="" style="endArrow=none;html=0;strokeColor=#6c8ebf;strokeWidth=2.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="230.05671826625388" y="134.46" as="sourcePoint" /><mxPoint x="96.47578947368422" y="407.54" as="targetPoint" /></mxGeometry></mxCell><mxCell id="uline3" value="" style="endArrow=none;html=0;strokeColor=#6c8ebf;strokeWidth=2.2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="263.9713931888545" y="134.46" as="sourcePoint" /><mxPoint x="480.4063157894737" y="407.54" as="targetPoint" /></mxGeometry></mxCell><mxCell id="uline4" value="" style="endArrow=none;html=0;strokeColor=#82b366;strokeWidth=1.6;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130.28" y="120.43729468599034" as="sourcePoint" /><mxPoint x="453.72" y="173.56270531400966" as="targetPoint" /></mxGeometry></mxCell><mxCell id="uline5" value="" style="endArrow=none;html=0;strokeColor=#82b366;strokeWidth=1.6;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="85.0" y="136.36" as="sourcePoint" /><mxPoint x="85.0" y="407.64" as="targetPoint" /></mxGeometry></mxCell><mxCell id="uline6" value="" style="endArrow=none;html=0;strokeColor=#82b366;strokeWidth=1.6;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="115.41207547169812" y="136.36" as="sourcePoint" /><mxPoint x="468.58792452830187" y="407.64" as="targetPoint" /></mxGeometry></mxCell><mxCell id="uline7" value="" style="endArrow=none;html=0;strokeColor=#82b366;strokeWidth=1.6;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="462.568" y="203.0" as="sourcePoint" /><mxPoint x="121.432" y="409.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="uline8" value="" style="endArrow=none;html=0;strokeColor=#82b366;strokeWidth=1.6;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="499.0" y="203.0" as="sourcePoint" /><mxPoint x="499.0" y="409.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="uline9" value="" style="endArrow=none;html=0;strokeColor=#82b366;strokeWidth=1.6;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130.28" y="431.0" as="sourcePoint" /><mxPoint x="453.72" y="431.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="title" value="One link cannot tell AP-side from device-side motion; compare links across devices - and add device-to-device links, because links grow as N x N" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=15;fontStyle=1;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="34" as="geometry" /></mxCell><mxCell id="home_lbl" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="530" height="10" as="geometry" /></mxCell><mxCell id="room1" value="room 1" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=#888888;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="64" width="262" height="200" as="geometry" /></mxCell><mxCell id="room2" value="room 2" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=#888888;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="64" width="262" height="200" as="geometry" /></mxCell><mxCell id="room3" value="room 3" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=#888888;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="272" width="262" height="200" as="geometry" /></mxCell><mxCell id="room4" value="room 4" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=none;strokeColor=#888888;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="300" y="272" width="262" height="200" as="geometry" /></mxCell><mxCell id="ap" value="AP" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="200" y="88" width="86" height="40" as="geometry" /></mxCell><mxCell id="d1" value="device 1" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="48" y="96" width="74" height="34" as="geometry" /></mxCell><mxCell id="d2" value="device 2" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="462" y="164" width="74" height="34" as="geometry" /></mxCell><mxCell id="d3" value="device 3" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="48" y="414" width="74" height="34" as="geometry" /></mxCell><mxCell id="d4" value="device 4" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="462" y="414" width="74" height="34" as="geometry" /></mxCell><mxCell id="pa" value="P" style="ellipse;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=9;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="222" y="140" width="26" height="26" as="geometry" /></mxCell><mxCell id="pa_l" value="motion near the AP:&#10;all AP links move together" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="150" y="170" width="150" height="34" as="geometry" /></mxCell><mxCell id="pb" value="Q" style="ellipse;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=9;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="430" y="440" width="26" height="26" as="geometry" /></mxCell><mxCell id="pb_l" value="motion near device 4:&#10;only its links move" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=right;fontSize=9;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1.5;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="306" y="432" width="120" height="34" as="geometry" /></mxCell><mxCell id="links" value="Link graph [B4]: blue solid = AP-device links (N); green dashed = device-to-device links via a softAP on each device, same channel as the AP, MAC-filtered. With N = 4 devices [1]: 4 AP links become 16 directed links (N x N, my arithmetic) - and the new links cross rooms the AP links never cross." style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=top;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="482" width="532" height="72" as="geometry" /></mxCell><mxCell id="wall" value="Through-wall false positives: motion next door reaches the links through the wall, weakened. Mitigate with more endpoints (the right room responds much more strongly), per-home sensitivity for thin walls, and fusion with a sensor that does not see through walls [B4]." style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=top;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="564" width="532" height="72" as="geometry" /></mxCell><mxCell id="rule_h" value="Decision rule: cross-correlate CSI variation across devices [B4]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="590" y="64" width="660" height="26" as="geometry" /></mxCell><mxCell id="r1" value="HIGH correlation across all AP links  -&gt;  motion near the AP (P): every AP link shares the AP end" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="590" y="94" width="660" height="40" as="geometry" /></mxCell><mxCell id="r2" value="LOW correlation, one device's links active  -&gt;  motion near that device (Q)" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="590" y="140" width="660" height="40" as="geometry" /></mxCell><mxCell id="r3" value="Several devices active, LOW mutual correlation  -&gt;  several people, each near a device" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="590" y="186" width="660" height="40" as="geometry" /></mxCell><mxCell id="sn" value="Where: sorted nodes and sorted links [B4]. Node variation w_i = sum_j v_ij; the node with the largest w is probably closest. Take links in order of v; if one end's w is clearly larger (w_i &gt; w_j + T, margin T found empirically), keep the half-plane on that side of the link's perpendicular bisector. The intersection of kept half-planes is the detected area; often the first two or three links decide the room. Equal w at three nodes -&gt; answer &quot;near several nodes&quot;. Needs rough device positions." style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=top;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="590" y="238" width="660" height="118" as="geometry" /></mxCell><mxCell id="ch_h" value="Home-level TPR at 1% FPR (ILLUSTRATIVE) [2]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=12;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="590" y="366" width="660" height="24" as="geometry" /></mxCell><mxCell id="bar0" value="0.5" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=13;fontStyle=1;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="690" y="505" width="90" height="95" as="geometry" /></mxCell><mxCell id="bl0" value="1 device&#10;AP link only&#10;1 link" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="678" y="604" width="114" height="46" as="geometry" /></mxCell><mxCell id="bar1" value="0.75" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=13;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="806" y="458" width="90" height="142" as="geometry" /></mxCell><mxCell id="bl1" value="4 devices&#10;AP links only&#10;4 links" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="794" y="604" width="114" height="46" as="geometry" /></mxCell><mxCell id="bar2" value="0.95" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=13;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="922" y="420" width="90" height="180" as="geometry" /></mxCell><mxCell id="bl2" value="4 devices&#10;AP + device-to-device&#10;16 links" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="910" y="604" width="114" height="46" as="geometry" /></mxCell><mxCell id="tick0" value="0" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=right;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="630" y="591" width="40" height="18" as="geometry" /></mxCell><mxCell id="tick5" value="0.5" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=right;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="630" y="496" width="40" height="18" as="geometry" /></mxCell><mxCell id="tick10" value="1" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=right;fontSize=9;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="630" y="401" width="40" height="18" as="geometry" /></mxCell><mxCell id="ch_note" value="Same four devices: adding device-to-device links gained more than going from one device to four on AP links. By scenario [3]: near a device 0.95, room with no device 0.6, typing 0.4." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1040" y="420" width="210" height="150" as="geometry" /></mxCell><mxCell id="legend" value="Legend: blue = AP and AP-device links | green = devices, device-to-device links (dashed) | red P, Q = example motions | amber = through-wall caveat | bars: grey 1 device, blue 4 devices AP links, green 4 devices all links.  [B4] = kit note; [n] = constants.json entries below." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="662" width="1220" height="44" as="geometry" /></mxCell><mxCell id="src" value="Numbers (all loaded from constants.json):&#10;[1] home_study_size_illustrative - ILLUSTRATIVE; illustrative shape of a cross-home study; internal I7&#10;[2] devices_tpr_illustrative - ILLUSTRATIVE; illustrative relation: more endpoints help, device-to-device links help more; internal I7&#10;[3] motion_type_tpr_illustrative - ILLUSTRATIVE; illustrative per-scenario spread; internal I7&#10;Notes: [B4] multi-device joint detection (softAP links, cross-correlation rule, sorted nodes/links, through-wall false positives, device-count result); see also [C5] one-device homes. hostapd is open-source." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=9;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="716" width="1220" height="84" as="geometry" /></mxCell><mxCell id="line0" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="672" y="600" as="sourcePoint" /><mxPoint x="1030" y="600" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line1" value="" style="endArrow=none;html=0;strokeColor=#333333;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="672" y="600" as="sourcePoint" /><mxPoint x="672" y="410" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line2" value="" style="endArrow=none;html=0;strokeColor=#bbbbbb;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="672" y="410" as="sourcePoint" /><mxPoint x="1022" y="410" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>