<mxfile host="app.diagrams.net"><diagram id="p_05_room_metric_learning" name="05-room-metric-learning"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="648" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Room localisation by metric learning: learn &quot;same room vs different room&quot; once from many homes - then a new home needs one calibration walk, not a new model" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=15;fontStyle=1;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="34" as="geometry" /></mxCell><mxCell id="h1" value="1  TRAIN once, on many homes [B5]" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=12;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="390" height="30" as="geometry" /></mxCell><mxCell id="h2" value="2  CALIBRATE once per new home [B5]" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=12;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="445" y="58" width="390" height="30" as="geometry" /></mxCell><mxCell id="h3" value="3  INFER: nearest reference embedding [B5]" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=12;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="860" y="58" width="390" height="30" as="geometry" /></mxCell><mxCell id="t_data" value="CSI windows (subcarriers x time) from many homes, each labelled with the room the person was in (link labelling rule [B3])" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=10;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="390" height="54" as="geometry" /></mxCell><mxCell id="t_a" value="anchor&#10;room K, home H" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="172" width="118" height="50" as="geometry" /></mxCell><mxCell id="t_p" value="positive&#10;same room K" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="166" y="172" width="118" height="50" as="geometry" /></mxCell><mxCell id="t_n" value="negative&#10;other room, SAME home" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="302" y="172" width="118" height="50" as="geometry" /></mxCell><mxCell id="t_net" value="ONE shared network (Siamese) embeds all three. Options: 1-D conv over time + weighting over subcarriers; 1-D conv over time then over subcarriers; or 2-D conv on the window as an image." style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="242" width="390" height="70" as="geometry" /></mxCell><mxCell id="t_loss" value="Triplet loss: require  d(anchor, negative) &gt; d(anchor, positive) + margin.&#10;FaceNet uses a margin of 0.2 on unit-length embeddings [1] (public).&#10;Contrastive loss (pairs) is the alternative: pull same-room pairs together, push other-room pairs a margin apart." style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="330" width="390" height="96" as="geometry" /></mxCell><mxCell id="c_walk" value="The user walks through each room once while the devices record CSI (the calibration walk)" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="445" y="100" width="390" height="54" as="geometry" /></mxCell><mxCell id="c_emb" value="Embed those windows with the trained network (no retraining)" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="445" y="172" width="390" height="50" as="geometry" /></mxCell><mxCell id="c_ref" value="Store one or a few REFERENCE embeddings per room of THIS home. Any number of rooms, any layout." style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="445" y="242" width="390" height="70" as="geometry" /></mxCell><mxCell id="c_age" value="References age: furniture, doors and device moves change the CSI, so the walk must be refreshed [B5, C5]. Metric learning removes labels in the deployed home - it does NOT remove the need for many training homes." style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="445" y="330" width="390" height="96" as="geometry" /></mxCell><mxCell id="space" value="Embedding space of one home (schematic, 2-D for drawing)" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=10;fillColor=#fbfbfb;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="860" y="100" width="390" height="326" as="geometry" /></mxCell><mxCell id="kA" value="kitchen" style="ellipse;whiteSpace=wrap;html=0;verticalAlign=top;align=center;fontSize=10;fontStyle=1;dashed=1;fillColor=#e8f0fa;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="890" y="150" width="120" height="84" as="geometry" /></mxCell><mxCell id="kB" value="living room" style="ellipse;whiteSpace=wrap;html=0;verticalAlign=top;align=center;fontSize=10;fontStyle=1;dashed=1;fillColor=#ecf5e8;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1070" y="140" width="130" height="90" as="geometry" /></mxCell><mxCell id="kC" value="bedroom" style="ellipse;whiteSpace=wrap;html=0;verticalAlign=bottom;align=center;fontSize=10;fontStyle=1;dashed=1;fillColor=#f4ecf7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="950" y="290" width="130" height="84" as="geometry" /></mxCell><mxCell id="rA" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#6c8ebf;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="942" y="186" width="14" height="14" as="geometry" /></mxCell><mxCell id="rB" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#82b366;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1128" y="176" width="14" height="14" as="geometry" /></mxCell><mxCell id="rC" value="" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=11;fillColor=#9673a6;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1008" y="318" width="14" height="14" as="geometry" /></mxCell><mxCell id="live" value="" style="ellipse;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=11;fillColor=#b85450;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1098" y="244" width="18" height="18" as="geometry" /></mxCell><mxCell id="live_l" value="live window -&gt; nearest&#10;reference = living room" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1056" y="262" width="184" height="36" as="geometry" /></mxCell><mxCell id="far" value="" style="ellipse;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=11;dashed=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1190" y="330" width="18" height="18" as="geometry" /></mxCell><mxCell id="far_l" value="farther than every reference&#10;-&gt; answer &quot;unknown&quot;: empty&#10;or the home has changed" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=right;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1096" y="350" width="150" height="50" as="geometry" /></mxCell><mxCell id="why" value="Why not a room classifier [B5]: a classifier has one output per class. A model trained on four-room homes has no meaning in a six-room home, and retraining per home needs a large labelled dataset. Metric learning turns per-home CLASSIFICATION (does not scale) into per-home CALIBRATION (one walk)." style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=top;align=left;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="444" width="600" height="66" as="geometry" /></mxCell><mxCell id="also" value="Two side uses [B5]: (1) single-device tests can still TRAIN on device-to-device links labelled by the room rule, adding data without changing what is available at test time; (2) devices whose CSI changes look alike are probably in the same room - auto-assign smart-home devices to rooms." style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=top;align=left;fontSize=11;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="650" y="444" width="600" height="66" as="geometry" /></mxCell><mxCell id="legend" value="Legend: purple = training (one network for all homes) | blue = per-home calibration | green = inference; dashed ellipses = rooms, squares = reference embeddings, red dot = live window, hollow red = unknown | amber = drift caveat | red panel = the reason for the design.  [B3], [B5], [C5] = kit notes." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="522" width="1220" height="44" as="geometry" /></mxCell><mxCell id="src" value="Numbers (all loaded from constants.json):&#10;[1] triplet_margin_facenet - public; Schroff, Kalenichenko, Philbin, 'FaceNet', CVPR 2015, alpha&#10;Notes: [B5] room localisation by metric learning (no result numbers - a proposed method); [B3] link labelling; [C5] drift. Public refs: Hadsell, Chopra, LeCun, CVPR 2006 (contrastive); Schroff, Kalenichenko, Philbin, CVPR 2015 (FaceNet, triplet)." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=9;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="578" width="1220" height="56" as="geometry" /></mxCell><mxCell id="line0" value="" style="endArrow=classic;html=0;strokeColor=#b85450;strokeWidth=1.8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1107" y="244" as="sourcePoint" /><mxPoint x="1136" y="192" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge0" value="" style="endArrow=classic;html=0;fontSize=10;exitX=0.15;exitY=1;entryX=0.5;entryY=0;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" parent="1" source="t_data" target="t_a"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge1" value="" style="endArrow=classic;html=0;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" parent="1" source="t_data" target="t_p"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge2" value="" style="endArrow=classic;html=0;fontSize=10;exitX=0.85;exitY=1;entryX=0.5;entryY=0;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" parent="1" source="t_data" target="t_n"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge3" value="" style="endArrow=classic;html=0;fontSize=10;exitX=0.5;exitY=1;entryX=0.15;entryY=0;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" parent="1" source="t_a" target="t_net"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge4" value="" style="endArrow=classic;html=0;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" parent="1" source="t_p" target="t_net"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge5" value="" style="endArrow=classic;html=0;fontSize=10;exitX=0.5;exitY=1;entryX=0.85;entryY=0;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" parent="1" source="t_n" target="t_net"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge6" value="" style="endArrow=classic;html=0;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" parent="1" source="t_net" target="t_loss"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge7" value="" style="endArrow=classic;html=0;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="c_walk" target="c_emb"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge8" value="" style="endArrow=classic;html=0;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="c_emb" target="c_ref"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge9" value="" style="endArrow=classic;html=0;fontSize=10;dashed=1;exitX=1;exitY=0.3;entryX=0;entryY=0.7;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" parent="1" source="t_net" target="c_emb"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge10" value="" style="endArrow=classic;html=0;fontSize=10;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.65;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="c_ref" target="space"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>