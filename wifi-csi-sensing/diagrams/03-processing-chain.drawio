<mxfile host="app.diagrams.net"><diagram id="p_03_processing_chain" name="03-processing-chain"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="902" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="The signal chain moved the result more than the model did: cheap preprocessing, features whose scale does not depend on the room, then any small classifier" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=15;fontStyle=1;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="34" as="geometry" /></mxCell><mxCell id="row1_lbl" value="PREPROCESSING [B1] - every step is a median, a norm or a moving average" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="31" y="54" width="900" height="20" as="geometry" /></mxCell><mxCell id="raw" value="Raw CSI report&#10;one frame: |H| per&#10;subcarrier, with a&#10;real timestamp [A2]" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=10;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="78" width="124" height="96" as="geometry" /></mxCell><mxCell id="s1" value="1  Power-normalise&#10;divide by L2 norm&#10;(removes AGC gain&#10;jumps)" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="166" y="78" width="124" height="96" as="geometry" /></mxCell><mxCell id="s2" value="2  Drop bad&#10;subcarriers&#10;guard-adjacent,&#10;very low amplitude" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="302" y="78" width="124" height="96" as="geometry" /></mxCell><mxCell id="s3" value="3  Background&#10;moving average per&#10;subcarrier = static&#10;channel" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="438" y="78" width="124" height="96" as="geometry" /></mxCell><mxCell id="s4" value="4  Dynamics&#10;amplitude minus&#10;background = the&#10;motion part [A1]" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="574" y="78" width="124" height="96" as="geometry" /></mxCell><mxCell id="s5" value="5  Energy series&#10;L2 norm of the&#10;dynamics: one&#10;number per report" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="710" y="78" width="124" height="96" as="geometry" /></mxCell><mxCell id="s6" value="6  Hampel filter&#10;flag if &gt; 3 x 1.4826 MAD&#10;from the median of&#10;+/-10 reports [1][2][3]" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="846" y="78" width="124" height="96" as="geometry" /></mxCell><mxCell id="s7" value="7  Replace&#10;flagged reports&#10;with the window&#10;median" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="982" y="78" width="124" height="96" as="geometry" /></mxCell><mxCell id="s8" value="8  Smooth&#10;(optional)&#10;exponential&#10;moving average" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1118" y="78" width="124" height="96" as="geometry" /></mxCell><mxCell id="row2_lbl" value="FEATURES [B2] and CLASSIFIER [B3] - one window on one link at a time" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=11;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#82b366;" vertex="1" parent="1"><mxGeometry x="150" y="210" width="900" height="20" as="geometry" /></mxCell><mxCell id="win" value="Window&#10;K subcarriers x L reports&#10;on one link&#10;&#10;illustrative 1 s or 4 s [4][5]" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=11;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="240" width="190" height="150" as="geometry" /></mxCell><mxCell id="f_acf" value="ACF (lag 1, averaged over subcarriers): ~1 when still, falls toward 0 with motion; lies in [-1, 1] in every room" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="270" y="240" width="330" height="46" as="geometry" /></mxCell><mxCell id="f_pca" value="PCA eigenvalues of the K x K covariance: still = one dominant eigenvalue; motion spreads energy to the 2nd and later" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="270" y="292" width="330" height="46" as="geometry" /></mxCell><mxCell id="f_fft" value="FFT per subcarrier, DC bin REMOVED (it encodes the room) and the top third of bins dropped as noise [6]" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="270" y="344" width="330" height="46" as="geometry" /></mxCell><mxCell id="clf" value="Classifier ladder [B3]&#10;- threshold on one feature&#10;- SVM (RBF kernel)&#10;- small MLP on FFT features, illustrative 128 + 32 hidden units [7]&#10;- (sequence / CNN models: too little data)&#10;Score -&gt; threshold set by the false-alarm budget [C1]" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="650" y="240" width="300" height="150" as="geometry" /></mxCell><mxCell id="out" value="Per-link, per-window motion probability&#10;&#10;-&gt; fused across all links of the home [B4]" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1000" y="240" width="250" height="150" as="geometry" /></mxCell><mxCell id="c_grp" value="Group adjacent subcarriers (Ng = 4; 802.11 uses Ng in 1/2/4 [8]): NO loss, 4x less data. Adjacent subcarriers are strongly correlated [B1]." style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=top;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="406" width="295" height="66" as="geometry" /></mxCell><mxCell id="c_sel" value="Keep only the top 10% of subcarriers [9] by mean amplitude: about 4 TPR points lost, about 90% of feature compute saved [10] (illustrative)." style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=top;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="338" y="406" width="295" height="66" as="geometry" /></mxCell><mxCell id="c_res" value="DO NOT resample to a uniform time grid: interpolation manufactured smooth samples where reports were missing and clearly hurt detection. Use real timestamps [B1, A2]." style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=top;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="646" y="406" width="295" height="66" as="geometry" /></mxCell><mxCell id="c_ph" value="Phase: random offsets per report. Sanitise only with 2+ receive antennas (linear fit, conjugate product, CSI ratio). A single-stream link uses amplitude only [A2, B1]." style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=top;align=left;fontSize=10;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="954" y="406" width="296" height="66" as="geometry" /></mxCell><mxCell id="ev1" value="What the studies showed (ILLUSTRATIVE values, direction is the lesson):&#10;- preprocessing raised average TPR by about 10 points, and by about 30 points in the hardest scenarios (room with no device, small motion, near the AP) [11]&#10;- single link, TPR at 1% FPR: variance 0.4, ACF lag 1 0.65 [12]; FFT + small net 0.6 [13]" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=top;align=left;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="484" width="610" height="84" as="geometry" /></mxCell><mxCell id="ev2" value="How the result must be tested (ILLUSTRATIVE):&#10;- same features and classifier: 0.9 accuracy on a random split, 0.6 on an unseen day [14][15] - split by time and by home, never at random [B3]&#10;- leave-one-home-out: best home 0.95 TPR, worst home 0.05 [16] - the home is the unit of generalisation" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=top;align=left;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="654" y="484" width="596" height="84" as="geometry" /></mxCell><mxCell id="legend" value="Legend: grey = input / window | blue = preprocessing step (red-outlined cards = traps) | green = room-independent feature, green panel = evidence | purple = classifier | amber = output | red panel = evaluation trap.  [A1]-[C1] = kit notes; [n] = constants.json entries below." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="580" width="1220" height="44" as="geometry" /></mxCell><mxCell id="src" value="Numbers (all loaded from constants.json):&#10;[1] hampel_threshold_typical - public; conventional Hampel threshold (Pearson 2002; MATLAB hampel default)&#10;[2] hampel_mad_scale - public; Hampel filter / MAD consistency constant for Gaussian data (Pearson, IEEE Trans. Control Syst. Technol. 2002)&#10;[3] hampel_halfwidth_illustrative - ILLUSTRATIVE; illustrative Hampel neighbourhood; internal I7&#10;[4] window_short_illustrative - ILLUSTRATIVE; round analysis window used in early single-link work; internal I1/I2&#10;[5] window_long_illustrative - ILLUSTRATIVE; round analysis window used in later feature studies; internal I7&#10;[6] fft_high_freq_drop_illustrative - ILLUSTRATIVE; illustrative: the top third of frequency bins was discarded as noise-dominated; internal I7&#10;[7] mlp_hidden_units_illustrative - ILLUSTRATIVE; illustrative small MLP on concatenated FFT features; internal I7&#10;[8] beamforming_grouping_ng - public; IEEE 802.11n/ac compressed beamforming feedback, grouping parameter Ng&#10;[9] subcarrier_keep_fraction_illustrative - ILLUSTRATIVE; illustrative 'top 10%' selection; internal I7&#10;[10] subcarrier_selection_cost_illustrative - ILLUSTRATIVE; illustrative relation: keeping 10% of subcarriers costs a few TPR points and saves about 90% of feature compute; internal I7&#10;[11] preprocessing_gain_illustrative - ILLUSTRATIVE; illustrative order of the event-level gain from the preprocessing chain, average vs hardest scenario; internal I7&#10;[12] acf_vs_variance_illustrative - ILLUSTRATIVE; illustrative gap between a self-normalised ACF feature and raw variance; internal I7&#10;[13] single_feature_tpr_illustrative - ILLUSTRATIVE; illustrative ordering of single-link features; internal I7 feature comparison&#10;[14] split_random_accuracy_illustrative - ILLUSTRATIVE; illustrative accuracy on a random train/test split of the same days; internal I2&#10;[15] split_heldout_day_accuracy_illustrative - ILLUSTRATIVE; illustrative accuracy when testing on an unseen day; internal I2&#10;[16] home_spread_illustrative - ILLUSTRATIVE; illustrative spread for a simple ACF+variance+SVM detector in leave-one-home-out tests; internal I7&#10;Notes: [A1] multipath; [A2] hardware; [B1] preprocessing; [B2] features; [B3] classifiers and windows; [B4] joint detection; [C1] KPIs. Public refs: Hampel 1974, Pearson 2002 (Hampel/MAD); Zhang et al. 2018-2019 (ACF); Wang et al. 2015 (CARM, PCA); Kotaru et al. 2015, Li et al. 2017, Zeng et al. 2019 (phase); Cortes and Vapnik 1995 (SVM)." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=9;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="636" width="1220" height="250" as="geometry" /></mxCell><mxCell id="line0" value="" style="endArrow=none;html=0;strokeColor=#666666;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1180" y="174" as="sourcePoint" /><mxPoint x="1180" y="200" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line1" value="" style="endArrow=none;html=0;strokeColor=#666666;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1180" y="200" as="sourcePoint" /><mxPoint x="125" y="200" as="targetPoint" /></mxGeometry></mxCell><mxCell id="line2" value="" style="endArrow=classic;html=0;strokeColor=#666666;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125" y="200" as="sourcePoint" /><mxPoint x="125" y="238" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge0" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="raw" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge1" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge2" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge3" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge4" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge5" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge6" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge7" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#6c8ebf;fontColor=#6c8ebf;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge8" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1" source="win" target="f_acf"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge9" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1" source="win" target="f_pca"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge10" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#82b366;fontColor=#82b366;" edge="1" parent="1" source="win" target="f_fft"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge11" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.3;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" parent="1" source="f_acf" target="clf"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge12" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" parent="1" source="f_pca" target="clf"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge13" value="" style="endArrow=classic;html=0;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.7;strokeColor=#9673a6;fontColor=#9673a6;" edge="1" parent="1" source="f_fft" target="clf"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge14" value="" style="endArrow=classic;html=0;fontSize=10;fontStyle=1;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#d79b00;fontColor=#d79b00;" edge="1" parent="1" source="clf" target="out"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>