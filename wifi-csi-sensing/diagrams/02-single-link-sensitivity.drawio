<mxfile host="app.diagrams.net"><diagram id="p_02_single_link_sensitivity" name="02-single-link-sensitivity"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="768" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="One link sees motion best near its two radios, less mid-link, and almost nothing a few metres off the line of sight or behind a wall" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=center;fontSize=15;fontStyle=1;fillColor=#ffffff;strokeColor=#ffffff;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1240" height="34" as="geometry" /></mxCell><mxCell id="scene" value="One link, seen from above (schematic: zone widths exaggerated, not to scale) [A1]" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fillColor=#fbfbfb;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="860" height="470" as="geometry" /></mxCell><mxCell id="band" value="walking visible out to about 4 m from the LoS [1] (illustrative); hand-waving about 3 m [2]" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=top;align=left;fontSize=10;dashed=1;fillColor=#f3f7fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="800" height="330" as="geometry" /></mxCell><mxCell id="z3" value="" style="ellipse;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=11;fillColor=none;strokeColor=#bbbbbb;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="75" y="190" width="740" height="200" as="geometry" /></mxCell><mxCell id="z2" value="" style="ellipse;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=11;fillColor=none;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="95" y="222" width="700" height="136" as="geometry" /></mxCell><mxCell id="z1" value="" style="ellipse;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=11;fillColor=#ece4f1;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="115" y="254" width="660" height="72" as="geometry" /></mxCell><mxCell id="z3l" value="zone 3" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="415" y="192" width="60" height="26" as="geometry" /></mxCell><mxCell id="z2l" value="zone 2" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="415" y="224" width="60" height="26" as="geometry" /></mxCell><mxCell id="z1l" value="first Fresnel zone" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=10;fontStyle=1;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="385" y="256" width="120" height="22" as="geometry" /></mxCell><mxCell id="tx" value="AP&#10;(transmitter)" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="56" y="264" width="96" height="52" as="geometry" /></mxCell><mxCell id="rx" value="device&#10;(receiver)" style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="738" y="264" width="96" height="52" as="geometry" /></mxCell><mxCell id="pA" value="A" style="ellipse;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="168" y="296" width="34" height="34" as="geometry" /></mxCell><mxCell id="pB" value="B" style="ellipse;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="428" y="292" width="34" height="34" as="geometry" /></mxCell><mxCell id="pC" value="C" style="ellipse;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="600" y="390" width="34" height="34" as="geometry" /></mxCell><mxCell id="wall" value="wall" style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=center;fontSize=9;fillColor=#bbbbbb;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="452" width="800" height="14" as="geometry" /></mxCell><mxCell id="pD" value="D" style="ellipse;whiteSpace=wrap;html=0;verticalAlign=middle;align=center;fontSize=10;fontStyle=1;dashed=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="430" y="478" width="34" height="34" as="geometry" /></mxCell><mxCell id="pD_l" value="D: next room, behind the wall - most of the effect removed [A1]; but what remains is a through-wall false positive [B4]" style="text;html=0;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=10;fillColor=none;strokeColor=none;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="470" y="476" width="380" height="40" as="geometry" /></mxCell><mxCell id="pat" value="What one link sees - a power-fading simulation and single-link measurements agreed [A1]:&#10;&#10;A  motion close to EITHER radio changes the CSI most (red).&#10;&#10;B  on the LoS, motion mid-link changes it LESS than near the ends: the first zone is narrowest at the radios, so a body there fills more of it (amber).&#10;&#10;C  sensitivity falls steeply outside the first zone (grey).&#10;&#10;Also: motion ON the LoS drops power more than motion beside it." style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=top;align=left;fontSize=11;fillColor=#eeeeee;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="910" y="60" width="340" height="250" as="geometry" /></mxCell><mxCell id="fz" value="Fresnel zones (Wang et al. UbiComp 2016): nested ellipses with the radios at the foci; zone n ends where a reflected path is n half-wavelengths longer than the LoS. First-zone radius at mid-link:&#10;      r1 = 0.5 x sqrt(lambda x d)&#10;For an illustrative d = 4 m link [3]:&#10;   0.23 m at 5 GHz, 0.35 m at 2.4 GHz [4]&#10;A body crossing zone boundaries makes one fluctuation per boundary." style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=top;align=left;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="910" y="322" width="340" height="208" as="geometry" /></mxCell><mxCell id="so" value="So what: placement decides coverage. A room with no device is covered only weakly, through walls, and one link cannot tell motion near its AP end from motion near its device end - only a comparison across several links resolves that [B4, C5]." style="rounded=1;whiteSpace=wrap;html=0;verticalAlign=middle;align=left;fontSize=11;fontStyle=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="542" width="1220" height="52" as="geometry" /></mxCell><mxCell id="legend" value="Legend: blue = radios | purple fill = first Fresnel zone, grey rings = zones 2-3 | dashed blue = illustrative detectable band | target fill: red = large change, amber = smaller, grey = weak, dashed white = behind a wall.  [A1], [B4], [C5] = kit notes; [n] = constants.json entries below." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="604" width="1220" height="44" as="geometry" /></mxCell><mxCell id="src" value="Numbers (all loaded from constants.json):&#10;[1] single_link_range_illustrative - ILLUSTRATIVE; illustrative distance beyond which walking motion is hard to see on one link; internal I1 reports the same order&#10;[2] small_motion_range_illustrative - ILLUSTRATIVE; illustrative range for hand-waving detection; internal I1&#10;[3] link_length_illustrative - ILLUSTRATIVE; round room-scale link length used for the Fresnel example in A1&#10;[4] fresnel_first_zone_mid_radius_example - public; my arithmetic: r1 = 0.5 x sqrt(lambda x d) at the midpoint of a link of illustrative length d = 4 m (link_length_illustrative); formula from Fresnel-zone model, Wang et al. UbiComp 2016&#10;Notes: [A1] CSI and multipath (Fresnel zones, single-link patterns, range, wall); [B4] multi-device joint detection; [C5] limits. Public ref: Wang et al., UbiComp 2016 (Fresnel-zone model)." style="text;html=0;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=9;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="658" width="1220" height="96" as="geometry" /></mxCell><mxCell id="line0" value="" style="endArrow=classic;html=0;strokeColor=#444444;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="152" y="290" as="sourcePoint" /><mxPoint x="738" y="290" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>